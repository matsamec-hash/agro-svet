---
// Atribuce přilepená do rohu hero fotky: autor · licence (odkaz na její text) ·
// zdroj. Používá se tam, kde je na stránce jedna velká fotka; přehledy s mnoha
// miniaturami mají místo toho souhrnný blok `PhotoCredits.astro`.
//
// `credit` má přednost (frontmatter u konkrétního stroje), jinak se autor
// a licence dotáhnou z registru podle cesty k obrázku.
import { creditFor, licenseUrlFor, type PhotoCredit } from '../lib/photo-credit';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  image?: string | null;
  /** `licenseUrl` dodej tam, kde se z názvu licence odvodit nedá (fotobanky). */
  credit?: { author?: string; license?: string; licenseUrl?: string; sourceUrl?: string } | null;
  locale?: Locale;
  /** Roh fotky. Na kartách s titulkem dole (homepage) je volný jen horní pravý. */
  placement?: 'bottom-right' | 'top-right';
  /**
   * Jen „© autor · licence" (odkaz na text licence). Zdroj a „upraveno" vynechá —
   * na kartě na ně není místo; ty nese souhrnný blok `PhotoCredits.astro`
   * pod/za přehledem, který zůstává.
   */
  compact?: boolean;
  /** Strop šířky plaketky (CSS), ať se na úzké kartě zalomí, a nepřekryje štítek kategorie. */
  maxWidth?: string;
}

const {
  image,
  credit,
  locale = (Astro.locals.locale ?? 'cs') as Locale,
  placement = 'bottom-right',
  compact = false,
  maxWidth,
} = Astro.props;

const resolved: PhotoCredit | null = credit?.author
  ? {
      author: credit.author,
      license: credit.license ?? '',
      licenseUrl: credit.licenseUrl ?? licenseUrlFor(credit.license),
      source: credit.sourceUrl,
    }
  : (() => {
      const c = creditFor(image);
      return c && c.author ? c : null;
    })();
---

{resolved && (
  <div
    class:list={['hero-photo-credit', { 'hero-photo-credit--top': placement === 'top-right', 'hero-photo-credit--compact': compact }]}
    style={maxWidth ? `max-width:${maxWidth}` : undefined}
  >
    © {resolved.author}
    {resolved.license && (
      <>
        {' · '}
        {resolved.licenseUrl ? (
          <a href={resolved.licenseUrl} target="_blank" rel="license noopener noreferrer nofollow">{resolved.license}</a>
        ) : (
          resolved.license
        )}
      </>
    )}
    {!compact && resolved.source && (
      <>
        {' · '}
        <a href={resolved.source} target="_blank" rel="noopener noreferrer nofollow">{t(locale, 'foto.blok.zdroj')}</a>
      </>
    )}
    {/* CC BY i CC BY-SA žádají uvést, že dílo bylo upraveno — hero fotky
        ořezáváme do poměru a převádíme do WebP. */}
    {!compact && <>{' · '}<span title={t(locale, 'foto.blok.upravy')}>{t(locale, 'foto.blok.upravenoKratce')}</span></>}
  </div>
)}

<style>
  .hero-photo-credit {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    font-size: 11px;
    line-height: 1.3;
    padding: 5px 9px;
    border-radius: 6px;
    background: rgba(10, 10, 11, 0.62);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(4px);
  }
  .hero-photo-credit--top {
    top: 10px;
    bottom: auto;
  }
  .hero-photo-credit--compact {
    font-size: 10px;
    padding: 4px 8px;
  }
  .hero-photo-credit a {
    color: inherit;
    text-decoration: underline;
    /* Název licence („CC BY-SA 4.0") se nesmí zalomit uprostřed; na úzké kartě
       se zalamuje až před ním. */
    white-space: nowrap;
  }
  .hero-photo-credit:hover {
    background: rgba(10, 10, 11, 0.85);
    color: #fff;
  }
</style>
