---
import IndicatorChart from './IndicatorChart.astro';
import { fmtNum, vsReference } from '../../lib/svet/render';
import { INDICATOR_LABELS, loc, type SvetLang } from '../../i18n/svet';
import type { Indicator, SeriesPoint } from '../../lib/svet/types';
interface Props {
  indicator: Indicator;
  refValue?: number;
  refSeries?: SeriesPoint[] | null;
  refName?: string;
  countryName: string;
}
const { indicator: ind, refValue, refSeries = null, refName = 'ČR', countryName } = Astro.props;
const locale = Astro.locals.locale ?? 'cs';
const label = locale === 'cs' ? ind.label : loc(INDICATOR_LABELS, ind.key, locale as SvetLang, ind.label);
const cmp = refValue != null ? vsReference(ind.latest.value, refValue) : null;
const periodNum = Number(ind.latest.referencePeriod);
const stale = periodNum > 0 && periodNum <= 2020;
const dirSign = cmp && cmp.dir === 'up' ? '+' : '';
// ‼️ Mapa, ne řetězený ternář: chybějící jazyk je pak vidět jako undefined,
// místo aby tiše spadl do češtiny uprostřed jinak přeložené stránky.
const VS_TITLE: Record<string, string> = {
  cs: `Poslední dostupná hodnota (${ind.latest.referencePeriod}) porovnaná se stejným ukazatelem v ${refName}. Vývoj po letech a rozdíl v jednotlivých letech ukazuje graf.`,
  sk: `Posledná dostupná hodnota (${ind.latest.referencePeriod}) v porovnaní s rovnakým ukazovateľom v referenčnej krajine ${refName}. Vývoj a rozdiely po rokoch ukazuje graf.`,
  pl: `Ostatnia dostępna wartość (${ind.latest.referencePeriod}) w porównaniu z tym samym wskaźnikiem w kraju referencyjnym ${refName}. Rozwój i różnice w latach pokazuje wykres.`,
  de: `Zuletzt verfügbarer Wert (${ind.latest.referencePeriod}) im Vergleich mit derselben Kennzahl im Referenzland ${refName}. Entwicklung und Unterschiede nach Jahren zeigt das Diagramm.`,
  uk: `Останнє доступне значення (${ind.latest.referencePeriod}) у порівнянні з тим самим показником у країні порівняння ${refName}. Динаміку та різницю за роками показує графік.`,
};
const STALE_SUFFIX: Record<string, string> = {
  cs: ' (nejnovější dostupné)', sk: ' (najnovšie dostupné)', pl: ' (najnowsze dostępne)',
  de: ' (aktuellste verfügbare)', uk: ' (найновіші доступні)',
};
const vsTitle = VS_TITLE[locale] ?? VS_TITLE.cs;
const staleSuffix = STALE_SUFFIX[locale] ?? STALE_SUFFIX.cs;
---
<article class="svet-ind">
  <div class="svet-ind-top">
    <span class="svet-ind-label">{label}</span>
    {cmp && (
      <span class={`svet-vs svet-vs-${cmp.dir}`} title={vsTitle}>
        {dirSign}{fmtNum(cmp.pct)} % vs {refName}<span class="svet-vs-info" aria-hidden="true">ⓘ</span>
      </span>
    )}
  </div>
  <div class="svet-ind-value">
    {fmtNum(ind.latest.value)} <span class="svet-ind-unit">{ind.unit}</span>
    {refValue != null && <span class="svet-ind-ref">· {refName} {fmtNum(refValue)}</span>}
  </div>
  <IndicatorChart series={ind.series} refSeries={refSeries} unit={ind.unit} label={label} countryName={countryName} refName={refName} />
  <div class="svet-ind-foot">
    <a class="svet-src" href={ind.latest.sourceUrl} target="_blank" rel="noopener noreferrer">{ind.latest.source} · {ind.latest.referencePeriod}{stale ? staleSuffix : ''}</a>
  </div>
</article>
