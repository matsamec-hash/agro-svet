---
// Ukrajinská homepage = kurátovaný rozcestník na launchnuté UA sekce,
// NE český zpravodajský feed. Renderuje se z index.astro když locale === 'uk'.
// Vzor: PudaUk.astro (self-contained, vlastní <Layout>, ukrajinské stringy).
// ‼️ 2026-08-31: rozcestník tu roky nabízel JEN 4 karty (statistiky / puda /
// dotace / slovnik), přestože uk má launchnutých 22 sekcí — katalog techniky,
// značky, encyklopedie, srovnání, žebříčky, plodiny, choroby, plemena,
// včelařství, jak-na-to, kvíz i akcie žily a nevedl na ně jediný odkaz.
// Launch sekce a odkaz na ni jsou DVĚ různé věci; hlídá to uk-launch.test.ts.
// Cesty hardcoded /uk/... — každá odpovídá záznamu v LAUNCHED_PREFIXES.uk.
import Layout from '../../layouts/Layout.astro';

const SECTIONS = [
  {
    href: '/uk/stroje/',
    icon: '🚜',
    title: 'Каталог техніки',
    desc: 'Трактори, комбайни та причіпна техніка 22 брендів — технічні дані, серії та моделі.',
  },
  {
    href: '/uk/znacky/',
    icon: '🏭',
    title: 'Бренди',
    desc: 'Профілі виробників сільгосптехніки — історія, модельний ряд і місце на ринку.',
  },
  {
    href: '/uk/encyklopedie/',
    icon: '📚',
    title: 'Енциклопедія машин',
    desc: 'Докладні описи окремих моделей: двигун, трансмісія, оснащення та для кого вони призначені.',
  },
  {
    href: '/uk/srovnani/',
    icon: '⚖️',
    title: 'Порівняння моделей',
    desc: 'Дві машини поруч — потужність, вага та оснащення у прямому зіставленні.',
  },
  {
    href: '/uk/zebricky/',
    icon: '🏆',
    title: 'Рейтинги',
    desc: 'Добірки за потужністю та шириною захвату — від компактних тракторів до кормозбиральних комбайнів.',
  },
  {
    href: '/uk/statistiky/',
    icon: '📊',
    title: 'Статистика',
    desc: 'Експорт, виробництво та ціни головних культур України — пшениця, кукурудза, соняшник.',
  },
  {
    href: '/uk/puda/',
    icon: '🌱',
    title: 'Ринок землі',
    desc: 'Відкриття ринку, ціни та оренда, структура культур і стан ґрунтів.',
  },
  {
    href: '/uk/dotace/',
    icon: '💰',
    title: 'Субсидії',
    desc: 'Гранти й воєнна підтримка, програма «Власна справа», кредити 5-7-9 та донори.',
  },
  {
    href: '/uk/akcie/',
    icon: '📈',
    title: 'Акції агрокомпаній',
    desc: 'Курси акцій найбільших аграрних компаній світу та їхній рух на біржах.',
  },
  {
    href: '/uk/plodiny/',
    icon: '🌾',
    title: 'Культури та сорти',
    desc: 'Агрономія польових культур — норма висіву, удобрення, сівозміна та врожайність.',
  },
  {
    href: '/uk/choroby/',
    icon: '🍂',
    title: 'Хвороби та шкідники',
