---
// Slovenská homepage = plnohodnotný portál jako CZ verze (zpravodajský feed +
// rozcestník sekcí + graf komodit + newsletter). Renderuje se z index.astro
// když locale === 'sk'. Self-contained (vlastní <Layout>, slovenské stringy).
// Vzor HomePl. Dřív SK používala sdílenou CZ šablonu → české sekce + feed
// odkazoval na skryté dotační články (404). Teď plně slovenská.
//
// Feed = reálné SK články přes `article_translations` overlay (locale='sk') +
// BEZ jurisdikčně skrytých kategorií (HIDDEN_NEWS_CATEGORIES.sk = dotace/legislativa),
// jinak by hero/feed odkazoval na 404. Overlay dá slovenské titulky.
import Layout from '../../layouts/Layout.astro';
import '../../styles/home.css';
import ArticleCard from '../ArticleCard.astro';
import CommodityChart from '../statistiky/CommodityChart.astro';
import Newsletter from '../Newsletter.astro';
import { createAnonClient } from '../../lib/supabase';
import { AGRO_SVET_SITE_ID as SITE_ID, SITE_URL } from '../../lib/config';
import { imgSrcset } from '../../lib/image-variants';
import { localizeInternalHref, localizedCategory } from '../../i18n/utils';
import { newsCategorySlug } from '../../lib/news-category';
import { HIDDEN_NEWS_CATEGORIES } from '../../i18n/nav';
import { COMMODITY_NAMES_SK } from '../../lib/commodity-names';
import { fetchArticleTranslations, overlayArticle, buildTranslationMap, fetchTranslatedArticleIds } from '../../lib/articles-i18n';

const LOCALE = 'sk' as const;

const supabase = createAnonClient();
const translatedIds = await fetchTranslatedArticleIds(supabase, LOCALE);
const idList = [...translatedIds];
const hidden = HIDDEN_NEWS_CATEGORIES[LOCALE];

let feed: any[] = [];
if (idList.length) {
  let q = supabase
    .from('articles')
    .select('id, title, slug, perex, featured_image_url, focal_point, category, tags, published_at, featured')
    .eq('site_id', SITE_ID)
    .eq('status', 'published')
    .in('id', idList);
  if (hidden.length) q = q.not('category', 'in', `(${hidden.join(',')})`);
  const { data } = await q
    .order('featured', { ascending: false })
    .order('published_at', { ascending: false })
    .limit(14);
  const rows = data ?? [];
  const trMap = buildTranslationMap(await fetchArticleTranslations(supabase, rows.map((a) => a.id), LOCALE));
  feed = rows.map((a) => overlayArticle(a, trMap.get(a.id)));
}

const featured = feed[0];
const heroRight = feed.slice(1, 5);
const rest = feed.slice(5, 14);

const SECTIONS = [
  { href: '/sk/stroje/', icon: '🚜', title: 'Katalóg strojov', desc: 'Traktory, kombajny a poľnohospodárske stroje s technickými parametrami, výkonom a popisom.' },
  { href: '/sk/znacky/', icon: '🏷️', title: 'Značky', desc: 'Prehľad výrobcov poľnohospodárskej techniky — od Fendtu a John Deere po Zetor.' },
  { href: '/sk/srovnani/', icon: '⚖️', title: 'Porovnania', desc: 'Priame porovnania modelov — výkon, hmotnosť, parametre a verdikt, čo vybrať.' },
  { href: '/sk/plemena/', icon: '🐄', title: 'Plemená zvierat', desc: 'Hovädzí dobytok, ošípané, ovce a hydina — pôvod, úžitkovosť a chovné vlastnosti plemien.' },
  { href: '/sk/encyklopedie/', icon: '📚', title: 'Encyklopédia', desc: 'Pojmy z poľnohospodárstva a techniky prehľadne vysvetlené — od stroja po agronómiu.' },
  { href: '/sk/jak-na-to/', icon: '📋', title: 'Ako na to', desc: 'Praktické návody krok za krokom — agrotechnika, výber strojov a chov.' },
  { href: '/sk/statistiky/', icon: '📊', title: 'Ceny a štatistiky', desc: 'Živé ceny komodít, produkcia, náklady na vstupy a regionálne dáta v interaktívnych grafoch.' },
  { href: '/sk/puda/', icon: '🌱', title: 'Poľnohospodárska pôda', desc: 'Trh s poľnohospodárskou pôdou — ceny, nájom a stav pôd.' },
  { href: '/sk/vcelarstvi/', icon: '🐝', title: 'Včelárstvo', desc: 'Chov včiel, medobranie a starostlivosť o včelstvá — praktické rady pre včelárov.' },
];

const heroTagLabel = (cat: string | null) => (cat ? localizedCategory(LOCALE, newsCategorySlug(cat)) : 'Novinky');

const homepageItems = [...(featured ? [featured] : []), ...heroRight];
const itemListJsonLd = homepageItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'agro-svět.cz — novinky (SK)',
  numberOfItems: homepageItems.length,
  itemListElement: homepageItems.map((a, i) => ({
    '@type': 'ListItem', position: i + 1,
    url: `${SITE_URL}/sk/novinky/${a.slug}/`, name: a.title,
  })),
} : null;
---

<Layout
  title="Svet poľnohospodárstva — stroje, značky a novinky"
  description="Poľnohospodársky portál po slovensky: novinky zo sveta poľnohospodárstva a techniky, katalóg strojov, značky výrobcov, porovnania modelov, ceny komodít a encyklopédia pojmov."
  preloadHeroImage={featured?.featured_image_url ?? undefined}
  preloadHeroSizes="(max-width: 900px) 100vw, 800px"
  preloadHeroMaxWidth={800}
>
  {itemListJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />}

  <h1 class="visually-hidden">Svet poľnohospodárstva — stroje, značky a novinky</h1>

  {featured && (
    <section class="hero-section">
      <div class={`hero-grid${heroRight.length === 3 ? ' hero-grid-3' : ''}`}>
        <div class="hero-card hero-main hero-wrap">
          <a href={localizeInternalHref(LOCALE, `/novinky/${featured.slug}/`)} class="hero-link">
            {featured.featured_image_url && (() => {
              const v = imgSrcset(featured.featured_image_url, '(max-width: 900px) 100vw, 800px', 800);
              return <img src={v.src} srcset={v.srcset} sizes={v.sizes} alt={featured.title} width="800" height="600" fetchpriority="high" decoding="async" style={`object-position: ${featured.focal_point?.x ?? 50}% ${featured.focal_point?.y ?? 50}%;`} />;
            })()}
            <div class="hero-overlay"></div>
            <div class="hero-card-content"><h2>{featured.title}</h2></div>
          </a>
          <div class="hero-tags">
            <a href={localizeInternalHref(LOCALE, '/novinky/')} class="hero-tag">Novinky</a>
            {featured.category && <a href={localizeInternalHref(LOCALE, `/novinky/kategorie/${newsCategorySlug(featured.category)}/`)} class="hero-tag">{heroTagLabel(featured.category)}</a>}
          </div>
        </div>

        {heroRight.map((article) => (
          <div class="hero-card hero-small hero-wrap">
            <a href={localizeInternalHref(LOCALE, `/novinky/${article.slug}/`)} class="hero-link">
              {article.featured_image_url
                ? (() => {
                    const v = imgSrcset(article.featured_image_url, '(max-width: 900px) 50vw, 400px');
                    return <img src={v.src} srcset={v.srcset} sizes={v.sizes} alt={article.title} width="400" height="300" loading="lazy" decoding="async" />;
                  })()
                : <div class="hero-placeholder"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#bbb" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div>
              }
              <div class="hero-overlay"></div>
              <div class="hero-card-content"><h3>{article.title}</h3></div>
            </a>
            <a href={localizeInternalHref(LOCALE, article.category ? `/novinky/kategorie/${newsCategorySlug(article.category)}/` : '/novinky/')} class="hero-tag">{heroTagLabel(article.category)}</a>
          </div>
        ))}
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="home-feed">
      <div class="home-head">
        <h2>Novinky</h2>
        <a href={localizeInternalHref(LOCALE, '/novinky/')} class="home-cta">Všetky novinky →</a>
      </div>
      <div class="home-cards">
        {rest.map((article) => (
          <ArticleCard
            title={article.title}
            description={article.perex}
            slug={article.slug}
            publishDate={new Date(article.published_at)}
            category={article.category}
            heroImage={article.featured_image_url}
            focalPoint={article.focal_point}
            locale={LOCALE}
          />
        ))}
      </div>
    </section>
  )}

  <section class="home-sections">
    <div class="home-head">
      <h2>Sekcie portálu</h2>
    </div>
    <div class="home-grid">
      {SECTIONS.map((s) => (
        <a href={s.href} class="home-card">
          <span class="home-card-icon" aria-hidden="true">{s.icon}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <span class="home-card-cta">Prejsť do sekcie →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-commodity">
    <div class="home-head">
      <h2>Dáta: Trhy a komodity</h2>
      <a href={localizeInternalHref(LOCALE, '/statistiky/')} class="home-cta">Zobraziť celú sekciu →</a>
    </div>
    <CommodityChart commodityNames={COMMODITY_NAMES_SK} dataBase="-sk" numLocale="sk-SK" locale={LOCALE} />
  </section>

  <Newsletter />
</Layout>
