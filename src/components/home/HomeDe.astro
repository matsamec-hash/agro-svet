---
// Německá homepage = kurátovaný rozcestník na launchnuté DE sekce, NE český
// zpravodajský feed. Renderuje se z index.astro když locale === 'de'.
// ‼️ PROČ: /de/ dřív servírovalo německý chrome (menu, cookie lišta) nad
// ČESKÝM tělem homepage a s českým <title> — pro návštěvníka to vypadalo
// rozbitě. Přesně stejná past jako dřív u /uk/, vzor je proto HomeUk.astro.
// Cesty hardcoded /de/... — všechny odkazované sekce jsou launchnuté a
// buď pan-evropské (katalog), nebo DE-only (Direktzahlungen, Öko-Regelungen).
import Layout from '../../layouts/Layout.astro';

const SECTIONS = [
  {
    href: '/de/stroje/',
    icon: '🚜',
    title: 'Maschinenkatalog',
    desc: 'Traktoren, Mähdrescher und Anbaugeräte von 22 Marken — technische Daten, Baureihen und Modelle.',
  },
  {
    href: '/de/znacky/',
    icon: '🏭',
    title: 'Marken',
    desc: 'Profile der Landtechnikhersteller — Geschichte, Produktprogramm und Einordnung im Markt.',
  },
  {
    href: '/de/encyklopedie/',
    icon: '📚',
    title: 'Maschinen-Enzyklopädie',
    desc: 'Ausführliche Porträts einzelner Modelle: Motor, Getriebe, Ausstattung und für wen sie gedacht sind.',
  },
  {
    href: '/de/srovnani/',
    icon: '⚖️',
    title: 'Modellvergleich',
    desc: 'Zwei Maschinen nebeneinander — Leistung, Gewicht und Ausstattung direkt gegenübergestellt.',
  },
  {
    href: '/de/direktzahlungen/',
    icon: '💶',
    title: 'Direktzahlungen',
    desc: 'Die Einheitsbeträge der GAP-Direktzahlungen je Hektar, ihre Entwicklung und ein Prämienrechner.',
  },
  {
    href: '/de/oeko-regelungen/',
    icon: '🌱',
    title: 'Öko-Regelungen',
    desc: 'Alle sieben Öko-Regelungen mit ihren Beträgen je Hektar und der Staffelung nach Flächenanteil.',
  },
  {
    href: '/de/direktzahlungen-oesterreich/',
    icon: '🇦🇹',
    title: 'Direktzahlungen Österreich',
    desc: 'Die erste Säule in Österreich: Basiseinkommensstützung, Umverteilung auf die ersten 40 Hektar und der Almauftrieb.',
  },
  {
    href: '/de/oepul/',
    icon: '🌾',
    title: 'ÖPUL 2023',
    desc: 'Das österreichische Agrarumweltprogramm — Basismodule UBB und Bio, Zuschläge und die neuen Maßnahmen ab 2025.',
  },
  {
    href: '/de/zebricky/',
    icon: '🏆',
    title: 'Ranglisten',
    desc: 'Kuratierte Ranglisten nach Leistung und Arbeitsbreite — von Kompakttraktoren bis zu Feldhäckslern über 1 000 PS.',
  },
  // Fáze 3c sekce. ‼️ Launchnuly se v LAUNCHED_PREFIXES, ale sem se nikdy
  // nedopsaly — z pohledu návštěvníka tedy neexistovaly. Launch sekce a odkaz
  // na ni jsou DVĚ různé věci; hlídá to de-launch.test.ts.
  {
    href: '/de/plemena/',
    icon: '🐄',
    title: 'Nutztierrassen',
    desc: 'Rinder, Pferde, Schafe und Schweine — Herkunft, Leistungsrichtung und wofür sich jede Rasse eignet.',
  },
  {
    href: '/de/choroby/',
    icon: '🍂',
    title: 'Krankheiten und Schädlinge',
    desc: 'Atlas der wichtigsten Krankheiten und Schädlinge im Ackerbau: Symptome, Erreger und Bekämpfung.',
  },
  {
    href: '/de/vcelarstvi/',
    icon: '🐝',
    title: 'Imkerei',
    desc: 'Bienenrassen, Ausrüstung und Honigsorten — der Einstieg in die Imkerei Schritt für Schritt.',
  },
  {
    href: '/de/slovnik/',
    icon: '📖',
    title: 'Fachbegriffe',
    desc: 'Über 300 Fachbegriffe erklärt — von GLÖZ und Sammelantrag bis zur Zapfwelle.',
  },
  {
    href: '/de/sezona/',
    icon: '📅',
    title: 'Landwirtschaftsjahr',
    desc: 'Saisonale Arbeiten Monat für Monat sowie der Aussaat- und Erntekalender.',
  },
  {
    href: '/de/akcie/',
    icon: '📈',
    title: 'Aktien von Agrarunternehmen',
    desc: 'Kurse der größten Landtechnik-, Agrarchemie- und Rohstoffkonzerne der Welt.',
  },
  {
    href: '/de/kviz/',
    icon: '🎯',
    title: 'Quiz',
    desc: 'Testen Sie Ihr Wissen über Markengeschichte, Technik und Agrarförderung.',
  },
  {
    href: '/de/kalkulacka/prevody-jednotek/',
    icon: '📐',
    title: 'Flächeneinheiten umrechnen',
    desc: 'Hektar, Ar, m², Acre — dazu Joch, Tagwerk und preußischer Morgen aus alten Grundbuchauszügen.',
  },
  {
    href: '/de/kalkulacka/prevody-hmotnost/',
    icon: '⚖️',
    title: 'Masseeinheiten umrechnen',
    desc: 'Tonne, Doppelzentner, Bushel und Pfund — mit Bushel-Gewicht je Kultur nach USDA-Standard.',
  },
];
---

<Layout
  title="Landmaschinen und Agrarförderung — Daten und Katalog"
  description="Landtechnik und Agrarwissen im Überblick: Maschinenkatalog mit 22 Marken, Modellvergleich und Enzyklopädie, die Beträge der Direktzahlungen und Öko-Regelungen für Deutschland und Österreich sowie Nutztierrassen, Pflanzenkrankheiten und Imkerei."
>
  <div class="hde-root">
    <section class="hde-hero">
      <span class="hde-kicker"><span class="dot"></span>LANDTECHNIK · FÖRDERUNG · TIERE · PFLANZEN</span>
      <h1>Landmaschinen und <em>Agrarwissen</em></h1>
      <p class="hde-lede">
        Landtechnik, Förderung und Fachwissen an einem Ort: Maschinen von 22 Marken
        mit technischen Daten und direktem Modellvergleich, die aktuellen Förderbeträge
        je Hektar für Deutschland und Österreich sowie Nutztierrassen, Pflanzenkrankheiten
        und Imkerei.
      </p>
    </section>

    <section class="hde-grid" aria-label="Bereiche">
      {SECTIONS.map((s) => (
        <a href={s.href} class="hde-card">
          <span class="hde-card-icon" aria-hidden="true">{s.icon}</span>
          <h2>{s.title}</h2>
          <p>{s.desc}</p>
          <span class="hde-card-cta">Zum Bereich →</span>
        </a>
      ))}
    </section>
  </div>
</Layout>

<style>
  .hde-root {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 32px 64px;
  }

  .hde-hero {
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .hde-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 12px 'Chakra Petch', sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #0A0A0B;
    background: #FFFF00;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1.5px solid #0A0A0B;
  }
  .hde-kicker .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0A0A0B;
  }

  .hde-hero h1 {
    font-family: 'Chakra Petch', sans-serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 18px 0 14px;
    color: #0A0A0B;
  }
  .hde-hero h1 em {
    font-style: normal;
    background: #FFFF00;
    padding: 0 .12em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hde-lede {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: #444;
    margin: 0;
  }

  .hde-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hde-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: 20px;
    background: #fff;
    border: 1.5px solid #0A0A0B;
    box-shadow: 4px 4px 0 #0A0A0B;
    text-decoration: none;
    color: inherit;
    transition: transform .15s, box-shadow .15s;
  }
  .hde-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 #0A0A0B;
  }

  .hde-card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .hde-card h2 {
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    color: #0A0A0B;
  }

  .hde-card p {
    font-size: .98rem;
    line-height: 1.5;
    color: #555;
    margin: 0;
    flex: 1;
  }

  .hde-card-cta {
    font: 700 14px 'Chakra Petch', sans-serif;
    color: #0A0A0B;
    margin-top: 6px;
  }

  @media (max-width: 980px) {
    .hde-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .hde-root { padding: 32px 16px 48px; }
    .hde-grid { grid-template-columns: 1fr; }
  }
</style>
