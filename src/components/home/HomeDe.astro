---
// Německá homepage = kurátovaný rozcestník na launchnuté DE sekce, NE český
// zpravodajský feed. Renderuje se z index.astro když locale === 'de'.
// ‼️ PROČ: /de/ dřív servírovalo německý chrome (menu, cookie lišta) nad
// ČESKÝM tělem homepage a s českým <title> — pro návštěvníka to vypadalo
// rozbitě. Přesně stejná past jako dřív u /uk/, vzor je proto HomeUk.astro.
// Cesty hardcoded /de/... — všechny odkazované sekce jsou launchnuté a
// buď pan-evropské (katalog), nebo DE-only (Direktzahlungen, Öko-Regelungen).
import Layout from '../../layouts/Layout.astro';

const SECTIONS = [
  {
    href: '/de/stroje/',
    icon: '🚜',
    title: 'Maschinenkatalog',
    desc: 'Traktoren, Mähdrescher und Anbaugeräte von 22 Marken — technische Daten, Baureihen und Modelle.',
  },
  {
    href: '/de/znacky/',
    icon: '🏭',
    title: 'Marken',
    desc: 'Profile der Landtechnikhersteller — Geschichte, Produktprogramm und Einordnung im Markt.',
  },
  {
    href: '/de/encyklopedie/',
    icon: '📚',
    title: 'Maschinen-Enzyklopädie',
    desc: 'Ausführliche Porträts einzelner Modelle: Motor, Getriebe, Ausstattung und für wen sie gedacht sind.',
  },
  {
    href: '/de/srovnani/',
    icon: '⚖️',
    title: 'Modellvergleich',
    desc: 'Zwei Maschinen nebeneinander — Leistung, Gewicht und Ausstattung direkt gegenübergestellt.',
  },
  {
    href: '/de/direktzahlungen/',
    icon: '💶',
    title: 'Direktzahlungen',
    desc: 'Die Einheitsbeträge der GAP-Direktzahlungen je Hektar, ihre Entwicklung und ein Prämienrechner.',
  },
  {
    href: '/de/oeko-regelungen/',
    icon: '🌱',
    title: 'Öko-Regelungen',
    desc: 'Alle sieben Öko-Regelungen mit ihren Beträgen je Hektar und der Staffelung nach Flächenanteil.',
  },
];
---

<Layout
  title="Landmaschinen und Agrarförderung — Daten und Katalog"
  description="Landtechnik und Agrarförderung im Überblick: Maschinenkatalog mit 22 Marken, Modellvergleich, Enzyklopädie sowie die Beträge der Direktzahlungen und Öko-Regelungen je Hektar."
>
  <div class="hde-root">
    <section class="hde-hero">
      <span class="hde-kicker"><span class="dot"></span>LANDTECHNIK · FÖRDERUNG · DATEN</span>
      <h1>Landmaschinen und <em>Agrarförderung</em></h1>
      <p class="hde-lede">
        Ein Katalog der Landtechnik und die Zahlen zur Agrarförderung an einem Ort:
        Maschinen von 22 Marken mit technischen Daten, direkte Modellvergleiche und
        die aktuellen Beträge der Direktzahlungen und Öko-Regelungen je Hektar.
      </p>
    </section>

    <section class="hde-grid" aria-label="Bereiche">
      {SECTIONS.map((s) => (
        <a href={s.href} class="hde-card">
          <span class="hde-card-icon" aria-hidden="true">{s.icon}</span>
          <h2>{s.title}</h2>
          <p>{s.desc}</p>
          <span class="hde-card-cta">Zum Bereich →</span>
        </a>
      ))}
    </section>
  </div>
</Layout>

<style>
  .hde-root {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 32px 64px;
  }

  .hde-hero {
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .hde-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 12px 'Chakra Petch', sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #0A0A0B;
    background: #FFFF00;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1.5px solid #0A0A0B;
  }
  .hde-kicker .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0A0A0B;
  }

  .hde-hero h1 {
    font-family: 'Chakra Petch', sans-serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 18px 0 14px;
    color: #0A0A0B;
  }
  .hde-hero h1 em {
    font-style: normal;
    background: #FFFF00;
    padding: 0 .12em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hde-lede {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: #444;
    margin: 0;
  }

  .hde-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hde-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border-radius: 20px;
    background: #fff;
    border: 1.5px solid #0A0A0B;
    box-shadow: 4px 4px 0 #0A0A0B;
    text-decoration: none;
    color: inherit;
    transition: transform .15s, box-shadow .15s;
  }
  .hde-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 #0A0A0B;
  }

  .hde-card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .hde-card h2 {
    font-family: 'Chakra Petch', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    color: #0A0A0B;
  }

  .hde-card p {
    font-size: .98rem;
    line-height: 1.5;
    color: #555;
    margin: 0;
    flex: 1;
  }

  .hde-card-cta {
    font: 700 14px 'Chakra Petch', sans-serif;
    color: #0A0A0B;
    margin-top: 6px;
  }

  @media (max-width: 980px) {
    .hde-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .hde-root { padding: 32px 16px 48px; }
    .hde-grid { grid-template-columns: 1fr; }
  }
</style>
