---
import ArticleCard from '../ArticleCard.astro';
import { createAnonClient } from '../../lib/supabase';
import { AGRO_SVET_SITE_ID as SITE_ID } from '../../lib/config';
import { getLocaleFromUrl, localizeInternalHref } from '../../i18n/utils';
import { fetchTranslatedArticleIds, fetchArticleTranslations, buildTranslationMap, overlayArticle } from '../../lib/articles-i18n';
import { HIDDEN_NEWS_CATEGORIES } from '../../i18n/nav';

// ‼️ server:defer island se načítá z /_server-islands/… BEZ /locale prefixu →
// Astro.locals.locale je tam vždy 'cs'. Proto locale předává PARENT jako prop
// (index.astro), jinak /sk/ „Novinky" ukazuje český feed vč. skrytých dotací.
const locale = Astro.props.locale ?? Astro.locals.locale ?? getLocaleFromUrl(Astro.url);

const supabase = createAnonClient();
// Non-cs (sk): JEN reálně přeložené články + bez skrytých jurisdikčních kategorií
// + overlay titulků. Jinak sekce ukázala české články a odkázala na 404. cs = beze změny.
const trIds = locale !== 'cs' ? await fetchTranslatedArticleIds(supabase, locale) : null;
const hidden = locale !== 'cs' ? HIDDEN_NEWS_CATEGORIES[locale] : [];

let latest: any[] = [];
if (!(trIds && trIds.size === 0)) {
  let q = supabase
    .from('articles')
    .select('id, title, slug, perex, featured_image_url, focal_point, category, tags, published_at, featured')
    .eq('site_id', SITE_ID)
    .eq('status', 'published');
  if (trIds) q = q.in('id', [...trIds]);
  if (hidden.length) q = q.not('category', 'in', `(${hidden.join(',')})`);
  const { data } = await q
    .order('featured', { ascending: false })
    .order('published_at', { ascending: false })
    .range(5, 10);
  let rows = data ?? [];
  if (locale !== 'cs' && rows.length) {
    const trMap = buildTranslationMap(await fetchArticleTranslations(supabase, rows.map((a) => a.id), locale));
    rows = rows.map((a) => overlayArticle(a, trMap.get(a.id)));
  }
  latest = rows;
}

const heading = locale === 'sk' ? 'Novinky' : locale === 'pl' ? 'Nowości' : 'Novinky';
const allCta = locale === 'sk' ? 'Všetky novinky →' : locale === 'pl' ? 'Wszystkie nowości →' : 'Všechny novinky →';
---

{latest.length > 0 && (
<section style="max-width:1280px; margin:0 auto; padding:72px 32px 48px;">
  <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:28px; flex-wrap:wrap; gap:12px;">
    <div>
      <h2 style="font-size:clamp(1.6rem,3.5vw,2.2rem);">{heading}</h2>
    </div>
    <a href={localizeInternalHref(locale, '/novinky/')} class="link-cta">{allCta}</a>
  </div>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px;">
    {latest.map(article => (
      <ArticleCard
        title={article.title}
        description={article.perex}
        slug={article.slug}
        publishDate={new Date(article.published_at)}
        category={article.category}
        heroImage={article.featured_image_url}
        focalPoint={article.focal_point}
        locale={locale}
      />
    ))}
  </div>
</section>
)}
