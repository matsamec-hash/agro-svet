---
import { CIS_PLODINY, CIS_ZVIRATA, SAZBY, LIMITY, ROK_SAZEB, KURZ_CZK_EUR, ZALOHA_PROCENT, ZDROJE, formatSazba } from '../../lib/cap-dotace';
import { getLocaleFromUrl, localizeInternalHref } from '../../i18n/utils';

const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);

interface Props {
  faqItems: { q: string; a: string }[];
}

const { faqItems } = Astro.props;
const kc = (n: number) => `${formatSazba(n)} Kč/ha`;
---

<div class="calc-root">
    <nav class="breadcrumb" aria-label="Cesta">
      <a href="/">Domů</a>
      <span aria-hidden="true">›</span>
      <a href={localizeInternalHref(locale, '/kalkulacka/')}>Kalkulačky</a>
      <span aria-hidden="true">›</span>
      <span class="current">Přímé platby SZP</span>
    </nav>

    <header class="calc-head">
      <span class="kicker">Kalkulačka · sazby {ROK_SAZEB}</span>
      <h1>Kolik dostanete na přímých platbách</h1>
      <p class="lede">
        Orientační výpočet přímých plateb Společné zemědělské politiky v ČR podle sazeb za rok {ROK_SAZEB}, které ministr zemědělství schválil 2. 10. 2026. Sečte základní platbu BISS, redistributivní platbu, platbu pro mladé zemědělce, ekoplatby a podporu vázanou na produkci (CIS).
      </p>
      <p class="source-line">
        Sazby: <a href={ZDROJE.sazby.url} rel="external nofollow">{ZDROJE.sazby.label}</a> (přepočet kurzem ECB k 30. 9. 2026, {KURZ_CZK_EUR.toLocaleString('cs-CZ')} Kč/EUR).
        Pravidla: <a href={ZDROJE.narizeni.url} rel="external nofollow">{ZDROJE.narizeni.label}</a>, <a href={ZDROJE.prirucka.url} rel="external nofollow">{ZDROJE.prirucka.label}</a>.
      </p>
    </header>

    <form class="calc-form" id="cap-form" autocomplete="off">
      <fieldset class="fs">
        <legend>Hospodářství</legend>

        <label class="field">
          <span>Způsobilá zemědělská půda v LPIS (ha) <strong class="req">*</strong></span>
          <input type="number" id="total-ha" name="totalHa" min="0" step="0.01" placeholder="např. 75" required />
          <span class="field-hint">Orná půda, trvalé travní porosty a trvalé kultury evidované na vás. Jiná kultura, mimoprodukční plocha a rybník se nepočítají.</span>
        </label>

        <label class="field">
          <span>Z toho orná půda (ha)</span>
          <input type="number" id="orna-ha" name="ornaHa" min="0" step="0.01" placeholder="např. 60" />
          <span class="field-hint">Standardní orná půda, úhor a travní porost (kultury R, U, G). Potřebné pro prémiovou ekoplatbu, krajinné prvky, živiny a pásové střídání.</span>
        </label>

        <label class="field-check">
          <input type="checkbox" id="mlady" name="mlady" />
          <span><strong>Mladý zemědělec</strong> <em>— {kc(SAZBY.mladyZemedelec)}, nejvýše na {LIMITY.mladyMaxHa} ha a pět let po sobě; v roce první žádosti nejvýše 40 let, minimální zemědělská kvalifikace.</em></span>
        </label>

        <label class="field-check">
          <input type="checkbox" id="mali" name="mali" />
          <span><strong>Platba pro malé zemědělce</strong> <em>— {kc(SAZBY.maliZemedelci)}, nejvýše na {LIMITY.maliMaxHa} ha, jen podnik do {LIMITY.maliMaxVymeraPodnikuHa} ha. Nahrazuje všechny ostatní přímé platby.</em></span>
        </label>
      </fieldset>

      <fieldset class="fs">
        <legend>Ekoplatby</legend>

        <label class="field-check">
          <input type="checkbox" id="eko-zakladni" name="ekoZakladni" checked />
          <span><strong>Základní celofaremní ekoplatba</strong> <em>— {kc(SAZBY.ekoZakladni)} na celou výměru. Podmínky na všech dílech: mimo jiné diverzifikace plodin, aspoň 5 % neprodukčních ploch na orné půdě, ochranné pásy podél vody, seč nebo pastva TTP do 31. 7.</em></span>
        </label>

        <p class="fs-hint">Následující platby lze dostat jen spolu se základní ekoplatbou. Zadejte jen plochy, které do nich opravdu přihlásíte.</p>

        <div class="cis-grid">
          <label class="cis-field">
            <span class="cis-name">Prémiová ekoplatba — neprodukční plochy</span>
            <span class="cis-rate">{kc(SAZBY.ekoPremiova)}</span>
            <input type="number" name="ekoPremiovaNpHa" min="0" step="0.01" placeholder="0 ha" />
            <span class="cis-hint">Krajinné prvky, liniové úhory, ochranné pásy, biopásy; platí se nejvýš do 10 % orné půdy. Podmínka: vyčlenit 7 % neprodukčních ploch.</span>
          </label>
          <label class="cis-field">
            <span class="cis-name">Prémiová ekoplatba — pásy podél vody</span>
            <span class="cis-rate">{kc(SAZBY.ekoPremiova)}</span>
            <input type="number" name="ekoPremiovaPasyHa" min="0" step="0.01" placeholder="0 ha" />
            <span class="cis-hint">Ochranné pásy podél vody typu prémiový (12 m).</span>
          </label>
          <label class="cis-field">
            <span class="cis-name">Údržba krajinných prvků</span>
            <span class="cis-rate">{kc(SAZBY.udrzbaKrajinnychPrvku)}</span>
            <input type="number" name="udrzbaKpHa" min="0" step="0.01" placeholder="0 ha" />
            <span class="cis-hint">Meze, stromořadí, skupiny dřevin, příkopy… na orné půdě a TTP. Ne na plochu v prémiové ekoplatbě.</span>
          </label>
          <label class="cis-field">
            <span class="cis-name">Vytváření nových krajinných prvků</span>
            <span class="cis-rate">{kc(SAZBY.noveKrajinnePrvky)}</span>
            <input type="number" name="noveKpHa" min="0" step="0.01" placeholder="0 ha" />
            <span class="cis-hint">Prvky na orné půdě založené po 1. 1. 2025, nejvýš 50 % orné půdy. Ne na plochu v prémiové ekoplatbě.</span>
          </label>
          <label class="cis-field">
            <span class="cis-name">Pásové střídání plodin</span>
            <span class="cis-rate">{kc(SAZBY.pasoveStridani)}</span>
            <input type="number" name="pasoveStridaniHa" min="0" step="0.01" placeholder="0 ha" />
            <span class="cis-hint">Díly půdních bloků od 4 ha se sklonitostí aspoň 3 %, nejméně 4 pásy plodin.</span>
          </label>
        </div>

        <label class="field-check">
          <input type="checkbox" id="ziviny" name="ziviny" />
          <span><strong>Udržitelné hospodaření s živinami</strong> <em>— {kc(SAZBY.hospodareniZivinami)} na ornou půdu; bilance dusíku nejvýš 60 kg N/ha a dodání fosforu podle odběru.</em></span>
        </label>
      </fieldset>

      <fieldset class="fs">
        <legend>Podpora vázaná na produkci (CIS)</legend>
        <p class="fs-hint">Plodiny v hektarech (u každé nejméně {LIMITY.cisMinHa} ha), zvířata v kusech. Nechte prázdné, pokud komoditu nemáte.</p>

        <div class="cis-grid">
          {CIS_PLODINY.map((s) => (
            <label class="cis-field">
              <span class="cis-name">{s.name}</span>
              <span class="cis-rate">{kc(s.sazba)}</span>
              <input type="number" name={`cis-${s.slug}`} min="0" step="0.01" placeholder="0 ha" />
              <span class="cis-hint">{s.description}</span>
            </label>
          ))}
          {CIS_ZVIRATA.map((s) => (
            <label class="cis-field">
              <span class="cis-name">{s.name}</span>
              <span class="cis-rate">{formatSazba(s.sazba)} Kč/ks</span>
              <input type="number" name={`cis-${s.slug}`} min="0" step="1" placeholder="0 ks" />
              <span class="cis-hint">{s.description}</span>
            </label>
          ))}
        </div>

        <label class="field-check">
          <input type="checkbox" id="dojnice-kvalita" name="dojniceSchemaKvality" />
          <span><strong>Hospodářství je zapojené do schématu kvality pro dojnice</strong> <em>— nutné, pokud žádáte na víc než {LIMITY.dojniceMaxBezSchematuKs} dojnic (příloha č. 21 NV 83/2023).</em></span>
        </label>
      </fieldset>

      <button type="submit" class="calc-btn">Spočítat přímé platby →</button>
    </form>

    <div id="result" class="result-card" hidden>
      <header class="result-head">
        <span class="result-kicker">Orientační výpočet · sazby {ROK_SAZEB}</span>
        <div class="result-total" id="result-total">— Kč/rok</div>
        <div class="result-perha" id="result-perha">— Kč/ha průměrně</div>
      </header>

      <h2>Rozpis</h2>
      <table class="result-table">
        <thead>
          <tr><th>Položka</th><th>Množství</th><th>Sazba</th><th>Částka</th></tr>
        </thead>
        <tbody id="result-tbody"></tbody>
      </table>

      <ul class="result-warnings" id="result-warnings" hidden></ul>
      <p class="result-alt" id="result-alt" hidden></p>

      <div class="result-disclaimer">
        ⚠️ Orientační výpočet, závazná jsou rozhodnutí <a href={ZDROJE.szifJednotnaZadost.url} rel="external nofollow">SZIF</a>. Sazby za rok {ROK_SAZEB} podle <a href={ZDROJE.sazby.url} rel="external nofollow">tiskové zprávy MZe z 2. 10. 2026</a>; SZIF vyplácí zálohy ve výši {ZALOHA_PROCENT} %. Při nesplnění podmínek (podmíněnost, podmínky ekoplateb, CIS) se platby krátí nebo neposkytnou.
      </div>

      <div class="result-cta">
        <a href={localizeInternalHref(locale, '/dotace/')} class="cta-link">Přehled dotací →</a>
        <a href={localizeInternalHref(locale, '/dotace/kalendar-kol/')} class="cta-link">Kalendář kol →</a>
      </div>
    </div>

    <section class="info">
      <h2>Jak kalkulačka počítá</h2>
      <p>Sazby za rok {ROK_SAZEB} v Kč, jak je zveřejnilo Ministerstvo zemědělství. Pravidla podle nařízení vlády č. 83/2023 Sb. ve znění pro rok 2026:</p>
      <ul>
        <li><strong>BISS</strong> — {kc(SAZBY.biss)} na způsobilou zemědělskou půdu v LPIS, nejméně 1 ha.</li>
        <li><strong>Redistributivní platba (CRISS)</strong> — {kc(SAZBY.redistributivni)} jen na prvních {LIMITY.redistributivniMaxHa} ha podniku.</li>
        <li><strong>Mladý zemědělec</strong> — {kc(SAZBY.mladyZemedelec)} nejvýše na {LIMITY.mladyMaxHa} ha, pět let po sobě.</li>
        <li><strong>Platba pro malé zemědělce</strong> — {kc(SAZBY.maliZemedelci)} nejvýše na {LIMITY.maliMaxHa} ha pro podniky do {LIMITY.maliMaxVymeraPodnikuHa} ha; kdo o ni žádá, nemůže žádat o žádnou jinou přímou platbu. U podniku do 10 ha kalkulačka ukáže obě varianty.</li>
        <li><strong>Základní ekoplatba</strong> — {kc(SAZBY.ekoZakladni)} na celou výměru. <strong>Prémiová ekoplatba</strong> — {kc(SAZBY.ekoPremiova)}, ale jen na neprodukční plochy (nejvýš 10 % orné půdy) a prémiové ochranné pásy podél vody.</li>
        <li><strong>Další ekoplatby</strong> (jen se základní ekoplatbou) — údržba krajinných prvků {kc(SAZBY.udrzbaKrajinnychPrvku)}, nové krajinné prvky {kc(SAZBY.noveKrajinnePrvky)}, hospodaření s živinami {kc(SAZBY.hospodareniZivinami)}, pásové střídání plodin {kc(SAZBY.pasoveStridani)}.</li>
        <li><strong>CIS</strong> (dříve VCS) — plodiny na hektar (chmel, ovoce, zelenina, cukrová řepa, škrobové brambory, bílkovinné plodiny), zvířata na kus (dojnice, telata masného typu, bahnice a kozy).</li>
      </ul>
      <p>Co kalkulačka <strong>nezapočítává</strong>: platby pro oblasti s přírodními omezeními (<strong>ANC</strong>) — nejsou přímou platbou, patří do II. pilíře a jejich sazba v EUR/ha závisí na typu oblasti (H1–H5, O1–O3, S) a zaměření podniku podle nařízení vlády č. 61/2023 Sb.; žádá se o ně v <a href={ZDROJE.szifJednotnaZadost.url} rel="external nofollow">Jednotné žádosti u SZIF</a>. Dále AEKO, ekologické zemědělství, Natura 2000, welfare zvířat, investiční dotace a krácení za porušení podmínek.</p>

      <h2>Časté dotazy</h2>
      <div class="faqs">
        {faqItems.map((item) => (
          <details class="faq">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <script>
    import { calculateCap, formatKc, formatSazba, CIS_PLODINY, CIS_ZVIRATA } from '../../lib/cap-dotace';

    const form = document.getElementById('cap-form') as HTMLFormElement;
    const resultEl = document.getElementById('result') as HTMLElement;
    const resultTotal = document.getElementById('result-total') as HTMLElement;
    const resultPerHa = document.getElementById('result-perha') as HTMLElement;
    const resultTbody = document.getElementById('result-tbody') as HTMLElement;
    const resultWarnings = document.getElementById('result-warnings') as HTMLElement;
    const resultAlt = document.getElementById('result-alt') as HTMLElement;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const num = (k: string) => parseFloat(String(data.get(k) ?? '').replace(',', '.')) || 0;

      const cisHa: Record<string, number> = {};
      for (const p of CIS_PLODINY) {
        const v = num(`cis-${p.slug}`);
        if (v > 0) cisHa[p.slug] = v;
      }
      const cisKs: Record<string, number> = {};
      for (const z of CIS_ZVIRATA) {
        const v = num(`cis-${z.slug}`);
        if (v > 0) cisKs[z.slug] = v;
      }

      const res = calculateCap({
        totalHa: num('totalHa'),
        ornaHa: num('ornaHa'),
        maliZemedelec: !!data.get('mali'),
        mladyZemedelec: !!data.get('mlady'),
        ekoZakladni: !!data.get('ekoZakladni'),
        ekoPremiovaNpHa: num('ekoPremiovaNpHa'),
        ekoPremiovaPasyHa: num('ekoPremiovaPasyHa'),
        noveKpHa: num('noveKpHa'),
        udrzbaKpHa: num('udrzbaKpHa'),
        ziviny: !!data.get('ziviny'),
        pasoveStridaniHa: num('pasoveStridaniHa'),
        cisHa,
        cisKs,
        dojniceSchemaKvality: !!data.get('dojniceSchemaKvality'),
      });

      if (!res.items.length && !res.warnings.length) {
        alert('Zadejte výměru hospodářství.');
        return;
      }

      resultTotal.textContent = `${formatKc(res.total)} / rok`;
      resultPerHa.textContent = res.perHa > 0 ? `${formatKc(res.perHa)} / ha průměrně` : '';
      resultTbody.innerHTML = res.items.map((it) => `
        <tr>
          <td>
            <strong>${escapeHtml(it.label)}</strong>
            ${it.note ? `<div class="row-note">${escapeHtml(it.note)}</div>` : ''}
          </td>
          <td class="num">${it.mnozstvi.toLocaleString('cs-CZ', { maximumFractionDigits: 2 })} ${it.jednotka}</td>
          <td class="num">${formatSazba(it.sazba)} Kč/${it.jednotka}</td>
          <td class="num strong">${formatKc(it.amount)}</td>
        </tr>
      `).join('');

      resultWarnings.innerHTML = res.warnings.map((w) => `<li>${escapeHtml(w)}</li>`).join('');
      resultWarnings.hidden = res.warnings.length === 0;

      if (res.alternativa) {
        resultAlt.textContent = `Pro srovnání — ${res.alternativa.label}: ${formatKc(res.alternativa.total)} / rok.`;
        resultAlt.hidden = false;
      } else {
        resultAlt.hidden = true;
      }

      resultEl.hidden = false;
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    function escapeHtml(s: string): string {
      return s.replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c] as string));
    }
  </script>

<style>
    .calc-root { max-width: 920px; margin: 0 auto; padding: 32px 24px 80px; }
    .breadcrumb { display: flex; gap: 8px; align-items: center; font-size: 13px; color: #666; margin-bottom: 20px; flex-wrap: wrap; }
    .breadcrumb a { color: #666; text-decoration: none; }
    .breadcrumb a:hover { color: #000; }
    .breadcrumb .current { color: #000; font-weight: 600; }

    .calc-head { margin-bottom: 32px; max-width: 720px; }
    .kicker {
      display: inline-block;
      background: #FFEA00;
      color: #0A0A0B;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    h1 { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -1px; line-height: 1.1; margin: 12px 0 12px; color: #1a1a1a; }
    .lede { font-size: 16px; color: #444; line-height: 1.6; margin: 0; }
    .source-line { font-size: 13px; color: #666; line-height: 1.5; margin: 12px 0 0; }
    .source-line a { color: #0B7A3B; text-decoration: underline; }

    .calc-form {
      background: #fff;
      border: 1.5px solid #eaeaec;
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .fs {
      border: none;
      padding: 0;
      margin: 0 0 24px;
    }
    .fs:last-of-type { margin-bottom: 16px; }
    .fs legend {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
      color: #0A0A0B;
      margin-bottom: 12px;
      padding: 0;
    }
    .fs-hint {
      font-size: 13px;
      color: #666;
      margin: 0 0 14px;
      line-height: 1.5;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 14px;
    }
    .field span { font-size: 13px; color: #333; font-weight: 600; }
    .field .field-hint { font-size: 12px; color: #888; font-weight: 400; line-height: 1.4; }
    .field input {
      padding: 10px 12px;
      border: 1.5px solid #DFDFE3;
      border-radius: 8px;
      font-size: 15px;
      background: #fff;
    }
    .field input:focus {
      outline: none;
      border-color: #FFEA00;
      box-shadow: 0 0 0 3px rgba(255, 234, 0, 0.2);
    }
    .req { color: #C8102E; }

    .field-check {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 12px;
      background: #fafafa;
      border-radius: 8px;
      margin: 10px 0;
      cursor: pointer;
    }
    .field-check input[type='checkbox'] {
      margin-top: 2px;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      cursor: pointer;
      accent-color: #0B7A3B;
    }
    .field-check strong { display: inline; font-size: 14px; color: #0A0A0B; }
    .field-check em { color: #666; font-style: normal; font-size: 13px; }

    .cis-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 10px;
    }
    .cis-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 10px 12px;
      border: 1.5px solid #eaeaec;
      border-radius: 8px;
      background: #fafafa;
    }
    .cis-name { font-size: 14px; font-weight: 600; color: #0A0A0B; }
    .cis-rate { font-size: 12px; color: #0B7A3B; font-weight: 700; }
    .cis-hint { font-size: 12px; color: #777; line-height: 1.4; }
    .cis-field input {
      margin-top: 4px;
      padding: 6px 8px;
      border: 1px solid #DFDFE3;
      border-radius: 5px;
      font-size: 14px;
    }

    .calc-btn {
      width: 100%;
      padding: 14px;
      background: #0A0A0B;
      color: #FFEA00;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: background .15s;
    }
    .calc-btn:hover { background: #2a2a2f; }

    .result-card {
      background: #fff;
      border: 2px solid #FFEA00;
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 32px;
    }
    .result-head { margin-bottom: 20px; text-align: center; }
    .result-kicker { font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; color: #6B6B72; font-weight: 700; }
    .result-total {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      color: #0A0A0B;
      margin: 8px 0 4px;
      font-family: 'Chakra Petch', sans-serif;
    }
    .result-perha { font-size: 14px; color: #666; }

    .result-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .result-table th {
      text-align: left;
      padding: 10px 8px;
      border-bottom: 2px solid #0A0A0B;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #666;
    }
    .result-table td {
      padding: 12px 8px;
      border-bottom: 1px solid #eaeaec;
      vertical-align: top;
    }
