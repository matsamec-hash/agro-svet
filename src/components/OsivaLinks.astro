---
// Prolink na osiva/poradenství pod detailem plodiny i odrůdy.
//
// POZOR na styly: komponenta se vkládá do stránek, jejichž scoped CSS cílí na
// `.pl-detail .section-title` apod. Astro scope se ale na značky uvnitř
// komponenty NEPROPÍŠE — dokud tu styly nebyly, renderoval se na ~2 730
// stránkách obří neostylovaný <h2> a odkazy jako holý text pod sebou.
// Proto má komponenta vlastní scoped styly, laděné podle design systému
// `.pl-detail` (stejné tokeny: 20px/800 nadpis, zelené akcenty, pill odkazy).
import { osivaLinksFor } from '../lib/osiva-links';
import type { Skupina } from '../lib/plodiny';

interface Props { plodina: string; skupina: Skupina; odruda?: string }
const { plodina, skupina } = Astro.props;
const links = osivaLinksFor(skupina);
---
<section class="osiva-synergie">
  <h2>Kde řešit osivo a poradenství</h2>
  <p>Pro pořízení osiva plodiny {plodina.toLowerCase()} a odborné poradenství:</p>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} rel={l.rel} {...(l.external ? { target: '_blank' } : {})}>
          <span>{l.label}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {l.external
              ? <><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></>
              : <path d="M5 12h14M13 6l6 6-6 6"/>}
          </svg>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .osiva-synergie { --o-ink: #0A0A0B; --o-body: #1E1E22; --o-muted: #6B6B72; --o-green: #3c7a1a; --o-green-dark: #2a5a10; }
  .osiva-synergie h2 {
    font-size: 20px; font-weight: 800; color: var(--o-ink); margin: 0 0 8px; line-height: 1.3;
  }
  .osiva-synergie p { font-size: 14.5px; line-height: 1.6; color: var(--o-muted); margin: 0 0 16px; }
  .osiva-synergie ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .osiva-synergie li { margin: 0; }
  .osiva-synergie a {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border: 1px solid #e0e0e0; border-radius: 999px;
    background: #fff; color: var(--o-green); font-size: 14.5px; font-weight: 600;
    text-decoration: none; transition: background .15s, border-color .15s, color .15s;
  }
  .osiva-synergie a:hover,
  .osiva-synergie a:focus-visible {
    background: #eaf4e0; border-color: var(--o-green); color: var(--o-green-dark);
  }
  .osiva-synergie svg { flex: none; opacity: .7; }

  @media (max-width: 640px) {
    .osiva-synergie ul { flex-direction: column; align-items: stretch; }
    .osiva-synergie a { justify-content: space-between; }
  }
</style>
