---
// Úvodní fotka článku: stojí pod titulkem a ukazuje se celá v poměru 16:9.
// Dřív šla přes celou šířku okna s výškou 40vh — na širokém monitoru z ní
// zbyl pás ~4,5:1 a traktor přišel o kabinu i kola.
// Na mobilu jde od kraje ke kraji (stránky mají sloupec s paddingem 32px),
// na desktopu přesahuje textový sloupec na 1000px.
---
<div class="article-hero"><slot /></div>

<style>
  .article-hero {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin: 0 0 36px;
    border-radius: 12px;
    background: #f0f0f0;
  }
  .article-hero :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 639px) {
    .article-hero { margin-inline: -32px; border-radius: 0; }
  }
  @media (min-width: 1100px) {
    .article-hero { width: 1000px; margin-left: calc(50% - 500px); }
  }
</style>
