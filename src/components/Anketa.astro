---
// Znovupoužitelná anketa se živými výsledky (agregace v Supabase přes /api/anketa/[slug]).
// Použití:
//   <Anketa slug="ktery-traktor-koupite" question="Který traktor byste koupili?"
//     options={[{ id: 'zetor', label: 'Zetor' }, { id: 'john-deere', label: 'John Deere' }]} />
// slug musí být unikátní kebab-case (drží hlasy v DB). Možnosti = kebab-case id + popisek.
export interface AnketaOption {
  id: string;
  label: string;
}
interface Props {
  slug: string;
  question: string;
  options: AnketaOption[];
  note?: string;
}
const { slug, question, options, note } = Astro.props as Props;
---

<section class="anketa" data-anketa data-slug={slug} aria-label="Anketa">
  <div class="anketa-head">
    <span class="anketa-kicker">Anketa</span>
    <h3 class="anketa-q">{question}</h3>
  </div>

  <div class="anketa-options" role="group" aria-label={question}>
    {options.map((o) => (
      <button type="button" class="anketa-opt" data-option={o.id}>
        <span class="anketa-opt-fill" aria-hidden="true"></span>
        <span class="anketa-opt-label">{o.label}</span>
        <span class="anketa-opt-pct" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <p class="anketa-foot">
    <span class="anketa-total" aria-live="polite">Hlasujte a uvidíte průběžné výsledky.</span>
    {note && <span class="anketa-note">{note}</span>}
  </p>
</section>

<script is:inline>
  (function () {
    if (window.__anketaBound) return;
    window.__anketaBound = true;

    function pct(v, total) {
      return total > 0 ? Math.round((v / total) * 100) : 0;
    }

    function render(root, tallies, myChoice) {
      var opts = root.querySelectorAll('.anketa-opt');
      var total = 0;
      opts.forEach(function (b) {
        total += tallies[b.getAttribute('data-option')] || 0;
      });
      opts.forEach(function (b) {
        var id = b.getAttribute('data-option');
        var v = tallies[id] || 0;
        var p = pct(v, total);
        b.classList.add('is-result');
        if (myChoice && id === myChoice) b.classList.add('is-mine');
        b.setAttribute('disabled', 'disabled');
        var fill = b.querySelector('.anketa-opt-fill');
        var pctEl = b.querySelector('.anketa-opt-pct');
        if (fill) fill.style.width = p + '%';
        if (pctEl) pctEl.textContent = p + ' % (' + v + ')';
      });
      var totalEl = root.querySelector('.anketa-total');
      if (totalEl) {
        totalEl.textContent =
          total === 1 ? '1 hlas celkem' : total + ' hlasů celkem';
      }
    }

    function fetchResults(slug) {
      // Trailing slash povinný — site jinak dělá 301 a prohlížeč by u POST změnil metodu na GET.
      return fetch('/api/anketa/' + encodeURIComponent(slug) + '/', { headers: { accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .catch(function () { return { ok: false, tallies: {} }; });
    }

    function vote(slug, option) {
      return fetch('/api/anketa/' + encodeURIComponent(slug) + '/', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ option: option }),
      })
        .then(function (r) { return r.json(); })
        .catch(function () { return { ok: false, tallies: {} }; });
    }

    function init(root) {
      if (root.__anketaInit) return;
      root.__anketaInit = true;
      var slug = root.getAttribute('data-slug');
      if (!slug) return;
      var storeKey = 'anketa_voted_' + slug;
      var myChoice = null;
      try { myChoice = localStorage.getItem(storeKey); } catch (e) {}

      if (myChoice) {
        fetchResults(slug).then(function (res) {
          render(root, (res && res.tallies) || {}, myChoice);
        });
      }

      root.querySelectorAll('.anketa-opt').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (root.classList.contains('is-voted')) return;
          var option = btn.getAttribute('data-option');
          root.classList.add('is-voted');
          try { localStorage.setItem(storeKey, option); } catch (e) {}
          vote(slug, option).then(function (res) {
            render(root, (res && res.tallies) || {}, option);
          });
        });
      });
    }

    function scan() {
      document.querySelectorAll('[data-anketa]').forEach(init);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scan);
    } else {
      scan();
    }
  })();
</script>

<style>
  .anketa {
    max-width: 640px;
    margin: 32px auto;
    padding: 22px 22px 18px;
    background: linear-gradient(135deg, #fff 0%, #fffef6 100%);
    border: 1.5px solid #eaeaec;
    border-radius: 16px;
    box-shadow: 0 2px 10px rgba(10, 10, 11, 0.04);
  }
  .anketa-head { margin-bottom: 16px; }
  .anketa-kicker {
    display: inline-block;
    background: #FFEA00;
    color: #0A0A0B;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .anketa-q {
    font-size: 19px;
    font-weight: 800;
    color: #0A0A0B;
    line-height: 1.3;
    margin: 10px 0 0;
  }
  .anketa-options { display: flex; flex-direction: column; gap: 10px; }
  .anketa-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 13px 16px;
    background: #fff;
    border: 1.5px solid #e2e2e6;
    border-radius: 10px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: border-color .15s, background .15s, transform .1s;
  }
  .anketa-opt:hover:not(.is-result) {
    border-color: #FFEA00;
    background: #fffdf0;
    transform: translateY(-1px);
  }
  .anketa-opt:focus-visible { outline: 2px solid #0B7A3B; outline-offset: 2px; }
  .anketa-opt-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 0;
    background: linear-gradient(90deg, #fff5b0 0%, #ffe94d 100%);
    z-index: 0;
    transition: width .7s cubic-bezier(.16, 1, .3, 1);
  }
  .anketa-opt.is-mine .anketa-opt-fill {
    background: linear-gradient(90deg, #d6f0dd 0%, #7fd39a 100%);
  }
  .anketa-opt-label, .anketa-opt-pct { position: relative; z-index: 1; }
  .anketa-opt-label { flex: 1; }
  .anketa-opt-pct {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    color: #0A0A0B;
    font-size: 14px;
    opacity: 0;
    transition: opacity .3s .3s;
  }
  .anketa-opt.is-result { cursor: default; }
  .anketa-opt.is-result .anketa-opt-pct { opacity: 1; }
  .anketa-opt.is-mine { border-color: #0B7A3B; }
  .anketa-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin: 14px 2px 0;
    font-size: 12.5px;
    color: #6B6B72;
  }
  .anketa-total { font-weight: 700; color: #0A0A0B; }
  .anketa-note { color: #9a9aa0; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .anketa {
      background: linear-gradient(135deg, #17171a 0%, #1c1b14 100%);
      border-color: #2c2c30;
    }
    :root:not([data-theme="light"]) .anketa-q { color: #f4f4f5; }
    :root:not([data-theme="light"]) .anketa-opt {
      background: #202024;
      border-color: #33333a;
      color: #e8e8ea;
    }
    :root:not([data-theme="light"]) .anketa-opt:hover:not(.is-result) { background: #26261c; }
    :root:not([data-theme="light"]) .anketa-opt-pct { color: #FFEA00; }
    :root:not([data-theme="light"]) .anketa-total { color: #f4f4f5; }
  }
  :root[data-theme="dark"] .anketa {
    background: linear-gradient(135deg, #17171a 0%, #1c1b14 100%);
    border-color: #2c2c30;
  }
  :root[data-theme="dark"] .anketa-q { color: #f4f4f5; }
  :root[data-theme="dark"] .anketa-opt { background: #202024; border-color: #33333a; color: #e8e8ea; }
  :root[data-theme="dark"] .anketa-opt-pct { color: #FFEA00; }
  :root[data-theme="dark"] .anketa-total { color: #f4f4f5; }
</style>
