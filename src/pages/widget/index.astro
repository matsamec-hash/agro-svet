---
// Stránka „vložit widget" — publisheři si tu zkopírují embed kód.
// Kód obsahuje <iframe> S atribučním odkazem (ten dává agro-svet reálný backlink,
// protože žije v HTML hostitelského webu; samotný iframe src backlink netvoří).
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const SITE = 'https://agro-svet.cz';
const WIDGET_URL = `${SITE}/widget/ceny-komodit/`;

const embed = `<iframe src="${WIDGET_URL}" width="100%" height="460" style="border:0;max-width:480px" loading="lazy" title="Ceny zemědělských komodit"></iframe>
<p style="font:12px sans-serif">Zdroj: <a href="${SITE}/statistiky/">Ceny zemědělských komodit – agro-svět.cz</a></p>`;
---

<Layout
  title="Vložit widget cen komodit na svůj web (zdarma)"
  description="Bezplatný embed widget s aktuálními cenami zemědělských komodit (pšenice, řepka, mléko, vepřové…). Zkopírujte kód a vložte na svůj web."
>
  <main class="wrap">
    <h1>Widget: Ceny zemědělských komodit</h1>
    <p class="lead">
      Aktuální ceny hlavních zemědělských komodit (pšenice, ječmen, řepka, kukuřice, mléko,
      vepřové, hovězí, vejce, mák) — automaticky aktualizované z dat ČSÚ. Vložte je zdarma
      na svůj web, blog nebo do článku.
    </p>

    <h2>Náhled</h2>
    <div class="preview">
      <iframe src={WIDGET_URL} width="100%" height="460" style="border:0;max-width:480px" loading="lazy" title="Náhled widgetu"></iframe>
    </div>

    <h2>Kód pro vložení</h2>
    <p>Zkopírujte a vložte do HTML svého webu. Prosíme o zachování odkazu na zdroj.</p>
    <textarea id="embed" readonly rows="4">{embed}</textarea>
    <button id="copy" type="button">Kopírovat kód</button>

    <h2>Podmínky použití</h2>
    <ul>
      <li>Widget je zdarma pro komerční i nekomerční weby.</li>
      <li>Ponechte prosím odkaz na zdroj (<a href={SITE + '/statistiky/'}>agro-svět.cz</a>) — je součástí kódu.</li>
      <li>Data pocházejí z Českého statistického úřadu a jsou orientační.</li>
    </ul>
  </main>

  <style>
    .wrap { max-width: 760px; margin: 0 auto; padding: 2rem 1rem 4rem; }
    h1 { font-size: 1.8rem; margin: 0 0 .5rem; }
    h2 { font-size: 1.2rem; margin: 2rem 0 .6rem; }
    .lead { font-size: 1.05rem; color: var(--muted, #556); }
    .preview { display: flex; justify-content: center; padding: 1rem; background: #f5f8f4; border-radius: 12px; }
    textarea { width: 100%; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; padding: 12px; border: 1px solid #d9e2d9; border-radius: 8px; background: #fbfdfb; resize: vertical; }
    button { margin-top: .6rem; padding: .6rem 1.1rem; font-weight: 600; color: #fff; background: #2e7d32; border: 0; border-radius: 8px; cursor: pointer; }
    button:hover { background: #256428; }
    button.done { background: #1b8a3a; }
    ul { line-height: 1.7; }
    @media (prefers-color-scheme: dark) {
      .preview { background: #17211b; }
      textarea { background: #0f1512; color: #e8efe8; border-color: #223029; }
    }
  </style>

  <script is:inline>
    (function () {
      var b = document.getElementById('copy');
      var t = document.getElementById('embed');
      if (!b || !t) return;
      b.addEventListener('click', function () {
        t.select();
        navigator.clipboard.writeText(t.value).then(function () {
          b.textContent = 'Zkopírováno ✓';
          b.classList.add('done');
          setTimeout(function () { b.textContent = 'Kopírovat kód'; b.classList.remove('done'); }, 2000);
        });
      });
    })();
  </script>
</Layout>
