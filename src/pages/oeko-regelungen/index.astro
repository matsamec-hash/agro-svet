---
// src/pages/oeko-regelungen/index.astro
// DE-only landing: Öko-Regelungen (dobrovolné ekoschémata 1. pilíře GAP v Německu).
// Jurisdikčně vázané na DE, obsah přímo německy. Non-de locale → 404.
//
// ‼️ 2026-10-15 přepsáno podle zdrojů, ne podle přehledů:
//   - částky 2025 = SKUTEČNÉ (BAnz AT 01.12.2025 B6), shodují se s plánem;
//   - plánované 2026 = GAPDZV Anlage 4 (ÖR 1d 1000/450/200, ÖR 3 600, ÖR 5 210);
//   - pravidla = GAPDZV Anlage 5 (ÖR 1a do 8 % orné, 1-Hektar-Regel; ÖR 6
//     stupeň 2 jen Ackerfutter; ÖR 4 hnojení jen do 1,4 RGV/ha).
//   Dřív: „über 2 % bis 6 %", „mind. 1 ha", ÖR 6 „übrige Kulturen 50", ÖR 4
//   „ohne mineralische N-Düngung", 2025 jako „geplant" — vše opraveno.
// Zdroje stažené v ~/agro-svet/foto-audit/de/zdroje (banz1–3, gapdzv.txt, oer2026).
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { localizePath, isLaunchedPath } from '../../i18n/utils';
import { DE_OER_MAX } from '../../data/foerderung-de';

const locale = Astro.locals.locale ?? 'cs';
// Mimo LAUNCHED_PREFIXES.de → 404 i pod /de (stránka se dá znovu stáhnout jedním řádkem).
if (locale !== 'de' || !isLaunchedPath('de', '/oeko-regelungen')) return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

type Stufe = { label: string; v2025: number; v2026: number };
type Oer = { code: string; name: string; desc: string; stufen: Stufe[] };

const oer: Oer[] = [
  {
    code: 'ÖR 1a', name: 'Nichtproduktive Ackerflächen (Brache)',
    desc: 'Ackerland, das über die Pflicht aus der Konditionalität hinaus brachliegt — begünstigt bis höchstens 8 % des förderfähigen Ackerlands. Gestaffelt nach Flächenanteil; mit der 1-Hektar-Regel gilt Stufe 1 für bis zu einen ganzen Hektar, auch wenn das mehr als 1 % ist (Betriebe über 10 ha Ackerland, ab 2026 auch Weinbaubetriebe).',
    stufen: [
      { label: 'Stufe 1 — bis 1 % des Ackerlands bzw. erster Hektar', v2025: DE_OER_MAX, v2026: DE_OER_MAX },
      { label: 'Stufe 2 — über 1 % bis 2 %', v2025: 500, v2026: 500 },
      { label: 'Stufe 3 — über 2 % bis 8 %', v2025: 300, v2026: 300 },
    ],
  },
  {
    code: 'ÖR 1b', name: 'Blühstreifen und -flächen auf ÖR-1a-Flächen',
    desc: 'Eingesät mit einer vorgegebenen Blühmischung auf Flächen, die bereits als ÖR 1a brachliegen — zusätzlich zur ÖR-1a-Prämie. Je Streifen oder Fläche 0,1 bis 3 Hektar, Aussaat bis 15. Mai.',
    stufen: [{ label: 'je Hektar', v2025: 200, v2026: 200 }],
  },
  {
    code: 'ÖR 1c', name: 'Blühstreifen und -flächen in Dauerkulturen',
    desc: 'Dieselben Blühmischungen in Dauerkulturen wie Obst, Wein oder Hopfen.',
    stufen: [{ label: 'je Hektar', v2025: 200, v2026: 200 }],
  },
  {
    code: 'ÖR 1d', name: 'Altgrasstreifen und -flächen im Dauergrünland',
    desc: 'Altgras, das erst ab 1. September genutzt werden darf — mindestens 1 % und höchstens 6 % des Dauergrünlands, je Fläche höchstens 20 %. Gestaffelt wie ÖR 1a, ebenfalls mit 1-Hektar-Regel. Für 2026 sind die ersten beiden Stufen angehoben.',
    stufen: [
      { label: 'Stufe 1 — bis 1 % des Dauergrünlands bzw. erster Hektar', v2025: 900, v2026: 1000 },
      { label: 'Stufe 2 — über 1 % bis 3 %', v2025: 400, v2026: 450 },
      { label: 'Stufe 3 — über 3 % bis 6 %', v2025: 200, v2026: 200 },
    ],
  },
  {
    code: 'ÖR 2', name: 'Vielfältige Kulturen im Ackerbau',
    desc: 'Mindestens fünf Hauptfruchtarten, jede auf 10 bis 30 % der Fläche, darunter mindestens 10 % Leguminosen; Getreide höchstens 66 %.',
    stufen: [{ label: 'je Hektar Ackerland (ohne Brache)', v2025: 60, v2026: 60 }],
  },
  {
    code: 'ÖR 3', name: 'Agroforst',
    desc: 'Beibehaltung von Gehölzstreifen auf Acker oder Grünland — 2 bis 40 % der Fläche, mindestens zwei Streifen. Vergütet wird nur die Gehölzfläche. Für 2026 ist der Betrag verdreifacht.',
    stufen: [{ label: 'je Hektar Gehölzfläche', v2025: 200, v2026: 600 }],
  },
  {
    code: 'ÖR 4', name: 'Extensivierung des gesamten Dauergrünlands',
    desc: 'Im ganzen Betrieb 0,3 bis 1,4 raufutterfressende Großvieheinheiten je Hektar Dauergrünland. Gedüngt werden darf nur im Umfang des Dunganfalls von 1,4 RGV je Hektar; keine Pflanzenschutzmittel, kein Pflügen.',
    stufen: [{ label: 'je Hektar Dauergrünland', v2025: 100, v2026: 100 }],
  },
  {
    code: 'ÖR 5', name: 'Kennarten im Dauergrünland',
    desc: 'Nachweis von mindestens vier Kennarten des artenreichen Grünlands aus der Liste des Bundeslandes — bezahlt wird das Ergebnis, nicht eine bestimmte Bewirtschaftung.',
    stufen: [{ label: 'je Hektar', v2025: 225, v2026: 210 }],
  },
  {
    code: 'ÖR 6', name: 'Verzicht auf chemisch-synthetische Pflanzenschutzmittel',
    desc: 'Kein chemisch-synthetischer Pflanzenschutz auf den bezeichneten Flächen; Mittel mit geringem Risiko und für den Ökolandbau zugelassene Mittel bleiben erlaubt. Die Stufe richtet sich nach der Kultur.',
    stufen: [
      { label: 'Stufe 1 — Sommergetreide inkl. Mais, Leguminosen (außer Ackerfutter), Sommer-Ölsaaten, Hackfrüchte, Feldgemüse, Dauerkulturen', v2025: 150, v2026: 150 },
      { label: 'Stufe 2 — Gras und Grünfutter, Leguminosen als Ackerfutter', v2025: 50, v2026: 50 },
    ],
  },
  {
    code: 'ÖR 7', name: 'Bewirtschaftung in Natura-2000-Gebieten',
    desc: 'Für landwirtschaftliche Flächen in Natura-2000-Gebieten, auf denen die dort geltenden Auflagen eingehalten werden.',
    stufen: [{ label: 'je Hektar', v2025: 40, v2026: 40 }],
  },
];

const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
const maxBetrag = DE_OER_MAX;

const lastUpdated = new Date().toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = 'https://agro-svet.cz/de/oeko-regelungen/';

const faq = [
  { q: 'Was sind die Öko-Regelungen?', a: 'Freiwillige Umweltmaßnahmen in der ersten Säule der GAP. Wer sie beantragt, erhält zusätzlich zu den Direktzahlungen einen Betrag je Hektar. Sie gelten jeweils für ein Antragsjahr und werden mit dem Sammelantrag beantragt — anders als die mehrjährigen Agrarumweltmaßnahmen der zweiten Säule.' },
  { q: 'Wie hoch ist die höchste Prämie?', a: `Die ÖR 1a für nichtproduktive Ackerflächen: ${fmt(maxBetrag)} €/ha in Stufe 1, also für das erste Prozent des Ackerlands beziehungsweise den ersten Hektar. Darüber 500 €/ha bis 2 % und 300 €/ha bis zur Obergrenze von 8 %.` },
  { q: 'Sind die Beträge für 2025 endgültig?', a: 'Ja. Das BMLEH hat die tatsächlichen Einheitsbeträge für 2025 am 1. Dezember 2025 im Bundesanzeiger bekannt gemacht; sie entsprechen den geplanten. Das war nicht immer so: 2023 lag ÖR 1a in Stufe 1 bei 1 690 €/ha und 2024 bei 1 410,83 €/ha, jeweils über dem geplanten Betrag von 1 300 €/ha.' },
  { q: 'Was ändert sich 2026?', a: 'Die geplanten Beträge für Altgrasstreifen (ÖR 1d) steigen auf 1 000 und 450 €/ha in den ersten beiden Stufen, für Agroforst (ÖR 3) von 200 auf 600 €/ha Gehölzfläche. Für Kennarten im Grünland (ÖR 5) sind 210 statt 225 €/ha geplant. Weinbaubetriebe können die 1-Hektar-Regel der ÖR 1a künftig auch mit weniger als 10 Hektar Ackerland nutzen.' },
  { q: 'Warum sind die Beträge gestaffelt?', a: 'Die ersten Prozent einer Fläche werden deutlich höher vergütet als die weiteren. So lohnt sich schon ein kleiner Beitrag, und viele Betriebe machen mit, statt dass wenige große Flächen stilllegen.' },
  { q: 'Kann man mehrere Öko-Regelungen kombinieren?', a: 'Im Betrieb ja, auf derselben Fläche nur eingeschränkt. ÖR 1b baut sogar ausdrücklich auf ÖR-1a-Flächen auf; andere Kombinationen auf demselben Schlag sind ausgeschlossen.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `https://agro-svet.cz${localizePath('de', '/')}` },
        { '@type': 'ListItem', position: 2, name: 'Öko-Regelungen', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout
  title="Öko-Regelungen 2025 und 2026 — Beträge je Hektar (ÖR 1 bis 7)"
  description={`Die Öko-Regelungen mit ihren Einheitsbeträgen: 2025 endgültig laut Bundesanzeiger, 2026 geplant. ÖR 1a bis ${fmt(maxBetrag)} €/ha, Blühstreifen 200 €/ha, Agroforst 2026 600 €/ha. Staffelung, Regeln und FAQ.`}
  noHreflang={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="db">
    <div class="db-wrap">
      <nav class="db-crumb" aria-label="Brotkrumennavigation">
        <a href={localizePath('de', '/')}>Startseite</a>
        <span>/</span>
        <b>Öko-Regelungen</b>
      </nav>

      <header class="db-head">
        <span class="db-eyebrow">Freiwillige Umweltmaßnahmen der 1. Säule · Antragsjahr 2025 und 2026</span>
        <h1>Öko-Regelungen — Beträge je Hektar</h1>
        <p class="db-lead">
          Die sieben Öko-Regelungen sind freiwillige, einjährige Umweltmaßnahmen. Wer sie beantragt,
          bekommt zusätzlich zu den Direktzahlungen einen Betrag je Hektar. Unten jede Maßnahme mit
          ihren Regeln, dem endgültigen Betrag für 2025 und dem geplanten für 2026.
        </p>
      </header>

      <section class="db-hero-stats" aria-label="Beispiele">
        <div class="db-stat db-stat--hl">
          <span class="l">ÖR 1a, Stufe 1</span>
          <span class="v">{fmt(maxBetrag)} <small>€/ha</small></span>
          <span class="d">erstes Prozent bzw. erster Hektar</span>
        </div>
        <div class="db-stat">
          <span class="l">Agroforst 2026</span>
          <span class="v">600 <small>€/ha</small></span>
          <span class="d">geplant, je Hektar Gehölzfläche (ÖR 3)</span>
        </div>
        <div class="db-stat">
          <span class="l">Vielfältige Kulturen</span>
          <span class="v">60 <small>€/ha</small></span>
          <span class="d">mind. 5 Hauptfruchtarten (ÖR 2)</span>
        </div>
      </section>

      <section class="db-tables" aria-labelledby="tab-h">
        <h2 id="tab-h">Alle Öko-Regelungen mit Beträgen</h2>
        {oer.map((o) => (
          <div class="db-tblcard">
            <h3>{o.code} — {o.name}</h3>
            <p class="db-calc-sub">{o.desc}</p>
            <div class="db-tblscroll">
              <table class="db-tbl">
                <thead>
                  <tr><th>Stufe</th><th class="num">2025 (endgültig)</th><th class="num">2026 (geplant)</th></tr>
                </thead>
                <tbody>
                  {o.stufen.map((s) => (
                    <tr>
                      <td><span class="db-tbl-name">{s.label}</span></td>
                      <td class="num strong">{fmt(s.v2025)} €/ha</td>
                      <td class="num">{fmt(s.v2026)} €/ha</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <p class="db-tbl-src">Für 2026 sind es <strong>geplante</strong> Einheitsbeträge. Den tatsächlichen
          Betrag macht das BMLEH nach Auswertung aller Anträge Ende des Jahres im Bundesanzeiger bekannt;
          er kann höher oder niedriger ausfallen, je nachdem, wie viel Fläche bundesweit beantragt wird.</p>
      </section>

      <section class="db-explain" aria-labelledby="exp-h">
        <h2 id="exp-h">Wie sich die Öko-Regelungen einordnen</h2>
        <div class="db-explain-grid">
          <div class="db-exp"><h3>Erste Säule, aber freiwillig</h3><p>Die Öko-Regelungen liegen in der ersten Säule der GAP, sind aber freiwillig. Sie kommen zu den Direktzahlungen hinzu und ersetzen sie nicht.</p></div>
          <div class="db-exp"><h3>Jedes Jahr neu</h3><p>Sie gelten für ein Antragsjahr. Ob ein Betrieb teilnimmt, entscheidet er mit jedem Sammelantrag neu — anders als bei mehrjährigen Agrarumweltmaßnahmen.</p></div>
          <div class="db-exp"><h3>Gestaffelte Beträge</h3><p>Bei ÖR 1a und 1d sinkt der Betrag mit dem Flächenanteil. Die 1-Hektar-Regel sorgt dafür, dass auch kleinere Betriebe einen ganzen Hektar zum höchsten Satz einbringen können.</p></div>
          <div class="db-exp"><h3>Geplant und tatsächlich</h3><p>Geplante Beträge stehen in der GAP-Direktzahlungen-Verordnung. Der tatsächliche Betrag hängt von der beantragten Fläche ab — 2023 und 2024 lag er bei ÖR 1a über dem Plan, 2025 genau darauf.</p></div>
        </div>
      </section>

      <section class="db-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Häufige Fragen</h2>
        {faq.map((f) => (
          <details class="db-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="db-related">
        <a href={localizePath('de', '/direktzahlungen/')}>→ Direktzahlungen — Einheitsbeträge je Hektar</a>
      </div>

      <footer class="db-src">
        <p>Datenquellen: <a href="https://www.bundesanzeiger.de/pub/publication/6jX01V1HVYmvLWWWWGS/content/6jX01V1HVYmvLWWWWGS/BAnz%20AT%2001.12.2025%20B6.pdf" target="_blank" rel="noopener">Bundesanzeiger, BAnz AT 01.12.2025 B6</a> (tatsächliche Einheitsbeträge 2025), <a href="https://www.gesetze-im-internet.de/gapdzv/" target="_blank" rel="noopener">GAP-Direktzahlungen-Verordnung</a> (Anlage 4: geplante Beträge 2026; Anlage 5: Verpflichtungen) und <a href="https://www.bmleh.de/DE/themen/landwirtschaft/eu-agrarpolitik-und-foerderung/direktzahlung/oeko-regelungen.html" target="_blank" rel="noopener">BMLEH — Öko-Regelungen</a>. Letzte Aktualisierung dieser Seite: <strong>{lastUpdated}</strong>.</p>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .db{--yellow:#FFEA00;--yellow-d:#FFD400;--ink:#0A0A0B;--line:#E7E7EA;--muted:#6E6E76;--paper:#FBFAF3;--soft:#F5F5F2;--green:#2E9E57;--red:#D6492B;
    font-family:'Chakra Petch',system-ui,sans-serif;color:var(--ink);background:#fff}
  .db-wrap{max-width:1000px;margin:0 auto;padding:26px 28px 72px}
  .db a{color:inherit}
  .db-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .db-crumb a{text-decoration:none}.db-crumb a:hover{color:var(--ink);text-decoration:underline}
  .db-crumb b{color:var(--ink)}

  .db-head{padding-bottom:22px;border-bottom:2px solid var(--ink)}
  .db-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .db-head h1{font-size:44px;letter-spacing:-.03em;font-weight:800;margin:8px 0 12px;line-height:1.02}
  .db-lead{font-size:15.5px;line-height:1.6;color:#2A2A2F;max-width:80ch}

  .db-hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
  .db-stat{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px}
  .db-stat--hl{background:var(--yellow);border-color:var(--yellow-d)}
  .db-stat .l{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .db-stat--hl .l{color:#5c5300}
  .db-stat .v{font-size:30px;font-weight:800;letter-spacing:-.02em}
  .db-stat .v small{font-size:14px;color:var(--muted);font-weight:600}
  .db-stat--hl .v small{color:#5c5300}
  .db-stat .d{font-size:12px;color:var(--muted)}
  .db-stat--hl .d{color:#5c5300}

  .db h2{font-size:24px;letter-spacing:-.02em;font-weight:800;margin:36px 0 6px}
  .db h3{font-size:16px;font-weight:800;letter-spacing:-.01em}

  .db-calc{margin-top:34px}
  .db-calc-sub{font-size:14px;color:var(--muted);margin:0 0 14px;max-width:70ch}
  .db-calc-box{display:grid;grid-template-columns:220px 1fr;gap:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:22px}
  .db-calc-field{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-calc-field input{font:800 26px 'Chakra Petch',sans-serif;color:var(--ink);border:2px solid var(--ink);border-radius:12px;padding:10px 14px;width:100%}
  .db-calc-out{display:flex;flex-direction:column;justify-content:center;gap:8px}
  .db-calc-line{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14.5px;padding:6px 0;border-bottom:1px dashed var(--line)}
  .db-calc-line em{color:var(--muted);font-style:normal;font-size:12px}
  .db-calc-line b{font-size:18px;font-weight:800;white-space:nowrap}
  .db-calc-total{border-bottom:0;margin-top:2px}
  .db-calc-total span{font-weight:700}
  .db-calc-total b{font-size:24px;background:var(--yellow);padding:2px 8px;border-radius:8px}
  .db-calc-note{font-size:12px;color:var(--muted);margin-top:10px}

  .db-tblcard{margin-top:18px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .db-tblcard h3{padding:14px 18px;background:var(--soft);border-bottom:1px solid var(--line);margin:0}
  .db-tblscroll{overflow-x:auto}
  .db-tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .db-tbl th,.db-tbl td{padding:11px 16px;text-align:left;border-bottom:1px solid var(--line)}
  .db-tbl th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-tbl th.num,.db-tbl td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .db-tbl tr:last-child td{border-bottom:0}
  .db-tbl-name{display:block;font-weight:700}
  .db-tbl-note{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .db-tbl td.strong{font-weight:800}
  .db-tbl td.unit{color:var(--muted);font-size:12.5px;white-space:nowrap}
  .db-yoy{font-weight:800;font-size:12.5px}
  .db-yoy.up{color:var(--green)}.db-yoy.dn{color:var(--red)}
  .db-tbl-src{font-size:12px;color:var(--muted);margin-top:12px}

  .db-explain-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  .db-exp{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
  .db-exp h3{margin:0 0 6px}
  .db-exp p{font-size:13.5px;line-height:1.55;color:#2A2A2F;margin:0}

  .db-faq{margin-top:8px}
  .db-q{border:1px solid var(--line);border-radius:12px;padding:2px 18px;margin-top:10px;background:#fff}
  .db-q summary{font-weight:700;font-size:15px;padding:13px 0;cursor:pointer;list-style:none}
  .db-q summary::-webkit-details-marker{display:none}
  .db-q summary::after{content:'+';float:right;color:var(--muted);font-weight:700}
  .db-q[open] summary::after{content:'–'}
  .db-q p{font-size:14px;line-height:1.6;color:#2A2A2F;margin:0 0 14px}

  .db-related{margin-top:26px}
  .db-related a{font-weight:700;font-size:15px;color:var(--ink);border-bottom:2px solid var(--yellow);padding-bottom:2px;text-decoration:none}
  .db-related a:hover{background:var(--yellow)}

  .db-src{margin-top:28px;padding:18px 20px;background:var(--paper);border:1px solid var(--line);border-radius:14px}
  .db-src p{font-size:13px;color:#2A2A2F;line-height:1.55;margin:0}
  .db-src a{text-decoration:underline}

  @media(max-width:720px){
    .db-head h1{font-size:32px}
    .db-hero-stats{grid-template-columns:1fr}
    .db-calc-box{grid-template-columns:1fr}
    .db-explain-grid{grid-template-columns:1fr}
  }
</style>
