---
// SSR (prerender:false) → middleware servíruje lokalizovanú /sk verziu cez
// locals.locale. cs výstup sémanticky identický.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbSchema, faqPageSchema } from '../../../lib/structured-data';
import { SITE_URL } from '../../../lib/config';
import AreaConverter from '../../../components/AreaConverter.astro';
import { content } from '../../../i18n/kalkulacka/prevody-jednotek';
import { crumbs } from '../../../i18n/kalkulacka/common';
import { localizeInternalHref } from '../../../i18n/utils';

const locale = Astro.locals.locale ?? 'cs';
const c = content[locale] ?? content.cs;
const cr = crumbs[locale] ?? crumbs.cs;
// Sekce (srovnání, tabulky, karty) — locale bez překladu (sk/uk) dostane cs
// blok, tedy přesně dnešní výstup. Dřív byly natvrdo česky v šabloně, takže
// /pl stránka byla z poloviny česky navzdory přeloženému hero i FAQ.
const sec = c.sections ?? content.cs.sections!;

const canonical = `${SITE_URL}/kalkulacka/prevody-jednotek/`;
const faqItems = c.faq;

const breadcrumbJsonLd = breadcrumbSchema([
  { name: cr.home, url: '/' },
  { name: cr.hub, url: '/kalkulacka/' },
  { name: c.crumb, url: canonical },
]);
const faqJsonLd = faqPageSchema(faqItems);

// WebApplication schema — Google u online nástrojů rád ukazuje jako app rich result.
const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.h1,
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: 'Kalkulačka',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  inLanguage: locale,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CZK' },
  description: c.metaDescription,
};
---

<Layout
  title={c.title}
  description={c.metaDescription}
  canonical={locale === 'cs' ? canonical : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appJsonLd)} />

  <div class="pj-page">
    <nav class="breadcrumb" aria-label="Cesta">
      <a href={locale === 'cs' ? '/' : `/${locale}/`}>{cr.home}</a>
      <span class="sep" aria-hidden="true">›</span>
      <a href={localizeInternalHref(locale, '/kalkulacka/')}>{cr.hub}</a>
      <span class="sep" aria-hidden="true">›</span>
      <span class="current">{c.crumb}</span>
    </nav>

    <header class="hero">
      <span class="kicker">{c.kicker}</span>
      <h1>{c.h1}</h1>
      <p class="hero-lede">{c.lede}</p>
    </header>

    <AreaConverter
      defaultUnit="ha"
      defaultValue={1}
      heading={c.converterHeading}
      caption={c.converterCaption}
      headingLevel="h2"
      numberLocale={c.numberLocale}
      ui={c.ui}
      unitNames={c.unitNames}
      comparisonsHeading={sec.comparisonsHeading}
      comparisonsCaption={sec.comparisonsCaption}
      comparisons={sec.comparisons}
      cmpText={sec.cmpText}
    />

    <section class="pj-reference">
      <h2>{sec.refHeading}</h2>
      <div class="pj-tables">
        {sec.tables.map((t) => (
          <table class="pj-table">
            <caption>{t.caption}</caption>
            <tbody>
              {t.rows.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
            </tbody>
          </table>
        ))}
      </div>
    </section>

    <section class="pj-context">
      <h2>{sec.contextHeading}</h2>
      <div class="pj-cards">
        {sec.cards.map((card) => (
          <article class="pj-card">
            <h3>
              {card.title}
              <a href={localizeInternalHref(locale, card.href)} class="pj-card-link">detail →</a>
            </h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pj-faq">
      <h2>{sec.faqHeading}</h2>
      {faqItems.map((item) => (
        <details class="pj-faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>

    <aside class="pj-related">
      <h2>{c.related?.heading ?? 'Další užitečné stránky'}</h2>
      <ul class="pj-related-list">
        {c.related ? c.related.items.map((it) => (
          <li><a href={it.href}>{it.label}</a></li>
        )) : (
          <>
            <li><a href="/slovnik/?kategorie=jednotky">📐 Slovník — všechny jednotky a měření</a></li>
            <li><a href={localizeInternalHref(locale, '/kalkulacka/naklady-na-hektar/')}>🌾 Kalkulačka nákladů na hektar</a></li>
            <li><a href={localizeInternalHref(locale, '/kalkulacka/dotace-cap/')}>💶 Kalkulačka dotací CAP 2024</a></li>
            <li><a href="/slovnik/hektar/">🟨 Hektar (ha) — detail jednotky</a></li>
            <li><a href="/slovnik/q-cent/">⚖️ Cent (q) — jednotka výnosu</a></li>
          </>
        )}
      </ul>
    </aside>
  </div>
</Layout>

<style>
  .pj-page { max-width: 980px; margin: 0 auto; padding: 32px 24px 80px; }
  .breadcrumb { display: flex; gap: 8px; align-items: center; font-size: 13px; color: #666; margin-bottom: 20px; flex-wrap: wrap; }
  .breadcrumb a { color: #666; text-decoration: none; }
  .breadcrumb a:hover { color: #000; }
  .breadcrumb .current { color: #000; font-weight: 600; }
  .breadcrumb .sep { opacity: 0.5; }

  .hero { max-width: 720px; margin-bottom: 28px; }
  .kicker {
    display: inline-block;
    background: #FFEA00;
    color: #0A0A0B;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -1px;
    margin: 12px 0 12px;
    line-height: 1.1;
    color: #1a1a1a;
  }
  .hero-lede { font-size: 16px; color: #555; line-height: 1.65; margin: 0; }

  .pj-reference { margin: 36px 0; }
  .pj-reference h2,
  .pj-context h2,
  .pj-faq h2,
  .pj-related h2 {
    font-size: 22px;
    font-weight: 800;
    color: #0A0A0B;
    margin: 0 0 18px;
    padding-bottom: 8px;
    border-bottom: 2px solid #FFEA00;
  }

  .pj-tables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .pj-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border: 1px solid #eaeaec;
    border-radius: 10px;
    overflow: hidden;
    font-size: 14px;
  }
  .pj-table caption {
    text-align: left;
    padding: 10px 14px;
    background: #fffef8;
    color: #0A0A0B;
    font-weight: 700;
    border-bottom: 1px solid #eaeaec;
    caption-side: top;
  }
  .pj-table th,
  .pj-table td { padding: 8px 14px; text-align: left; }
  .pj-table th {
    font-weight: 700;
    color: #0A0A0B;
    font-variant-numeric: tabular-nums;
    width: 40%;
  }
  .pj-table td { color: #444; font-variant-numeric: tabular-nums; }
  .pj-table tr + tr { border-top: 1px solid #f1f1f3; }

  .pj-context { margin: 36px 0; }
  .pj-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .pj-card {
    padding: 16px 18px;
    background: #fff;
    border: 1.5px solid #eaeaec;
    border-radius: 10px;
  }
  .pj-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: #0A0A0B;
    margin: 0 0 8px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .pj-card-link {
    font-size: 12px;
    font-weight: 600;
    color: #0B7A3B;
    text-decoration: none;
    white-space: nowrap;
  }
  .pj-card-link:hover { text-decoration: underline; }
  .pj-card p { font-size: 13px; color: #555; line-height: 1.6; margin: 0; }

  .pj-faq { margin: 36px 0; }
  .pj-faq-item {
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #eaeaec;
    border-radius: 8px;
    margin-bottom: 8px;
  }
  .pj-faq-item summary {
    cursor: pointer;
    font-weight: 700;
    color: #0A0A0B;
    font-size: 14px;
  }
  .pj-faq-item[open] summary { margin-bottom: 8px; }
  .pj-faq-item p {
    margin: 0;
    font-size: 14px;
    color: #444;
    line-height: 1.65;
  }

  .pj-related {
    margin: 36px 0 0;
    padding: 20px 24px;
    background: #f9f9fb;
    border-radius: 12px;
  }
  .pj-related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px;
  }
  .pj-related-list a {
    display: block;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid #eaeaec;
    border-radius: 8px;
    color: #0A0A0B;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: border-color .15s;
  }
  .pj-related-list a:hover { border-color: #FFEA00; }
</style>
