---
import Layout from '../../../layouts/Layout.astro';
import EuropeMap from '../../../components/svet/EuropeMap.astro';
import mapData from '../../../data/svet/map-metrics.json';
import countryIndex from '../../../data/svet/index.json';
import { localizePath, t, bcp47 } from '../../../i18n/utils';
import { COUNTRY_NAMES, loc, localizeMetric, type SvetLang } from '../../../i18n/svet';
import { pageSlugs } from '../../../lib/svet/map';
import '../../../styles/svet.css';

// Země bez profilu nesmí mít odkaz — /svet/<slug>/ by na ni vracelo 301 na
// rozcestník. Zdroj pravdy je index.json, viz pageSlugs().
const PAGE_SLUGS = pageSlugs(countryIndex);

const locale = Astro.locals.locale ?? 'cs';
const numLocale = bcp47(locale); // ‼️ sdílená mapa, ne vlastní ternář — ten neznal de ani uk

const UI = {
  cs: { title: 'Mapa zemědělství Evropy — porovnání zemí', description: 'Interaktivní mapa: výnosy, stavy zvířat, zemědělská plocha, počet farem, ekozemědělství a zaměstnanost napříč Evropou. Přepínejte metriky a porovnejte země. Zdroje Eurostat a World Bank.', bcHome: 'Domů', bcSvet: 'Svět', bcMap: 'Mapa', byCountry: 'Zemědělství podle zemí', country: 'Země', sortNote: 'Řazeno podle ceny zemědělské půdy. Nejnovější dostupný rok za každou zemi; „—" = data nejsou v daném zdroji k dispozici.', method: 'Zdroje a metodika', methodP: 'Data pocházejí z oficiálních evropských a světových statistik. Nejnovější dostupný rok za každou zemi; některé mimoevropské a menší země nemusí mít všechny ukazatele (zobrazeny šedě). Mapa staví na profilech zemí v sekci', svetLink: 'Svět', methodP2: '— kliknutím na zemi přejdete na její detail.', srcData: 'zdrojová data',
    cols: [{ key: 'land_price', label: 'Cena půdy', unit: '€/ha' }, { key: 'rent', label: 'Pachtovné', unit: '€/ha' }, { key: 'wheat_yield', label: 'Výnos pšenice', unit: 't/ha' }, { key: 'ag_land', label: 'Zeměd. plocha', unit: 'mil. ha' }, { key: 'organic_share', label: 'Eko', unit: '%' }] },
  sk: { title: 'Mapa poľnohospodárstva Európy — porovnanie krajín', description: 'Interaktívna mapa: výnosy, stavy zvierat, poľnohospodárska plocha, počet fariem, ekopoľnohospodárstvo a zamestnanosť naprieč Európou. Prepínajte metriky a porovnajte krajiny. Zdroje Eurostat a World Bank.', bcHome: 'Domov', bcSvet: 'Svet', bcMap: 'Mapa', byCountry: 'Poľnohospodárstvo podľa krajín', country: 'Krajina', sortNote: 'Zoradené podľa ceny poľnohospodárskej pôdy. Najnovší dostupný rok za každú krajinu; „—" = dáta nie sú v danom zdroji k dispozícii.', method: 'Zdroje a metodika', methodP: 'Dáta pochádzajú z oficiálnych európskych a svetových štatistík. Najnovší dostupný rok za každú krajinu; niektoré mimoeurópske a menšie krajiny nemusia mať všetky ukazovatele (zobrazené sivo). Mapa stavia na profiloch krajín v sekcii', svetLink: 'Svet', methodP2: '— kliknutím na krajinu prejdete na jej detail.', srcData: 'zdrojové dáta',
    cols: [{ key: 'land_price', label: 'Cena pôdy', unit: '€/ha' }, { key: 'rent', label: 'Nájomné', unit: '€/ha' }, { key: 'wheat_yield', label: 'Výnos pšenice', unit: 't/ha' }, { key: 'ag_land', label: 'Poľn. plocha', unit: 'mil. ha' }, { key: 'organic_share', label: 'Eko', unit: '%' }] },
  de: { title: 'Karte der Landwirtschaft Europas — Länder im Vergleich', description: 'Interaktive Karte: Erträge, Tierbestände, landwirtschaftliche Fläche, Zahl der Betriebe, Ökolandbau und Beschäftigung in ganz Europa. Metriken umschalten und Länder vergleichen. Quellen Eurostat und World Bank.', bcHome: 'Startseite', bcSvet: 'Welt', bcMap: 'Karte', byCountry: 'Landwirtschaft nach Ländern', country: 'Land', sortNote: 'Sortiert nach dem Bodenpreis. Jeweils das neueste verfügbare Jahr je Land; „—" = im jeweiligen Datensatz nicht verfügbar.', method: 'Quellen und Methodik', methodP: 'Die Daten stammen aus amtlichen europäischen und weltweiten Statistiken. Angegeben ist jeweils das neueste verfügbare Jahr je Land; bei einigen außereuropäischen und kleineren Ländern fehlen Kennzahlen (grau dargestellt). Die Karte baut auf den Länderprofilen im Bereich', svetLink: 'Welt', methodP2: '— ein Klick auf ein Land öffnet sein Profil.', srcData: 'Quelldaten',
    cols: [{ key: 'land_price', label: 'Bodenpreis', unit: '€/ha' }, { key: 'rent', label: 'Pacht', unit: '€/ha' }, { key: 'wheat_yield', label: 'Weizenertrag', unit: 't/ha' }, { key: 'ag_land', label: 'Landw. Fläche', unit: 'Mio. ha' }, { key: 'organic_share', label: 'Öko', unit: '%' }] },
  uk: { title: 'Карта сільського господарства Європи — порівняння країн', description: 'Інтерактивна карта: урожайність, поголів’я, сільськогосподарські угіддя, кількість господарств, органічне виробництво та зайнятість по всій Європі. Перемикайте показники й порівнюйте країни. Джерела Eurostat і World Bank.', bcHome: 'Домів', bcSvet: 'Світ', bcMap: 'Карта', byCountry: 'Сільське господарство за країнами', country: 'Країна', sortNote: 'Відсортовано за ціною сільськогосподарської землі. Для кожної країни — найновіший доступний рік; „—" = даних у цьому джерелі немає.', method: 'Джерела та методика', methodP: 'Дані походять з офіційної європейської та світової статистики. Для кожної країни наведено найновіший доступний рік; у деяких неєвропейських і менших країн частина показників відсутня (показано сірим). Карта спирається на профілі країн у розділі', svetLink: 'Світ', methodP2: '— натисніть на країну, щоб перейти до її профілю.', srcData: 'вихідні дані',
    cols: [{ key: 'land_price', label: 'Ціна землі', unit: '€/га' }, { key: 'rent', label: 'Оренда', unit: '€/га' }, { key: 'wheat_yield', label: 'Урожай пшениці', unit: 'т/га' }, { key: 'ag_land', label: 'Сільгоспугіддя', unit: 'млн га' }, { key: 'organic_share', label: 'Орг.', unit: '%' }] },
  pl: { title: 'Mapa rolnictwa Europy — porównanie krajów', description: 'Interaktywna mapa: plony, pogłowie zwierząt, powierzchnia użytków rolnych, liczba gospodarstw, rolnictwo ekologiczne i zatrudnienie w całej Europie. Przełączaj metryki i porównuj kraje. Źródła Eurostat i World Bank.', bcHome: 'Główna', bcSvet: 'Świat', bcMap: 'Mapa', byCountry: 'Rolnictwo według krajów', country: 'Kraj', sortNote: 'Sortowane według ceny ziemi rolnej. Najnowszy dostępny rok dla każdego kraju; „—" = dane niedostępne w danym źródle.', method: 'Źródła i metodyka', methodP: 'Dane pochodzą z oficjalnych statystyk europejskich i światowych. Najnowszy dostępny rok dla każdego kraju; niektóre kraje pozaeuropejskie i mniejsze mogą nie mieć wszystkich wskaźników (pokazane na szaro). Mapa opiera się na profilach krajów w sekcji', svetLink: 'Świat', methodP2: '— kliknięcie w kraj przenosi do jego profilu.', srcData: 'dane źródłowe',
    cols: [{ key: 'land_price', label: 'Cena ziemi', unit: '€/ha' }, { key: 'rent', label: 'Czynsz', unit: '€/ha' }, { key: 'wheat_yield', label: 'Plon pszenicy', unit: 't/ha' }, { key: 'ag_land', label: 'Uż. rolne', unit: 'mln ha' }, { key: 'organic_share', label: 'Eko', unit: '%' }] },
} as const;
const L = UI[locale as keyof typeof UI] ?? UI.cs;
const title = L.title;
const description = L.description;
const TCOLS = L.cols;

const metricsRaw = mapData.metrics as { key: string; label: string; source: string; sourceUrl: string }[];
const metrics = metricsRaw.map((m) => localizeMetric(m, locale));
const sources = Array.from(new Map(metrics.filter((m) => m.source).map((m) => [m.source + m.sourceUrl, { source: m.source, url: m.sourceUrl }])).values());

// SSR tabulka zemí (crawlovatelný obsah + interní prolinky).
const tCountries = mapData.countries as Record<string, { slug: string; name: string; flag: string; values: Record<string, number | null> }>;
const cName = (c: { slug: string; name: string }) => (locale === 'cs' ? c.name : loc(COUNTRY_NAMES, c.slug, locale as SvetLang, c.name));
const nf0 = new Intl.NumberFormat(numLocale, { maximumFractionDigits: 2 });
const fmt = (v: number | null | undefined) => (v == null ? '—' : nf0.format(v));
const tableRows = Object.entries(tCountries)
  .map(([code, c]) => ({ code, ...c }))
  .sort((a, b) => (b.values.land_price ?? -1) - (a.values.land_price ?? -1));
---

<Layout title={title} description={description}>
  <main class="svet-page">
    <nav class="svet-crumbs" aria-label={t(locale, 'a11y.breadcrumb')} style="font-size:13px;color:#666;margin-bottom:8px;">
      <a href={localizePath(locale, '/')} style="color:#666;text-decoration:none;">{L.bcHome}</a> ·
      <a href={localizePath(locale, '/svet/')} style="color:#666;text-decoration:none;">{L.bcSvet}</a> ·
      <span>{L.bcMap}</span>
    </nav>
    <header class="svet-hero" style="padding-bottom:12px;">
      <div class="svet-hero-inner">
        <span class="svet-flag">🗺️</span>
        <h1>{title}</h1>
        <p class="svet-lede">{description}</p>
      </div>
    </header>

    <EuropeMap />

    <section class="svet-section" style="margin-top:24px;">
      <header class="svet-section-head"><h2>{L.byCountry}</h2></header>
      <div style="overflow-x:auto; margin-top:8px;">
        <table class="svet-ctable">
          <thead>
            <tr>
              <th>{L.country}</th>
              {TCOLS.map((c) => (<th>{c.label}<br /><span>{c.unit}</span></th>))}
            </tr>
          </thead>
          <tbody>
            {tableRows.map((r) => (
              <tr>
                <td>{PAGE_SLUGS.has(r.slug)
                  ? <a href={localizePath(locale, `/svet/${r.slug}/`)}>{r.flag} {cName(r)}</a>
                  : <span class="svet-ctable-plain">{r.flag} {cName(r)}</span>}</td>
                {TCOLS.map((c) => (<td>{fmt(r.values[c.key])}</td>))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="color:#888; font-size:12.5px; margin-top:10px;">{L.sortNote}</p>
    </section>

    <section class="svet-section" style="margin-top:28px;">
      <header class="svet-section-head"><h2>{L.method}</h2></header>
      <p style="color:#555;font-size:14px;line-height:1.6;">
        {L.methodP} <a href={localizePath(locale, '/svet/')}>{L.svetLink}</a> {L.methodP2}
      </p>
      <ul style="color:#555;font-size:14px;line-height:1.7;">
        {sources.map((s) => (
          <li><strong>{s.source}</strong>{s.url ? <> — <a href={s.url} rel="nofollow noopener" target="_blank">{L.srcData}</a></> : null}</li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
