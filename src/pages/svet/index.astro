---
import Layout from '../../layouts/Layout.astro';
import index from '../../data/svet/index.json';
import { localizePath } from '../../i18n/utils';
import { COUNTRY_NAMES, loc, type SvetLang } from '../../i18n/svet';
import '../../styles/svet.css';

const locale = Astro.locals.locale ?? 'cs';
const lang = locale as SvetLang; // loc() bere jen sk/pl; cs si stringy nechává z dat
// Česko (reference) MÁ vlastní profil (cesko.json) — zařaď ho do rozcestníku jako
// první (domácí země, na mapě nejhledanější). Ostatní v původním pořadí.
const countries = [
  ...index.countries.filter((c) => c.reference),
  ...index.countries.filter((c) => !c.reference),
];

const UI = {
  cs: { title: 'Zemědělství ve světě — data zemí', description: 'Zemědělská data evropských zemí i světa: produkce, půda, ekonomika. Profily zemí a srovnání s Českem. Zdroje Eurostat a World Bank.', profily: 'Profily zemí', cta: 'Zobrazit data →', compare: 'Porovnat země vedle sebe →' },
  sk: { title: 'Poľnohospodárstvo vo svete — dáta krajín', description: 'Poľnohospodárske dáta európskych krajín i sveta: produkcia, pôda, ekonomika. Profily krajín a porovnanie s Českom. Zdroje Eurostat a World Bank.', profily: 'Profily krajín', cta: 'Zobraziť dáta →', compare: 'Porovnať krajiny vedľa seba →' },
  // ‼️ „srovnání s Českem" se pro de/uk mění na jejich vlastní trh — viz
  // SVET_REFERENCE. Německému čtenáři neříká odchylka od Česka nic.
  de: { title: 'Landwirtschaft weltweit — Länderdaten', description: 'Agrardaten europäischer Länder und der Welt: Produktion, Boden, Wirtschaft. Länderprofile und Vergleich mit Deutschland. Quellen Eurostat und World Bank.', profily: 'Länderprofile', cta: 'Daten ansehen →', compare: 'Länder nebeneinander vergleichen →' },
  uk: { title: 'Сільське господарство світу — дані країн', description: 'Аграрні дані країн Європи та світу: виробництво, земля, економіка. Профілі країн і порівняння з Україною. Джерела Eurostat і World Bank.', profily: 'Профілі країн', cta: 'Переглянути дані →', compare: 'Порівняти країни поруч →' },
  pl: { title: 'Rolnictwo na świecie — dane krajów', description: 'Dane rolnicze krajów europejskich i świata: produkcja, ziemia, gospodarka. Profile krajów i porównanie z Czechami. Źródła Eurostat i World Bank.', profily: 'Profile krajów', cta: 'Zobacz dane →', compare: 'Porównaj kraje obok siebie →' },
} as const;
const L = UI[locale as keyof typeof UI] ?? UI.cs;
const title = L.title;
const description = L.description;
const countryName = (c: { slug: string; nameCs: string }) => (locale === 'cs' ? c.nameCs : loc(COUNTRY_NAMES, c.slug, lang, c.nameCs));
---

<Layout title={title} description={description}>
  <main class="svet-page svet-hub">
    <header class="svet-hero">
      <div class="svet-hero-inner">
        <span class="svet-flag">🌍</span>
        <h1>{title}</h1>
        <p class="svet-lede">{description}</p>
      </div>
    </header>

    <section class="svet-section">
      <header class="svet-section-head"><h2>{L.profily}</h2></header>
      <div class="svet-grid">
        {countries.map((c) => (
          <a class="svet-card" href={localizePath(locale, `/svet/${c.slug}/`)}>
            <span class="svet-card-flag">{c.flag}</span>
            <span class="svet-card-name">{countryName(c)}</span>
            <span class="svet-card-cta">{L.cta}</span>
          </a>
        ))}
      </div>
      <p class="svet-method" style="margin-top:18px"><a href={localizePath(locale, '/svet/srovnani/')}>{L.compare}</a></p>
    </section>
  </main>
</Layout>
