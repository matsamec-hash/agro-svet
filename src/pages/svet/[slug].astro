---
// SSR: profil země se načítá podle slugu z URL. Dřív prerender=true + getStaticPaths,
// jenže prerendered routy nejdou middleware-rewritnout pod /sk//pl/ (Astro Node SSR →
// „unable to find a component instance" → 302 na cs). Pro launch /svet v sk/pl musí
// být route SSR. Data jsou statický JSON import (žádný runtime fetch) → edge-cache.
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import IndicatorRow from '../../components/svet/IndicatorRow.astro';
import RegionMap from '../../components/svet/RegionMap.astro';
import { groupByPackage, fmtNum, COUNTRY_LOCATIVE } from '../../lib/svet/render';
import { prodejeProZemi, akcieProZemi } from '../../lib/agro-integrace';
import { assertCountryProfile } from '../../lib/svet/types';
import { breadcrumbSchema, datasetSchema } from '../../lib/structured-data';
import { SITE_URL } from '../../lib/config';
import { localizePath, t } from '../../i18n/utils';
import { COUNTRY_NAMES, INDICATOR_LABELS, PACKAGE_LABELS, SVET_REFERENCE, loc, type SvetLang } from '../../i18n/svet';
import type { Locale } from '../../i18n/config';
import index from '../../data/svet/index.json';
import mapData from '../../data/svet/map-metrics.json';
import '../../styles/svet.css';

const { slug } = Astro.params;
// Reference (Česko) MÁ vlastní profil (cesko.json s daty) — proto NEfiltrujeme
// `!reference`. Na vlastní stránce se jen potlačí sebe-porovnání „vs ČR".
const known = index.countries.find((c) => c.slug === slug);
const mods = import.meta.glob('../../data/svet/*.json', { eager: true });
const regionMods = import.meta.glob('../../data/svet/regions/*.json', { eager: true });
const profileMod = known ? (mods[`../../data/svet/${slug}.json`] as any) : null;
if (!known || !profileMod) {
  // Země, co je na mapě (map-metrics), ale nemá plný profil (např. Island) →
  // mapa na ni odkazuje, takže místo 404 nasměruj 301 na rozcestník /svet/.
  const isMapCountry = Object.values(mapData.countries as Record<string, { slug: string }>).some((c) => c.slug === slug);
  const localeNow = Astro.locals.locale ?? 'cs';
  if (isMapCountry) return Astro.redirect(localizePath(localeNow, '/svet/'), 301);
  return new Response('Country not found', { status: 404 });
}
const profile = profileMod.default;
const localeEarly = (Astro.locals.locale ?? 'cs') as Locale;
// ‼️ Referenční země NENÍ napevno Česko. „O 12 % víc než v Česku" je pro
// německého čtenáře informace o cizí zemi; de se proto poměřuje s Německem
// a uk s Ukrajinou (SVET_REFERENCE). cs/sk/pl zůstávají u Česka → beze změny.
const refSlug = SVET_REFERENCE[localeEarly] ?? 'cesko';
const isRef = slug === refSlug; // na stránce referenční země potlač sebe-porovnání
const regionGeo = (regionMods[`../../data/svet/regions/${slug}-geo.json`] as any)?.default ?? null;
const regionData = (regionMods[`../../data/svet/regions/${slug}.json`] as any)?.default ?? null;
assertCountryProfile(profile);
const hasMap = regionGeo && regionData;

// Statická data → agresivní edge-cache (jako ostatní /svet SSR stránky).
Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

// `mods` už globuje všechny profily, takže referenční profil je zdarma —
// vlastní glob na cesko.json by navíc referenci zabetonoval do češtiny.
const ref = (mods[`../../data/svet/${refSlug}.json`] as any)?.default ?? null;
// Na stránce samotné reference sebe-porovnání nedává smysl → bez ref hodnot.
const refVal = (key: string) => (isRef || !ref ? undefined : ref.indicators[key]?.latest?.value);
const refSeries = (key: string) => (isRef || !ref ? null : ref.indicators[key]?.series ?? null);

const locale = localeEarly;
const lang = locale as SvetLang;
const name = locale === 'cs' ? profile.nameCs : loc(COUNTRY_NAMES, profile.slug, lang, profile.nameCs);
// cs drží zkratku „ČR" (beze změny výstupu), ostatní berou název z COUNTRY_NAMES.
const refName = locale === 'cs' ? 'ČR' : loc(COUNTRY_NAMES, refSlug, lang, 'ČR');
const pkgLabel = (g: { pkg: string; label: string }) => (locale === 'cs' ? g.label : loc(PACKAGE_LABELS, g.pkg, lang, g.label));
const indLabel = (k: { key: string; label: string }) => (locale === 'cs' ? k.label : loc(INDICATOR_LABELS, k.key, lang, k.label));

const groups = groupByPackage(profile);
const heroKeys = ['ag_land', 'ag_output_value', 'farm_count', 'cattle_count'];
const heroKpis = heroKeys.map((k) => profile.indicators[k]).filter(Boolean);

const loc0 = COUNTRY_LOCATIVE[profile.slug] ?? `v ${profile.nameCs}`;
// Klíčová slova do Dataset JSON-LD. ‼️ Teče to Googlu, ne na stránku — česká
// slova pod /de by tam zůstala neviditelně (viz feedback-json-ld…).
const DS_KEYWORDS: Record<string, string[]> = {
  cs: ['zemědělství', 'zemědělská statistika', 'produkce'],
  sk: ['poľnohospodárstvo', 'poľnohospodárska štatistika', 'produkcia'],
  pl: ['rolnictwo', 'statystyka rolna', 'produkcja'],
  de: ['Landwirtschaft', 'Agrarstatistik', 'Produktion'],
  uk: ['сільське господарство', 'аграрна статистика', 'виробництво'],
};

const UI = {
  cs: { title: `Zemědělství ${loc0}`, description: `Aktuální zemědělská data: ${profile.nameCs} — produkce, půda, ekonomika a srovnání s ČR. Zdroje Eurostat a World Bank.`, bcHome: 'Domů', bcSvet: 'Zemědělství ve světě', method: 'Zdroje a metodika', methodP: `Data se stahují automaticky z oficiálních otevřených zdrojů (Eurostat, World Bank); u každého ukazatele je uvedeno období a odkaz na zdroj. Hodnoty jsou srovnatelné mezi zeměmi a „vs ČR" porovnává poslední dostupnou hodnotu s Českem. Aktualizováno ${profile.generated}.`, compare: 'Porovnat země vedle sebe →', dsName: `Zemědělská data — ${profile.nameCs}` },
  sk: { title: `${name} — poľnohospodárstvo a dáta`, description: `Aktuálne poľnohospodárske dáta: ${name} — produkcia, pôda, ekonomika a porovnanie s Českom. Zdroje Eurostat a World Bank.`, bcHome: 'Domov', bcSvet: 'Poľnohospodárstvo vo svete', method: 'Zdroje a metodika', methodP: `Dáta sa sťahujú automaticky z oficiálnych otvorených zdrojov (Eurostat, World Bank); pri každom ukazovateli je uvedené obdobie a odkaz na zdroj. Hodnoty sú porovnateľné medzi krajinami a „vs Česko" porovnáva poslednú dostupnú hodnotu s Českom. Aktualizované ${profile.generated}.`, compare: 'Porovnať krajiny vedľa seba →', dsName: `Poľnohospodárske dáta — ${name}` },
  de: { title: `${name} — Landwirtschaft und Daten`, description: `Aktuelle Agrardaten: ${name} — Produktion, Boden, Wirtschaft und Vergleich mit Deutschland. Quellen Eurostat und World Bank.`, bcHome: 'Startseite', bcSvet: 'Landwirtschaft weltweit', method: 'Quellen und Methodik', methodP: `Die Daten werden automatisch aus amtlichen offenen Quellen bezogen (Eurostat, World Bank); bei jeder Kennzahl stehen Zeitraum und Quellenlink. Die Werte sind zwischen Ländern vergleichbar und „vs. DE" stellt den zuletzt verfügbaren Wert Deutschland gegenüber. Aktualisiert ${profile.generated}.`, compare: 'Länder nebeneinander vergleichen →', dsName: `Agrardaten — ${name}` },
  uk: { title: `${name} — сільське господарство та дані`, description: `Актуальні аграрні дані: ${name} — виробництво, земля, економіка та порівняння з Україною. Джерела Eurostat і World Bank.`, bcHome: 'Домів', bcSvet: 'Сільське господарство світу', method: 'Джерела та методика', methodP: `Дані завантажуються автоматично з офіційних відкритих джерел (Eurostat, World Bank); для кожного показника вказано період і посилання на джерело. Значення порівнянні між країнами, а „vs Україна" зіставляє останнє доступне значення з Україною. Оновлено ${profile.generated}.`, compare: 'Порівняти країни поруч →', dsName: `Аграрні дані — ${name}` },
  pl: { title: `${name} — rolnictwo i dane`, description: `Aktualne dane rolnicze: ${name} — produkcja, ziemia, gospodarka i porównanie z Czechami. Źródła Eurostat i World Bank.`, bcHome: 'Główna', bcSvet: 'Rolnictwo na świecie', method: 'Źródła i metodyka', methodP: `Dane pobierane są automatycznie z oficjalnych otwartych źródeł (Eurostat, World Bank); przy każdym wskaźniku podano okres i odnośnik do źródła. Wartości są porównywalne między krajami, a „vs Czechy" porównuje ostatnią dostępną wartość z Czechami. Zaktualizowano ${profile.generated}.`, compare: 'Porównaj kraje obok siebie →', dsName: `Dane rolnicze — ${name}` },
} as const;
const L = UI[locale as keyof typeof UI] ?? UI.cs;
const title = L.title;
const description = L.description;
const pageUrl = `${SITE_URL}${localizePath(locale, `/svet/${profile.slug}/`)}`;
const ogImage = `${SITE_URL}/og/svet-${profile.slug}.png`;

// Provázání: prodeje techniky + akcie firem se sídlem v této zemi.
const prodejeTech = prodejeProZemi(profile.slug);
const akcieZeme = akcieProZemi(profile.slug);
const prodejeZnacky = (prodejeTech?.zeme.znacky ?? []).slice(0, 3).map((z) => z.znacka);

// ---- Strukturovaná data (JSON-LD) ----
const inds = Object.values(profile.indicators) as any[];
const years = inds.flatMap((i) => (i.series ?? []).map((p: any) => Number(p.period))).filter((y) => Number.isFinite(y));
const temporalCoverage = years.length ? `${Math.min(...years)}/${Math.max(...years)}` : undefined;
const SOURCE_URLS: Record<string, string> = {
  Eurostat: 'https://ec.europa.eu/eurostat',
  'World Bank': 'https://data.worldbank.org',
};
const sources = [...new Set(inds.map((i) => i.latest?.source).filter(Boolean))].map((name: string) => ({
  name, url: SOURCE_URLS[name],
}));
const breadcrumbJsonLd = breadcrumbSchema([
  { name: L.bcHome, url: localizePath(locale, '/') },
  { name: L.bcSvet, url: localizePath(locale, '/svet/') },
  { name, url: pageUrl },
]);
const datasetJsonLd = datasetSchema({
  name: L.dsName,
  description,
  url: pageUrl,
  countryName: name,
  keywords: [name, ...(DS_KEYWORDS[locale] ?? DS_KEYWORDS.cs), ...sources.map((s) => s.name)],
  temporalCoverage,
  dateModified: profile.generated,
  variables: inds.map((i) => ({ name: (locale === 'cs' ? i.label : loc(INDICATOR_LABELS, i.key, lang, i.label)), unitText: i.unit })),
  sources,
});
---
<Layout title={title} description={description} canonical={pageUrl} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetJsonLd)} />
  <main class="svet-page svet-profile">
    <nav class="svet-crumbs" aria-label={t(locale, 'a11y.breadcrumb')}>
      <a href={localizePath(locale, '/')}>{L.bcHome}</a>
      <span aria-hidden="true">›</span>
      <a href={localizePath(locale, '/svet/')}>{L.bcSvet}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{name}</span>
    </nav>
    <header class="svet-hero">
      <div class="svet-hero-inner">
        <span class="svet-flag">{profile.flag}</span>
        <h1>{title}</h1>
        <p class="svet-lede">{description}</p>
      </div>
      {heroKpis.length > 0 && (
        <div class="svet-kpis">
          {heroKpis.map((k: any) => (
            <div class="svet-kpi">
              <div class="svet-kpi-val">{fmtNum(k.latest.value)} <span>{k.unit}</span></div>
              <div class="svet-kpi-lbl">{indLabel(k)}</div>
            </div>
          ))}
        </div>
      )}
    </header>

    {hasMap && <RegionMap geo={regionGeo} data={regionData} countryName={name} />}

    {groups.map((g) => (
      <section class="svet-section">
        <header class="svet-section-head"><h2>{pkgLabel(g)}</h2></header>
        <div class="svet-rows">
          {g.indicators.map((ind: any) => (
            <IndicatorRow indicator={ind} refValue={refVal(ind.key)} refSeries={refSeries(ind.key)} refName={refName} countryName={name} />
          ))}
        </div>
      </section>
    ))}

    {locale === 'cs' && (prodejeTech || akcieZeme.length > 0) && (
      <section class="svet-section">
        <header class="svet-section-head"><h2>Zemědělská technika a agrobyznys</h2></header>
        <div class="svet-rows">
          {prodejeTech && (
            <p class="svet-method">
              Ročně se {loc0} registruje přibližně <strong>{fmtNum(prodejeTech.traktory)} nových traktorů</strong> ({prodejeTech.rok}){prodejeTech.poradi === 1 ? <> — <strong>největší národní trh se zemědělskou technikou</strong> v našem přehledu</> : prodejeTech.poradi ? <> ({prodejeTech.poradi}. největší trh z {prodejeTech.poradiZCelku} sledovaných)</> : null}.{prodejeZnacky.length > 0 ? ` Nejsilnější značky: ${prodejeZnacky.join(', ')}.` : ''} <a href="/data/prodeje-techniky/">Prodeje zemědělské techniky v Evropě →</a>
            </p>
          )}
          {akcieZeme.length > 0 && (
            <p class="svet-method">
              Veřejně obchodované zemědělské firmy se sídlem {loc0}: {akcieZeme.map((a, i) => (<>{i > 0 ? ', ' : ''}<a href={`/akcie/${a.ticker}/`}>{a.nazev.split(' (')[0]}</a></>))}. <a href="/akcie/">Akcie agro firem na burze →</a>
            </p>
          )}
        </div>
      </section>
    )}

    <section class="svet-section">
      <header class="svet-section-head"><h2>{L.method}</h2></header>
      <p class="svet-method">{L.methodP}</p>
      <p class="svet-method"><a href={localizePath(locale, '/svet/srovnani/')}>{L.compare}</a></p>
    </section>
  </main>
</Layout>
