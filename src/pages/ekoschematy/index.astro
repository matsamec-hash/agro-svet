---
// src/pages/ekoschematy/index.astro
// PL-only landing: ekoschematy (eco-schemes) — stawki 2025, system punktowy,
// tabele praktyk. Jurisdykčně vázané na PL → obsah přímo polsky (mirror doplaty).
// SSR (prerender=false): middleware rewrite /pl/... → cs-root routa s locale=pl.
// Non-pl locale → 404. Souvisí s /pl/doplaty-bezposrednie (přímé platby).
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { localizePath } from '../../i18n/utils';

const locale = Astro.locals.locale ?? 'cs';
if (locale !== 'pl') return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

// ── Oficjalne stawki ekoschematów obszarowych 2025 (ARiMR / MRiRW) ──
// Źródło: gov.pl/web/rolnictwo — „Stawki płatności bezpośrednich za 2025 r. -
// aktualizacja", Tabela 2 (Tabela_-_stawki.pdf). Kurs EBC 30.09.2025 = 4,2698 zł/EUR.
const KURS = '4,2698';
const PKT = '87,52'; // wartość ~1 pkt w Rolnictwie węglowym 2025 (5 pkt = 437,60 zł/ha)
type Row = { name: string; v: number; note?: string };

// Rolnictwo węglowe i zarządzanie składnikami odżywczymi (system punktowy, praktyki)
const weglowe: Row[] = [
  { name: 'Ekstensywne użytkowanie TUZ z obsadą zwierząt', v: 437.60 },
  { name: 'Międzyplony ozime lub wsiewki śródplonowe', v: 437.60 },
  { name: 'Zróżnicowana struktura upraw', v: 233.13 },
  { name: 'Wymieszanie obornika na gruntach ornych (do 12 h)', v: 175.04 },
  { name: 'Nawozy naturalne płynne — inne metody niż rozbryzgowo', v: 262.56 },
  { name: 'Uproszczone systemy uprawy', v: 262.56 },
  { name: 'Wymieszanie słomy z glebą', v: 87.52 },
  { name: 'Plan nawożenia — wariant podstawowy', v: 87.52 },
  { name: 'Plan nawożenia — wariant z wapnowaniem', v: 262.56 },
];

// Pozostałe ekoschematy obszarowe (stawki ryczałtowe zł/ha)
const pozostale: Row[] = [
  { name: 'Obszary z roślinami miododajnymi', v: 931.07 },
  { name: 'Integrowana Produkcja Roślin — sadownicza', v: 1185.24 },
  { name: 'Integrowana Produkcja Roślin — jagodowa', v: 1069.41 },
  { name: 'Integrowana Produkcja Roślin — warzywna', v: 1069.41 },
  { name: 'Integrowana Produkcja Roślin — rolnicza', v: 505.18 },
  { name: 'Biologiczna ochrona — mikrobiologiczne środki ochrony roślin', v: 310.88 },
  { name: 'Biologiczna ochrona — nawozowe produkty mikrobiologiczne', v: 87.52 },
  { name: 'Retencjonowanie wody na trwałych użytkach zielonych', v: 245.98, note: 'dodatkowo do ekstensywnego TUZ' },
  { name: 'Grunty wyłączone z produkcji', v: 437.57 },
  { name: 'Materiał siewny kwalifikowany — zboża', v: 104.15 },
  { name: 'Materiał siewny kwalifikowany — rośliny strączkowe', v: 168.93 },
  { name: 'Materiał siewny kwalifikowany — ziemniaki', v: 436.76 },
];

const fmt = (v: number) => v.toLocaleString('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const maxWeglowe = Math.max(...weglowe.map((r) => r.v));
const lastUpdated = new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = 'https://agro-svet.cz/pl/ekoschematy/';

const faq = [
  { q: 'Ile wynoszą stawki ekoschematów w 2025 roku?', a: `Stawki zależą od praktyki. Najwyższą stawkę ma Integrowana Produkcja Roślin sadownicza (${fmt(1185.24)} zł/ha) oraz Obszary z roślinami miododajnymi (${fmt(931.07)} zł/ha). W Rolnictwie węglowym najwyżej punktowane praktyki (ekstensywne TUZ, międzyplony) dają ${fmt(437.60)} zł/ha.` },
  { q: 'Jak działa system punktowy w Rolnictwie węglowym?', a: `Rolnictwo węglowe i zarządzanie składnikami odżywczymi działa punktowo — za każdą praktykę rolnik otrzymuje punkty, a rolnik musi zrealizować praktyki za co najmniej 25% liczby punktów odpowiadającej powierzchni gospodarstwa. Wartość 1 punktu za 2025 r. to ok. ${PKT} zł.` },
  { q: 'Czy ekoschematy łączą się z dopłatami bezpośrednimi?', a: 'Tak. Ekoschematy są dodatkową, dobrowolną płatnością obszarową doliczaną do podstawowego wsparcia dochodów (PWD) i pozostałych płatności bezpośrednich. Część praktyk można łączyć na tej samej powierzchni.' },
  { q: 'Jakie są stawki ekoschematu Dobrostan zwierząt?', a: 'Ekoschemat Dobrostan zwierząt również działa w systemie punktowym, ale jego stawki za 2025 r. zostały ustalone odrębnym rozporządzeniem w późniejszym terminie. Wartość punktu wynosi ok. 80,83 zł.' },
  { q: 'Jaki kurs euro zastosowano do przeliczenia stawek?', a: `Stawki przeliczono po kursie referencyjnym EBC z 30 września 2025 r., który wyniósł ${KURS} zł/EUR.` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `https://agro-svet.cz${localizePath('pl', '/')}` },
        { '@type': 'ListItem', position: 2, name: 'Ekoschematy', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Layout
  title="Ekoschematy 2025 — stawki płatności (zł/ha)"
  description={`Aktualne stawki ekoschematów obszarowych ARiMR za 2025 r.: Rolnictwo węglowe, Integrowana Produkcja Roślin, Obszary z roślinami miododajnymi, Biologiczna ochrona, retencja wody. Pełna tabela stawek zł/ha i system punktowy.`}
  noHreflang={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="db">
    <div class="db-wrap">
      <nav class="db-crumb" aria-label="Ścieżka nawigacji">
        <a href={localizePath('pl', '/')}>Strona główna</a>
        <span>/</span>
        <b>Ekoschematy</b>
      </nav>

      <header class="db-head">
        <span class="db-eyebrow">Ekoschematy obszarowe ARiMR · rok 2025</span>
        <h1>Ekoschematy 2025 — stawki</h1>
        <p class="db-lead">
          Ekoschematy to dobrowolne, dodatkowe płatności obszarowe za praktyki korzystne dla klimatu,
          gleby i środowiska — doliczane do <a href={localizePath('pl', '/doplaty-bezposrednie/')}>dopłat bezpośrednich</a>.
          Poniżej oficjalne stawki za 2025 r. (kurs EBC {KURS} zł/EUR) oraz zasady systemu punktowego.
        </p>
      </header>

      <section class="db-hero-stats" aria-label="Najwyższe stawki 2025">
        <div class="db-stat db-stat--hl">
          <span class="l">Integrowana Produkcja — sadownicza</span>
          <span class="v">{fmt(1185.24)} <small>zł/ha</small></span>
          <span class="d">najwyższa stawka</span>
        </div>
        <div class="db-stat">
          <span class="l">Rośliny miododajne</span>
          <span class="v">{fmt(931.07)} <small>zł/ha</small></span>
          <span class="d">obszary pszczele</span>
        </div>
        <div class="db-stat">
          <span class="l">Wartość 1 punktu</span>
          <span class="v">~{PKT} <small>zł/pkt</small></span>
          <span class="d">Rolnictwo węglowe</span>
        </div>
      </section>

      <!-- ── Rolnictwo węglowe ── -->
      <section class="db-tables" aria-labelledby="w-h">
        <h2 id="w-h">Rolnictwo węglowe i zarządzanie składnikami odżywczymi</h2>
        <p class="db-calc-sub">System punktowy: rolnik realizuje praktyki za min. 25% liczby punktów wynikającej
          z powierzchni gospodarstwa. Stawki poszczególnych praktyk (zł/ha):</p>
        <div class="db-tblcard">
          <div class="db-tblscroll">
            <table class="db-tbl">
              <thead><tr><th>Praktyka</th><th class="num">Stawka 2025</th><th></th></tr></thead>
              <tbody>
                {weglowe.map((r) => (
                  <tr>
                    <td><span class="db-tbl-name">{r.name}</span>{r.note && <span class="db-tbl-note">{r.note}</span>}</td>
                    <td class="num strong">{fmt(r.v)} <span class="unit">zł/ha</span></td>
                    <td class="bar"><span style={`width:${Math.round((r.v / maxWeglowe) * 100)}%`}></span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ── Pozostałe ekoschematy ── -->
      <section class="db-tables" aria-labelledby="p-h">
        <h2 id="p-h">Pozostałe ekoschematy obszarowe</h2>
        <div class="db-tblcard">
          <div class="db-tblscroll">
            <table class="db-tbl">
              <thead><tr><th>Ekoschemat / wariant</th><th class="num">Stawka 2025</th><th>Jedn.</th></tr></thead>
              <tbody>
                {pozostale.map((r) => (
                  <tr>
                    <td><span class="db-tbl-name">{r.name}</span>{r.note && <span class="db-tbl-note">{r.note}</span>}</td>
                    <td class="num strong">{fmt(r.v)}</td>
                    <td class="unit">zł/ha</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="db-tbl-src">Ekoschemat <strong>Dobrostan zwierząt</strong> działa punktowo (ok. 80,83 zł/pkt);
          stawki za 2025 r. ustalono odrębnym rozporządzeniem. Kurs EBC: {KURS} zł/EUR.</p>
      </section>

      <!-- ── FAQ ── -->
      <section class="db-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Najczęstsze pytania</h2>
        {faq.map((f) => (
          <details class="db-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="db-related">
        <a href={localizePath('pl', '/doplaty-bezposrednie/')}>→ Dopłaty bezpośrednie 2025 — stawki podstawowe</a>
      </div>

      <footer class="db-src">
        <p>Źródło danych: <a href="https://www.gov.pl/web/rolnictwo" target="_blank" rel="noopener">MRiRW / ARiMR</a> — oficjalne stawki płatności w ramach ekoschematów obszarowych za 2025 r. (aktualizacja). Ostatnia aktualizacja: <strong>{lastUpdated}</strong>.</p>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .db{--yellow:#FFEA00;--yellow-d:#FFD400;--ink:#0A0A0B;--line:#E7E7EA;--muted:#6E6E76;--paper:#FBFAF3;--soft:#F5F5F2;--green:#2E9E57;
    font-family:'Chakra Petch',system-ui,sans-serif;color:var(--ink);background:#fff}
  .db-wrap{max-width:1000px;margin:0 auto;padding:26px 28px 72px}
  .db a{color:inherit}
  .db-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .db-crumb a{text-decoration:none}.db-crumb a:hover{color:var(--ink);text-decoration:underline}
  .db-crumb b{color:var(--ink)}

  .db-head{padding-bottom:22px;border-bottom:2px solid var(--ink)}
  .db-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .db-head h1{font-size:44px;letter-spacing:-.03em;font-weight:800;margin:8px 0 12px;line-height:1.02}
  .db-lead{font-size:15.5px;line-height:1.6;color:#2A2A2F;max-width:80ch}
  .db-lead a{text-decoration:underline;text-decoration-color:var(--yellow-d);text-decoration-thickness:2px}

  .db-hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
  .db-stat{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px}
  .db-stat--hl{background:var(--yellow);border-color:var(--yellow-d)}
  .db-stat .l{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .db-stat--hl .l{color:#5c5300}
  .db-stat .v{font-size:28px;font-weight:800;letter-spacing:-.02em}
  .db-stat .v small{font-size:14px;color:var(--muted);font-weight:600}
  .db-stat--hl .v small{color:#5c5300}
  .db-stat .d{font-size:12px;color:var(--muted)}
  .db-stat--hl .d{color:#5c5300}

  .db h2{font-size:23px;letter-spacing:-.02em;font-weight:800;margin:36px 0 6px}
  .db-calc-sub{font-size:14px;color:var(--muted);margin:0 0 14px;max-width:75ch}

  .db-tblcard{margin-top:14px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .db-tblscroll{overflow-x:auto}
  .db-tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .db-tbl th,.db-tbl td{padding:11px 16px;text-align:left;border-bottom:1px solid var(--line)}
  .db-tbl th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-tbl th.num,.db-tbl td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .db-tbl tr:last-child td{border-bottom:0}
  .db-tbl-name{display:block;font-weight:700}
  .db-tbl-note{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .db-tbl td.strong{font-weight:800}
  .db-tbl td .unit,.db-tbl td.unit{color:var(--muted);font-size:12px;font-weight:600}
  .db-tbl td.bar{width:120px;padding-left:0}
  .db-tbl td.bar span{display:block;height:8px;border-radius:4px;background:var(--yellow-d)}
  .db-tbl-src{font-size:12.5px;color:var(--muted);margin-top:12px;line-height:1.5}

  .db-faq{margin-top:8px}
  .db-q{border:1px solid var(--line);border-radius:12px;padding:2px 18px;margin-top:10px;background:#fff}
  .db-q summary{font-weight:700;font-size:15px;padding:13px 0;cursor:pointer;list-style:none}
  .db-q summary::-webkit-details-marker{display:none}
  .db-q summary::after{content:'+';float:right;color:var(--muted);font-weight:700}
  .db-q[open] summary::after{content:'–'}
  .db-q p{font-size:14px;line-height:1.6;color:#2A2A2F;margin:0 0 14px}

  .db-related{margin-top:26px}
  .db-related a{font-weight:700;font-size:15px;color:var(--ink);border-bottom:2px solid var(--yellow);padding-bottom:2px;text-decoration:none}
  .db-related a:hover{background:var(--yellow)}

  .db-src{margin-top:28px;padding:18px 20px;background:var(--paper);border:1px solid var(--line);border-radius:14px}
  .db-src p{font-size:13px;color:#2A2A2F;line-height:1.55;margin:0}
  .db-src a{text-decoration:underline}

  @media(max-width:720px){
    .db-head h1{font-size:32px}
    .db-hero-stats{grid-template-columns:1fr}
    .db-tbl td.bar{display:none}
  }
</style>
