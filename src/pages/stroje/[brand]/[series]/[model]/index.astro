---
export const prerender = false;
import Layout from '../../../../../layouts/Layout.astro';
import { getAllBrands, getAllModels, getSeries, seriesFamily, familyLabel, categoryLabel, type StrojKategorie, type StrojModel } from '../../../../../lib/stroje';
import { createServerClient } from '../../../../../lib/supabase';
import { breadcrumbSchema, machineProductSchema, machineAggregateOfferSchema, faqPageSchema, videoObjectSchema } from '../../../../../lib/structured-data';
import { encUrlForStrojeSlug } from '../../../../../lib/machine-crosslink';
import { tierListsForModel } from '../../../../../lib/tier-lists';
import MachineVideo from '../../../../../components/MachineVideo.astro';
import MachineGallery from '../../../../../components/MachineGallery.astro';
import Anketa from '../../../../../components/Anketa.astro';
import { generateModelFaq } from '../../../../../lib/faq-generator';
import { findCompetitors, useCaseDescription } from '../../../../../lib/competitor-finder';
import { pairCombo } from '../../../../../lib/comparator';
import { useTranslations, getLocaleFromUrl, tf, plural, localizePath, localizeInternalHref, bcp47 } from '../../../../../i18n/utils';

const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);
// ‼️ Redakční detail modelu (overview / reliability / common_faults / pros /
// cons / for_whom / used_price) žije v základních datech POUZE česky a žádný
// locale pro něj nemá overlay. Pro čerstvě launchnutou němčinu ho proto
// neukazujeme — radši chybějící blok než český odstavec pod německým nadpisem.
// Ceny navíc nesou Kč a odkazují na český bazar, což pro DE/AT nedává smysl.
// sk/uk/pl to zobrazují dál (je to tak měsíce živé a indexované); až vznikne
// jejich overlay, pusť to sem všem najednou.
const showCsEditorial = locale !== 'de';

export async function getStaticPaths() {
  const paths: { params: { brand: string; series: string; model: string }; props: { modelSlug: string } }[] = [];
  for (const brand of getAllBrands()) {
    for (const cat of Object.values(brand.categories || {})) {
      for (const s of cat.series || []) {
        for (const m of s.models || []) {
          const short = m.slug.startsWith(brand.slug + '-') ? m.slug.slice(brand.slug.length + 1) : m.slug;
          paths.push({
            params: { brand: brand.slug, series: s.slug, model: short },
            props: { modelSlug: m.slug },
          });
        }
      }
    }
  }
  return paths;
}

const { brand: brandSlug, series: seriesSlug, model: modelParam } = Astro.params;
const { modelSlug: modelSlugFromProps } = (Astro.props ?? {}) as { modelSlug?: string };
const found = getSeries(brandSlug!, seriesSlug!, locale);
if (!found) return Astro.rewrite('/404');
const { brand, category, series } = found;
// SSR: props is empty (getStaticPaths not invoked), resolve from URL param.
// Match against full slug (e.g. "john-deere-6195m") or short ("6195m").
const candidate = modelSlugFromProps ?? modelParam ?? '';
const model: StrojModel | undefined = series.models.find(
  (m) => m.slug === candidate || m.slug === `${brand.slug}-${candidate}`,
);
if (!model) return Astro.rewrite('/404');

// Edge cache 1h s-maxage + 24h SWR — model detail only changes on YAML/bazar updates.
Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=3600, stale-while-revalidate=86400');

const categoryLabels: Record<StrojKategorie, string> = {
  traktory: tr('cat.label.traktory'),
  kombajny: tr('cat.label.kombajny'),
};
const categorySingular: Record<StrojKategorie, string> = {
  traktory: tr('cat.s.d.singular.traktory'),
  kombajny: tr('cat.s.d.singular.kombajny'),
};
// Popisek kategorie pro tag/alt: lokalizovaný traktory/kombajny, u nářadí fallback
// na kanonický CZ název efektivní subkategorie (dřív prázdný tag).
const catDisplayLabel = categoryLabels[category] ?? categoryLabel(series.subcategory ?? category, locale);
const categoryHero: Record<StrojKategorie, string> = {
  traktory: '/images/traktor.webp',
  kombajny: '/images/kombajn.webp',
};

const brandColors: Record<string, [string, string]> = {
  'john-deere': ['#4A9838', '#2E6B22'],
  fendt: ['#3FA85D', '#0E6730'],
  claas: ['#9C9532', '#65601A'],
  'deutz-fahr': ['#2BA84A', '#1a5e2a'],
  kubota: ['#FF6B1A', '#C24414'],
  'new-holland': ['#3874AC', '#1A4370'],
  'case-ih': ['#D62A2A', '#8F1818'],
  'massey-ferguson': ['#D62A2A', '#8F1818'],
  valtra: ['#1F1F1F', '#0A0A0A'],
  zetor: ['#E93A3A', '#A01818'],
};
const [brandC1, brandC2] = brandColors[brand.slug] ?? ['#2a2a30', '#0a0a0b'];

// Live count + cenové rozpětí inzerátů tohoto konkrétního modelu (naplňuje slib „cena")
let modelBazarCount = 0;
let priceStats: { min: number; max: number; count: number } | null = null;
try {
  const supabase = createServerClient();
  const { data, count } = await supabase
    .from('bazar_listings')
    .select('price', { count: 'exact' })
    .eq('status', 'active')
    .eq('model_slug', model.slug);
  modelBazarCount = count ?? 0;
  const prices = (data ?? [])
    .map((r: { price: number | null }) => r.price)
    .filter((p): p is number => typeof p === 'number' && p > 0);
  if (prices.length > 0) {
    priceStats = { min: Math.min(...prices), max: Math.max(...prices), count: prices.length };
  }
} catch {}
const priceFmt = (n: number) => n.toLocaleString(bcp47(locale));

const family = series.family || seriesFamily(series.slug);
const familyLab = familyLabel(family, locale);

const yr = model.year_from ? (model.year_to ? `${model.year_from}–${model.year_to}` : `${model.year_from}–${tr('cat.rada.dosud')}`) : '';
const isCurrent = model.year_to === null && model.year_from !== null;
const seriesNameClean = String(series.name).replace(/\s*\([^)]*\)\s*$/, '');
const seriesYr = series.year_from ? (series.year_to ? `${series.year_from}–${series.year_to}` : `${series.year_from}–${tr('cat.rada.dosud')}`) : '';

// Related models: same series first, then backfilled with same-brand + same-category
// models from OTHER series — so even small series always surface ~6 internal model
// links (denser internal graph → víc odkazové síly na high-impression stránky).
type RelatedItem = { slug: string; name: string; power_hp: number | null; year_from: number | null; year_to: number | null; series_slug: string };
const byPowerProximity = (a: RelatedItem, b: RelatedItem) =>
  Math.abs((a.power_hp ?? 0) - (model.power_hp ?? 0)) - Math.abs((b.power_hp ?? 0) - (model.power_hp ?? 0));
const relatedSameSeries: RelatedItem[] = series.models
  .filter((m) => m.slug !== model.slug)
  .map((m) => ({ slug: m.slug, name: m.name, power_hp: m.power_hp, year_from: m.year_from, year_to: m.year_to, series_slug: series.slug }));
const related: RelatedItem[] = relatedSameSeries.sort(byPowerProximity).slice(0, 6);
if (related.length < 6) {
  const backfill: RelatedItem[] = getAllModels(locale)
    .filter((m) => m.brand_slug === brand.slug && m.effective_category === (series.subcategory ?? category) && m.series_slug !== series.slug)
    .map((m) => ({ slug: m.slug, name: m.name, power_hp: m.power_hp, year_from: m.year_from, year_to: m.year_to, series_slug: m.series_slug }));
  related.push(...backfill.sort(byPowerProximity).slice(0, 6 - related.length));
}
const relatedBroadened = related.some((m) => m.series_slug !== series.slug);

function modelUrlPart(slug: string): string {
  return slug.startsWith(brand.slug + '-') ? slug.slice(brand.slug.length + 1) : slug;
}

// Build categorized spec rows
type SpecRow = { label: string; value: string };
const performanceSpecs: SpecRow[] = [];
const drivetrainSpecs: SpecRow[] = [];
const dimensionSpecs: SpecRow[] = [];
const otherSpecs: SpecRow[] = [];

const numLocale = bcp47(locale);
if (model.power_hp) performanceSpecs.push({ label: tr('cat.s.d.specPower'), value: `${model.power_hp} k${model.power_kw ? ` (${model.power_kw} kW)` : ''}` });
if (model.engine) drivetrainSpecs.push({ label: tr('cat.s.d.specEngine'), value: model.engine });
if (model.transmission) drivetrainSpecs.push({ label: tr('cat.s.d.specTransmission'), value: model.transmission });
if (model.weight_kg) dimensionSpecs.push({ label: tr('cat.s.d.specWeight'), value: `${model.weight_kg.toLocaleString(numLocale)} kg` });
if (model.cutting_width_m) dimensionSpecs.push({ label: tr('cat.s.d.specCuttingWidth'), value: `${model.cutting_width_m} m` });
if (model.grain_tank_l) dimensionSpecs.push({ label: tr('cat.s.d.specGrainTank'), value: `${model.grain_tank_l.toLocaleString(numLocale)} l` });
// Implement-specific typed fieldy (pluhy/nářadí) — dřív jen ve FAQ, teď i ve spec tabulce.
if (model.pracovni_zaber_m) dimensionSpecs.push({ label: tr('cat.s.d.specZaber'), value: `${model.pracovni_zaber_m} m` });
if (model.prikon_traktor_hp_min || model.prikon_traktor_hp_max) {
  const pMin = model.prikon_traktor_hp_min, pMax = model.prikon_traktor_hp_max;
  const pRange = pMin && pMax ? `${pMin}–${pMax}` : String(pMin ?? pMax);
  performanceSpecs.push({ label: tr('cat.s.d.specPrikonTraktor'), value: `${pRange} ${tr('cmp.unitHp')}` });
}
if (yr) performanceSpecs.push({ label: tr('cat.s.d.specYears'), value: yr });

if (model.specs) {
  const specGroups: Record<string, 'perf' | 'drive' | 'dim' | 'other'> = {
    hydraulika_l_min: 'drive',
    zadni_zaves_kg: 'dim',
    predni_zaves_kg: 'dim',
    emise: 'drive',
    kabina: 'other',
  };
  const specLabels: Record<string, string> = {
    hydraulika_l_min: tr('cat.s.d.specHydraulika'),
    zadni_zaves_kg: tr('cat.s.d.specZadniZaves'),
    predni_zaves_kg: tr('cat.s.d.specPredniZaves'),
    emise: tr('cat.s.d.specEmise'),
    kabina: tr('cat.s.d.specKabina'),
  };
  const specUnits: Record<string, string> = {
    hydraulika_l_min: ' l/min',
    zadni_zaves_kg: ' kg',
    predni_zaves_kg: ' kg',
  };
  for (const [k, v] of Object.entries(model.specs)) {
    if (v === null || v === undefined || v === '') continue;
    const label = specLabels[k] ?? k.replace(/_/g, ' ');
    const unit = specUnits[k] ?? '';
    const formatted = typeof v === 'number' ? v.toLocaleString(numLocale) + unit : String(v);
    const row = { label, value: formatted };
    const grp = specGroups[k] ?? 'other';
    if (grp === 'perf') performanceSpecs.push(row);
    else if (grp === 'drive') drivetrainSpecs.push(row);
    else if (grp === 'dim') dimensionSpecs.push(row);
    else otherSpecs.push(row);
  }
}

const totalSpecCount = performanceSpecs.length + drivetrainSpecs.length + dimensionSpecs.length + otherSpecs.length;

const heroPhoto = series.image_url || categoryHero[category] || '/images/traktor.webp';
const heroCreditUrl: string | null = series.image_url ? (series.image_credit_url || null) : null;
const heroCreditAuthor: string | null = series.image_url ? (series.image_credit || null) : null;
const heroCreditLicense: string | null = series.image_url ? (series.image_license || null) : null;
const heroCreditTitle = tf(locale, 'cat.s.d.photoTitle', { author: heroCreditAuthor ?? '', license: heroCreditLicense ? ` (${heroCreditLicense})` : '' });
const heroCreditTextRaw = tf(locale, 'cat.s.d.photoCredit', { author: heroCreditAuthor ?? '', license: heroCreditLicense ? ` · ${heroCreditLicense}` : '' });
const heroCreditText = '\n' + heroCreditTextRaw + '\n';
const wholeSeriesText = '\n' + tf(locale, 'cat.s.d.wholeSeries', { series: seriesNameClean }) + ' ';
const compareLinkText = '\n' + tr('cat.s.d.compareLink') + '\n';
const ebProcessedText = '\n' + tr('cat.s.d.ebProcessed') + ' ';

const pageTitle = `${brand.name} ${model.name}`;
// Spec-led meta description pro modely s úplnou spec sadou (singular + výkon + roky = traktory/kombajny)
// — trefuje hledané „technické údaje / cena" líp než náhodných 160 znaků prózy. Ostatní kategorie
// (pluhy/lisy/nakladače bez výkonu) si drží prózu, jinak by šablona dala „undefined, výkon ? k".
const specLedDesc = categorySingular[category] && model.power_hp && yr;
const pageDesc = (
  specLedDesc
    ? tf(locale, 'cat.s.d.descFallback', { title: pageTitle, singular: categorySingular[category], power: model.power_hp, years: yr })
    // Kategorie bez spec sady (pluhy/lisy/nakladače): próza modelu → série → aspoň název.
    // Nikdy ne descFallback s „výkon ? k, roky výroby ." placeholdery.
    : (model.description || series.description || pageTitle)
).replace(/\s+/g, ' ').trim().slice(0, 160);

const canonical = `https://agro-svet.cz${localizePath(locale, `/stroje/${brand.slug}/${series.slug}/${modelUrlPart(model.slug)}/`)}`;
const breadcrumbJsonLd = breadcrumbSchema([
  { name: tr('cat.bc.home'), url: localizePath(locale, '/') },
  { name: tr('cat.bc.tech'), url: localizePath(locale, '/stroje/') },
  { name: brand.name, url: localizePath(locale, `/stroje/${brand.slug}/`) },
  { name: seriesNameClean, url: localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`) },
  { name: model.name, url: canonical },
]);
// Redakční recenze téhož modelu v encyklopedii (jen 42 modelů; jen pokud v tomto
// locale existuje). Odkaz + sameAs rozlišuje intent: tato stránka = data, enc = recenze.
const reviewUrl = await encUrlForStrojeSlug(model.slug, locale);
const reviewHref = reviewUrl ? localizePath(locale, reviewUrl) : null;
const productJsonLd = machineProductSchema({
  brandName: brand.name,
  brandSlug: brand.slug,
  seriesName: seriesNameClean,
  modelName: model.name,
  modelSlug: model.slug,
  category,
  url: canonical,
  description: model.description ?? undefined,
  imageUrl: heroPhoto,
  powerHp: model.power_hp,
  powerKw: model.power_kw,
  weightKg: model.weight_kg,
  yearFrom: model.year_from,
  yearTo: model.year_to,
  engine: model.engine,
  transmission: model.transmission,
  lang: bcp47(locale),
  sameAs: reviewHref ?? undefined,
  galleryImageUrls: (model.gallery ?? []).map((p) => p.src).filter(Boolean),
});

// Média: YouTube embed (facade + VideoObject) a foto galerie s atribucí. Vše volitelné.
const galleryPhotos = (model.gallery ?? []).filter((p) => p && p.src);
const videoJsonLd = model.youtube_id
  ? videoObjectSchema({
      youtubeId: model.youtube_id,
      name: model.youtube_title ?? `${brand.name} ${model.name} — video`,
      description: (showCsEditorial ? model.overview : undefined) || model.description || `${brand.name} ${model.name}`,
      pageUrl: canonical,
    })
  : null;

// Product + AggregateOffer jen když má model inzeráty s cenou (naplňuje slib „cena").
const bazarSearchUrl = `/bazar/?brand=${encodeURIComponent(brand.slug)}&category=${category}&q=${encodeURIComponent(model.name)}`;
const offerJsonLd = priceStats
  ? machineAggregateOfferSchema(
      { name: `${brand.name} ${model.name}`, url: canonical, offerUrl: bazarSearchUrl, imageUrl: heroPhoto, brandName: brand.name },
      priceStats,
    )
  : null;

const faqItems = generateModelFaq({
  brand,
  model,
  category,
  categorySingular: categorySingular[category],
  bazarCount: modelBazarCount,
  priceStats,
  locale,
});
const faqJsonLd = faqItems ? faqPageSchema(faqItems) : null;

// Competitors — cross-brand models in same category within ±15% power.
const competitors = findCompetitors({
  slug: model.slug,
  brand_slug: brand.slug,
  category,
  power_hp: model.power_hp,
  year_to: model.year_to,
}, { limit: 6, locale });

// Use-case description from data (no hand-written content per model).
// ‼️ Bez locale → funkce má polské znění připravené, ale vždy vracela cs.
// /pl/stroje/<b>/<s>/<m>/ tak ukazovalo „Středně výkonná sklízecí mlátička…".
const useCase = useCaseDescription(category, model.power_hp, locale);


// Žebříčky, kde se model umístil — cross-link datová vrstva → redakční žebříčky.
// Jen cs (žebříčky nejsou lokalizované). Odkaz + umístění posiluje vnitřní síť.
const tierPlacements = locale === 'cs' ? tierListsForModel(model.slug) : [];

function competitorUrlPart(competitor: { slug: string; brand_slug: string }): string {
  return competitor.slug.startsWith(competitor.brand_slug + '-')
    ? competitor.slug.slice(competitor.brand_slug.length + 1)
    : competitor.slug;
}
---

<Layout title={tf(locale, modelBazarCount > 0 ? 'cat.s.d.titleSuffix' : 'cat.s.d.titleSuffixNoPrice', { name: pageTitle })} description={pageDesc} canonical={canonical} ogImage={heroPhoto} ogType="product">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(productJsonLd)} />
  {offerJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(offerJsonLd)} />}
  {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
  {videoJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(videoJsonLd)} />}
  <div class="model-page">

    <nav class="breadcrumb" aria-label={tr('cat.s.d.bcAria')}>
      <a href={localizePath(locale, '/')}>{tr('cat.bc.home')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, '/stroje/')}>{tr('cat.bc.tech')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, `/stroje/${brand.slug}/`)}>{brand.name}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`)}>{seriesNameClean}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <span class="current">{model.name}</span>
    </nav>

    <section class="hero" style={`--brand-c1:${brandC1};--brand-c2:${brandC2};`}>
      <div class="hero-left">
        <div class="hero-tags">
          <span class="tag tag-brand">{brand.name}</span>
          <span class="tag tag-cat">{catDisplayLabel}</span>
          <span class="tag tag-series">{seriesNameClean}</span>
          {isCurrent ? (
            <span class="tag tag-current"><span class="dot"></span>{tr('cat.s.d.tagCurrent')}</span>
          ) : (
            <span class="tag tag-legacy">{tr('cat.s.d.tagLegacy')}</span>
          )}
        </div>
        <h1>{model.name}</h1>
        {yr && <div class="hero-year">{yr}</div>}

        {model.power_hp && (
          <div class="power-pill">
            <span class="pp-num">{model.power_hp}</span>
            <span class="pp-unit">{tr('cmp.unitHp')}</span>
            {model.power_kw && <span class="pp-kw">· {model.power_kw} kW</span>}
          </div>
        )}

        {(showCsEditorial ? (model.overview || model.description) : model.description) && <p class="hero-lede">{showCsEditorial ? (model.overview || model.description) : model.description}</p>}

        <div class="hero-actions">
          <a class="cta-primary" href={`/bazar/?brand=${encodeURIComponent(brand.slug)}&category=${category}&q=${encodeURIComponent(model.name)}`}>
            {modelBazarCount > 0
              ? tf(locale, 'cat.s.d.bazarCount', { count: modelBazarCount, unit: plural(locale, modelBazarCount, { one: tr('cat.s.d.adOne'), few: tr('cat.s.d.adFew'), many: tr('cat.s.d.adMany') }) })
              : tf(locale, 'cat.s.d.bazarSearch', { model: model.name })}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="cta-secondary" href={localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`)}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>{wholeSeriesText}</a>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-photo">
          <img
            class="hero-photo-img"
            src={heroPhoto}
            alt={tf(locale, 'cat.s.d.altPhoto', { model: model.name, category: catDisplayLabel })}
            width="800"
            height="600"
            fetchpriority="high"
            decoding="async"
          />
          <div class="hero-photo-badge">
            <span class="n">{model.name}</span>
            {model.power_hp && <span class="pwr">{model.power_hp} {tr('cmp.unitHp')}</span>}
          </div>
          {heroCreditAuthor && heroCreditUrl && (
            <a class="hero-photo-credit" href={heroCreditUrl} target="_blank" rel="noopener noreferrer"
               title={heroCreditTitle}>{heroCreditText}</a>
          )}
        </div>
      </div>
    </section>

    <div class="content-grid">
      <div class="content-main">
        {galleryPhotos.length > 0 && (
          <MachineGallery
            photos={galleryPhotos}
            heading={tf(locale, 'cat.s.d.galleryHeading', { model: model.name })}
            altFallback={tf(locale, 'cat.s.d.altPhoto', { model: model.name, category: catDisplayLabel })}
            sourceLabel={tr('cat.s.d.gallerySource')}
          />
        )}
        {model.youtube_id && (
          <MachineVideo
            youtubeId={model.youtube_id}
            title={model.youtube_title ?? `${brand.name} ${model.name}`}
            heading={tf(locale, 'cat.s.d.videoHeading', { model: model.name })}
            playLabel={tr('cat.s.d.videoPlay')}
            previewLabel={tr('cat.s.d.videoPreview')}
            note={tr('cat.s.d.videoNote')}
          />
        )}
        {totalSpecCount > 0 ? (
          <section class="spec-card">
            <div class="card-head">
              <h2>{tr('cat.s.d.specTitle')}</h2>
              <span class="card-head-meta">{totalSpecCount} {plural(locale, totalSpecCount, { one: tr('cat.s.d.specCountOne'), few: tr('cat.s.d.specCountFew'), many: tr('cat.s.d.specCountMany') })}</span>
            </div>

            {performanceSpecs.length > 0 && (
              <div class="spec-group">
                <div class="spec-group-label">{tr('cat.s.d.groupPerf')}</div>
                <dl class="spec-list">
                  {performanceSpecs.map((row) => (
                    <div class="spec-item"><dt>{row.label}</dt><dd>{row.value}</dd></div>
                  ))}
                </dl>
              </div>
            )}

            {drivetrainSpecs.length > 0 && (
              <div class="spec-group">
                <div class="spec-group-label">{tr('cat.s.d.groupDrive')}</div>
                <dl class="spec-list">
                  {drivetrainSpecs.map((row) => (
                    <div class="spec-item"><dt>{row.label}</dt><dd>{row.value}</dd></div>
                  ))}
                </dl>
              </div>
            )}

            {dimensionSpecs.length > 0 && (
              <div class="spec-group">
                <div class="spec-group-label">{tr('cat.s.d.groupDim')}</div>
                <dl class="spec-list">
                  {dimensionSpecs.map((row) => (
                    <div class="spec-item"><dt>{row.label}</dt><dd>{row.value}</dd></div>
                  ))}
                </dl>
              </div>
            )}

            {otherSpecs.length > 0 && (
              <div class="spec-group">
                <div class="spec-group-label">{tr('cat.s.d.groupOther')}</div>
                <dl class="spec-list">
                  {otherSpecs.map((row) => (
                    <div class="spec-item"><dt>{row.label}</dt><dd>{row.value}</dd></div>
                  ))}
                </dl>
              </div>
            )}
          </section>
        ) : (
          <section class="spec-card spec-empty">
            <h2>{tr('cat.s.d.specTitle')}</h2>
            <p>{tr('cat.s.d.specEmpty')}</p>
          </section>
        )}

        {useCase && (
          <section class="usecase-card">
            <div class="card-head">
              <h2>{tf(locale, 'cat.s.d.useCaseTitle', { brand: brand.name, model: model.name })}</h2>
            </div>
            <p class="usecase-text">{useCase}</p>
          </section>
        )}

        {showCsEditorial && (model.reliability || (model.common_faults && model.common_faults.length > 0)) && (
          <section class="faults-card">
            <div class="card-head">
              <h2>{tr('cat.s.d.faultsTitle')}</h2>
            </div>
            {model.reliability && <p class="faults-lede">{model.reliability}</p>}
            {model.common_faults && model.common_faults.length > 0 && (
              <ul class="faults-list">
                {model.common_faults.map((f) => (
                  <li class="fault-item">
                    <span class="fault-issue">{f.issue}</span>
                    {f.note && <span class="fault-note">{f.note}</span>}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {showCsEditorial && ((model.pros && model.pros.length > 0) || (model.cons && model.cons.length > 0)) && (
          <section class="proscons-card">
            <div class="card-head">
              <h2>{tr('cat.s.d.prosconsTitle')}</h2>
            </div>
            <div class="pc-grid">
              {model.pros && model.pros.length > 0 && (
                <div class="pc-col pc-pros">
                  <h3>{tr('cat.s.d.prosTitle')}</h3>
                  <ul>{model.pros.map((p) => <li>{p}</li>)}</ul>
                </div>
              )}
              {model.cons && model.cons.length > 0 && (
                <div class="pc-col pc-cons">
                  <h3>{tr('cat.s.d.consTitle')}</h3>
                  <ul>{model.cons.map((c) => <li>{c}</li>)}</ul>
                </div>
              )}
            </div>
          </section>
        )}

        {showCsEditorial && model.for_whom && (
          <section class="forwhom-card">
            <div class="card-head">
              <h2>{tf(locale, 'cat.s.d.forWhomTitle', { model: model.name })}</h2>
            </div>
            <p class="forwhom-text">{model.for_whom}</p>
          </section>
        )}

        {competitors.length > 0 && (
          <section class="competitor-card">
            <div class="card-head">
              <h2>{tr('cat.s.d.compTitle')}</h2>
              <span class="card-head-meta">{competitors.length} {plural(locale, competitors.length, { one: tr('cat.s.d.compCountOne'), few: tr('cat.s.d.compCountFew'), many: tr('cat.s.d.compCountMany') })}</span>
            </div>
            <p class="competitor-lede" set:html={tr('cat.s.d.compLede')}></p>
            <div class="comp-grid">
              {competitors.map((c) => {
                const cUrl = localizePath(locale, `/stroje/${c.brand_slug}/${c.series_slug}/${competitorUrlPart(c)}/`);
                const cYr = c.year_from ? (c.year_to ? `${c.year_from}–${c.year_to}` : `${c.year_from}–${tr('cat.rada.dosud')}`) : '';
                const cIsCurrent = c.year_to === null && c.year_from !== null;
                // Compare with the source model — only meaningful when source has power data.
                const compareCombo = model.power_hp !== null ? pairCombo(model.slug, c.slug) : null;
                return (
                  <div class="comp-card-wrap">
                    <a href={cUrl} class="comp-card">
                      <div class="comp-brand">{c.brand_name}</div>
                      <div class="comp-name">
                        {c.name}
                        {cIsCurrent && <span class="dot-current" title={tr('cat.s.d.dotCurrent')}></span>}
                      </div>
                      <div class="comp-meta">
                        <span class="comp-power"><strong>{c.power_hp} {tr('cmp.unitHp')}</strong>{c.power_kw ? ` · ${c.power_kw} kW` : ''}</span>
                        {cYr && <span class="comp-year">{cYr}</span>}
                      </div>
                    </a>
                    {compareCombo && (
                      <a href={localizePath(locale, `/srovnani/${compareCombo}/`)} class="comp-compare-link" title={tf(locale, 'cat.s.d.compareTitle', { model: model.name, competitor: c.name })}>{compareLinkText}</a>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        )}

        {tierPlacements.length > 0 && (
          <section class="tier-card">
            <div class="card-head">
              <h2>Žebříčky, kde se {model.name} umístil</h2>
              <span class="card-head-meta">{tierPlacements.length} {plural(locale, tierPlacements.length, { one: 'žebříček', few: 'žebříčky', many: 'žebříčků' })}</span>
            </div>
            <div class="tier-grid">
              {tierPlacements.map((t) => (
                <a href={localizeInternalHref(locale, `/zebricky/${t.slug}/`)} class="tier-item">
                  <span class="tier-rank">{t.rank}.<span class="tier-rank-of"> z {t.total}</span></span>
                  <span class="tier-title">{t.title}</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              ))}
            </div>
          </section>
        )}

        {faqItems && (
          <section class="faq-card" aria-labelledby="faq-heading">
            <div class="card-head">
              <h2 id="faq-heading">{tr('cat.s.d.faqTitle')}</h2>
            </div>
            <dl class="faq-list">
              {faqItems.map((qa) => (
                <div class="faq-item">
                  <dt>{qa.q}</dt>
                  <dd>{qa.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {related.length > 0 && (
          <section class="related-card">
            <div class="card-head">
              <h2>{relatedBroadened ? tf(locale, 'cat.s.d.relatedTitleBroad', { brand: brand.name }) : tf(locale, 'cat.s.d.relatedTitle', { series: seriesNameClean })}</h2>
              <a class="card-head-link" href={localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`)}>{tr('cat.s.d.allModels')}</a>
            </div>
            <div class="rel-grid">
              {related.map((m) => {
                const mYr = m.year_from ? (m.year_to ? `${m.year_from}–${m.year_to}` : `${m.year_from}–${tr('cat.rada.dosud')}`) : '';
                const mIsCurrent = m.year_to === null && m.year_from !== null;
                return (
                  <a href={localizePath(locale, `/stroje/${brand.slug}/${m.series_slug}/${modelUrlPart(m.slug)}/`)} class="rel-card">
                    <div class="rel-title">
                      {m.name}
                      {mIsCurrent && <span class="dot-current" title={tr('cat.s.d.dotCurrent')}></span>}
                    </div>
                    <div class="rel-meta">
                      <span class="rel-power">
                        {m.power_hp !== null ? <><strong>{m.power_hp} {tr('cmp.unitHp')}</strong></> : '—'}
                      </span>
                      <span class="rel-year">{mYr}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <aside class="editorial-bar" aria-label={tr('enc.trust.label')}>
          <span class="eb-item">{ebProcessedText}<a href={localizePath(locale, '/redakce/')} class="eb-link">{tr('cat.s.d.ebEditorial')}</a>
          </span>
          <span class="eb-sep" aria-hidden="true">·</span>
          <span class="eb-item">{tr('cat.s.d.ebSpec')}</span>
        </aside>
      </div>

      <aside class="content-aside">
        <div class="aside-card primary-cta-card">
          <span class="acc-kicker">{modelBazarCount > 0 ? tf(locale, 'cat.s.d.asideKickerCount', { count: modelBazarCount, unit: plural(locale, modelBazarCount, { one: tr('cat.s.d.asideKickerOne'), few: tr('cat.s.d.asideKickerFew'), many: tr('cat.s.d.asideKickerMany') }) }) : tr('cat.s.d.asideKickerNone')}</span>
          <h3>{brand.name} {model.name}<br/>{tr('cat.s.d.asideInBazar')}</h3>
          {showCsEditorial && priceStats && (
            <div class="aside-price">
              <span class="ap-label">{tr('cat.s.d.priceLabel')}</span>
              <span class="ap-value">{priceStats.min === priceStats.max ? `${priceFmt(priceStats.min)} Kč` : `${priceFmt(priceStats.min)} – ${priceFmt(priceStats.max)} Kč`}</span>
            </div>
          )}
          {showCsEditorial && model.used_price && (
            <div class="aside-price aside-used-price">
              <span class="ap-label">{tr('cat.s.d.usedPriceLabel')}</span>
              <span class="ap-value">{model.used_price.min === model.used_price.max ? `${priceFmt(model.used_price.min)} Kč` : `${priceFmt(model.used_price.min)} – ${priceFmt(model.used_price.max)} Kč`}</span>
              {model.used_price.note && <span class="ap-note">{model.used_price.note}</span>}
            </div>
          )}
          <p>{modelBazarCount > 0 ? tr('cat.s.d.asideTextHas') : tr('cat.s.d.asideTextNone')}</p>
          <a href={`/bazar/?brand=${encodeURIComponent(brand.slug)}&category=${category}&q=${encodeURIComponent(model.name)}`} class="aside-btn primary">
            {modelBazarCount > 0 ? (modelBazarCount === 1 ? tr('cat.s.d.asideBtnShowOne') : tr('cat.s.d.asideBtnShowFew')) : tr('cat.s.d.asideBtnOpen')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={localizeInternalHref(locale, '/bazar/novy/')} class="aside-btn ghost-light">{tr('cat.s.d.asideAddOwn')}</a>
        </div>

        {reviewHref && (
          <a class="aside-card review-card" href={reviewHref}>
            <span class="acc-kicker">{tr('cat.s.d.reviewKicker')}</span>
            <h3>{brand.name} {model.name}<br/>{tr('cat.s.d.reviewTitle')}</h3>
            <span class="review-cta">{tr('cat.s.d.reviewBtn')}</span>
          </a>
        )}

        <div class="aside-card nav-card">
          <span class="acc-label">{tr('cat.s.d.contextLabel')}</span>
          <a href={localizePath(locale, `/stroje/${brand.slug}/`)} class="aside-link">
            <span class="al-label">{tr('cat.s.d.contextBrand')}</span>
            <span class="al-value">{brand.name}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a href={localizePath(locale, `/stroje/${brand.slug}/rada/${category}/${family}/`)} class="aside-link">
            <span class="al-label">{tr('cat.s.d.contextSeries')}</span>
            <span class="al-value">{familyLab}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
          <a href={localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`)} class="aside-link">
            <span class="al-label">{tr('cat.s.d.contextGeneration')}</span>
            <span class="al-value">{seriesNameClean}{seriesYr ? ` · ${seriesYr}` : ''}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
      </aside>
    </div>

    {locale === 'cs' && (
      <div style="max-width:760px; margin:0 auto; padding:0 24px;">
        <Anketa
          slug={`znacka-${brand.slug}`}
          question={`Doporučili byste značku ${brand.name}?`}
          options={[
            { id: 'urcite-ano', label: 'Určitě ano' },
            { id: 'spis-ano', label: 'Spíš ano' },
            { id: 'spis-ne', label: 'Spíš ne' },
            { id: 'urcite-ne', label: 'Určitě ne' },
          ]}
          note="Hlasování čtenářů · průběžné výsledky"
        />
      </div>
    )}

  </div>
</Layout>

<style>
  .model-page{
