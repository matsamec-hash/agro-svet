    border:1px solid rgba(255,255,255,.08);
    color:rgba(255,255,255,.78);text-decoration:none;
    padding:5px 9px;border-radius:7px;
    font:500 10.5px/1 'Chakra Petch',sans-serif;letter-spacing:.02em;
    max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    transition:.15s;
  }
  .model-page .hero-photo-credit:hover{background:rgba(10,10,11,.85);color:#fff;border-color:rgba(255,255,255,.18)}

  .model-page .content-grid{display:grid;grid-template-columns:1fr 320px;gap:22px}

  .model-page .content-main{display:flex;flex-direction:column;gap:22px}

  .model-page .spec-card, .model-page .related-card, .model-page .faq-card,
  .model-page .usecase-card, .model-page .competitor-card, .model-page .tier-card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--r-xl);
    padding:24px 24px 22px;box-shadow:var(--sh-1);
  }

