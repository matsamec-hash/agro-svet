---
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import { getSeries, seriesFamily, familyLabel, categoryLabel, type StrojKategorie } from '../../../../lib/stroje';
import { itemListSchema } from '../../../../lib/structured-data';
import { useTranslations, getLocaleFromUrl, tf, plural, localizePath, localizeInternalHref, bcp47 } from '../../../../i18n/utils';
import MachinePoster, { type PosterCell } from '../../../../components/MachinePoster.astro';

const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);

const { brand: brandSlug, series: seriesSlug } = Astro.params;
const found = getSeries(brandSlug!, seriesSlug!, locale);
if (!found) return Astro.rewrite('/404');
const { brand, category, series } = found;

// Edge cache 1h s-maxage + 24h SWR — series list only changes on YAML updates.
Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=3600, stale-while-revalidate=86400');

const modelPlural = (n: number) => plural(locale, n, { one: tr('cat.s.d.s.modelOne'), few: tr('cat.s.d.s.modelFew'), many: tr('cat.s.d.s.modelMany') });

const categoryLabels: Record<StrojKategorie, string> = {
  traktory: tr('cat.label.traktory'),
  kombajny: tr('cat.label.kombajny'),
};
const categoryHero: Record<StrojKategorie, string> = {
  traktory: '/images/traktor.webp',
  kombajny: '/images/kombajn.webp',
};

const family = series.family || seriesFamily(series.slug);
const familyLab = series.family_label || familyLabel(family, locale);

const yr = series.year_from ? (series.year_to ? `${series.year_from}–${series.year_to}` : `${series.year_from}–${tr('cat.rada.dosud')}`) : '';
const isCurrent = series.year_to === null && series.year_from !== null;
const seriesNameClean = String(series.name).replace(/\s*\([^)]*\)\s*$/, '');

const hpValues = series.models.map((m) => m.power_hp).filter((x): x is number => typeof x === 'number');
const minHp = hpValues.length ? Math.min(...hpValues) : null;
const maxHp = hpValues.length ? Math.max(...hpValues) : null;
const hpRange = minHp !== null && maxHp !== null
  ? (minHp === maxHp ? `${minHp} ${tr('cmp.unitHp')}` : `${minHp}–${maxHp} ${tr('cmp.unitHp')}`)
  : '';

// Pull engine/transmission from any model (typically shared within a series)
const engines = Array.from(new Set(series.models.map((m) => m.engine).filter((x): x is string => !!x)));
const transmissions = Array.from(new Set(series.models.map((m) => m.transmission).filter((x): x is string => !!x)));

const sortedModels = [...series.models].sort((a, b) => (b.power_hp ?? 0) - (a.power_hp ?? 0));
const categoryHasGrainTank = category === 'kombajny';

function modelUrlPart(slug: string): string {
  return slug.startsWith(brand.slug + '-') ? slug.slice(brand.slug.length + 1) : slug;
}

// Sibling generations in same family
const sameCategory = brand.categories?.[category];
const siblings = (sameCategory?.series ?? [])
  .filter((s) => s.slug !== series.slug && (s.family || seriesFamily(s.slug)) === family)
  .map((s) => {
    const sHpAll = (s.models ?? []).map((m) => m.power_hp).filter((x): x is number => typeof x === 'number');
    const sIsCurrent = (s.models ?? []).some((m) => m.year_to === null && m.year_from !== null);
    const sYr = s.year_from ? (s.year_to ? `${s.year_from}–${s.year_to}` : `${s.year_from}–${tr('cat.rada.dosud')}`) : '';
    return {
      slug: s.slug,
      name: s.name.replace(/\s*\([^)]*\)\s*$/, ''),
      year_from: s.year_from,
      yr: sYr,
      modelCount: (s.models ?? []).length,
      minHp: sHpAll.length ? Math.min(...sHpAll) : null,
      maxHp: sHpAll.length ? Math.max(...sHpAll) : null,
      isCurrent: sIsCurrent,
    };
  })
  .sort((a, b) => (b.year_from ?? 0) - (a.year_from ?? 0));

const heroPhoto = series.image_url || categoryHero[category] || '/images/traktor.webp';
const heroCreditUrl: string | null = series.image_credit_url || null;
const heroCreditAuthor: string | null = series.image_credit || null;
const heroCreditLicense: string | null = series.image_license || null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: tr('cat.bc.home'), item: `https://agro-svet.cz${localizePath(locale, '/')}` },
    { '@type': 'ListItem', position: 2, name: tr('cat.bc.tech'), item: `https://agro-svet.cz${localizePath(locale, '/stroje/')}` },
    { '@type': 'ListItem', position: 3, name: brand.name, item: `https://agro-svet.cz${localizePath(locale, `/stroje/${brand.slug}/`)}` },
    { '@type': 'ListItem', position: 4, name: familyLab, item: `https://agro-svet.cz${localizePath(locale, `/stroje/${brand.slug}/rada/${category}/${family}/`)}` },
    { '@type': 'ListItem', position: 5, name: seriesNameClean, item: `https://agro-svet.cz${localizePath(locale, `/stroje/${brand.slug}/${series.slug}/`)}` },
  ],
};
const modelListJsonLd = sortedModels.length > 0
  ? itemListSchema(
      sortedModels.map((m) => ({
        url: localizePath(locale, `/stroje/${brand.slug}/${series.slug}/${modelUrlPart(m.slug)}/`),
        name: `${brand.name} ${m.name}`,
      })),
      tf(locale, 'cat.s.d.s.jsonListName', { brand: brand.name, series: seriesNameClean }),
    )
  : null;

// Whitespace-bearing CTA strings precomputed to keep cs HTML byte-identical
// (avoids newline-collapse around `Czech {expr}` adjacency in JSX text nodes).
// Astro trims/normalizes whitespace around JSX text nodes; precomputed strings are
// emitted verbatim, so reproduce the exact surrounding whitespace of the original cs HTML.
const heroSearchText = '\n' + tf(locale, 'cat.s.d.s.heroSearch', { series: seriesNameClean }) + '\n';
const heroAllGenText = '\n' + tf(locale, 'cat.s.d.s.heroAllGen', { fam: familyLab }) + ' ';
const sibTitleText = tf(locale, 'cat.s.d.s.sibTitle', { fam: familyLab });
const ctaOpenText = '\n' + tr('cat.s.d.s.ctaOpen') + '\n';

// Plakát nahoře (stejný jako detail modelu): obří rozpětí výkonu, pod ním
// kW, počet modelů a roky; motor a převodovka v pruhu dole.
const numLocale = bcp47(locale);
const nf = new Intl.NumberFormat(numLocale);
const kwValues = series.models.map((m) => m.power_kw).filter((x): x is number => typeof x === 'number');
const fmtRange = (a: number, b: number) => (a === b ? nf.format(a) : `${nf.format(a)}–${nf.format(b)}`);
const posterGiant = minHp !== null && maxHp !== null ? { v: fmtRange(minHp, maxHp), u: tr('enc.alt.koni') } : null;
const posterCells: PosterCell[] = [
  kwValues.length ? { k: tr('enc.spec.vykon'), v: fmtRange(Math.min(...kwValues), Math.max(...kwValues)), u: 'kW' } : null,
  series.models.length ? { k: modelPlural(series.models.length), v: String(series.models.length) } : null,
  yr ? { k: tr('cat.s.d.specYears'), v: yr } : null,
].filter((c): c is PosterCell => Boolean(c));
// Jen když je pro celou řadu jeden — „Motor 3 variant motoru" nic neříká.
const posterStrip = [
  engines.length === 1 ? { k: tr('enc.spec.motor'), v: engines[0] } : null,
  transmissions.length === 1 ? { k: tr('enc.spec.prevodovka'), v: transmissions[0] } : null,
].filter((c): c is { k: string; v: string } => Boolean(c));
// Bez roku nevíme, jestli se řada ještě prodává — radši nic než „Historie".
const posterStatus = isCurrent
  ? { label: tr('cat.s.d.tagCurrent'), current: true }
  : series.year_from ? { label: tr('cat.s.d.tagLegacy'), current: false } : null;
const catDisplayLabel = categoryLabels[category] ?? categoryLabel(series.subcategory ?? category, locale);
---

<Layout
  title={tf(locale, 'cat.s.d.s.title', { brand: brand.name, series: series.name })}
  description={tf(locale, 'cat.s.d.s.desc', { brand: brand.name, series: series.name, hp: hpRange || '—', yr: yr || '—' })}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  {modelListJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(modelListJsonLd)} />}
  <div class="series-page">

    <nav class="breadcrumb" aria-label={tr('cat.s.d.bcAria')}>
      <a href={localizePath(locale, '/')}>{tr('cat.bc.home')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, '/stroje/')}>{tr('cat.bc.tech')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, `/stroje/${brand.slug}/`)}>{brand.name}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizePath(locale, `/stroje/${brand.slug}/rada/${category}/${family}/`)}>{familyLab}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <span class="current">{seriesNameClean}</span>
    </nav>

    <MachinePoster
      badge={catDisplayLabel}
      meta={`${brand.name.toUpperCase()} · ${familyLab}`}
      status={posterStatus}
      title={seriesNameClean}
      lead={series.description}
      giant={posterGiant}
      cells={posterCells}
      strip={posterStrip}
      photo={heroPhoto}
      photoAlt={`${brand.name} ${seriesNameClean}`}
      credit={heroCreditAuthor && heroCreditUrl ? { author: heroCreditAuthor, license: heroCreditLicense ?? undefined, sourceUrl: heroCreditUrl } : null}
      locale={locale}
    />

    <div class="hero-actions">
      <a class="cta-primary" href={`/bazar/?brand=${encodeURIComponent(brand.slug)}&category=${category}&q=${encodeURIComponent(seriesNameClean)}`}>{heroSearchText}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="cta-secondary" href={localizePath(locale, `/stroje/${brand.slug}/rada/${category}/${family}/`)}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>{heroAllGenText}</a>
    </div>

    <section class="models-section">
      <div class="ms-head">
        <div>
          <h2>{tr('cat.s.d.s.modelsTitle')}</h2>
          <p class="ms-sub">{tr('cat.s.d.s.modelsSub')}</p>
        </div>
        {hpRange && <div class="ms-summary"><strong>{series.models.length}</strong> {modelPlural(series.models.length)} · {hpRange}</div>}
      </div>

      <div class="models-table">
        <div class="mt-head">
          <span>{tr('cat.s.d.s.colModel')}</span>
          <span class="mt-col-power">{tr('cat.s.d.s.colPower')}</span>
          <span class="mt-col-year">{tr('cat.s.d.s.colYear')}</span>
          {categoryHasGrainTank && <span class="mt-col-tank">{tr('cat.s.d.s.colTank')}</span>}
          <span class="mt-col-engine">{tr('cat.s.d.s.colEngine')}</span>
          <span class="mt-col-action"></span>
        </div>
        {sortedModels.map((m) => {
          const mYr = m.year_from ? (m.year_to ? `${m.year_from}–${m.year_to}` : `${m.year_from}–${tr('cat.rada.dosud')}`) : '—';
          const mIsCurrent = m.year_to === null && m.year_from !== null;
          return (
            <a href={localizePath(locale, `/stroje/${brand.slug}/${series.slug}/${modelUrlPart(m.slug)}/`)} class="mt-row">
              <span class="mt-name">
                {m.name}
                {mIsCurrent && <span class="dot-current" title={tr('cat.s.d.dotCurrent')}></span>}
              </span>
              <span class="mt-power">
                {m.power_hp !== null ? (
                  <>
                    <strong>{m.power_hp} {tr('cmp.unitHp')}</strong>
                    {m.power_kw && <span class="kw"> · {m.power_kw} kW</span>}
                  </>
                ) : '—'}
              </span>
              <span class="mt-year">{mYr}</span>
              {categoryHasGrainTank && (
                <span class="mt-tank">{m.grain_tank_l ? `${m.grain_tank_l.toLocaleString(bcp47(locale))} l` : '—'}</span>
              )}
              <span class="mt-engine">{m.engine ?? '—'}</span>
              <span class="mt-go">{tr('cat.s.d.s.detailLink')}</span>
            </a>
          );
        })}
      </div>
    </section>

    {siblings.length > 0 && (
      <section class="siblings">
        <div class="sib-head">
          <h2>{sibTitleText}</h2>
          <a class="sib-all" href={localizePath(locale, `/stroje/${brand.slug}/rada/${category}/${family}/`)}>{tr('cat.s.d.s.sibAll')}</a>
        </div>
        <div class="sib-grid">
          {siblings.map((s) => {
            const sHp = s.minHp !== null && s.maxHp !== null
              ? (s.minHp === s.maxHp ? `${s.minHp} ${tr('cmp.unitHp')}` : `${s.minHp}–${s.maxHp} ${tr('cmp.unitHp')}`)
              : '';
            return (
              <a class="sib-card" href={localizePath(locale, `/stroje/${brand.slug}/${s.slug}/`)}>
                <div class="sib-title-row">
                  <span class="sib-title">{s.name}</span>
                  {s.isCurrent ? (
                    <span class="sib-badge current"><span class="dot"></span>{tr('cat.s.d.s.sibCurrent')}</span>
                  ) : (
                    <span class="sib-badge legacy">{tr('cat.s.d.s.sibLegacy')}</span>
                  )}
                </div>
                <div class="sib-meta">
                  <span><strong>{s.modelCount}</strong> {modelPlural(s.modelCount)}</span>
                  {sHp && <><span class="sep"></span><span>{sHp}</span></>}
                  {s.yr && <><span class="sep"></span><span>{s.yr}</span></>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="big-cta">
      <div>
        <span class="cta-kicker">{tr('cat.s.d.s.ctaKicker')}</span>
        <h2>{brand.name} {seriesNameClean} {tr('cat.s.d.s.ctaHeadingPre')}<br />{tr('cat.s.d.s.ctaHeadingPost')}</h2>
        <p>{tr('cat.s.d.s.ctaText')}</p>
        <div class="cta-actions">
          <a class="cta-btn primary" href={`/bazar/?brand=${encodeURIComponent(brand.slug)}&category=${category}&q=${encodeURIComponent(seriesNameClean)}`}>{ctaOpenText}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="cta-btn ghost" href={localizeInternalHref(locale, '/bazar/novy/')}>{tr('cat.s.d.s.ctaAdd')}</a>
        </div>
      </div>
      <div class="cta-right">
        <div class="cta-photo" style={`background-image:url('${heroPhoto}')`}></div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .series-page{
    --yellow:#FFEA00;
    --yellow-soft:#FFF6A8;
    --yellow-glow:rgba(255,234,0,.35);
    --ink:#0A0A0B;
    --body:#1E1E22;
    --muted:#6B6B72;
    --muted-2:#9A9AA3;
    --line:#EAEAEC;
    --line-2:#DFDFE3;
    --bg-cream:#FBFAF4;
    --card:#FFFFFF;
    --green:#0B7A3B;
    --green-soft:#E3F3EA;
    --legacy:#7A6B0B;
    --legacy-soft:#F5EFC8;
    --r-xl:24px;
    --r-lg:18px;
    --r-md:12px;
    --sh-1:0 1px 2px rgba(10,10,12,.04), 0 0 0 1px rgba(10,10,12,.03);
    --sh-3:0 18px 40px -12px rgba(10,10,12,.18), 0 0 0 1px rgba(10,10,12,.04);
    max-width:1280px;margin:0 auto;padding:26px 24px 96px;
    color:var(--body);
  }

  .series-page .breadcrumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .series-page .breadcrumb a{color:var(--muted);text-decoration:none;transition:color .15s}
  .series-page .breadcrumb a:hover{color:#000}
  .series-page .breadcrumb svg{width:14px;height:14px;color:var(--muted-2);flex-shrink:0}
  .series-page .breadcrumb .current{color:#000;font-weight:600}

  /* Tlačítka pod plakátem — na světlém pozadí. */
  .series-page .hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 22px}
  .series-page .cta-primary{
    display:inline-flex;align-items:center;gap:10px;
    background:var(--yellow);color:#0A0A0B;
    padding:13px 18px;border-radius:12px;text-decoration:none;
    font:700 14px 'Chakra Petch',sans-serif;letter-spacing:.02em;
    transition:transform .15s, box-shadow .15s;
    box-shadow:0 10px 28px -12px var(--yellow-glow);
  }
  .series-page .cta-primary:hover{transform:translateY(-1px);box-shadow:0 16px 36px -10px var(--yellow-glow)}
  .series-page .cta-secondary{
    display:inline-flex;align-items:center;gap:8px;
    color:var(--ink);background:#fff;
    border:1px solid #DFDFE3;
    padding:13px 16px;border-radius:12px;text-decoration:none;
    font:500 13px 'Chakra Petch',sans-serif;letter-spacing:.02em;
    transition:.15s;
  }
  .series-page .cta-secondary:hover{background:#FBFAF4;border-color:var(--ink)}

  .series-page .models-section{
    margin:24px 0;background:var(--card);border:1px solid var(--line);
    border-radius:var(--r-xl);padding:24px 24px 22px;
    box-shadow:var(--sh-1);
  }
  .series-page .ms-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin-bottom:18px;flex-wrap:wrap}
  .series-page .ms-head h2{font-family:'Chakra Petch',sans-serif;font-size:24px;font-weight:700;letter-spacing:-.02em;margin:0;line-height:1.1;color:var(--ink)}
  .series-page .ms-sub{font-size:13px;color:var(--muted);margin-top:4px}
  .series-page .ms-summary{font:600 13px 'Chakra Petch',sans-serif;color:var(--muted);background:#FBFAF4;padding:8px 12px;border-radius:8px}
  .series-page .ms-summary strong{color:var(--ink);font-weight:700}

  .series-page .models-table{
    background:#FBFAF4;border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;
  }
  .series-page .mt-head, .series-page .mt-row{
    display:grid;
    grid-template-columns:1.6fr .9fr .9fr 1.4fr auto;
    gap:12px;align-items:center;padding:11px 16px;
  }
  .series-page .mt-head{
    background:#F4F2E9;border-bottom:1px solid var(--line);
    font:600 11px 'Chakra Petch',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
  }
  .series-page[data-cat="kombajny"] .mt-head, .series-page[data-cat="kombajny"] .mt-row{
    grid-template-columns:1.4fr .9fr .9fr .8fr 1.2fr auto;
  }
  .series-page .mt-row{
    border-bottom:1px solid var(--line);text-decoration:none;color:var(--body);
    transition:background .12s;font:500 14px 'Roboto Condensed',sans-serif;
  }
  .series-page .mt-row:last-child{border-bottom:0}
  .series-page .mt-row:hover{background:#fff}
  .series-page .mt-name{font:700 16px 'Chakra Petch',sans-serif;color:var(--ink);letter-spacing:-.005em;display:inline-flex;align-items:center;gap:8px}
  .series-page .mt-name .dot-current{width:6px;height:6px;background:var(--green);border-radius:50%;animation:sp-pulse 2s infinite;flex-shrink:0}
  .series-page .mt-power strong{color:var(--ink);font-family:'Chakra Petch',sans-serif;font-size:15px;font-weight:700;letter-spacing:-.01em}
  .series-page .mt-power .kw{color:var(--muted);font-size:12px}
  .series-page .mt-year{color:var(--muted);font-family:'Chakra Petch',sans-serif;font-size:13.5px}
  .series-page .mt-tank{font-family:'Chakra Petch',sans-serif;font-size:13.5px;color:var(--ink)}
  .series-page .mt-engine{color:var(--muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .series-page .mt-go{
    font:700 12.5px 'Chakra Petch',sans-serif;color:#0A0A0B;
    padding:6px 11px;border:1px solid var(--line-2);border-radius:8px;
    background:#fff;transition:.15s;white-space:nowrap;
  }
  .series-page .mt-row:hover .mt-go{background:var(--yellow);border-color:var(--yellow);transform:translateX(2px)}
  @keyframes sp-pulse{0%,100%{box-shadow:0 0 0 0 rgba(11,122,59,.4)}50%{box-shadow:0 0 0 4px rgba(11,122,59,0)}}

  .series-page .siblings{margin:32px 0 0}
  .series-page .sib-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px;flex-wrap:wrap}
  .series-page .sib-head h2{font-family:'Chakra Petch',sans-serif;font-size:22px;font-weight:700;letter-spacing:-.02em;margin:0;color:var(--ink)}
  .series-page .sib-all{font:600 13px 'Chakra Petch',sans-serif;color:#0A0A0B;text-decoration:none;background:#fff;border:1px solid var(--line);padding:9px 14px;border-radius:10px;transition:.15s}
  .series-page .sib-all:hover{background:var(--yellow-soft);border-color:var(--yellow)}
  .series-page .sib-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
  .series-page .sib-card{
    display:block;text-decoration:none;color:inherit;
    background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);
