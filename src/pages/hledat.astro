---
import Layout from '../layouts/Layout.astro';
import { createAnonClient } from '../lib/supabase';
import { getAllModels } from '../lib/stroje';
import { getAllPlemena } from '../lib/plemena';
import { AGRO_SVET_SITE_ID as SITE_ID } from '../lib/config';
import {
  useTranslations,
  tf,
  getLocaleFromUrl,
  searchGroupsFor,
  localizeInternalHref,
  localizedCategory,
} from '../i18n/utils';
import { defaultLocale } from '../i18n/config';
import { buildTranslationMap, hasTranslatedTitle, overlayArticle } from '../lib/articles-i18n';

const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);

const query = (Astro.url.searchParams.get('q') ?? '').trim();

/** Jediný zdroj pravdy o tom, co se v této locale prohledává (viz
 *  searchGroupsFor). Používá se ZÁROVEŇ na dotazy i na výčet „co prohledáváme",
 *  aby stránka neslibovala sekci, do které nikdy nesáhne. */
const searchable = new Set(searchGroupsFor(locale));
const has = (id: string) => searchable.has(id);
/** Lokalizovaný odkaz s dotazem: cestu prefixuje locale, query zůstává. */
const hrefQ = (csPath: string) => `${localizeInternalHref(locale, csPath)}?q=${encodeURIComponent(query)}`;

type ResultItem = {
  title: string;
  url: string;
  snippet?: string;
  meta?: string;
};

type Group = {
  id: string;
  label: string;
  icon: string;
  items: ResultItem[];
  moreLink?: { href: string; label: string };
};

const groups: Group[] = [];
let totalHits = 0;

if (query.length >= 2) {
  const needle = query.toLowerCase();
  const supabase = createAnonClient();

  // Novinky. cs hledá v `articles`; ne-cs hledá v PŘELOŽENÝCH titulcích a
  // perexech (`article_translations`), ne v českých — jinak by /pl/hledat
  // reagovalo na české slovo a vypsalo článek, který polsky vůbec není.
  if (has('novinky')) {
    let articles: any[] = [];
    if (locale === defaultLocale) {
      const { data } = await supabase
        .from('articles')
        .select('id, title, slug, perex, category, published_at')
        .eq('site_id', SITE_ID)
        .eq('status', 'published')
        .or(`title.ilike.%${query}%,perex.ilike.%${query}%`)
        .order('published_at', { ascending: false })
        .limit(10);
      articles = data ?? [];
    } else {
      const { data: trs } = await supabase
        .from('article_translations')
        .select('article_id, title, perex')
        .eq('locale', locale)
        .or(`title.ilike.%${query}%,perex.ilike.%${query}%`)
        .limit(10);
      const rows = (trs ?? []).filter((r: any) => r?.article_id && hasTranslatedTitle(r));
      if (rows.length > 0) {
        const map = buildTranslationMap(rows as any);
        const { data: cs } = await supabase
          .from('articles')
          .select('id, title, slug, perex, category, published_at')
          .eq('site_id', SITE_ID)
          .eq('status', 'published')
          .in('id', rows.map((r: any) => r.article_id))
          .order('published_at', { ascending: false });
        articles = (cs ?? []).map((a: any) => overlayArticle(a, map.get(a.id)));
      }
    }

    if (articles.length > 0) {
      groups.push({
        id: 'novinky',
        label: tr('search.g.novinky'),
        icon: 'news',
        items: articles.map((a: any) => ({
          title: a.title,
          url: localizeInternalHref(locale, `/novinky/${a.slug}/`),
          snippet: a.perex,
          meta: a.category ? localizedCategory(locale, a.category) : undefined,
        })),
        moreLink: { href: hrefQ('/novinky/'), label: tr('search.more.novinky') },
      });
      totalHits += articles.length;
    }
  }

  // Stroje (katalog ze statických YAML, pan-evropský)
  if (has('stroje')) {
    const modelMatches = getAllModels(locale).filter((m) => {
      const hay = `${m.brand_name} ${m.name} ${m.series_name}`.toLowerCase();
      return hay.includes(needle);
    });
    if (modelMatches.length > 0) {
      groups.push({
        id: 'stroje',
        label: tr('search.g.stroje'),
        icon: 'tractor',
        items: modelMatches.slice(0, 15).map((m) => {
          const short = m.slug.startsWith(m.brand_slug + '-') ? m.slug.slice(m.brand_slug.length + 1) : m.slug;
          return {
            title: `${m.brand_name} ${m.name}`,
            url: localizeInternalHref(locale, `/stroje/${m.brand_slug}/${m.series_slug}/${short}/`),
            snippet: m.description?.slice(0, 140) ?? undefined,
            meta: `${m.series_name}${m.power_hp ? ` · ${m.power_hp} ${tr('cmp.unitHp')}` : ''}${m.year_from ? ` · ${m.year_from}${m.year_to ? '–' + m.year_to : `–${tr('cat.rada.dosud')}`}` : ''}`,
          };
        }),
        moreLink: modelMatches.length > 15
          ? { href: hrefQ('/stroje/'), label: tf(locale, 'search.more.stroje', { n: modelMatches.length }) }
          : undefined,
      });
      totalHits += modelMatches.length;
    }
  }

  // Plemena
  if (has('plemena')) {
    const plemenaMatches = getAllPlemena(locale).filter((p) => {
      const hay = `${p.name} ${(p.alternative_names ?? []).join(' ')} ${p.origin_country}`.toLowerCase();
      return hay.includes(needle);
    });
    if (plemenaMatches.length > 0) {
      groups.push({
        id: 'plemena',
        label: tr('search.g.plemena'),
        icon: 'animal',
        items: plemenaMatches.slice(0, 12).map((p) => ({
          title: p.name,
          url: localizeInternalHref(locale, `/plemena/${p.druh_slug}/${p.slug}/`),
          snippet: p.description?.slice(0, 140),
          meta: `${p.druh_name} · ${p.origin_country}`,
        })),
        moreLink: plemenaMatches.length > 12
          ? { href: hrefQ('/plemena/'), label: tf(locale, 'search.more.plemena', { n: plemenaMatches.length }) }
          : undefined,
      });
      totalHits += plemenaMatches.length;
    }
  }

  // Bazar (cs-only — viz SEARCH_GROUP_SECTIONS)
  if (has('bazar')) {
    const { data: listings } = await supabase
      .from('bazar_listings')
      .select('id, title, price, location, category, brand, year_of_manufacture, power_hp, created_at')
      .eq('status', 'active')
      .or(`title.ilike.%${query}%,description.ilike.%${query}%`)
      .order('created_at', { ascending: false })
      .limit(10);

    if (listings && listings.length > 0) {
      groups.push({
        id: 'bazar',
        label: tr('search.g.bazar'),
        icon: 'tag',
        items: listings.map((l: any) => ({
          title: l.title,
          url: `/bazar/${l.id}/`,
          snippet: `${l.location}${l.year_of_manufacture ? ` · rok ${l.year_of_manufacture}` : ''}${l.power_hp ? ` · ${l.power_hp} ${tr('cmp.unitHp')}` : ''}`,
          meta: l.price ? `${l.price.toLocaleString('cs-CZ')} Kč` : 'Dohodou',
        })),
        moreLink: { href: hrefQ('/bazar/'), label: tr('search.more.bazar') },
      });
      totalHits += listings.length;
    }
  }
}

/** Co vyhledávání prohledává — drží se stejných podmínek jako skupiny výše,
 *  aby stránka neslibovala sekci, kterou v dané locale nikdy neprohledá. */
const scope = [
  has('novinky') && { label: tr('search.g.novinky'), detail: tr('search.scope.novinky') },
  has('stroje') && { label: tr('search.g.stroje'), detail: tr('search.scope.stroje') },
  has('plemena') && { label: tr('search.g.plemena'), detail: tr('search.scope.plemena') },
  has('bazar') && { label: tr('search.g.bazar'), detail: tr('search.scope.bazar') },
].filter(Boolean) as Array<{ label: string; detail: string }>;
---

<Layout title={query ? tf(locale, 'search.titleQuery', { q: query }) : tr('search.h1')} description={tr('search.metaDesc')} noindex={true}>
  <div style="max-width:1000px; margin:0 auto; padding:48px 32px 80px;">
    <div style="margin-bottom:24px;">
      <span class="section-label">{tr('search.label')}</span>
      <h1 style="font-size:clamp(1.8rem,4vw,2.6rem); margin-bottom:14px;">
        {query ? tf(locale, 'search.resultsFor', { q: query }) : tr('search.h1')}
      </h1>
    </div>

    <form method="GET" action={localizeInternalHref(locale, '/hledat/')} style="margin-bottom:32px;">
      <div style="position:relative;">
        <svg style="position:absolute; left:20px; top:50%; transform:translateY(-50%); pointer-events:none;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="search"
          name="q"
          value={query}
          placeholder={tr('search.placeholder')}
          autofocus
          style="width:100%; height:56px; padding:0 20px 0 52px; font-size:17px; background:#fff; border:1px solid #d9d9d9; border-radius:14px;"
        />
      </div>
      {query.length >= 1 && query.length < 2 && (
        <p style="font-size:13px; color:#767676; margin-top:8px;">{tr('search.minChars')}</p>
      )}
    </form>

    {query.length >= 2 && (
      <>
        {totalHits > 0 ? (
          <div style="margin-bottom:14px; font-size:14px; color:#666;">
            {tf(locale, 'search.found', { n: totalHits, s: groups.length })}
          </div>
        ) : (
          <div style="padding:48px 0; text-align:center; color:#666;">
            <p style="font-size:16px;">{tf(locale, 'search.empty', { q: query })}</p>
            <p style="font-size:13px; margin-top:8px;">{tr('search.emptyHint')}</p>
          </div>
        )}

        {groups.map((g) => (
          <section style="margin-bottom:36px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline; gap:12px; margin-bottom:12px;">
              <h2 style="display:inline-flex; align-items:center; gap:10px; font-family:'Chakra Petch',sans-serif; font-size:20px; font-weight:700; color:#1a1a1a;">
                {g.icon === 'news' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8z"/></svg>
                )}
                {g.icon === 'tractor' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="3"/><path d="M4 17H3v-4l2-2h4l3-4h5v10h-2"/></svg>
                )}
                {g.icon === 'animal' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.25 16.25h1.5L12 17z"/><path d="M16 14v.5"/><path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309"/><path d="M8 14v.5"/><path d="M8.5 8.5c-.384 1.05-1.083 2.028-2.344 2.5-1.931.722-3.576-.297-3.656-1-.113-.994 1.177-6.53 4-7 1.923-.321 3.651.845 3.651 2.235A7.497 7.497 0 0 1 14 5c0-1.39 1.844-2.598 3.767-2.277 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.96-1.45-2.344-2.5"/></svg>
                )}
                {g.icon === 'tag' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                )}
                {g.label} <span style="font-size:14px; font-weight:400; color:#666;">({g.items.length})</span>
              </h2>
              {g.moreLink && <a href={g.moreLink.href} class="link-underline">{g.moreLink.label} →</a>}
            </div>
            <div style="border:1px solid #e8e8e8; border-radius:14px; background:#fff; overflow:hidden;">
              {g.items.map((item, idx) => (
                <a
                  href={item.url}
                  style={`display:block; padding:14px 18px; text-decoration:none; color:inherit; border-bottom:${idx < g.items.length - 1 ? '1px solid #f2f2f2' : 'none'};`}
                  class="search-result"
                >
                  <div style="display:flex; justify-content:space-between; gap:12px; align-items:baseline; flex-wrap:wrap;">
                    <div style="font-family:'Chakra Petch',sans-serif; font-size:15px; font-weight:700; color:#1a1a1a;">{item.title}</div>
                    {item.meta && <div style="font-size:12px; color:#666;">{item.meta}</div>}
                  </div>
                  {item.snippet && (
                    <div style="font-size:13px; color:#666; line-height:1.5; margin-top:4px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                      {item.snippet}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))}
      </>
    )}

    {!query && (
      <div style="padding:32px 0; color:#666; line-height:1.6; font-size:15px;">
        <p>{tr('search.scopeIntro')}</p>
        <ul style="margin-top:10px; padding-left:22px;">
          {scope.map((s) => (
            <li><strong>{s.label}</strong> — {s.detail}</li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <style>
    .search-result:hover { background: #fafafa; }
  </style>
</Layout>
