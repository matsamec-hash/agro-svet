---
// src/pages/oepul/index.astro
// DE-only landing: ÖPUL 2023 — rakouský agrárně-environmentální program
// (2. pilíř GAP). Obdoba německých /oeko-regelungen, ale jiná jurisdikce
// i jiná logika: ÖPUL je modulární (Basismodul + Zuschläge), ne bodový.
// Non-de locale → 404 (žádný cs ekvivalent).
//
// ‼️ PAST V DATECH: skoro všechny veřejně dohledatelné přehledy uvádějí
// VÝCHOZÍ sazby roku 2023. Od žádosti 2024 ale Rakousko v rámci
// „Impulsprogramm" zvedlo VŠECHNY sazby ÖPUL nejméně o 8 % a u části
// měr přidalo znovu od 2025. Kdyby stránka psala „70 €/ha" jako aktuální
// sazbu UBB, lhala by — proto je u každé tabulky uveden ROK sazby a
// u dvou hlavních modulů celá řada 2023 → 2024 → 2025.
//
// Zdroje (ověřeno křížem, shodují se na 70 €/ha UBB a 205 €/ha Bio pro 2023):
//   - AMA, „Höhere Prämien und Neuerungen bei ÖPUL-Maßnahmen" (ama.at)
//     → řada 2023/2024/2025 a nové míry a zuschlägy od 2025
//   - Landwirtschaftskammer Österreich, „ÖPUL 2023 — ein Überblick" (lko.at)
//     → sazby jednotlivých měr, výchozí rok 2023
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { localizePath } from '../../i18n/utils';

const locale = Astro.locals.locale ?? 'cs';
if (locale !== 'de') return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

// ── Basismodule mit vollständiger Reihe ──────────────────────────────────────
type Serie = { name: string; v2023: number; v2024: number; v2025: number; note?: string };
const serien: Serie[] = [
  { name: 'UBB — Basismodulprämie auf Ackerflächen', v2023: 70, v2024: 75.6, v2025: 85, note: 'Umweltgerechte und biodiversitätsfördernde Bewirtschaftung' },
  { name: 'Biologische Wirtschaftsweise — Basismodulprämie auf Ackerflächen', v2023: 205, v2024: 221.4, v2025: 235, note: 'Bio-Basismodul' },
];

// ── Weitere Sätze: Ausgangswerte 2023 ────────────────────────────────────────
type Row = { name: string; v: number | [number, number]; unit: string; note?: string };

const basis: Row[] = [
  { name: 'UBB — Grünland, Nicht-Tierhalter', v: 25, unit: '€/ha' },
  { name: 'Bio — Grünland, Tierhalter bis 1,4 RGVE/ha', v: 215, unit: '€/ha', note: 'höchster Grünlandsatz' },
  { name: 'Bio — Grünland, Tierhalter über 1,4 RGVE/ha', v: 205, unit: '€/ha' },
  { name: 'Bio — Grünland, Nicht-Tierhalter', v: 70, unit: '€/ha' },
];

const acker: Row[] = [
  { name: 'Begrünung — Mulchsaat', v: 50, unit: '€/ha' },
  { name: 'Begrünung — Direktsaat und Strip-Till', v: 80, unit: '€/ha', note: 'höherer Satz für bodenschonende Verfahren' },
  { name: 'Begrünung — Winterraps', v: 90, unit: '€/ha' },
  { name: 'Erosionsschutz Acker — Querdämme bei Kartoffeln', v: 550, unit: '€/ha' },
  { name: 'Erosionsschutz Acker — begrünte Abflusswege', v: 550, unit: '€/ha' },
  { name: 'Grundwasserschutz Acker', v: 50, unit: '€/ha', note: 'in Oberösterreich mit regionalem Zuschlag 80 €/ha' },
  { name: 'Humuserhalt und Bodenschutz — Grünland', v: [30, 100], unit: '€/ha', note: 'gestaffelt nach Hangneigung' },
];

// ── Neu ab dem Antragsjahr 2025 ──────────────────────────────────────────────
const neu2025: Row[] = [
  { name: 'Nichtproduktive Ackerflächen', v: [350, 450], unit: '€/ha', note: 'neue Maßnahme ab 2025' },
  { name: 'Agroforststreifen', v: [600, 800], unit: '€/ha', note: 'neue Maßnahme ab 2025' },
  { name: 'Neueinsaat Biodiversitätsflächen (Grünbrache)', v: 324, unit: '€/ha' },
  { name: 'Pheromonfallen bei Zuckerrüben', v: 150, unit: '€/ha' },
  { name: 'Belassen von Altgrasflächen', v: 150, unit: '€/ha' },
  { name: 'Untersaaten bei Mais und Sorghum', v: [81, 97.2], unit: '€/ha', note: 'je nach Ausführung' },
  { name: 'Kreislaufwirtschaft', v: 40, unit: '€/ha' },
  { name: 'Cultan-Düngung', v: 40, unit: '€/ha' },
  { name: 'Almweideplan — erste 20 Hektar', v: 20, unit: '€/ha' },
  { name: 'Betriebsbezogene Transaktionskosten', v: 400, unit: '€/Betrieb', note: 'je Betrieb, nicht je Hektar' },
];

const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const val = (r: Row) => (Array.isArray(r.v) ? `${fmt(r.v[0])} – ${fmt(r.v[1])} ${r.unit}` : `${fmt(r.v)} ${r.unit}`);
const lastUpdated = new Date().toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = 'https://agro-svet.cz/de/oepul/';

const ubb = serien[0];
const bio = serien[1];

const faq = [
  { q: 'Was ist ÖPUL?', a: 'ÖPUL ist das österreichische Programm für umweltgerechte Landwirtschaft — der Agrarumwelt-Teil der zweiten Säule der GAP. Es ist freiwillig: Betriebe verpflichten sich für die Programmperiode zu Maßnahmen, die über die gesetzlichen Mindestanforderungen hinausgehen, und erhalten dafür eine Prämie je Hektar. ÖPUL 2023 läuft in der Periode 2023 bis 2027.' },
  { q: 'Wie hoch ist die UBB-Prämie?', a: `Die Basismodulprämie der Maßnahme „Umweltgerechte und biodiversitätsfördernde Bewirtschaftung" auf Ackerflächen betrug im Jahr 2023 ${fmt(ubb.v2023)} €/ha, 2024 ${fmt(ubb.v2024)} €/ha und 2025 ${fmt(ubb.v2025)} €/ha. Auf das Basismodul kommen je nach Betrieb Zuschläge für einzelne Zusatzleistungen.` },
  { q: 'Wie hoch ist die Bio-Prämie?', a: `Das Basismodul der Maßnahme „Biologische Wirtschaftsweise" auf Ackerflächen lag 2023 bei ${fmt(bio.v2023)} €/ha, 2024 bei ${fmt(bio.v2024)} €/ha und 2025 bei ${fmt(bio.v2025)} €/ha. Im Grünland hängt der Satz von der Tierhaltung ab: Tierhalter bis 1,4 RGVE je Hektar erhalten 215 €/ha, darüber 205 €/ha, Nicht-Tierhalter 70 €/ha.` },
  { q: 'Warum sind die Prämien seit 2024 höher?', a: 'Mit dem Antragsjahr 2024 trat ein Impulsprogramm für die österreichische Landwirtschaft in Kraft. Sämtliche ÖPUL-Prämiensätze wurden dabei um mindestens 8 Prozent angehoben, bei einem Teil der Maßnahmen kam ab 2025 eine weitere Erhöhung dazu. Ältere Übersichten führen deshalb häufig noch die niedrigeren Ausgangssätze von 2023.' },
  { q: 'Was ist ab 2025 neu?', a: 'Neu ist vor allem die Maßnahme „Nichtproduktive Ackerflächen und Agroforststreifen" mit 350 bis 450 €/ha für nichtproduktive Ackerflächen und 600 bis 800 €/ha für Agroforststreifen. Dazu kamen mehrere Zuschläge, etwa für die Neueinsaat von Biodiversitätsflächen (324 €/ha), Pheromonfallen bei Zuckerrüben (150 €/ha), das Belassen von Altgrasflächen (150 €/ha) sowie Untersaaten bei Mais und Sorghum.' },
  { q: 'Kann man UBB und Bio kombinieren?', a: 'Nein, die beiden Basismodule schließen einander aus — ein Betrieb wählt entweder die Maßnahme „Umweltgerechte und biodiversitätsfördernde Bewirtschaftung" oder „Biologische Wirtschaftsweise". Beide lassen sich aber mit zahlreichen weiteren ÖPUL-Maßnahmen und Zuschlägen kombinieren, etwa Begrünung, Erosionsschutz oder Grundwasserschutz.' },
  { q: 'Sind die genannten Beträge verbindlich?', a: 'Nein. Die Sätze stammen aus den Informationsunterlagen der AMA und der Landwirtschaftskammer und gelten für das jeweils angegebene Antragsjahr. Die tatsächliche Auszahlung hängt vom Antragsumfang, der Einhaltung der Auflagen und dem verfügbaren Budget ab. Verbindlich ist allein der Bescheid der AMA; maßgeblich sind die Merkblätter zur jeweiligen Maßnahme.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `https://agro-svet.cz${localizePath('de', '/')}` },
        { '@type': 'ListItem', position: 2, name: 'ÖPUL', item: pageUrl },
      ],
    },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};

const groups: { title: string; sub: string; rows: Row[] }[] = [
  { title: 'Weitere Basismodulsätze', sub: 'Ausgangssätze des Jahres 2023 — ab 2024 um mindestens 8 % angehoben.', rows: basis },
  { title: 'Acker, Boden und Wasser', sub: 'Ausgangssätze des Jahres 2023 — ab 2024 um mindestens 8 % angehoben.', rows: acker },
  { title: 'Neue Maßnahmen und Zuschläge ab 2025', sub: 'Sätze für das Antragsjahr 2025 laut AMA.', rows: neu2025 },
];
---

<Layout
  title="ÖPUL 2023 — Prämien des österreichischen Agrarumweltprogramms"
  description={`Die Prämien des ÖPUL 2023 je Hektar: UBB-Basismodul ${fmt(ubb.v2025)} €/ha und Bio-Basismodul ${fmt(bio.v2025)} €/ha im Jahr 2025, Begrünung, Erosions- und Grundwasserschutz sowie die neuen Maßnahmen ab 2025.`}
  noHreflang={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="db">
    <div class="db-wrap">
      <nav class="db-crumb" aria-label="Brotkrumennavigation">
        <a href={localizePath('de', '/')}>Startseite</a>
        <span>/</span>
        <b>ÖPUL</b>
      </nav>

      <header class="db-head">
        <span class="db-eyebrow">Agrarumweltprogramm Österreich · Periode 2023–2027</span>
        <h1>ÖPUL 2023 — Prämien je Hektar</h1>
        <p class="db-lead">
          Das österreichische Programm für umweltgerechte Landwirtschaft ist modular aufgebaut:
          Ein Betrieb wählt ein Basismodul — UBB oder Bio — und ergänzt es um Zuschläge für
          einzelne Zusatzleistungen. Unten die Sätze der wichtigsten Maßnahmen, die Entwicklung
          der beiden Basismodule seit 2023 und die neuen Maßnahmen ab 2025.
        </p>
      </header>

      <div class="db-flag">
        <strong>Achtung bei älteren Übersichten.</strong> Mit dem Antragsjahr 2024 wurden im Rahmen
        eines Impulsprogramms <em>sämtliche</em> ÖPUL-Prämiensätze um mindestens 8 % angehoben, bei
        einem Teil der Maßnahmen ab 2025 noch einmal. Viele frei zugängliche Zusammenstellungen
        führen weiterhin die Ausgangssätze von 2023. Bei jeder Tabelle unten steht deshalb, für
        welches Jahr der Satz gilt.
      </div>

      <section class="db-hero-stats" aria-label="Wichtigste Prämien 2025">
        <div class="db-stat db-stat--hl">
          <span class="db-stat-l">UBB Acker · 2025</span>
          <b class="db-stat-v">{fmt(ubb.v2025)} <em>€/ha</em></b>
        </div>
        <div class="db-stat db-stat--hl">
          <span class="db-stat-l">Bio Acker · 2025</span>
          <b class="db-stat-v">{fmt(bio.v2025)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Agroforststreifen</span>
          <b class="db-stat-v">600–800 <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Erosionsschutz Acker</span>
          <b class="db-stat-v">550 <em>€/ha</em></b>
        </div>
      </section>

      <section class="db-tables" aria-labelledby="dev-h">
        <h2 id="dev-h">Entwicklung der beiden Basismodule</h2>
        <p class="db-calc-sub">Die einzigen beiden Sätze, für die eine vollständige Reihe vorliegt.
          Sie zeigen die Wirkung des Impulsprogramms unmittelbar.</p>
        <div class="db-tw">
          <table class="db-table">
            <thead>
              <tr><th scope="col">Basismodul (Ackerflächen)</th><th scope="col">2023</th><th scope="col">2024</th><th scope="col">2025</th></tr>
            </thead>
            <tbody>
              {serien.map((s) => (
                <tr>
                  <td>{s.name}</td>
                  <td class="db-num">{fmt(s.v2023)} €/ha</td>
                  <td class="db-num">{fmt(s.v2024)} €/ha</td>
                  <td class="db-num"><strong>{fmt(s.v2025)} €/ha</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="db-tables" aria-labelledby="tab-h">
        <h2 id="tab-h">Prämien der einzelnen Maßnahmen</h2>
        {groups.map((g) => (
          <div class="db-tw">
            <h3>{g.title}</h3>
            <p class="db-calc-sub">{g.sub}</p>
            <table class="db-table">
              <thead>
                <tr><th scope="col">Maßnahme</th><th scope="col">Prämie</th><th scope="col">Anmerkung</th></tr>
              </thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="db-num">{val(r)}</td>
                    <td class="db-note">{r.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>

      <section class="db-explain" aria-labelledby="exp-h">
        <h2 id="exp-h">Wie ÖPUL aufgebaut ist</h2>
        <div class="db-explain-grid">
          <div class="db-exp"><h3>Basismodul zuerst</h3><p>Jeder teilnehmende Betrieb wählt ein Basismodul: entweder UBB — umweltgerechte und biodiversitätsfördernde Bewirtschaftung — oder die biologische Wirtschaftsweise. Beide schließen einander aus. Das Basismodul bestimmt den Grundsatz je Hektar.</p></div>
          <div class="db-exp"><h3>Zuschläge obendrauf</h3><p>Auf das Basismodul lassen sich zahlreiche Zusatzleistungen legen — Begrünungsvarianten, Erosionsschutz, Grundwasserschutz, Pheromonfallen, Untersaaten. Der Gesamtbetrag je Hektar ergibt sich erst aus der Kombination.</p></div>
          <div class="db-exp"><h3>Grünland nach Tierbesatz</h3><p>Im Grünland richtet sich der Bio-Satz nach dem Tierbesatz: Betriebe mit bis zu 1,4 RGVE je Hektar erhalten den höchsten Satz, darüber sinkt er, und Nicht-Tierhalter bekommen deutlich weniger. Die Systematik honoriert extensive Weidehaltung.</p></div>
          <div class="db-exp"><h3>Mehrjährige Verpflichtung</h3><p>ÖPUL ist freiwillig, aber nicht unverbindlich: Wer teilnimmt, verpflichtet sich für die Programmperiode. Wird eine Auflage nicht eingehalten, drohen Kürzungen und Rückforderungen — die Prämie ist Entgelt für eine tatsächlich erbrachte Leistung.</p></div>
        </div>
      </section>

      <section class="db-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Häufige Fragen</h2>
        {faq.map((f) => (
          <details class="db-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="db-related">
        <a href={localizePath('de', '/direktzahlungen-oesterreich/')}>→ Direktzahlungen in Österreich — die erste Säule (Beträge je Hektar)</a>
        <a href={localizePath('de', '/oeko-regelungen/')}>→ Öko-Regelungen in Deutschland — das Gegenstück im Vergleich</a>
      </div>

      <footer class="db-src">
        <p>Datenquellen: <a href="https://www.ama.at/fachliche-informationen/oepul/aktuelles/2024/hoehere-praemien-und-neuerungen-bei-oepul-massnahmen/" target="_blank" rel="noopener">AMA — Höhere Prämien und Neuerungen bei ÖPUL-Maßnahmen</a> (Reihe 2023–2025, neue Maßnahmen ab 2025), gegengeprüft mit <a href="https://www.lko.at/%C3%B6pul-2023-ein-%C3%BCberblick+2400+3563571" target="_blank" rel="noopener">Landwirtschaftskammer Österreich — ÖPUL 2023, ein Überblick</a> (Sätze der Einzelmaßnahmen). Die Merkblätter zu allen Maßnahmen veröffentlicht die <a href="https://www.ama.at/fachliche-informationen/oepul" target="_blank" rel="noopener">AMA</a>. Letzte Aktualisierung dieser Seite: <strong>{lastUpdated}</strong>.</p>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .db{--yellow:#FFEA00;--yellow-d:#FFD400;--ink:#0A0A0B;--line:#E7E7EA;--muted:#6E6E76;--paper:#FBFAF3;--soft:#F5F5F2;--green:#2E9E57;--red:#D6492B;
    font-family:'Chakra Petch',system-ui,sans-serif;color:var(--ink);background:#fff}
  .db-wrap{max-width:1000px;margin:0 auto;padding:26px 28px 72px}
  .db a{color:inherit}
  .db-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .db-crumb a{text-decoration:none}.db-crumb a:hover{color:var(--ink);text-decoration:underline}
  .db-crumb b{color:var(--ink)}

  .db-head{padding-bottom:22px;border-bottom:2px solid var(--ink)}
  .db-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .db-head h1{font-size:44px;letter-spacing:-.03em;font-weight:800;margin:8px 0 12px;line-height:1.02}
  .db-lead{font-size:15.5px;line-height:1.6;color:#2A2A2F;max-width:80ch}

  .db-hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
  .db-stat{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px}
  .db-stat--hl{background:var(--yellow);border-color:var(--yellow-d)}
  .db-stat .l{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .db-stat--hl .l{color:#5c5300}
  .db-stat .v{font-size:30px;font-weight:800;letter-spacing:-.02em}
  .db-stat .v small{font-size:14px;color:var(--muted);font-weight:600}
  .db-stat--hl .v small{color:#5c5300}
  .db-stat .d{font-size:12px;color:var(--muted)}
  .db-stat--hl .d{color:#5c5300}

  .db h2{font-size:24px;letter-spacing:-.02em;font-weight:800;margin:36px 0 6px}
  .db h3{font-size:16px;font-weight:800;letter-spacing:-.01em}

  .db-calc{margin-top:34px}
  .db-calc-sub{font-size:14px;color:var(--muted);margin:0 0 14px;max-width:70ch}
  .db-calc-box{display:grid;grid-template-columns:220px 1fr;gap:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:22px}
  .db-calc-field{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-calc-field input{font:800 26px 'Chakra Petch',sans-serif;color:var(--ink);border:2px solid var(--ink);border-radius:12px;padding:10px 14px;width:100%}
  .db-calc-out{display:flex;flex-direction:column;justify-content:center;gap:8px}
  .db-calc-line{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14.5px;padding:6px 0;border-bottom:1px dashed var(--line)}
  .db-calc-line em{color:var(--muted);font-style:normal;font-size:12px}
  .db-calc-line b{font-size:18px;font-weight:800;white-space:nowrap}
  .db-calc-total{border-bottom:0;margin-top:2px}
  .db-calc-total span{font-weight:700}
  .db-calc-total b{font-size:24px;background:var(--yellow);padding:2px 8px;border-radius:8px}
  .db-calc-note{font-size:12px;color:var(--muted);margin-top:10px}

  .db-tblcard{margin-top:18px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .db-tblcard h3{padding:14px 18px;background:var(--soft);border-bottom:1px solid var(--line);margin:0}
  .db-tblscroll{overflow-x:auto}
  .db-tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .db-tbl th,.db-tbl td{padding:11px 16px;text-align:left;border-bottom:1px solid var(--line)}
  .db-tbl th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-tbl th.num,.db-tbl td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .db-tbl tr:last-child td{border-bottom:0}
  .db-tbl-name{display:block;font-weight:700}
  .db-tbl-note{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .db-tbl td.strong{font-weight:800}
  .db-tbl td.unit{color:var(--muted);font-size:12.5px;white-space:nowrap}
  .db-yoy{font-weight:800;font-size:12.5px}
  .db-yoy.up{color:var(--green)}.db-yoy.dn{color:var(--red)}
  .db-tbl-src{font-size:12px;color:var(--muted);margin-top:12px}

  .db-explain-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  .db-exp{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
  .db-exp h3{margin:0 0 6px}
  .db-exp p{font-size:13.5px;line-height:1.55;color:#2A2A2F;margin:0}

  .db-faq{margin-top:8px}
  .db-q{border:1px solid var(--line);border-radius:12px;padding:2px 18px;margin-top:10px;background:#fff}
  .db-q summary{font-weight:700;font-size:15px;padding:13px 0;cursor:pointer;list-style:none}
  .db-q summary::-webkit-details-marker{display:none}
  .db-q summary::after{content:'+';float:right;color:var(--muted);font-weight:700}
  .db-q[open] summary::after{content:'–'}
  .db-q p{font-size:14px;line-height:1.6;color:#2A2A2F;margin:0 0 14px}

  .db-related{margin-top:26px}
