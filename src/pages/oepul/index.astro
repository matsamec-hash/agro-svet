---
// src/pages/oepul/index.astro
// DE-only landing: ÖPUL 2023 — rakouský agroenvironmentální program.
// Non-de locale → 404 (žádný cs ekvivalent).
//
// ‼️ 2026-10-15 přepsáno podle Sonderrichtlinie ÖPUL 2023 (Fassung 01.10.2026)
// a informačních listů AMA. Dřívější verze (z přehledu LKÖ 2022) měla chyby:
// „Impulsprogramm +8 % na KAŽDOU sazbu" (jen opatření čl. 70/72, ne Öko-
// Regelungen v ÖPUL), Querdämme 550 (správně 150/162), Mulch-/Direktsaat pod
// Begrünung (patří pod Erosionsschutz Acker), Humus podle sklonu (podle
// Grünlandzahl), Bio Grünland v sazbách 2023.
// Zdroje (stažené v ~/agro-svet/foto-audit/de/zdroje):
//   - SRL ÖPUL 2023, Fassung 01.10.2026 — bod 1.9.3.2 (Öko-Regelungen), Impulsprogramm
//   - AMA Informationsblätter: UBB 10/2026, Biologische Wirtschaftsweise 10/2026,
//     Erosionsschutz Acker 04/2026, Begrünung – Zwischenfruchtanbau 10/2026,
//     Vorbeugender Grundwasserschutz – Acker 04/2026, Humuserhalt 10/2026,
//     Nichtproduktive Ackerflächen und Agroforststreifen 10/2026, Almbewirtschaftung 04/2026
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { localizePath, isLaunchedPath } from '../../i18n/utils';
import { AT_OEPUL_BIO_GRUENLAND_MAX } from '../../data/foerderung-de';

const locale = Astro.locals.locale ?? 'cs';
// Mimo LAUNCHED_PREFIXES.de → 404 i pod /de (stránka se dá znovu stáhnout jedním řádkem).
if (locale !== 'de' || !isLaunchedPath('de', '/oepul')) return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

// ── Basismodule auf Ackerflächen: vollständige Reihe ──────────────────────────
type Serie = { name: string; v2023: number; v2024: number; v2025: number; note?: string };
const serien: Serie[] = [
  { name: 'UBB — Basismodulprämie Ackerflächen', v2023: 70, v2024: 75.6, v2025: 85 },
  { name: 'Biologische Wirtschaftsweise — Basismodulprämie Ackerflächen', v2023: 205, v2024: 221.4, v2025: 235 },
];

// ── Weitere Sätze (gültig ab 2024, wo nicht anders angegeben) ─────────────────
type Row = { name: string; v: number | [number, number]; unit: string; note?: string };

const gruenland: Row[] = [
  { name: 'UBB — Grünland, tierhaltender Betrieb', v: 75.6, unit: '€/ha' },
  { name: 'UBB — Grünland, nicht-tierhaltender Betrieb', v: 27, unit: '€/ha' },
  { name: 'Bio — Grünland, tierhaltend unter 1,40 RGVE/ha', v: AT_OEPUL_BIO_GRUENLAND_MAX, unit: '€/ha', note: 'höchster Grünlandsatz' },
  { name: 'Bio — Grünland, tierhaltend ab 1,40 RGVE/ha', v: 221.4, unit: '€/ha' },
  { name: 'Bio — Grünland, nicht-tierhaltender Betrieb', v: 75.6, unit: '€/ha' },
];

const acker: Row[] = [
  { name: 'Erosionsschutz Acker — Mulchsaat', v: 54, unit: '€/ha', note: 'bei Reihenkulturen wie Mais, Rüben, Soja, Sonnenblumen' },
  { name: 'Erosionsschutz Acker — Direktsaat oder Strip-Till', v: 86.4, unit: '€/ha' },
  { name: 'Erosionsschutz Acker — Anhäufungen bei Kartoffeln', v: 162, unit: '€/ha', note: 'nicht mit Mulch- oder Direktsaat auf derselben Fläche' },
  { name: 'Erosionsschutz Acker — begrünte Abflusswege', v: 594, unit: '€/ha' },
  { name: 'Erosionsschutz Acker — Untersaaten', v: 81, unit: '€/ha', note: 'plus 16,2 €/ha bei Bio; Mais und Sorghum ab 2025' },
  { name: 'Vorbeugender Grundwasserschutz Acker — Basisprämie', v: 54, unit: '€/ha', note: '27 €/ha bei Teilnahme an Bio oder „Einschränkung ertragssteigernder Betriebsmittel“' },
  { name: 'Humuserhalt und Bodenschutz — Grünland unter 18 % Hangneigung', v: [32.4, 108], unit: '€/ha', note: 'gestaffelt nach Grünlandzahl (bis 20 / 20–30 / 30–40 / ab 40)' },
];

// Öko-Regelungen innerhalb von ÖPUL: Prämienbänder, keine Erhöhung durch das Impulsprogramm.
const oeko: Row[] = [
  { name: 'Begrünung Zwischenfruchtanbau — Variante 1', v: [180, 220], unit: '€/ha', note: 'Prämienband, garantiert ist der untere Wert' },
  { name: 'Begrünung Zwischenfruchtanbau — Variante 2', v: [171, 209], unit: '€/ha' },
  { name: 'Begrünung Zwischenfruchtanbau — Variante 4', v: [153, 187], unit: '€/ha' },
  { name: 'Begrünung Zwischenfruchtanbau — Variante 5', v: [135, 165], unit: '€/ha' },
  { name: 'Begrünung Zwischenfruchtanbau — Varianten 3 und 6', v: [108, 132], unit: '€/ha' },
  { name: 'Begrünung Zwischenfruchtanbau — Variante 7', v: [81, 99], unit: '€/ha' },
  { name: 'Nichtproduktive Ackerflächen', v: [350, 450], unit: '€/ha', note: 'ab 2025, höchstens 4 % der Ackerfläche' },
  { name: 'Agroforststreifen', v: [600, 800], unit: '€/ha', note: 'ab 2025' },
];

const neu2025: Row[] = [
  { name: 'UBB — Zuschlag Belassen von Altgrasflächen', v: 150, unit: '€/ha' },
  { name: 'Zuschlag Pheromonfallen bei Zuckerrüben', v: 150, unit: '€/ha' },
  { name: 'Bio — Neueinsaat von Biodiversitätsflächen mit regionaler Acker-Saatgutmischung', v: 324, unit: '€/ha' },
  { name: 'Bio — Zuschlag für betriebsbezogene Transaktionskosten', v: 400, unit: '€/Betrieb', note: 'je Betrieb, nicht je Hektar' },
  { name: 'Almbewirtschaftung — Zuschlag Almweideplan', v: 20, unit: '€/ha', note: 'für die ersten 20 Hektar je Alm' },
];

const fmt = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 });
const val = (r: Row) => (Array.isArray(r.v) ? `${fmt(r.v[0])} – ${fmt(r.v[1])} ${r.unit}` : `${fmt(r.v)} ${r.unit}`);
const lastUpdated = new Date().toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = 'https://agro-svet.cz/de/oepul/';

const ubb = serien[0];
const bio = serien[1];

const faq = [
  { q: 'Was ist ÖPUL?', a: 'ÖPUL ist das österreichische Agrarumweltprogramm. Es bündelt die Agrarumwelt- und Klimamaßnahmen der zweiten Säule und — eine österreichische Besonderheit — auch einige Öko-Regelungen der ersten Säule, etwa die Begrünung von Ackerflächen, Tierwohl – Weide und seit 2025 die nichtproduktiven Ackerflächen. Die Teilnahme ist freiwillig; mehrjährige Verpflichtungen laufen bis 31. Dezember 2028.' },
  { q: 'Wie hoch ist die UBB-Prämie auf dem Acker?', a: `Das Basismodul „Umweltgerechte und biodiversitätsfördernde Bewirtschaftung" brachte auf Ackerflächen ${fmt(ubb.v2023)} €/ha im Jahr 2023, ${fmt(ubb.v2024)} €/ha 2024 und seit 2025 ${fmt(ubb.v2025)} €/ha. Auf das Basismodul kommen betriebsindividuell Zuschläge für zusätzliche Leistungen.` },
  { q: 'Wie hoch ist die Bio-Prämie?', a: `Auf Ackerflächen ${fmt(bio.v2023)} €/ha (2023), ${fmt(bio.v2024)} €/ha (2024) und seit 2025 ${fmt(bio.v2025)} €/ha. Im Grünland entscheidet der Tierbesatz: Seit 2024 erhalten tierhaltende Betriebe unter 1,40 RGVE je Hektar ${fmt(AT_OEPUL_BIO_GRUENLAND_MAX)} €/ha, ab 1,40 RGVE 221,4 €/ha und nicht-tierhaltende Betriebe 75,6 €/ha.` },
  { q: 'Warum sind viele Prämien seit 2024 höher?', a: 'Mit dem Impulsprogramm für die österreichische Landwirtschaft wurden ab dem Antragsjahr 2024 alle Prämiensätze der Maßnahmen nach Art. 70 und 72 der GAP-Strategieplan-Verordnung um 8 % angehoben. Nicht betroffen sind die Öko-Regelungen innerhalb von ÖPUL — Zwischenfruchtanbau, System Immergrün und Tierwohl – Weide —, die mit Prämienbändern aus dem EU-Agrargarantiefonds bezahlt werden. Die Basismodule auf dem Acker stiegen 2025 zusätzlich.' },
  { q: 'Was ist ab 2025 neu?', a: 'Vor allem die Öko-Regelung „Nichtproduktive Ackerflächen und Agroforststreifen" mit Prämienbändern von 350 bis 450 €/ha beziehungsweise 600 bis 800 €/ha. Dazu kamen Zuschläge wie das Belassen von Altgrasflächen, Pheromonfallen bei Zuckerrüben, der Almweideplan sowie in der Bio-Maßnahme ein Zuschlag für betriebsbezogene Transaktionskosten von 400 € je Betrieb.' },
  { q: 'Was bedeutet „Prämienband"?', a: 'Bei den Öko-Regelungen innerhalb von ÖPUL steht der Betrag nicht von vornherein fest. Garantiert ist der untere Wert des Bandes; wie viel darüber hinaus gezahlt wird, hängt davon ab, wie viel Fläche österreichweit beantragt wird und wie viel Geld zur Verfügung steht.' },
  { q: 'Kann man UBB und Bio kombinieren?', a: 'Nein. Ein Betrieb wählt eines der beiden Basismodule. Beide lassen sich aber mit vielen weiteren ÖPUL-Maßnahmen verbinden, etwa mit Erosionsschutz, Grundwasserschutz oder der Begrünung von Ackerflächen.' },
  { q: 'Sind die Beträge verbindlich?', a: 'Die Sätze stammen aus der Sonderrichtlinie ÖPUL 2023 und den Informationsblättern der AMA. Was ein Betrieb tatsächlich erhält, hängt von der beantragten Fläche, der Einhaltung der Auflagen und bei Prämienbändern vom verfügbaren Budget ab. Verbindlich ist der Bescheid der AMA.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `https://agro-svet.cz${localizePath('de', '/')}` },
        { '@type': 'ListItem', position: 2, name: 'ÖPUL', item: pageUrl },
      ],
    },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};

const groups: { title: string; sub: string; rows: Row[] }[] = [
  { title: 'Basismodule im Grünland', sub: 'Sätze ab dem Antragsjahr 2024.', rows: gruenland },
  { title: 'Acker, Boden und Wasser', sub: 'Sätze ab dem Antragsjahr 2024 (Impulsprogramm eingerechnet).', rows: acker },
  { title: 'Öko-Regelungen innerhalb von ÖPUL', sub: 'Prämienbänder — garantiert ist der untere Wert; keine Erhöhung durch das Impulsprogramm.', rows: oeko },
  { title: 'Neue Zuschläge ab 2025', sub: 'Sätze ab dem Antragsjahr 2025.', rows: neu2025 },
];
---

<Layout
  title="ÖPUL 2023 — Prämien des österreichischen Agrarumweltprogramms"
  description={`Die Prämien des ÖPUL je Hektar: UBB-Basismodul ${fmt(ubb.v2025)} €/ha und Bio-Basismodul ${fmt(bio.v2025)} €/ha auf dem Acker seit 2025, Grünland, Erosions- und Grundwasserschutz, Begrünung und die neuen Maßnahmen ab 2025.`}
  noHreflang={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="db">
    <div class="db-wrap">
      <nav class="db-crumb" aria-label="Brotkrumennavigation">
        <a href={localizePath('de', '/')}>Startseite</a>
        <span>/</span>
        <b>ÖPUL</b>
      </nav>

      <header class="db-head">
        <span class="db-eyebrow">Agrarumweltprogramm Österreich · Stand Antragsjahr 2025/2026</span>
        <h1>ÖPUL 2023 — Prämien je Hektar</h1>
        <p class="db-lead">
          Das österreichische Agrarumweltprogramm ist modular: Ein Betrieb wählt ein Basismodul — UBB oder
          Bio — und ergänzt es um weitere Maßnahmen und Zuschläge. Unten die Entwicklung der beiden
          Basismodule seit 2023, die aktuellen Sätze der wichtigsten Maßnahmen und die Neuerungen ab 2025.
        </p>
      </header>

      <div class="db-flag">
        <strong>Ältere Übersichten zeigen meist die Sätze von 2023.</strong> Seit dem Antragsjahr 2024
        liegen die Prämien der klassischen Agrarumweltmaßnahmen um 8 % höher (Impulsprogramm), die
        Basismodule auf dem Acker stiegen 2025 noch einmal. Die Öko-Regelungen innerhalb von ÖPUL wurden
        nicht erhöht — sie werden mit Prämienbändern bezahlt. Bei jeder Tabelle steht, ab wann der Satz gilt.
      </div>

      <section class="db-hero-stats" aria-label="Wichtigste Prämien">
        <div class="db-stat db-stat--hl">
          <span class="db-stat-l">UBB Acker · ab 2025</span>
          <b class="db-stat-v">{fmt(ubb.v2025)} <em>€/ha</em></b>
        </div>
        <div class="db-stat db-stat--hl">
          <span class="db-stat-l">Bio Acker · ab 2025</span>
          <b class="db-stat-v">{fmt(bio.v2025)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Bio Grünland · ab 2024</span>
          <b class="db-stat-v">bis {fmt(AT_OEPUL_BIO_GRUENLAND_MAX)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Agroforststreifen · ab 2025</span>
          <b class="db-stat-v">600–800 <em>€/ha</em></b>
        </div>
      </section>

      <section class="db-tables" aria-labelledby="dev-h">
        <h2 id="dev-h">Entwicklung der Basismodule auf dem Acker</h2>
        <p class="db-calc-sub">Hier sieht man beide Erhöhungen: 2024 durch das Impulsprogramm, 2025 durch
          die Anhebung der Acker-Basismodule.</p>
        <div class="db-tw">
          <table class="db-table">
            <thead>
              <tr><th scope="col">Basismodul (Ackerflächen)</th><th scope="col">2023</th><th scope="col">2024</th><th scope="col">ab 2025</th></tr>
            </thead>
            <tbody>
              {serien.map((s) => (
                <tr>
                  <td>{s.name}</td>
                  <td class="db-num">{fmt(s.v2023)} €/ha</td>
                  <td class="db-num">{fmt(s.v2024)} €/ha</td>
                  <td class="db-num"><strong>{fmt(s.v2025)} €/ha</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="db-tables" aria-labelledby="tab-h">
        <h2 id="tab-h">Prämien der einzelnen Maßnahmen</h2>
        {groups.map((g) => (
          <div class="db-tw">
            <h3>{g.title}</h3>
            <p class="db-calc-sub">{g.sub}</p>
            <table class="db-table">
              <thead>
                <tr><th scope="col">Maßnahme</th><th scope="col">Prämie</th><th scope="col">Anmerkung</th></tr>
              </thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="db-num">{val(r)}</td>
                    <td class="db-note">{r.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>

      <section class="db-explain" aria-labelledby="exp-h">
        <h2 id="exp-h">Wie ÖPUL aufgebaut ist</h2>
        <div class="db-explain-grid">
          <div class="db-exp"><h3>Basismodul zuerst</h3><p>Jeder teilnehmende Betrieb entscheidet sich für UBB oder für die biologische Wirtschaftsweise — beides zugleich geht nicht. Das Basismodul legt den Grundbetrag je Hektar fest, getrennt für Acker und Grünland.</p></div>
          <div class="db-exp"><h3>Zuschläge und Einzelmaßnahmen</h3><p>Erosionsschutz, Grundwasserschutz, Humuserhalt, Begrünung oder Pheromonfallen kommen je nach Betrieb dazu. Erst die Kombination ergibt, was ein Hektar tatsächlich bringt.</p></div>
          <div class="db-exp"><h3>Grünland nach Tierbesatz</h3><p>Im Grünland hängt der Satz davon ab, ob und wie viele Tiere gehalten werden. Bei Bio bekommen Betriebe unter 1,40 RGVE je Hektar am meisten — ein Anreiz für extensive Haltung.</p></div>
          <div class="db-exp"><h3>Mehrjährig oder einjährig</h3><p>Die Basismodule und Maßnahmen wie Erosionsschutz Acker, Grundwasserschutz oder Almbewirtschaftung sind Verpflichtungen bis Ende 2028. Andere laufen jeweils ein Kalenderjahr — darunter die Öko-Regelungen der ersten Säule: Begrünung, Tierwohl – Weide und die nichtproduktiven Ackerflächen.</p></div>
        </div>
      </section>

      <section class="db-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Häufige Fragen</h2>
        {faq.map((f) => (
          <details class="db-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="db-related">
        <a href={localizePath('de', '/direktzahlungen-oesterreich/')}>→ Direktzahlungen in Österreich — Einheitsbeträge der AMA</a>
        <a href={localizePath('de', '/oeko-regelungen/')}>→ Öko-Regelungen in Deutschland — das Gegenstück im Vergleich</a>
      </div>

      <footer class="db-src">
        <p>Datenquellen: <a href="https://www.ama.at/media/tp2fbtou/srl_oepul_2023_20261001.pdf" target="_blank" rel="noopener">Sonderrichtlinie ÖPUL 2023 (Fassung 1. Oktober 2026)</a> und die Informationsblätter zu den einzelnen Maßnahmen auf der <a href="https://www.ama.at/fachliche-informationen/oepul/merkblaetter" target="_blank" rel="noopener">AMA-Seite „ÖPUL — Merkblätter"</a>. Verbindlich ist der Bescheid der AMA. Letzte Aktualisierung dieser Seite: <strong>{lastUpdated}</strong>.</p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .db{--yellow:#FFEA00;--yellow-d:#FFD400;--ink:#0A0A0B;--line:#E7E7EA;--muted:#6E6E76;--paper:#FBFAF3;--soft:#F5F5F2;--green:#2E9E57;--red:#D6492B;
    font-family:'Chakra Petch',system-ui,sans-serif;color:var(--ink);background:#fff}
  .db-wrap{max-width:1000px;margin:0 auto;padding:26px 28px 72px}
  .db a{color:inherit}
  .db-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .db-crumb a{text-decoration:none}.db-crumb a:hover{color:var(--ink);text-decoration:underline}
  .db-crumb b{color:var(--ink)}

  .db-head{padding-bottom:22px;border-bottom:2px solid var(--ink)}
  .db-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .db-head h1{font-size:44px;letter-spacing:-.03em;font-weight:800;margin:8px 0 12px;line-height:1.02}
  .db-lead{font-size:15.5px;line-height:1.6;color:#2A2A2F;max-width:80ch}

  .db-hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
  .db-stat{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px}
  .db-stat--hl{background:var(--yellow);border-color:var(--yellow-d)}
  .db-stat .l{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .db-stat--hl .l{color:#5c5300}
  .db-stat .v{font-size:30px;font-weight:800;letter-spacing:-.02em}
  .db-stat .v small{font-size:14px;color:var(--muted);font-weight:600}
  .db-stat--hl .v small{color:#5c5300}
  .db-stat .d{font-size:12px;color:var(--muted)}
  .db-stat--hl .d{color:#5c5300}

  .db h2{font-size:24px;letter-spacing:-.02em;font-weight:800;margin:36px 0 6px}
  .db h3{font-size:16px;font-weight:800;letter-spacing:-.01em}

  .db-calc{margin-top:34px}
  .db-calc-sub{font-size:14px;color:var(--muted);margin:0 0 14px;max-width:70ch}
  .db-calc-box{display:grid;grid-template-columns:220px 1fr;gap:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:22px}
  .db-calc-field{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-calc-field input{font:800 26px 'Chakra Petch',sans-serif;color:var(--ink);border:2px solid var(--ink);border-radius:12px;padding:10px 14px;width:100%}
  .db-calc-out{display:flex;flex-direction:column;justify-content:center;gap:8px}
  .db-calc-line{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14.5px;padding:6px 0;border-bottom:1px dashed var(--line)}
  .db-calc-line em{color:var(--muted);font-style:normal;font-size:12px}
  .db-calc-line b{font-size:18px;font-weight:800;white-space:nowrap}
  .db-calc-total{border-bottom:0;margin-top:2px}
  .db-calc-total span{font-weight:700}
  .db-calc-total b{font-size:24px;background:var(--yellow);padding:2px 8px;border-radius:8px}
  .db-calc-note{font-size:12px;color:var(--muted);margin-top:10px}

  .db-tblcard{margin-top:18px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .db-tblcard h3{padding:14px 18px;background:var(--soft);border-bottom:1px solid var(--line);margin:0}
  .db-tblscroll{overflow-x:auto}
  .db-tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .db-tbl th,.db-tbl td{padding:11px 16px;text-align:left;border-bottom:1px solid var(--line)}
  .db-tbl th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-tbl th.num,.db-tbl td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .db-tbl tr:last-child td{border-bottom:0}
  .db-tbl-name{display:block;font-weight:700}
  .db-tbl-note{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .db-tbl td.strong{font-weight:800}
  .db-tbl td.unit{color:var(--muted);font-size:12.5px;white-space:nowrap}
