---
// Kvíz „Poznáš značku?" — cs-only interaktivní hra postavená nad katalogem strojů.
// Engagement + interní prolinkování na /stroje/. Non-cs locale (není v LAUNCHED_PREFIXES)
// → self-canonical, žádné hreflang alternates (noHreflang).
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import TractorQuiz from '../../../components/TractorQuiz.astro';
import { breadcrumbSchema, faqPageSchema } from '../../../lib/structured-data';
import { SITE_URL } from '../../../lib/config';

const canonical = `${SITE_URL}/kviz/poznas-znacku/`;
const title = 'Kvíz: Poznáš značku zemědělského stroje?';
const metaDescription =
  'Zábavný kvíz — uhodni výrobce traktoru, kombajnu nebo dalšího stroje podle reálné fotky. 10 otázek, okamžité skóre a odkaz na detail každého stroje.';

const faqItems = [
  {
    question: 'Jak kvíz funguje?',
    answer:
      'Ukážeme ti 10 reálných fotek zemědělské techniky. U každé vybíráš ze čtyř značek tu správnou. Po odpovědi hned uvidíš výsledek, název série a odkaz na detail stroje.',
  },
  {
    question: 'Odkud jsou fotky a data?',
    answer:
      'Fotky pocházejí z otevřených zdrojů (Wikimedia Commons) a jsou navázané na náš katalog strojů — traktory, kombajny a další techniku 22 značek. Každá otázka odkazuje na detail konkrétní série.',
  },
  {
    question: 'Kolik je otázek a dá se hrát opakovaně?',
    answer:
      'Každá hra má 10 otázek náhodně vybraných z celého katalogu, takže pokaždé dostaneš jinou sadu. Po dohrání můžeš hrát znovu a zlepšovat skóre.',
  },
];

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Domů', url: '/' },
  { name: 'Kvíz — poznáš značku?', url: canonical },
]);
const faqJsonLd = faqPageSchema(faqItems);

// GameApplication — Google u interaktivních nástrojů/her rád ukazuje jako app.
const gameJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kvíz: Poznáš značku zemědělského stroje?',
  url: canonical,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  inLanguage: 'cs',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CZK' },
  description: metaDescription,
};
---

<Layout title={title} description={metaDescription} canonical={canonical} noHreflang={true} ogImage="/images/stroje/case-ih/case-ih-farmall.webp">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(gameJsonLd)} />

  <main class="kviz-page">
    <nav class="kviz-crumbs" aria-label="Drobečková navigace">
      <a href="/">Domů</a> <span aria-hidden="true">›</span> <span>Kvíz</span>
    </nav>

    <header class="kviz-head">
      <h1>Poznáš značku zemědělského stroje?</h1>
      <p class="kviz-lede">
        Traktory Fendt, kombajny Claas, pluhy Lemken… Poznáš je od sebe podle fotky?
        Zahraj si rychlý kvíz o&nbsp;10&nbsp;otázkách a zjisti, jak dobře znáš zemědělskou techniku.
      </p>
    </header>

    <TractorQuiz />

    <section class="kviz-about">
      <h2>Jak dobře znáš zemědělské značky?</h2>
      <p>
        Každá otázka ti ukáže skutečnou fotku stroje z&nbsp;našeho <a href="/stroje/">katalogu techniky</a> —
        od ikonických traktorů přes samojízdné kombajny až po nářadí ke&nbsp;zpracování půdy.
        Vybíráš vždy ze&nbsp;čtyř výrobců a hned vidíš, jestli jsi trefil.
        Po každé odpovědi se dostaneš na detail konkrétní série s&nbsp;technickými parametry,
        historií a přehledem modelů.
      </p>
      <p>
        Chceš si značky nastudovat dopředu? Projdi <a href="/znacky/">přehled značek</a> nebo
        srovnání <a href="/srovnani/">výrobců techniky</a>.
      </p>

      <h2>Časté dotazy</h2>
      <dl class="kviz-faq">
        {faqItems.map((f) => (
          <div class="kviz-faq-item">
            <dt>{f.question}</dt>
            <dd>{f.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
</Layout>

<style>
  .kviz-page { max-width: 760px; margin: 0 auto; padding: 24px 20px 56px; }
  .kviz-crumbs { font-size: 13px; color: #6B6B72; margin-bottom: 18px; }
  .kviz-crumbs a { color: #4d7a37; text-decoration: none; }
  .kviz-crumbs a:hover { text-decoration: underline; }
  .kviz-crumbs span[aria-hidden] { margin: 0 6px; color: #b4b4bb; }

  .kviz-head h1 {
    font-size: 30px; font-weight: 800; color: #0A0A0B; margin: 0 0 12px;
    letter-spacing: -0.6px; line-height: 1.15;
  }
  .kviz-lede { font-size: 17px; color: #52525b; line-height: 1.6; margin: 0; }

  .kviz-about { margin-top: 40px; }
  .kviz-about h2 {
    font-size: 20px; font-weight: 800; color: #0A0A0B; margin: 28px 0 12px; letter-spacing: -0.3px;
  }
  .kviz-about p { font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 14px; }
  .kviz-about a { color: #4d7a37; font-weight: 600; text-decoration: none; }
  .kviz-about a:hover { text-decoration: underline; }

  .kviz-faq { margin: 0; }
  .kviz-faq-item { padding: 14px 0; border-bottom: 1px solid #eaeaec; }
  .kviz-faq-item:first-child { border-top: 1px solid #eaeaec; }
  .kviz-faq dt { font-size: 15px; font-weight: 800; color: #0A0A0B; margin-bottom: 6px; }
  .kviz-faq dd { font-size: 14px; color: #52525b; line-height: 1.6; margin: 0; }

  @media (max-width: 480px) {
    .kviz-head h1 { font-size: 25px; }
    .kviz-lede { font-size: 16px; }
  }
</style>
