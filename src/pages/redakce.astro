---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { SITE_URL } from '../lib/config';
import { breadcrumbSchema } from '../lib/structured-data';
import { t } from '../i18n/utils';

const locale = Astro.locals.locale ?? 'cs';
const isSk = locale === 'sk';
const isPl = locale === 'pl';
const isUk = locale === 'uk';
const isDe = locale === 'de';
const base = isSk ? '/sk' : isPl ? '/pl' : isUk ? '/uk' : isDe ? '/de' : '';

const breadcrumbJsonLd = breadcrumbSchema([
  { name: isSk ? 'Domov' : isPl ? 'Strona główna' : isUk ? 'Головна' : isDe ? 'Startseite' : 'Domů', url: `${base}/` },
  { name: isSk ? 'Redakcia' : isPl ? 'Redakcja' : isUk ? 'Редакція' : isDe ? 'Redaktion' : 'Redakce', url: `${base}/redakce/` },
]);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: isSk ? 'Redakcia agro-svet.cz' : isPl ? 'Redakcja agro-svet.cz' : isUk ? 'Редакція agro-svet.cz' : isDe ? 'Redaktion agro-svet.cz' : 'Redakce agro-svět.cz',
  url: `${SITE_URL}${base}/redakce/`,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png`, width: 512, height: 512 },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Samec Digital s.r.o.',
    legalName: 'Samec Digital s.r.o.',
    identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '29547539' },
    address: { '@type': 'PostalAddress', streetAddress: 'Na Břehu 378', postalCode: '387 11', addressLocality: 'Katovice', addressCountry: 'CZ' },
  },
  diversityPolicy: `${SITE_URL}${base}/redakce/`,
  ethicsPolicy: `${SITE_URL}${base}/redakce/`,
  contactPoint: { '@type': 'ContactPoint', contactType: 'editorial', email: 'info@samecdigital.com', availableLanguage: isSk ? 'Slovak' : isPl ? 'Polish' : isUk ? 'Ukrainian' : isDe ? 'German' : 'Czech' },
};
---

<Layout
  title={isSk ? 'Redakcia agro-svet.cz' : isPl ? 'Redakcja agro-svet.cz' : isUk ? 'Редакція agro-svet.cz' : isDe ? 'Redaktion agro-svet.cz' : 'Redakce agro-svět.cz'}
  description={isSk ? 'Redakcia poľnohospodárskeho portálu agro-svet.cz — kto stojí za obsahom, redakčné zásady a kontakt.' : isPl ? 'Redakcja portalu rolniczego agro-svet.cz — kto stoi za treściami, zasady redakcyjne i kontakt.' : isUk ? 'Редакція аграрного порталу agro-svet.cz — хто стоїть за контентом, редакційні засади та контакт.' : isDe ? 'Redaktion des Agrarportals agro-svet.cz — wer hinter den Inhalten steht, redaktionelle Grundsätze und Kontakt.' : 'Redakce zemědělského portálu agro-svět.cz — kdo stojí za obsahem, redakční zásady a kontakt.'}
  {/* Self-canonical pro každou locale. Dřív tu bylo `isSk ? undefined : cs URL`,
      takže /pl/redakce/ (a nově i /uk/) kanonizovalo na české znění — hreflang
      říkal „alternativa", canonical „duplikát". */}
  canonical={locale === 'cs' ? `${SITE_URL}/redakce/` : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />

  <main class="redakce">
  {isUk ? (
    <Fragment>
    <nav class="breadcrumb" aria-label={t(locale, 'a11y.breadcrumb')}>
      <a href={`${base}/`}>Головна</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Редакція</span>
    </nav>

    <header class="hero">
      <span class="kicker">Про нас</span>
      <h1>Редакція agro-svet.cz</h1>
      <p class="lead">
        Пишемо про сільське господарство, техніку, субсидії та життя на селі. Мета — давати
        аграріям корисну, перевірену та актуальну інформацію.
      </p>
    </header>

    <section class="block">
      <h2>Чим ми займаємося</h2>
      <p>
        Стежимо за новинками світу сільськогосподарської техніки, аграрною політикою ЄС, динамікою
        цін на товарних ринках і змінами в законодавстві. Ведемо енциклопедію тракторів і комбайнів,
        базу порівнянь моделей, атлас хвороб польових культур і словник аграрних термінів.
      </p>
    </section>

    <section class="block">
      <h2>Редакційні засади</h2>
      <ul>
        <li><strong>Перевірені джерела.</strong> Спираємося на офіційні дані (ČSÚ, Eurostat) і пресрелізи виробників.</li>
        <li><strong>Звідки дані.</strong> Агрономічні строки сівби та збирання, врожайність і реєстри сортів походять із чеських джерел — у тексті це завжди зазначено формулюванням „у Чехії". Для українських умов їх треба брати як орієнтир, не як норму.</li>
        <li><strong>Виправлення.</strong> Якщо в тексті з'явиться помилка, виправляємо її та позначаємо дату зміни.</li>
        <li><strong>Розділення контенту й реклами.</strong> Комерційні матеріали завжди чітко позначені.</li>
        <li><strong>Зворотний зв'язок.</strong> Зауваження читачів вітаємо й відповідаємо на них.</li>
      </ul>
    </section>

    <section class="block">
      <h2>Контакт</h2>
      <p>
        Щодо тем, пресрелізів і загальних запитань пишіть на
        <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
        Щодо рекламної співпраці використайте ту саму адресу з темою „Реклама".
      </p>
      <p class="provoz">
        Сайт веде <a href="https://samecdigital.com" target="_blank" rel="noopener">Samec Digital s.r.o.</a>,
        IČO 29547539, юридична адреса Na Břehu 378, 387 11 Katovice, Чехія.
      </p>
    </section>
    </Fragment>
  ) : isPl ? (
    <Fragment>
    <nav class="breadcrumb" aria-label="Nawigacja okruszkowa">
      <a href={`${base}/`}>Strona główna</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Redakcja</span>
    </nav>

    <header class="hero">
      <span class="kicker">O nas</span>
      <h1>Redakcja agro-svet.cz</h1>
      <p class="lead">
        Piszemy o rolnictwie, technice, dopłatach i życiu na wsi. Naszym celem jest dostarczać
        rolnikom użyteczne, sprawdzone i aktualne informacje — z Polski i ze świata.
      </p>
    </header>

    <section class="block">
      <h2>Czym się zajmujemy</h2>
      <p>
        Śledzimy nowości ze świata techniki rolniczej, europejską politykę dopłat, zmiany cen
        towarów rolnych i zmiany w przepisach. Prowadzimy też encyklopedię traktorów i kombajnów,
        bazę ras zwierząt gospodarskich oraz atlas chorób roślin uprawnych.
      </p>
    </section>

    <section class="block">
      <h2>Zasady redakcyjne</h2>
      <ul>
        <li><strong>Sprawdzone źródła.</strong> Opieramy się na danych urzędowych (GUS, ARiMR, Eurostat) i informacjach prasowych producentów.</li>
        <li><strong>Sprostowania.</strong> Jeśli w tekście pojawi się błąd, poprawiamy go i oznaczamy datę zmiany.</li>
        <li><strong>Rozdział treści i reklam.</strong> Materiały komercyjne są zawsze wyraźnie oznaczone.</li>
        <li><strong>Informacje lokalne.</strong> Stawki dopłat i przepisy podajemy dla Polski; tam, gdzie dane pochodzą z Czech, wyraźnie to zaznaczamy.</li>
        <li><strong>Informacja zwrotna.</strong> Uwagi czytelników są mile widziane i odpowiadamy na nie.</li>
      </ul>
    </section>

    <section class="block">
      <h2>Kontakt</h2>
      <p>
        W sprawie tematów, informacji prasowych i pytań ogólnych napisz na
        <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
        W sprawie współpracy reklamowej użyj tego samego adresu z tematem „Reklama".
      </p>
      <p class="provoz">
        Serwis prowadzi <a href="https://samecdigital.com" target="_blank" rel="noopener">Samec Digital s.r.o.</a>,
        IČO 29547539, z siedzibą Na Břehu 378, 387 11 Katovice, Czechy.
      </p>
    </section>
    </Fragment>
  ) : isSk ? (
    <Fragment>
    <nav class="breadcrumb" aria-label={t(locale, 'a11y.breadcrumb')}>
      <a href={`${base}/`}>Domov</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Redakcia</span>
    </nav>

    <header class="hero">
      <span class="kicker">O nás</span>
      <h1>Redakcia agro-svet.cz</h1>
      <p class="lead">
        Píšeme o poľnohospodárstve, technike, dotáciách a živote na vidieku. Cieľom je dávať
        poľnohospodárom užitočné, overené a aktuálne informácie z domova aj zo sveta.
      </p>
    </header>

    <section class="block">
      <h2>Čo robíme</h2>
      <p>
        Sledujeme novinky zo sveta poľnohospodárskej techniky, európskej dotačnej politiky, vývoj
        cien komodít a legislatívne zmeny. Prevádzkujeme tiež encyklopédiu traktorov a kombajnov,
        databázu plemien hospodárskych zvierat a bazár poľnohospodárskej techniky.
      </p>
    </section>

    <section class="block">
      <h2>Redakčné zásady</h2>
      <ul>
        <li><strong>Overené zdroje.</strong> Vychádzame z oficiálnych dát (ČSÚ, MZe, Eurostat) a tlačových správ výrobcov.</li>
        <li><strong>Korekcie.</strong> Ak sa v texte objaví chyba, opravíme ju a označíme dátum úpravy.</li>
        <li><strong>Oddelenie obsahu a inzercie.</strong> Komerčný obsah je vždy zreteľne označený.</li>
        <li><strong>Spätná väzba.</strong> Podnety čitateľov vítame a reagujeme na ne.</li>
      </ul>
    </section>

    <section class="block">
      <h2>Kontakt</h2>
      <p>
        Pre tipy, tlačové správy a všeobecné otázky napíšte na
        <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
        Pre inzertnú spoluprácu využite rovnaký kontakt s predmetom „Inzercia".
      </p>
      <p class="provoz">
        Web prevádzkuje <a href="https://samecdigital.com" target="_blank" rel="noopener">Samec Digital s.r.o.</a>,
        IČO 29547539, so sídlom Na Břehu 378, 387 11 Katovice.
      </p>
    </section>
    </Fragment>
  ) : isDe ? (
    <Fragment>
    <nav class="breadcrumb" aria-label="Brotkrumen-Navigation">
      <a href={`${base}/`}>Startseite</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Redaktion</span>
    </nav>

    <header class="hero">
      <span class="kicker">Über uns</span>
      <h1>Redaktion agro-svet.cz</h1>
      <p class="lead">
        Wir schreiben über Landwirtschaft, Technik, Förderung und das Leben auf dem Land. Unser Ziel
        ist es, Landwirtinnen und Landwirten nützliche, geprüfte und aktuelle Informationen zu
        liefern — aus Deutschland, Österreich und der Welt.
      </p>
    </header>

    <section class="block">
      <h2>Womit wir uns beschäftigen</h2>
      <p>
        Wir verfolgen Neuheiten aus der Landtechnik, die europäische Förderpolitik, die Entwicklung
        der Agrarpreise und Änderungen der Vorschriften. Außerdem pflegen wir eine Enzyklopädie der
        Traktoren und Mähdrescher, eine Datenbank der Nutztierrassen sowie einen Atlas der
        Krankheiten von Feldkulturen.
      </p>
    </section>

    <section class="block">
      <h2>Redaktionelle Grundsätze</h2>
      <ul>
        <li><strong>Geprüfte Quellen.</strong> Wir stützen uns auf amtliche Daten (Destatis, BMLEH, AMA, Statistik Austria, Eurostat) und auf Pressemitteilungen der Hersteller.</li>
        <li><strong>Berichtigungen.</strong> Enthält ein Text einen Fehler, korrigieren wir ihn und weisen das Datum der Änderung aus.</li>
        <li><strong>Trennung von Inhalt und Werbung.</strong> Kommerzielle Beiträge sind stets deutlich gekennzeichnet.</li>
        <li><strong>Förderbeträge.</strong> Die Einheitsbeträge geben wir für Deutschland und Österreich an, jeweils mit Quelle und Stand. Wo wir zwischen endgültigen und geplanten Beträgen unterscheiden müssen, sagen wir es ausdrücklich.</li>
        <li><strong>Regionale Angaben.</strong> Stammen Daten aus Tschechien, kennzeichnen wir das eindeutig — etwa bei Preisangaben des tschechischen Marktes.</li>
        <li><strong>Rückmeldungen.</strong> Hinweise unserer Leserinnen und Leser sind willkommen, und wir beantworten sie.</li>
      </ul>
    </section>

    <section class="block">
      <h2>Kontakt</h2>
      <p>
        Für Themenvorschläge, Pressemitteilungen und allgemeine Fragen schreiben Sie an
        <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
        Für Werbekooperationen nutzen Sie dieselbe Adresse mit dem Betreff „Werbung".
      </p>
      <p class="provoz">
        Betrieben wird das Portal von <a href="https://samecdigital.com" target="_blank" rel="noopener">Samec Digital s.r.o.</a>,
        IČO 29547539, mit Sitz Na Břehu 378, 387 11 Katovice, Tschechische Republik.
      </p>
    </section>
    </Fragment>
  ) : (
    <Fragment>
    <nav class="breadcrumb" aria-label={t(locale, 'a11y.breadcrumb')}>
      <a href="/">Domů</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Redakce</span>
    </nav>

    <header class="hero">
      <span class="kicker">O nás</span>
      <h1>Redakce agro-svět.cz</h1>
      <p class="lead">
        Píšeme o zemědělství, technice, dotacích a životě na vesnici. Cílem je dávat zemědělcům
        užitečné, ověřené a aktuální informace z domova i ze světa.
      </p>
    </header>

    <section class="block">
      <h2>Co děláme</h2>
      <p>
        Sledujeme novinky ze světa zemědělské techniky, evropské dotační politiky, vývoj cen
        komodit a legislativní změny. Provozujeme rovněž encyklopedii traktorů a kombajnů,
        databázi plemen hospodářských zvířat a bazar zemědělské techniky.
      </p>
    </section>

    <section class="block">
      <h2>Redakční zásady</h2>
      <ul>
        <li><strong>Ověřené zdroje.</strong> Vycházíme z oficiálních dat (ČSÚ, MZe, Eurostat) a tiskových zpráv výrobců.</li>
        <li><strong>Korekce.</strong> Pokud se v textu objeví chyba, opravíme ji a označíme datum úpravy.</li>
        <li><strong>Oddělení obsahu a inzerce.</strong> Komerční obsah je vždy zřetelně označen.</li>
        <li><strong>Zpětná vazba.</strong> Podněty čtenářů vítáme a reagujeme na ně.</li>
      </ul>
    </section>

    <section class="block">
      <h2>Kontakt</h2>
      <p>
        Pro tipy, tiskové zprávy a obecné dotazy napište na
        <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
        Pro inzertní spolupráci využijte stejný kontakt s předmětem „Inzerce".
      </p>
      <p class="provoz">
        Web provozuje <a href="https://samecdigital.com" target="_blank" rel="noopener">Samec Digital s.r.o.</a>,
        IČO 29547539, se sídlem Na Břehu 378, 387 11 Katovice.
      </p>
    </section>
    </Fragment>
  )}
  </main>

  <style>
    .redakce {
      max-width: 760px;
      margin: 0 auto;
      padding: 32px 24px 96px;
    }
    .breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      background: #FBFAF4;
      border: 1.5px solid #0A0A0B;
      border-radius: 10px;
      font: 600 12px 'Chakra Petch', sans-serif;
      color: #0A0A0B;
      margin-bottom: 28px;
      box-shadow: 2px 2px 0 #0A0A0B;
    }
    .breadcrumb a { color: #6B6B72; text-decoration: none; }
    .breadcrumb a:hover { color: #0A0A0B; }
    .breadcrumb span[aria-hidden] { color: #c0c0c5; }
    .hero { margin-bottom: 40px; padding-bottom: 24px; border-bottom: 2px dashed #EAEAEC; }
    .kicker {
      display: inline-block;
      padding: 5px 11px;
      background: #FFFF00;
      border: 1.5px solid #0A0A0B;
      border-radius: 8px;
      box-shadow: 3px 3px 0 #0A0A0B;
      font: 700 11px 'Chakra Petch', sans-serif;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: #0A0A0B;
      margin-bottom: 18px;
    }
    h1 {
      font: 800 clamp(2rem, 5vw, 3rem) 'Chakra Petch', sans-serif;
      letter-spacing: -.025em;
      color: #0A0A0B;
      margin: 0 0 14px;
      line-height: 1.1;
    }
    .lead { font-size: 17px; line-height: 1.65; color: #555; max-width: 620px; }
    .block { margin-bottom: 36px; }
    .block h2 {
      font: 700 1.4rem 'Chakra Petch', sans-serif;
      color: #0A0A0B;
      margin-bottom: 12px;
    }
    .block p { font-size: 16px; line-height: 1.7; color: #444; margin-bottom: 12px; }
    .block ul { padding-left: 1.2em; margin: 0 0 12px; }
    .block li { font-size: 16px; line-height: 1.7; color: #444; margin-bottom: 8px; }
    .block a { color: #0A0A0B; }
    .provoz { font-size: 14px; color: #6B6B72; margin-top: 16px; }
  </style>
</Layout>
