---
// prerender=false (SSR): launchnuté ne-cs locale servíruje middleware rewrite,
// který prerendered routy nepokrývá. Proto žádné getStaticPaths — ticker se
// hledá z Astro.params a neznámý vrací 404.
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../../lib/structured-data';
import { SITE_URL } from '../../../lib/config';
import { AKCIE } from '../../../data/akcie-agro';
import { akcieText } from '../../../data/akcie-agro-pl';
import { akcieCopy } from '../../../i18n/akcie';
import { localizeInternalHref } from '../../../i18n/utils';
import { AKCIE_DB_ZNACKY, ZNACKA_LABEL, ZNACKA_LOGO, svetSlugProVlajku } from '../../../lib/agro-integrace';

const raw = AKCIE.find((x) => x.ticker === Astro.params.ticker);
if (!raw) return new Response('Not found', { status: 404 });

const locale = Astro.locals.locale ?? 'cs';
const c = akcieCopy(locale);
// Kurátorské texty přes overlay — přímé raw.popis by do /pl vrátilo češtinu.
const a = akcieText(raw, locale);
Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

const canonical = `${SITE_URL}/akcie/${a.ticker}/`;
const href = (p: string) => localizeInternalHref(locale, p);

const znacky = AKCIE_DB_ZNACKY[a.ticker] ?? [];
const svetSlug = svetSlugProVlajku(a.zeme);
const kratkyNazev = a.nazev.split(' (')[0];
// „Zastoupení v ČR“ je informace o českém trhu — pod /pl by to byla rada mimo
// zemi čtenáře (Polsko má vlastní distributory), tak se mimo cs neukazuje.
const zastoupeni = locale === 'cs' ? a.czZastoupeni : undefined;

const metaTitle = c.detailTitleTpl.replace('{name}', kratkyNazev).replace('{ticker}', a.ticker);
const metaDescription = c.detailDescriptionTpl.replace('{name}', kratkyNazev).replace('{profil}', a.profil);

const breadcrumbJsonLd = breadcrumbSchema([
  { name: c.crumbHome, url: '/' },
  { name: c.crumbData, url: '/data/' },
  { name: c.crumbSelf, url: `${SITE_URL}/akcie/` },
  { name: kratkyNazev, url: canonical },
]);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Corporation',
  name: kratkyNazev,
  tickerSymbol: a.ticker,
  url: a.web,
  ...(a.sidlo ? { location: a.sidlo } : {}),
  ...(a.zalozeno ? { foundingDate: String(a.zalozeno) } : {}),
  ...(a.popis ? { description: a.popis } : {}),
};
---

<Layout
  title={metaTitle}
  description={metaDescription}
  canonical={locale === 'cs' ? canonical : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />

  <main class="ad" data-ticker={a.ticker} data-mena={a.mena} data-numlocale={c.numberLocale} data-bln={c.bln} data-chartaria={c.chartAria} data-periodsuffix={c.chartPeriodSuffix}>
    <section class="ad-hero">
      <div class="ad-lines"></div>
      <div class="ad-wrap ad-hero-in">
        <nav class="ad-bc" aria-label={c.crumbAria}>
          <a href={href('/')}>{c.crumbHome}</a><span>›</span><a href={href('/data/')}>{c.crumbData}</a><span>›</span><a href={href('/akcie/')}>{c.crumbAkcie}</a><span>›</span><span class="cur">{kratkyNazev}</span>
        </nav>
        <div class="ad-head">
          <div>
            <span class="ad-cat">{a.zeme} {c.kategorie[a.kategorie]}</span>
            <h1>{kratkyNazev}</h1>
            <div class="ad-sub"><span class="ad-ticker">{a.ticker}</span> <span class="ad-burza">{a.burza} · {a.mena}</span></div>
          </div>
          <div class="ad-quote" id="adQuote">
            <div class="ad-price" id="adPrice">—</div>
            <div class="ad-chg" id="adChg"></div>
          </div>
        </div>
      </div>
    </section>

    <div class="ad-body"><div class="ad-wrap">

      <div class="ad-disclaimer">
        <strong>{c.detailDisclaimerStrong}</strong> {c.detailDisclaimerText}
      </div>

      <!-- FUNDAMENT -->
      <section class="ad-block">
        <h2>{c.metricsTitle}</h2>
        <div class="ad-metrics" id="adMetrics">
          <div class="ad-metric"><span class="l">{c.mCap}</span><b id="mCap">—</b></div>
          <div class="ad-metric"><span class="l">{c.mPe}</span><b id="mPe">—</b></div>
          <div class="ad-metric"><span class="l">{c.mDiv}</span><b id="mDiv">—</b></div>
          <div class="ad-metric"><span class="l">{c.mInd}</span><b id="mInd">—</b></div>
        </div>
        <div class="ad-range" id="adRange" hidden>
          <div class="ad-range-head"><span>{c.range52}</span><span id="rVals"></span></div>
          <div class="ad-range-bar"><span class="ad-range-fill" id="rFill"></span><span class="ad-range-dot" id="rDot"></span></div>
        </div>
      </section>

      <!-- GRAF KURZU -->
      <section class="ad-block ad-chart-block" id="adChartBlock" hidden>
        <div class="ad-chart-head">
          <h2>{c.chartTitle}</h2>
          <div class="ad-chart-ranges" id="adChartRanges" role="group" aria-label={c.chartRangesAria}>
            <button type="button" data-r="21">1M</button>
            <button type="button" data-r="126">6M</button>
            <button type="button" data-r="0" class="active">1R</button>
          </div>
        </div>
        <div class="ad-chart" id="adChart">
          <span class="ad-chart-cross" id="adCross"></span>
          <span class="ad-chart-dot" id="adDot"></span>
          <div class="ad-chart-tip" id="adChartTip" hidden></div>
          <span class="ad-chart-empty" id="adChartEmpty">{c.chartLoading}</span>
        </div>
        <div class="ad-chart-foot"><span id="adChartMeta"></span><span>{c.chartSource}</span></div>
      </section>

      <!-- PROFIL -->
      {a.popis && (
        <section class="ad-block">
          <h2>{c.profileTitle}</h2>
          <p class="ad-text">{a.popis}</p>
          <div class="ad-facts">
            {a.sidlo && <div class="ad-fact"><span class="l">{c.factHq}</span><b>{a.sidlo}</b></div>}
            {a.zalozeno && <div class="ad-fact"><span class="l">{c.factFounded}</span><b>{a.zalozeno}</b></div>}
            {a.reditel && <div class="ad-fact"><span class="l">{c.factCeo}</span><b>{a.reditel}</b></div>}
            {a.obrat && <div class="ad-fact"><span class="l">{c.factRevenue}</span><b>{a.obrat}</b></div>}
          </div>
        </section>
      )}

      <!-- NAŠE PRODUKTY -->
      {znacky.length > 0 && (
        <section class="ad-block">
          <h2>{znacky.length > 1 ? c.brandsTitleMulti : c.brandsTitleSingle}</h2>
          <p class="ad-text">{c.brandsLede}</p>
          <div class="ad-brands">
            {znacky.map((z) => (
              <div class="ad-brandrow">
                {ZNACKA_LOGO[z] && <img class="ad-brandlogo" src={ZNACKA_LOGO[z]} alt={`${c.logoAlt} ${ZNACKA_LABEL[z] ?? z}`} loading="lazy" decoding="async" />}
                <span class="ad-brandname">{ZNACKA_LABEL[z] ?? z}</span>
                <a href={href(`/stroje/${z}/`)}>{c.brandsModels}</a>
                <a href={href(`/znacky/${z}/`)}>{c.brandsProfile}</a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ÚSPĚCHY -->
      {a.uspechy && a.uspechy.length > 0 && (
        <section class="ad-block">
          <h2>{c.achievementsTitle}</h2>
          <ul class="ad-list">
            {a.uspechy.map((u) => <li>{u}</li>)}
          </ul>
        </section>
      )}

      <!-- ZASTOUPENÍ V ČR -->
      {zastoupeni && zastoupeni.length > 0 && (
        <section class="ad-block">
          <h2>Zastoupení v Česku</h2>
          <p class="ad-text">Prodej a servis v ČR zajišťuje:</p>
          <ul class="ad-list">
            {zastoupeni.map((d) => <li><a href={d.url} target="_blank" rel="nofollow noopener">{d.name}</a></li>)}
          </ul>
        </section>
      )}

      <!-- ODKAZY -->
      <section class="ad-block ad-links">
        <h2>{c.linksTitle}</h2>
        <p class="ad-cross">
          → <a href={a.web} target="_blank" rel="nofollow noopener">{c.linkWeb}</a><br>
          {svetSlug && <>→ <a href={href(`/svet/${svetSlug}/`)}>{c.linkCountry}</a><br /></>}
          → <a href={href('/akcie/')}>{c.linkAll}</a><br>
          → <a href={href('/data/prodeje-techniky/')}>{c.linkSales}</a>
        </p>
      </section>

    </div></div>
  </main>

  <script is:inline>
    (function () {
      var root = document.querySelector('.ad[data-ticker]');
      if (!root) return;
      var t = root.getAttribute('data-ticker');
      var mena = root.getAttribute('data-mena') || 'USD';
      var NUM = root.getAttribute('data-numlocale') || 'cs-CZ';
      var BLN = root.getAttribute('data-bln') || 'mld.';
      var CHART_ARIA = root.getAttribute('data-chartaria') || '';
      var PERIOD_SUFFIX = root.getAttribute('data-periodsuffix') || '';
      function fmt(n, d) { return Number(n).toLocaleString(NUM, { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }); }
      fetch('/api/akcie/' + encodeURIComponent(t) + '.json/', { headers: { accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (!res || !res.ok) return;
          if (res.kurz && typeof res.kurz.cena === 'number') {
            document.getElementById('adPrice').textContent = fmt(res.kurz.cena, 2) + ' ' + mena;
            var dp = res.kurz.zmenaPct;
            if (typeof dp === 'number') {
              var el = document.getElementById('adChg');
              el.textContent = (dp >= 0 ? '▲ ' : '▼ ') + Math.abs(dp).toFixed(2) + ' %';
              el.className = 'ad-chg ' + (dp >= 0 ? 'up' : 'dn');
            }
          }
          var p = res.profil || {}, m = res.metriky || {};
          if (p.marketCap) document.getElementById('mCap').textContent = '≈ ' + fmt(p.marketCap / 1000, 1) + ' ' + BLN + ' ' + (p.mena || 'USD');
          if (m.pe) document.getElementById('mPe').textContent = fmt(m.pe, 1);
          if (m.dividendYield) document.getElementById('mDiv').textContent = fmt(m.dividendYield, 2) + ' %';
          if (p.odvetvi) document.getElementById('mInd').textContent = p.odvetvi;
          if (m.high52 && m.low52 && res.kurz && res.kurz.cena) {
            var lo = m.low52, hi = m.high52, cur = res.kurz.cena;
            var pos = Math.max(0, Math.min(100, ((cur - lo) / (hi - lo)) * 100));
            document.getElementById('rVals').textContent = fmt(lo, 2) + ' – ' + fmt(hi, 2) + ' ' + mena;
            document.getElementById('rFill').style.width = pos + '%';
            document.getElementById('rDot').style.left = pos + '%';
            document.getElementById('adRange').hidden = false;
          }
          initChart(res.historie);
        })
        .catch(function () {});

      // ── Interaktivní graf kurzu (Yahoo historie) ──
      function initChart(hist) {
        var block = document.getElementById('adChartBlock');
        var chartEl = document.getElementById('adChart');
        if (!block || !chartEl) return;
        if (!hist || !hist.c || hist.c.length < 2) { block.hidden = true; return; }
        block.hidden = false;
        var empty = document.getElementById('adChartEmpty');
        var cross = document.getElementById('adCross');
        var dot = document.getElementById('adDot');
        var tip = document.getElementById('adChartTip');
        var meta = document.getElementById('adChartMeta');
        var fullT = hist.t, fullC = hist.c;
        var W = 800, H = 240, padX = 6, padTop = 12, padBot = 20;
        var st = null;

        function draw(n) {
          var c = (!n || n >= fullC.length) ? fullC : fullC.slice(-n);
          var t = (!n || n >= fullT.length) ? fullT : fullT.slice(-n);
          var min = Math.min.apply(null, c), max = Math.max.apply(null, c);
          var span = (max - min) || 1;
          var X = function (i) { return padX + (i / (c.length - 1)) * (W - 2 * padX); };
          var Y = function (v) { return padTop + (1 - (v - min) / span) * (H - padTop - padBot); };
          var line = '';
          for (var i = 0; i < c.length; i++) line += (i === 0 ? 'M' : 'L') + X(i).toFixed(1) + ',' + Y(c[i]).toFixed(1) + ' ';
          var area = line + 'L' + X(c.length - 1).toFixed(1) + ',' + (H - padBot) + ' L' + X(0).toFixed(1) + ',' + (H - padBot) + ' Z';
          var up = c[c.length - 1] >= c[0];
          var stroke = up ? '#2E9E57' : '#C0392B';
          var fill = up ? 'rgba(46,158,87,.10)' : 'rgba(192,57,43,.10)';
          var old = chartEl.querySelector('svg'); if (old) old.remove();
          chartEl.insertAdjacentHTML('afterbegin',
            '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img" aria-label="' + CHART_ARIA + '" style="display:block;width:100%;height:100%">' +
            '<path d="' + area + '" fill="' + fill + '"/>' +
            '<path d="' + line + '" fill="none" stroke="' + stroke + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>');
          if (empty) empty.hidden = true;
          dot.style.background = stroke;
          st = { t: t, c: c, X: X, Y: Y };
          var chg = ((c[c.length - 1] - c[0]) / c[0]) * 100;
          if (meta) meta.textContent = (chg >= 0 ? '+' : '') + chg.toFixed(1) + PERIOD_SUFFIX;
        }

        function move(ev) {
          if (!st) return;
          var rect = chartEl.getBoundingClientRect();
          var cx = ev.touches ? ev.touches[0].clientX : ev.clientX;
          var frac = Math.max(0, Math.min(1, (cx - rect.left) / rect.width));
          var idx = Math.round(frac * (st.c.length - 1));
          var pxX = (st.X(idx) / W) * rect.width;
          var pxY = (st.Y(st.c[idx]) / H) * rect.height;
          cross.style.left = pxX + 'px'; cross.style.opacity = '1';
          dot.style.left = pxX + 'px'; dot.style.top = pxY + 'px'; dot.style.opacity = '1';
          var d = new Date(st.t[idx] * 1000);
          var ds = d.toLocaleDateString(NUM, { day: 'numeric', month: 'short', year: 'numeric' });
          tip.innerHTML = '<b>' + fmt(st.c[idx], 2) + ' ' + mena + '</b><span>' + ds + '</span>';
          tip.hidden = false;
          var tw = tip.offsetWidth;
          tip.style.left = Math.max(4, Math.min(rect.width - tw - 4, pxX - tw / 2)) + 'px';
        }
        function leave() { cross.style.opacity = '0'; dot.style.opacity = '0'; tip.hidden = true; }

        chartEl.addEventListener('mousemove', move);
        chartEl.addEventListener('mouseleave', leave);
        chartEl.addEventListener('touchstart', move, { passive: true });
        chartEl.addEventListener('touchmove', move, { passive: true });

        var ranges = document.getElementById('adChartRanges');
        if (ranges) ranges.addEventListener('click', function (e) {
          var btn = e.target.closest ? e.target.closest('button') : null;
          if (!btn) return;
          var bs = ranges.querySelectorAll('button');
          for (var i = 0; i < bs.length; i++) bs[i].classList.remove('active');
          btn.classList.add('active');
          leave();
          draw(parseInt(btn.getAttribute('data-r'), 10) || 0);
        });

        draw(0);
      }
    })();
  </script>
</Layout>

<style>
  .ad { --yellow:#FFEA00; --ink:#0A0A0B; --line:#E7E7EA; --muted:#6E6E76; --soft:#F5F5F2; --green:#2E9E57;
    font-family:'Chakra Petch',system-ui,sans-serif; background:#fff; color:var(--ink); line-height:1.55; }
  .ad-wrap { max-width:860px; margin:0 auto; padding:0 24px; }
  .ad a { color:inherit; }

  .ad-hero { background:var(--ink); color:#fff; position:relative; overflow:hidden; }
  .ad-hero::before { content:""; position:absolute; inset:0; background:radial-gradient(600px 300px at 90% -10%, rgba(255,234,0,.16), transparent 60%); }
  .ad-lines { position:absolute; inset:0; opacity:.05; background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px); background-size:44px 44px; }
  .ad-hero-in { position:relative; z-index:1; padding:22px 24px 30px; }
  .ad-bc { font-size:12.5px; color:rgba(255,255,255,.55); display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
  .ad-bc a { color:rgba(255,255,255,.7); text-decoration:none; } .ad-bc a:hover { color:#fff; } .ad-bc .cur { color:#fff; }
  .ad-head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .ad-cat { font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--yellow); }
  .ad-head h1 { font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; letter-spacing:-.02em; margin:8px 0 8px; }
  .ad-sub { display:flex; align-items:center; gap:10px; }
  .ad-ticker { font-size:13px; font-weight:800; color:var(--ink); background:var(--yellow); border-radius:5px; padding:3px 9px; }
  .ad-burza { font-size:13px; color:rgba(255,255,255,.7); }
  .ad-quote { text-align:right; }
  .ad-price { font-size:30px; font-weight:800; font-variant-numeric:tabular-nums; }
  .ad-chg { font-size:14px; font-weight:800; font-variant-numeric:tabular-nums; }
  .ad-chg.up { color:#7CE0A0; } .ad-chg.dn { color:#FF9B84; }

  .ad-body { padding:32px 0 80px; }
  .ad-disclaimer { font-size:13px; line-height:1.6; color:#5a4a00; background:#fffbe6; border:1px solid #ffe66b; border-left:4px solid var(--yellow); border-radius:10px; padding:12px 14px; margin-bottom:30px; }
  .ad-disclaimer strong { color:#0A0A0B; }
  .ad-block { margin-bottom:32px; }
  .ad-block h2 { font-size:19px; font-weight:800; letter-spacing:-.01em; margin:0 0 14px; padding-bottom:8px; border-bottom:2px solid var(--ink); }
  .ad-text { font-size:15.5px; line-height:1.7; color:#333; margin:0 0 16px; }

  .ad-metrics { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px; }
  .ad-metric { background:var(--soft); border-radius:10px; padding:12px 14px; }
  .ad-metric .l { display:block; font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:4px; }
  .ad-metric b { font-size:17px; font-variant-numeric:tabular-nums; }
  .ad-range { margin-top:16px; }
  .ad-range-head { display:flex; justify-content:space-between; font-size:12.5px; color:var(--muted); margin-bottom:6px; font-variant-numeric:tabular-nums; }
  .ad-range-bar { position:relative; height:8px; background:var(--soft); border-radius:5px; }
  .ad-range-fill { position:absolute; left:0; top:0; bottom:0; background:linear-gradient(90deg,#fff2a8,#ffe11f); border-radius:5px; }
  .ad-range-dot { position:absolute; top:50%; width:14px; height:14px; border-radius:50%; background:var(--ink); border:2px solid var(--yellow); transform:translate(-50%,-50%); }

  .ad-chart-block h2 { border:none; padding-bottom:0; margin:0; }
  .ad-chart-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
  .ad-chart-ranges { display:flex; gap:4px; }
  .ad-chart-ranges button { font:700 12px 'Chakra Petch',sans-serif; padding:4px 11px; border:1.5px solid var(--line); background:#fff; color:var(--muted); border-radius:6px; cursor:pointer; }
  .ad-chart-ranges button.active { background:var(--ink); color:#fff; border-color:var(--ink); }
  .ad-chart { position:relative; width:100%; height:230px; border:1.5px solid var(--line); border-radius:12px; background:var(--soft); overflow:hidden; touch-action:none; }
  .ad-chart svg { display:block; width:100%; height:100%; }
  .ad-chart-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:13px; color:var(--muted); }
  .ad-chart-cross { position:absolute; top:0; bottom:0; width:1px; background:rgba(10,10,11,.3); opacity:0; pointer-events:none; transition:opacity .1s; }
  .ad-chart-dot { position:absolute; width:11px; height:11px; border-radius:50%; background:var(--ink); border:2px solid #fff; box-shadow:0 1px 4px rgba(0,0,0,.35); transform:translate(-50%,-50%); opacity:0; pointer-events:none; }
  .ad-chart-tip { position:absolute; top:8px; background:var(--ink); color:#fff; font-size:12px; line-height:1.35; padding:5px 9px; border-radius:7px; pointer-events:none; white-space:nowrap; z-index:2; box-shadow:0 4px 12px rgba(0,0,0,.25); }
  .ad-chart-tip b { display:block; font-variant-numeric:tabular-nums; }
  .ad-chart-tip span { font-size:11px; opacity:.7; }
  .ad-chart-foot { display:flex; justify-content:space-between; gap:12px; font-size:11.5px; color:var(--muted); margin-top:8px; flex-wrap:wrap; }

  .ad-facts { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; }
  .ad-fact { border:1.5px solid var(--line); border-radius:10px; padding:11px 14px; }
  .ad-fact .l { display:block; font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:3px; }
  .ad-fact b { font-size:15px; }

  .ad-brands { display:flex; flex-direction:column; gap:10px; }
  .ad-brandrow { display:flex; align-items:center; gap:14px; flex-wrap:wrap; border:1.5px solid var(--line); border-radius:10px; padding:12px 14px; }
  .ad-brandlogo { height:26px; max-width:96px; width:auto; object-fit:contain; flex-shrink:0; }
  .ad-brandname { font-weight:800; flex:1; min-width:100px; }
  .ad-brandrow a { color:var(--green); text-decoration:underline; font-size:14px; font-weight:600; }

  .ad-list { margin:0; padding-left:20px; font-size:15px; line-height:1.7; }
  .ad-list li { margin-bottom:6px; }
  .ad-list a { color:var(--green); text-decoration:underline; }

