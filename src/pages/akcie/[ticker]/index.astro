---
// prerender=false (SSR): launchnuté ne-cs locale servíruje middleware rewrite,
// který prerendered routy nepokrývá. Proto žádné getStaticPaths — ticker se
// hledá z Astro.params a neznámý vrací 404.
export const prerender = false;
// 2026-10-16: kurz, 52týdenní rozpětí a graf (Yahoo Finance) i fundamenty
// (Finnhub) pryč — podmínky obou zakazují komerční použití a redistribuci.
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../../lib/structured-data';
import { SITE_URL } from '../../../lib/config';
import { AKCIE } from '../../../data/akcie-agro';
import { akcieText } from '../../../data/akcie-agro-pl';
import { akcieCopy } from '../../../i18n/akcie';
import { localizeInternalHref } from '../../../i18n/utils';
import { isWithdrawnPath } from '../../../i18n/config';
import { AKCIE_DB_ZNACKY, ZNACKA_LABEL, ZNACKA_LOGO, svetSlugProVlajku } from '../../../lib/agro-integrace';
import PhotoCredits from '../../../components/PhotoCredits.astro';

const raw = AKCIE.find((x) => x.ticker === Astro.params.ticker);
if (!raw) return new Response('Not found', { status: 404 });

const locale = Astro.locals.locale ?? 'cs';
const c = akcieCopy(locale);
// Kurátorské texty přes overlay — přímé raw.popis by do /pl vrátilo češtinu.
const a = akcieText(raw, locale);
Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

const canonical = `${SITE_URL}/akcie/${a.ticker}/`;
const href = (p: string) => localizeInternalHref(locale, p);

const znacky = AKCIE_DB_ZNACKY[a.ticker] ?? [];
// /svet je pod de stažený (licence geometrií map) — odkaz by vedl na 410.
const svetSlug = isWithdrawnPath(locale, '/svet') ? null : svetSlugProVlajku(a.zeme);
const kratkyNazev = a.nazev.split(' (')[0];
// „Zastoupení v ČR“ je informace o českém trhu — pod /pl by to byla rada mimo
// zemi čtenáře (Polsko má vlastní distributory), tak se mimo cs neukazuje.
const zastoupeni = locale === 'cs' ? a.czZastoupeni : undefined;

const metaTitle = c.detailTitleTpl.replace('{name}', kratkyNazev).replace('{ticker}', a.ticker);
const metaDescription = c.detailDescriptionTpl.replace('{name}', kratkyNazev).replace('{profil}', a.profil);

const breadcrumbJsonLd = breadcrumbSchema([
  { name: c.crumbHome, url: '/' },
  { name: c.crumbData, url: '/data/' },
  { name: c.crumbSelf, url: `${SITE_URL}/akcie/` },
  { name: kratkyNazev, url: canonical },
]);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Corporation',
  name: kratkyNazev,
  tickerSymbol: a.ticker,
  url: a.web,
  ...(a.sidlo ? { location: a.sidlo } : {}),
  ...(a.zalozeno ? { foundingDate: String(a.zalozeno) } : {}),
  ...(a.popis ? { description: a.popis } : {}),
};
---

<Layout
  title={metaTitle}
  description={metaDescription}
  canonical={locale === 'cs' ? canonical : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />

  <div class="ad">
    <section class="ad-hero">
      <div class="ad-lines"></div>
      <div class="ad-wrap ad-hero-in">
        <nav class="ad-bc" aria-label={c.crumbAria}>
          <a href={href('/')}>{c.crumbHome}</a><span>›</span><a href={href('/data/')}>{c.crumbData}</a><span>›</span><a href={href('/akcie/')}>{c.crumbAkcie}</a><span>›</span><span class="cur">{kratkyNazev}</span>
        </nav>
        <div class="ad-head">
          <div>
            <span class="ad-cat">{a.zeme} {c.kategorie[a.kategorie]}</span>
            <h1>{kratkyNazev}</h1>
            <div class="ad-sub"><span class="ad-ticker">{a.ticker}</span> <span class="ad-burza">{a.burza} · {a.mena}</span></div>
          </div>
        </div>
      </div>
    </section>

    <div class="ad-body"><div class="ad-wrap">

      <div class="ad-disclaimer">
        <strong>{c.detailDisclaimerStrong}</strong> {c.detailDisclaimerText}
      </div>

      <!-- PROFIL -->
      {a.popis && (
        <section class="ad-block">
          <h2>{c.profileTitle}</h2>
          <p class="ad-text">{a.popis}</p>
          <div class="ad-facts">
            {a.sidlo && <div class="ad-fact"><span class="l">{c.factHq}</span><b>{a.sidlo}</b></div>}
            {a.zalozeno && <div class="ad-fact"><span class="l">{c.factFounded}</span><b>{a.zalozeno}</b></div>}
            {a.reditel && <div class="ad-fact"><span class="l">{c.factCeo}</span><b>{a.reditel}</b></div>}
            {a.obrat && <div class="ad-fact"><span class="l">{c.factRevenue}</span><b>{a.obrat}</b></div>}
          </div>
        </section>
      )}

      <!-- NAŠE PRODUKTY -->
      {znacky.length > 0 && (
        <section class="ad-block">
          <h2>{znacky.length > 1 ? c.brandsTitleMulti : c.brandsTitleSingle}</h2>
          <p class="ad-text">{c.brandsLede}</p>
          <div class="ad-brands">
            {znacky.map((z) => (
              <div class="ad-brandrow">
                {ZNACKA_LOGO[z] && <img class="ad-brandlogo" src={ZNACKA_LOGO[z]} alt={`${c.logoAlt} ${ZNACKA_LABEL[z] ?? z}`} loading="lazy" decoding="async" />}
                <span class="ad-brandname">{ZNACKA_LABEL[z] ?? z}</span>
                <a href={href(`/stroje/${z}/`)}>{c.brandsModels}</a>
                <a href={href(`/znacky/${z}/`)}>{c.brandsProfile}</a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ÚSPĚCHY -->
      {a.uspechy && a.uspechy.length > 0 && (
        <section class="ad-block">
          <h2>{c.achievementsTitle}</h2>
          <ul class="ad-list">
            {a.uspechy.map((u) => <li>{u}</li>)}
          </ul>
        </section>
      )}

      <!-- ZASTOUPENÍ V ČR -->
      {zastoupeni && zastoupeni.length > 0 && (
        <section class="ad-block">
          <h2>{c.repTitle}</h2>
          <p class="ad-text">{c.repLede}</p>
          <ul class="ad-list">
            {zastoupeni.map((d) => <li><a href={d.url} target="_blank" rel="nofollow noopener">{d.name}</a></li>)}
          </ul>
        </section>
      )}

      <!-- ODKAZY -->
      <section class="ad-block ad-links">
        <h2>{c.linksTitle}</h2>
        <p class="ad-cross">
          → <a href={a.web} target="_blank" rel="nofollow noopener">{c.linkWeb}</a><br>
          {svetSlug && <>→ <a href={href(`/svet/${svetSlug}/`)}>{c.linkCountry}</a><br /></>}
          → <a href={href('/akcie/')}>{c.linkAll}</a><br>
          → <a href={href('/data/prodeje-techniky/')}>{c.linkSales}</a>
        </p>
      </section>

    </div></div>
  </div>

  {/* Loga značek: většina je PD (text a jednoduché tvary), ale Bednar
      a Joskin jsou CC BY-SA 4.0 a atribuce k nim patří všude, kde se
      ukážou. Blok se vykreslí jen tehdy, když ho něco opravdu vyžaduje. */}
  <PhotoCredits images={znacky.map((z) => ZNACKA_LOGO[z])} locale={locale} />
</Layout>

<style>
  .ad { --yellow:#FFEA00; --ink:#0A0A0B; --line:#E7E7EA; --muted:#6E6E76; --soft:#F5F5F2; --green:#2E9E57;
    font-family:'Chakra Petch',system-ui,sans-serif; background:#fff; color:var(--ink); line-height:1.55; }
  .ad-wrap { max-width:860px; margin:0 auto; padding:0 24px; }
  .ad a { color:inherit; }

  .ad-hero { background:var(--ink); color:#fff; position:relative; overflow:hidden; }
  .ad-hero::before { content:""; position:absolute; inset:0; background:radial-gradient(600px 300px at 90% -10%, rgba(255,234,0,.16), transparent 60%); }
  .ad-lines { position:absolute; inset:0; opacity:.05; background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px); background-size:44px 44px; }
  .ad-hero-in { position:relative; z-index:1; padding:22px 24px 30px; }
  .ad-bc { font-size:12.5px; color:rgba(255,255,255,.55); display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
  .ad-bc a { color:rgba(255,255,255,.7); text-decoration:none; } .ad-bc a:hover { color:#fff; } .ad-bc .cur { color:#fff; }
  .ad-head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .ad-cat { font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--yellow); }
  .ad-head h1 { font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; letter-spacing:-.02em; margin:8px 0 8px; }
  .ad-sub { display:flex; align-items:center; gap:10px; }
  .ad-ticker { font-size:13px; font-weight:800; color:var(--ink); background:var(--yellow); border-radius:5px; padding:3px 9px; }
  .ad-burza { font-size:13px; color:rgba(255,255,255,.7); }

  .ad-body { padding:32px 0 80px; }
  .ad-disclaimer { font-size:13px; line-height:1.6; color:#5a4a00; background:#fffbe6; border:1px solid #ffe66b; border-left:4px solid var(--yellow); border-radius:10px; padding:12px 14px; margin-bottom:30px; }
  .ad-disclaimer strong { color:#0A0A0B; }
  .ad-block { margin-bottom:32px; }
  .ad-block h2 { font-size:19px; font-weight:800; letter-spacing:-.01em; margin:0 0 14px; padding-bottom:8px; border-bottom:2px solid var(--ink); }
  .ad-text { font-size:15.5px; line-height:1.7; color:#333; margin:0 0 16px; }



  .ad-facts { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; }
  .ad-fact { border:1.5px solid var(--line); border-radius:10px; padding:11px 14px; }
  .ad-fact .l { display:block; font-size:11.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:3px; }
  .ad-fact b { font-size:15px; }

  .ad-brands { display:flex; flex-direction:column; gap:10px; }
  .ad-brandrow { display:flex; align-items:center; gap:14px; flex-wrap:wrap; border:1.5px solid var(--line); border-radius:10px; padding:12px 14px; }
  .ad-brandlogo { height:26px; max-width:96px; width:auto; object-fit:contain; flex-shrink:0; }
  .ad-brandname { font-weight:800; flex:1; min-width:100px; }
  .ad-brandrow a { color:var(--green); text-decoration:underline; font-size:14px; font-weight:600; }

  .ad-list { margin:0; padding-left:20px; font-size:15px; line-height:1.7; }
  .ad-list li { margin-bottom:6px; }
  .ad-list a { color:var(--green); text-decoration:underline; }

  .ad-cross { font-size:15px; line-height:1.95; }
  .ad-cross a { color:var(--green); text-decoration:underline; }

  @media (max-width:560px) { .ad-head { align-items:flex-start; } }
</style>
