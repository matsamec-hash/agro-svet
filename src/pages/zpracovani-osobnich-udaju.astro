---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
const locale = Astro.locals.locale ?? 'cs';
const isSk = locale === 'sk';
const isPl = locale === 'pl';
const isUk = locale === 'uk';
const isDe = locale === 'de';
const META = {
  cs: { title: 'Zpracování osobních údajů — Agro-svět', description: 'Zásady zpracování osobních údajů na Agro-svět.cz — kdo jsme, jaké údaje zpracováváme, jak dlouho, vaše práva.' },
  sk: { title: 'Spracúvanie osobných údajov — Agro-svet', description: 'Zásady spracúvania osobných údajov na agro-svet.cz — kto sme, aké údaje spracúvame, ako dlho, vaše práva.' },
  pl: { title: 'Przetwarzanie danych osobowych — Agro-svet', description: 'Zasady przetwarzania danych osobowych w serwisie agro-svet.cz — kim jesteśmy, jakie dane przetwarzamy, jak długo, twoje prawa.' },
  uk: { title: 'Обробка персональних даних — Agro-svet', description: 'Засади обробки персональних даних на agro-svet.cz — хто ми, які дані обробляємо, як довго, ваші права.' },
  de: { title: 'Datenschutzerklärung — Agro-svet', description: 'Datenschutzerklärung für agro-svet.cz — wer wir sind, welche Daten wir verarbeiten, wie lange, Ihre Rechte.' },
};
const meta = META[locale] ?? META.cs;
---
<Layout
  title={meta.title}
  description={meta.description}
>
  <div class="legal-page">
  {isSk ? (
    <Fragment>
    <h1>Zásady spracúvania osobných údajov</h1>
    <p class="lead">Ako spracúvame osobné údaje používateľov webu <strong>agro-svet.cz</strong> v súlade s nariadením GDPR (2016/679) a zákonom č. 110/2019 Sb.</p>

    <h2>1. Prevádzkovateľ osobných údajov</h2>
    <p>
      <strong>Samec Digital s.r.o.</strong>, IČO 29547539, so sídlom Na Břehu 378, 387 11 Katovice, zapísaná v obchodnom registri vedenom Krajským súdom v Českých Budějoviciach, oddiel C, vložka 36598.<br>
      Kontakt: <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>
    </p>

    <h2>2. Aké údaje spracúvame</h2>

    <h3>2.1 Newsletter (odber noviniek)</h3>
    <ul>
      <li>E-mailová adresa</li>
      <li>Dátum prihlásenia a potvrdenia odberu</li>
      <li>Časové pečiatky kliknutia na potvrdzovací odkaz (anti-fraud)</li>
    </ul>

    <h3>2.2 Bazár — registrovaní používatelia</h3>
    <ul>
      <li>Meno (zobrazované pri inzeráte)</li>
      <li>E-mail (prihlasovanie, kontakt)</li>
      <li>Telefón (kontakt na inzerenta)</li>
      <li>Lokalita (mesto/kraj)</li>
      <li>Heslo (hašované, nikdy v plain texte)</li>
    </ul>

    <h3>2.3 Bazár — inzeráty</h3>
    <ul>
      <li>Obsah inzerátu (názov, popis, cena, kategória, fotky)</li>
      <li>Kontaktné údaje uvedené v inzeráte</li>
    </ul>

    <h3>2.4 Bazár — oznámenie závadného inzerátu</h3>
    <ul>
      <li>Meno a e-mail oznamovateľa (pri oznámeniach týkajúcich sa sexuálneho zneužívania detí nepovinné)</li>
      <li>URL inzerátu, dôvod a odôvodnenie oznámenia, vyhlásenie o dobrej viere</li>
      <li>Odtlačok (hash) IP adresy odosielateľa — ochrana formulára pred zneužitím</li>
    </ul>

    <h3>2.5 Fotosúťaž</h3>
    <p>Pre fotosúťaž platia samostatné <a href="/fotosoutez/gdpr/">zásady spracúvania</a>.</p>

    <h3>2.6 Kontaktný formulár</h3>
    <ul>
      <li>E-mailová adresa (aby sme vám mohli odpovedať)</li>
      <li>Meno, ak ho uvediete</li>
      <li>Téma, text správy a prípadne adresa stránky, ktorej sa správa týka</li>
      <li>IP adresa — len na obmedzenie počtu správ (najviac 5 za 15 minút); uchováva sa 15 minút v operačnej pamäti servera a nikam sa neukladá</li>
    </ul>
    <p>Správu neukladáme do databázy; doručí sa e-mailom do našej schránky info@samecdigital.com. Na adresu z formulára neposielame nič iné ako odpoveď.</p>

    <h3>2.7 Technické údaje (všetci návštevníci)</h3>
    <ul>
      <li>IP adresa (anonymizovaná v logu, anti-fraud, max 30 dní)</li>
      <li>User-agent prehliadača (štatistika, debugging)</li>
      <li>Referer (z akého webu ste prišli)</li>
    </ul>

    <h2>3. Účel a právny základ spracúvania</h2>
    <table class="legal-table">
      <thead>
        <tr><th>Účel</th><th>Právny základ (GDPR čl. 6)</th></tr>
      </thead>
      <tbody>
        <tr><td>Zasielanie newslettera</td><td>Súhlas — ods. 1 písm. a)</td></tr>
        <tr><td>Prevádzka používateľského účtu (bazár)</td><td>Plnenie zmluvy — ods. 1 písm. b)</td></tr>
        <tr><td>Zverejňovanie inzerátov</td><td>Plnenie zmluvy — ods. 1 písm. b)</td></tr>
        <tr><td>Meranie návštevnosti (Google Analytics, Microsoft Clarity)</td><td>Súhlas — ods. 1 písm. a)</td></tr>
        <tr><td>Anti-fraud, bezpečnosť prevádzky</td><td>Oprávnený záujem — ods. 1 písm. f)</td></tr>
        <tr><td>Plnenie zákonných povinností (účtovníctvo pri platených službách)</td><td>Právna povinnosť — ods. 1 písm. c)</td></tr>
        <tr><td>Vybavenie oznámenia závadného obsahu v bazári (DSA čl. 16) vrátane potvrdenia o prijatí a oznámenia rozhodnutia</td><td>Právna povinnosť — ods. 1 písm. c)</td></tr>
        <tr><td>Vybavenie správy z kontaktného formulára a odpoveď na ňu</td><td>Oprávnený záujem — ods. 1 písm. f) (odpovedať na otázky); ak sa správa týka zmluvy s nami (napr. účtu v bazári), plnenie zmluvy — ods. 1 písm. b); pri žiadostiach podľa GDPR právna povinnosť — ods. 1 písm. c)</td></tr>
      </tbody>
    </table>

    <h2>4. Doba uchovávania</h2>
    <ul>
      <li><strong>Newsletter a upozornenia:</strong> do odvolania súhlasu (odhlásenia). Záznam
        o odhlásení si ponechávame, aby sme vám neposielali ďalšie e-maily.</li>
      <li><strong>Účet bazára:</strong> do zmazania účtu — zmažeme ho na vašu žiadosť.
        Účty <strong>nemažeme automaticky</strong> po dobe nečinnosti.</li>
      <li><strong>Inzeráty:</strong> aktívne 30 dní, potom status „expired" a zostávajú na účte.
        Keď inzerát zmažete, <strong>zmaže sa okamžite a nevratne</strong> — žiadny archív si
        neponechávame.</li>
      <li><strong>IP adresy z anti-fraudu</strong> (pokusy o zadanie kódu): najviac 30 dní.</li>
      <li><strong>Oznámenia závadného inzerátu:</strong> meno a e-mail oznamovateľa 6 mesiacov od oznámenia rozhodnutia (dovtedy sa proti nemu môžete ohradiť), potom ich mažeme; odtlačok IP adresy 90 dní.</li>
      <li><strong>Správy z kontaktného formulára:</strong> v e-mailovej schránke počas vybavovania, potom najviac 2 roky od poslednej komunikácie; ak sa správa týka uplatnenia alebo obhajoby právnych nárokov (napr. sťažnosť na porušenie práv), do skončenia veci.</li>
      <li><strong>Prevádzkové logy</strong> vznikajú u poskytovateľov infraštruktúry
        (Cloudflare, hosting) a riadia sa ich lehotami, nie našimi.</li>
    </ul>

    <h2>5. Komu údaje odovzdávame (sprostredkovatelia)</h2>
    <ul>
      <li><strong>Cloudflare, Inc.</strong> (USA) — reverzná proxy, CDN, anti-DDoS; prechádzajú ním všetky požiadavky na web. Štandardné zmluvné doložky (SCC) podľa čl. 46 GDPR.</li>
      <li><strong>Hostinger International Ltd.</strong> (Cyprus) — server s webom a databázou (dátové centrum vo Frankfurte nad Mohanom) a CDN obrázkov <code>cdn.samecdigital.com</code>. Databázu a prihlasovanie prevádzkujeme na vlastnom serveri (open-source Supabase), nie u spoločnosti Supabase, Inc. U Hostingeru je aj naša e-mailová schránka info@samecdigital.com.</li>
      <li><strong>Resend, Inc.</strong> (USA) — odosielanie transakčných a newsletter e-mailov a doručovanie správ z kontaktného formulára do našej schránky. SCC.</li>
      <li><strong>Google Ireland Limited</strong> (Írsko) — Google Analytics 4 (ID merania G-HC3JY466RR), štatistika návštevnosti; cookies <code>_ga</code> a <code>_ga_*</code> ukladajú náhodný identifikátor prehliadača až na 2 roky. Načíta sa <strong>až po vašom súhlase</strong>. Prehliadač pritom Googlu odovzdá vašu IP adresu; podľa Googlu Google Analytics 4 IP adresy neukladá. Prenos do USA na základe rámca EU–US Data Privacy Framework a SCC.</li>
      <li><strong>Microsoft Ireland Operations Limited</strong> (Írsko) — Microsoft Clarity (ID projektu ws6puxcjnb), heatmapy a záznamy návštev (pohyb myši, kliknutia, posúvanie). Načíta sa <strong>až po vašom súhlase</strong>. Prenos do USA na základe rámca EU–US Data Privacy Framework a SCC.</li>
      <li><strong>Google Ireland Limited</strong> (Írsko) — prehrávač YouTube (<code>youtube-nocookie.com</code>) pri videách v katalógu techniky a v encyklopédii. Načíta sa <strong>až po kliknutí</strong> na video, dovtedy sa z YouTube nenačíta nič. Google pritom dostane vašu IP adresu, prehrávač ukladá údaje do úložiska prehliadača (<code>localStorage</code>, IndexedDB) a údaje môžu ísť do USA (EU–US Data Privacy Framework).</li>
    </ul>
    <p>Na niektorých stránkach sa váš prehliadač pripája priamo k ďalším službám, ktoré tým dostanú vašu IP adresu: <strong>OpenStreetMap</strong> (mapové podklady v bazári a pri farmách), <strong>Cloudflare Turnstile</strong> (ochrana formulárov pred robotmi) a <strong>Unsplash</strong> (obrázky v sekcii Médiá). Server navyše používa <strong>Nominatim / OpenStreetMap</strong> na prevod lokality inzerátu na súradnice, <strong>Fio banku</strong> na párovanie platieb za zvýhodnenie inzerátu a služby <strong>OpenAI</strong> a <strong>Anthropic</strong> na strojové spracovanie textu inzerátov, ktoré redakcia prevezme z iných inzertných serverov. Predpoveď počasia sťahuje náš server od <strong>MET Norway</strong> (Nórsky meteorologický ústav); keď o predpoveď pre svoje pole kliknutím požiadate, odovzdáme mu len súradnice zaokrúhlené zhruba na 1 km, nie vašu IP adresu (polohu si pamätá len váš prehliadač).</p>
    <p>Vaše osobné údaje nepredávame ani neodovzdávame tretím stranám na marketingové účely.</p>

    <h2>6. Vaše práva</h2>
    <p>Podľa GDPR máte právo na:</p>
    <ul>
      <li><strong>Prístup</strong> k svojim údajom (čl. 15)</li>
      <li><strong>Opravu</strong> nepresných údajov (čl. 16)</li>
      <li><strong>Výmaz</strong> („právo byť zabudnutý", čl. 17)</li>
      <li><strong>Obmedzenie spracúvania</strong> (čl. 18)</li>
      <li><strong>Prenosnosť</strong> údajov (čl. 20)</li>
      <li><strong>Námietku</strong> proti spracúvaniu na základe oprávneného záujmu (čl. 21)</li>
      <li><strong>Odvolanie súhlasu</strong> kedykoľvek (čl. 7 ods. 3) — týka sa merania návštevnosti (odkaz <strong>Nastavenia cookies</strong> v pätičke) a newslettera</li>
    </ul>
    <p>Žiadosť zašlite na <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>. Vybavíme ju bez zbytočného odkladu, najneskôr do jedného mesiaca (čl. 12 ods. 3 GDPR).</p>
    <p><strong>Právo namietať (čl. 21 GDPR):</strong> Ak údaje spracúvame na základe oprávneného záujmu (anti-fraud, bezpečnosť prevádzky), môžete proti tomuto spracúvaniu kedykoľvek namietať z dôvodov týkajúcich sa vašej konkrétnej situácie. Automatizované rozhodovanie vrátane profilovania v zmysle čl. 22 GDPR nevykonávame.</p>

    <h2>7. Odhlásenie z newslettera</h2>
    <p>Odber newslettera môžete kedykoľvek odhlásiť:</p>
    <ul>
      <li>Odpoveďou na akýkoľvek newsletter e-mail s textom „odhlásiť"</li>
      <li>E-mailom na <a href="mailto:info@samecdigital.com">info@samecdigital.com</a></li>
    </ul>

    <h2>8. Sťažnosť u dozorného úradu</h2>
    <p>
      Ak sa domnievate, že spracúvaním vašich osobných údajov porušujeme GDPR, môžete podať sťažnosť.
      Keďže prevádzkovateľ je usadený v Českej republike, vedúcim dozorným úradom je
      <strong>Úřad pro ochranu osobních údajů (ČR)</strong>, Pplk. Sochora 27, 170 00 Praha 7,
      <a href="https://uoou.gov.cz/" rel="noopener">uoou.gov.cz</a>.
      Ako používateľ zo Slovenska sa môžete obrátiť aj na
      <strong>Úrad na ochranu osobných údajov Slovenskej republiky</strong>, Hraničná 4826/12,
      820 07 Bratislava 27, <a href="https://dataprotection.gov.sk" rel="noopener">dataprotection.gov.sk</a>.
    </p>

    <h2>9. Cookies</h2>
    <p><strong>Technicky nevyhnutné cookies</strong> (prihlásenie, hlasovanie v anketách a vo fotosúťaži) sa používajú vždy — bez nich web nefunguje. Vašu voľbu o súhlase si web pamätá v úložisku prehliadača (<code>localStorage</code>), nie v cookie.</p>
    <p><strong>Analytické cookies</strong> — Google Analytics 4 (<code>_ga</code>, <code>_ga_*</code>) a Microsoft Clarity (<code>_clck</code>, <code>_clsk</code>) — sa načítajú <strong>len s vaším súhlasom</strong>. Merajú návštevnosť a to, ako sa po stránke pohybujete. Doba uloženia: <code>_ga</code> a <code>_ga_*</code> až 2 roky, <code>_clck</code> 1 rok, <code>_clsk</code> 1 deň. Ak zvolíte „Iba nevyhnutné", nenačíta sa žiadny merací skript (Google ani Microsoft) a ich cookies sa z prehliadača vymažú.</p>
    <p>Nepoužívame marketingové ani reklamné cookies tretích strán.</p>
    <p>Súhlas môžete kedykoľvek odvolať odkazom <strong>Nastavenia cookies</strong> v pätičke — odvolanie je rovnako jednoduché ako udelenie (čl. 7 ods. 3 GDPR).</p>

    <p class="effective"><strong>Účinnosť:</strong> 17. októbra 2026</p>
    </Fragment>
  ) : isPl ? (
    <Fragment>
    <h1>Zasady przetwarzania danych osobowych</h1>
    <p class="lead">Jak przetwarzamy dane osobowe użytkowników serwisu <strong>agro-svet.cz</strong> zgodnie z rozporządzeniem RODO (2016/679) oraz czeską ustawą nr 110/2019 Sb.</p>

    <h2>1. Administrator danych osobowych</h2>
    <p>
      <strong>Samec Digital s.r.o.</strong>, IČO 29547539, z siedzibą Na Břehu 378, 387 11 Katovice, wpisana do rejestru handlowego prowadzonego przez Sąd Okręgowy w Czeskich Budziejowicach, dział C, wkładka 36598.<br>
      Kontakt: <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>
    </p>

    <h2>2. Jakie dane przetwarzamy</h2>

    <h3>2.1 Newsletter (subskrypcja aktualności)</h3>
    <ul>
      <li>Adres e-mail</li>
      <li>Data zapisu i potwierdzenia subskrypcji</li>
      <li>Znaczniki czasu kliknięcia w link potwierdzający (anti-fraud)</li>
    </ul>

    <h3>2.2 Bazar — zarejestrowani użytkownicy</h3>
    <ul>
      <li>Imię (wyświetlane przy ogłoszeniu)</li>
      <li>E-mail (logowanie, kontakt)</li>
      <li>Telefon (kontakt do ogłoszeniodawcy)</li>
      <li>Lokalizacja (miasto/region)</li>
      <li>Hasło (zahaszowane, nigdy w postaci jawnej)</li>
    </ul>

    <h3>2.3 Bazar — ogłoszenia</h3>
    <ul>
      <li>Treść ogłoszenia (tytuł, opis, cena, kategoria, zdjęcia)</li>
      <li>Dane kontaktowe podane w ogłoszeniu</li>
    </ul>

    <h3>2.4 Bazar — zgłoszenie niedozwolonego ogłoszenia</h3>
    <ul>
      <li>Imię i nazwisko oraz e-mail zgłaszającego (przy zgłoszeniach dotyczących wykorzystywania seksualnego dzieci nieobowiązkowe)</li>
      <li>URL ogłoszenia, powód i uzasadnienie zgłoszenia, oświadczenie o działaniu w dobrej wierze</li>
      <li>Skrót (hash) adresu IP nadawcy — ochrona formularza przed nadużyciami</li>
    </ul>

    <h3>2.5 Fotokonkurs</h3>
    <p>Dla fotokonkursu obowiązują odrębne <a href="/fotosoutez/gdpr/" hreflang="cs">zasady przetwarzania</a> (po czesku).</p>

    <h3>2.6 Formularz kontaktowy</h3>
    <ul>
      <li>Adres e-mail (abyśmy mogli odpowiedzieć)</li>
      <li>Imię i nazwisko, jeśli je podasz</li>
      <li>Temat, treść wiadomości i ewentualnie adres strony, której dotyczy wiadomość</li>
      <li>Adres IP — wyłącznie w celu ograniczenia liczby wiadomości (maksymalnie 5 w ciągu 15 minut); przechowywany przez 15 minut w pamięci operacyjnej serwera i nigdzie nie zapisywany</li>
    </ul>
    <p>Wiadomości nie zapisujemy w bazie danych; trafia ona e-mailem do naszej skrzynki info@samecdigital.com. Na adres podany w formularzu wysyłamy wyłącznie odpowiedź.</p>

    <h3>2.7 Dane techniczne (wszyscy odwiedzający)</h3>
    <ul>
      <li>Adres IP (zanonimizowany w logu, anti-fraud, maks. 30 dni)</li>
      <li>User-agent przeglądarki (statystyka, debugowanie)</li>
