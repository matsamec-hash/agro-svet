---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
const locale = Astro.locals.locale ?? 'cs';
const isSk = locale === 'sk';
const isPl = locale === 'pl';
const isUk = locale === 'uk';
// Právní stránky se odkazují jedna na druhou; bez prefixu poslal polský
// dokument čtenáře na ČESKÉ znění vedlejšího dokumentu.
const lp = (path: string) => (locale === 'cs' ? path : `/${locale}${path}`);
const META = {
  cs: { title: 'Podmínky použití — Agro-svět', description: 'Podmínky použití webu agro-svet.cz — orientační charakter informací, vyloučení odpovědnosti, autorská práva, kontakt.' },
  sk: { title: 'Podmienky používania — Agro-svet', description: 'Podmienky používania webu agro-svet.cz — orientačný charakter informácií, vylúčenie zodpovednosti, autorské práva, kontakt.' },
  pl: { title: 'Warunki korzystania — Agro-svet', description: 'Warunki korzystania z serwisu agro-svet.cz — orientacyjny charakter informacji, wyłączenie odpowiedzialności, prawa autorskie, kontakt.' },
  uk: { title: 'Умови використання — Agro-svet', description: 'Умови використання сайту agro-svet.cz — орієнтовний характер інформації, відмова від відповідальності, авторські права, контакт.' },
};
const meta = META[locale] ?? META.cs;
---
<Layout
  title={meta.title}
  description={meta.description}
>
  <main class="legal-page">
  {isSk ? (
    <Fragment>
    <h1>Podmienky používania</h1>
    <p class="lead">
      Tieto podmienky upravujú používanie webu <strong>agro-svet.cz</strong> prevádzkovaného spoločnosťou
      <strong>Samec Digital s.r.o.</strong>, IČO 29547539, se sídlem Na Břehu 378, 387 11 Katovice
      (ďalej len „prevádzkovateľ"). Používaním webu s nimi vyjadrujete súhlas.
    </p>

    <h2>1. Charakter obsahu — informácie sú len orientačné</h2>
    <p>
      Všetky údaje, čísla, ceny, parametre techniky, štatistiky, kalkulačky, prevody jednotiek,
      heslá v slovníku a encyklopédii, údaje o dotáciách, plemenách, pôde, strojoch, predajcoch,
      značkách a všetky ostatné informácie zverejnené na webe majú <strong>výhradne informatívny
      a orientačný charakter</strong>.
    </p>
    <p>
      Prevádzkovateľ <strong>negarantuje</strong> ich presnosť, úplnosť, aktuálnosť ani vhodnosť
      pre konkrétny účel. Údaje sa môžu v čase meniť, zastarať alebo obsahovať chyby (technické,
      typografické, prevzaté zo zdrojov tretích strán, generované automaticky).
    </p>

    <h2>2. Vylúčenie zodpovednosti</h2>
    <p>
      Prevádzkovateľ <strong>nenesie žiadnu zodpovednosť</strong> za:
    </p>
    <ul>
      <li>správnosť, presnosť ani aktuálnosť zverejnených údajov a informácií,</li>
      <li>akékoľvek rozhodnutia urobené používateľom na základe informácií z webu,</li>
      <li>priame i nepriame škody (finančné, materiálne, ušlý zisk) vzniknuté použitím obsahu webu,</li>
      <li>výsledky výpočtov kalkulačiek, prevodov jednotiek a porovnaní — slúžia len na hrubý odhad,</li>
      <li>obsah inzerátov v bazári — zodpovedá zaň výhradne ich autor (inzerent),</li>
      <li>obsah a dostupnosť odkazovaných webov tretích strán,</li>
      <li>výpadky, obmedzenie dostupnosti alebo prerušenie prevádzky webu.</li>
    </ul>
    <p>
      <strong>Pred akýmkoľvek rozhodnutím</strong> s finančnými, právnymi, technologickými alebo
      prevádzkovými dôsledkami (nákup techniky, žiadosť o dotáciu, agronomické postupy, výživa rastlín
      a zvierat, použitie prípravkov na ochranu rastlín a pod.) si vždy overte informácie u
      <strong>oficiálnych zdrojov</strong>, výrobcu, predajcu, autorizovaného poradcu, SZIF,
      ÚKZÚZ, Ministerstva zemědělství alebo inej kompetentnej autority.
    </p>

    <h2>3. Bazár a používateľský obsah</h2>
    <p>
      Bazár agro-svet.cz je <strong>inzertná platforma</strong> — prevádzkovateľ iba
      sprostredkúva kontakt medzi inzerentom a záujemcom. Prevádzkovateľ <strong>nie je stranou
      kúpnej zmluvy</strong>, nevykonáva inkaso platieb, neručí za stav, kvalitu ani existenciu
      ponúkaného tovaru, ani za to, že druhá strana splní svoje záväzky.
    </p>
    <p>
      Za obsah inzerátu, pravdivosť údajov, cenu, stav ponúkaného tovaru, autorské práva
      k fotografiám aj za splnenie všetkých zákonných povinností (živnostenský zákon, záručná
      zodpovednosť, daň z príjmov, DPH, ohlasovacia povinnosť) zodpovedá <strong>výhradne
      inzerent</strong>.
    </p>

    <h3>3.1 Kto smie inzerovať</h3>
    <ul>
      <li><strong>Fyzické osoby (nepodnikatelia)</strong> môžu inzerovať <strong>svoj
        vlastný majetok</strong> — konkrétne jednotlivé veci po kuse, s jasným popisom
        (jeden traktor, jeden pluh, jedno teľa a pod.). Nemožno inzerovať „sklad", „ponuku
        z výroby" ani neurčité množstvo.</li>
      <li><strong>Podnikatelia (SZČO, firmy, dealerstvá)</strong> môžu inzerovať
        <strong>konkrétny ponúkaný tovar alebo službu</strong>. Inzerent-podnikateľ je
        povinný v inzeráte uviesť <strong>obchodné meno alebo meno a IČO</strong>
        (na konci inzerátu alebo v poli „Meno / firma"). Neuvedenie IČO podnikateľom je
        dôvodom na zmazanie inzerátu a zablokovanie účtu.</li>
      <li>Nie je dovolené inzerovať <strong>podnikateľskú činnosť všeobecne</strong>
        („ponúkame všetku poľnohospodársku techniku", „dovoz strojov z Nemecka") — iba
        konkrétny tovar.</li>
    </ul>

    <h3>3.2 Zakázaný obsah</h3>
    <p>Na bazári nemožno inzerovať najmä:</p>
    <ul>
      <li>falzifikáty a neoriginálne náhradné diely vydávané za originálne,</li>
      <li>MLM, provízne a pyramídové systémy, „prácu z domu",</li>
      <li>pôžičky, úvery a finančné služby nebankových subjektov,</li>
      <li>erotické inzeráty, zoznamky, eskortné služby,</li>
      <li>kradnuté alebo nelegálne získané veci,</li>
      <li>lieky (humánne i veterinárne) bez príslušného oprávnenia,</li>
      <li>prípravky na ochranu rastlín v rozpore so zákonem č. 326/2004 Sb. (najmä
        bez registrácie ÚKZÚZ, mimo profesionálnych používateľov tam, kde to zákon vyžaduje),</li>
      <li>zbrane, strelivo a výbušniny v rozpore so zákonem č. 119/2002 Sb.,</li>
      <li>živé zvieratá bez veterinárneho osvedčenia, chránené druhy bez CITES, mŕtve zvieratá,</li>
      <li>tabakové výrobky, alkohol, omamné a psychotropné látky, e-cigarety,</li>
      <li>kryptomeny, herné účty, virtuálne predmety,</li>
      <li>čokoľvek porušujúce autorské, priemyselné či osobnostné práva tretích osôb,</li>
      <li>diskriminačný, urážlivý, nenávistný alebo inak nezákonný obsah.</li>
    </ul>
    <p>
      Podrobné pravidlá bazára vrátane ďalších zakázaných obsahov a postupu pri porušení
      nájdete na stránke <a href="/bazar/pravidla/">Pravidlá bazára</a>.
    </p>

    <h3>3.3 Mazanie inzerátov a blokácia účtov</h3>
    <p>
      Prevádzkovateľ je oprávnený <strong>bez predchádzajúceho upozornenia</strong> nezverejniť
      inzerát, zmazať zverejnený inzerát, prípadne zablokovať účet používateľa, ak:
    </p>
    <ul>
      <li>inzerát alebo správanie používateľa porušuje tieto podmienky, pravidlá bazára
        alebo právne predpisy,</li>
      <li>inzerát obsahuje nepravdivé, klamlivé alebo zavádzajúce informácie,</li>
      <li>používateľ opakovane vkladá duplicitné alebo spamové inzeráty,</li>
      <li>prevádzkovateľ dostane <strong>kvalifikované oznámenie</strong> o nezákonnosti
        obsahu od tretej osoby alebo úradu.</li>
    </ul>
    <p>
      Používateľ bude o dôvode zmazania / blokácie informovaný e-mailom registrovaným k účtu.
      Proti rozhodnutiu možno podať odôvodnenú sťažnosť na
      <a href="mailto:info@samecdigital.com">info@samecdigital.com</a> v lehote 14 dní;
      prevádzkovateľ ju vybaví do 14 dní od doručenia.
    </p>

    <h3>3.4 Hlásenie závadného obsahu (notice-and-action)</h3>
    <p>
      Ak sa domnievate, že konkrétny inzerát porušuje právne predpisy alebo tieto pravidlá,
      použite formulár <a href="/bazar/nahlasit/">Nahlásiť závadný inzerát</a>
      alebo pošlite oznámenie e-mailom na <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>.
      V oznámení uveďte:
    </p>
    <ul>
      <li>URL inzerátu alebo jeho ID,</li>
      <li>dôvod, prečo považujete obsah za závadný (porušený predpis alebo pravidlo),</li>
      <li>vaše kontaktné údaje (voliteľne, pre prípad doplnenia informácií).</li>
    </ul>
    <p>
      Prevádzkovateľ oznámenie posúdi <strong>bez zbytočného odkladu</strong>, spravidla do
      <strong>7 dní</strong>, a o výsledku vás informuje, ak ste uviedli kontakt.
      V odôvodnených prípadoch (zjavne nezákonný obsah, ohrozenie zdravia) koná bezodkladne.
    </p>

    <h2>4. Pravidlá používania</h2>
    <p>Používateľ sa zaväzuje, že nebude:</p>
    <ul>
      <li>narúšať prevádzku webu, jeho bezpečnosť ani používať automatizované nástroje (scrapery, boty) bez súhlasu,</li>
      <li>vkladať klamlivý, urážlivý, nezákonný alebo spamový obsah,</li>
      <li>vydávať sa za inú osobu alebo subjekt,</li>
      <li>obchádzať technické opatrenia chrániace obsah alebo prístup k nemu.</li>
    </ul>
    <p>
      Prevádzkovateľ si vyhradzuje právo bez predchádzajúceho upozornenia odstrániť obsah porušujúci
      tieto podmienky a zablokovať účet používateľa.
    </p>

    <h2>5. Autorské práva</h2>
    <p>
      Obsah webu (texty, grafika, dizajn, databázy, fotografie redakcie, slovníkové heslá,
      encyklopedické články, štatistiky a ich vizualizácie) je chránený autorským právom
      a databázovým právom. Bez písomného súhlasu prevádzkovateľa nie je dovolené obsah
      kopírovať, šíriť, upravovať ani inak komerčne využívať.
    </p>
    <p>
      Fotografie a obsah inzerátov v bazári zostávajú vlastníctvom inzerenta; vložením inzerátu
      inzerent udeľuje prevádzkovateľovi nevýhradnú bezodplatnú licenciu na ich zobrazenie v rámci
      prevádzky webu.
    </p>

    <h2>6. Ochrana osobných údajov</h2>
    <p>
      Spracúvanie osobných údajov upravujú samostatné
      <a href={lp('/zpracovani-osobnich-udaju/')}>Zásady spracúvania osobných údajov</a>.
    </p>

    <h2>7. Zmeny podmienok</h2>
    <p>
      Prevádzkovateľ je oprávnený tieto podmienky kedykoľvek zmeniť. Aktuálne znenie je vždy zverejnené
      na tejto stránke s uvedením dátumu účinnosti. Pokračovaním v používaní webu po zmene podmienok
      vyjadrujete súhlas s novým znením.
    </p>

    <h2>8. Kontakt</h2>
    <p>
      Samec Digital s.r.o., IČO 29547539<br>
      Na Břehu 378, 387 11 Katovice<br>
      E-mail: <a href="mailto:info@samecdigital.com">info@samecdigital.com</a>
    </p>

    <p class="effective"><strong>Účinnosť:</strong> 28. mája 2026</p>
    </Fragment>
  ) : isPl ? (
    <Fragment>
    <h1>Warunki korzystania</h1>
    <p class="lead">
      Niniejsze warunki regulują korzystanie z serwisu <strong>agro-svet.cz</strong> prowadzonego przez spółkę
      <strong>Samec Digital s.r.o.</strong>, IČO 29547539, z siedzibą Na Břehu 378, 387 11 Katovice
      (dalej „operator"). Korzystając z serwisu, wyrażasz na nie zgodę.
    </p>

    <h2>1. Charakter treści — informacje mają wyłącznie charakter orientacyjny</h2>
    <p>
      Wszelkie dane, liczby, ceny, parametry techniki, statystyki, kalkulatory, przeliczniki jednostek,
      hasła w słowniku i encyklopedii, informacje o dopłatach, rasach, glebie, maszynach, sprzedawcach,
      markach oraz wszystkie pozostałe informacje publikowane w serwisie mają <strong>wyłącznie informacyjny
      i orientacyjny charakter</strong>.
    </p>
    <p>
      Operator <strong>nie gwarantuje</strong> ich dokładności, kompletności, aktualności ani przydatności
      do konkretnego celu. Dane mogą się z czasem zmieniać, tracić aktualność lub zawierać błędy (techniczne,
      typograficzne, przejęte ze źródeł zewnętrznych, generowane automatycznie).
    </p>

    <h2>2. Wyłączenie odpowiedzialności</h2>
    <p>
      Operator <strong>nie ponosi żadnej odpowiedzialności</strong> za:
    </p>
    <ul>
      <li>poprawność, dokładność ani aktualność opublikowanych danych i informacji,</li>
      <li>jakiekolwiek decyzje podjęte przez użytkownika na podstawie informacji z serwisu,</li>
      <li>bezpośrednie i pośrednie szkody (finansowe, materialne, utracone korzyści) powstałe wskutek korzystania z treści serwisu,</li>
      <li>wyniki obliczeń kalkulatorów, przeliczników jednostek i porównań — służą one wyłącznie do zgrubnego oszacowania,</li>
      <li>treść ogłoszeń w bazarze — odpowiada za nią wyłącznie ich autor (ogłoszeniodawca),</li>
      <li>treść i dostępność serwisów zewnętrznych, do których prowadzą odnośniki,</li>
      <li>awarie, ograniczenie dostępności lub przerwy w działaniu serwisu.</li>
    </ul>
    <p>
      <strong>Przed podjęciem jakiejkolwiek decyzji</strong> o skutkach finansowych, prawnych, technologicznych
      lub operacyjnych (zakup techniki, wniosek o dopłatę, praktyki agronomiczne, żywienie roślin i zwierząt,
      stosowanie środków ochrony roślin itp.) zawsze zweryfikuj informacje w <strong>oficjalnych źródłach</strong>,
      u producenta, sprzedawcy, autoryzowanego doradcy, w ARiMR, PIORiN, Ministerstwie Rolnictwa i Rozwoju Wsi
      lub u innego właściwego organu.
    </p>

    <h2>3. Bazar i treści użytkownika</h2>
    <p>
      Bazar agro-svet.cz to <strong>platforma ogłoszeniowa</strong> — operator jedynie
      pośredniczy w kontakcie między ogłoszeniodawcą a zainteresowanym. Operator <strong>nie jest stroną
      umowy sprzedaży</strong>, nie pobiera płatności, nie ręczy za stan, jakość ani istnienie
      oferowanego towaru, ani za to, że druga strona wywiąże się ze swoich zobowiązań.
    </p>
    <p>
      Za treść ogłoszenia, prawdziwość danych, cenę, stan oferowanego towaru, prawa autorskie
      do zdjęć oraz za spełnienie wszystkich obowiązków ustawowych (przepisy o działalności gospodarczej,
      odpowiedzialność z tytułu rękojmi, podatek dochodowy, VAT, obowiązek zgłoszeniowy) odpowiada <strong>wyłącznie
      ogłoszeniodawca</strong>.
    </p>

    <h3>3.1 Kto może zamieszczać ogłoszenia</h3>
    <ul>
      <li><strong>Osoby fizyczne (nieprowadzące działalności)</strong> mogą ogłaszać <strong>swój
        własny majątek</strong> — konkretne pojedyncze rzeczy sztuka po sztuce, z jasnym opisem
        (jeden ciągnik, jeden pług, jedno cielę itp.). Nie można ogłaszać „magazynu", „oferty
        z produkcji" ani nieokreślonej ilości.</li>
      <li><strong>Przedsiębiorcy (samozatrudnieni, firmy, dealerzy)</strong> mogą ogłaszać
        <strong>konkretny oferowany towar lub usługę</strong>. Ogłoszeniodawca-przedsiębiorca jest
        zobowiązany podać w ogłoszeniu <strong>firmę albo imię i nazwisko oraz numer identyfikacyjny (IČO/NIP)</strong>
        (na końcu ogłoszenia lub w polu „Imię / firma"). Niepodanie numeru identyfikacyjnego przez przedsiębiorcę jest
        podstawą do usunięcia ogłoszenia i zablokowania konta.</li>
      <li>Nie wolno ogłaszać <strong>działalności gospodarczej ogólnie</strong>
        („oferujemy wszelką technikę rolniczą", „import maszyn z Niemiec") — wyłącznie
        konkretny towar.</li>
    </ul>

    <h3>3.2 Treści zakazane</h3>
    <p>W bazarze nie można ogłaszać w szczególności:</p>
    <ul>
      <li>podróbek i nieoryginalnych części zamiennych sprzedawanych jako oryginalne,</li>
      <li>systemów MLM, prowizyjnych i piramidowych, „pracy z domu",</li>
      <li>pożyczek, kredytów i usług finansowych podmiotów pozabankowych,</li>
      <li>ogłoszeń erotycznych, portali randkowych, usług towarzyskich,</li>
      <li>rzeczy kradzionych lub uzyskanych nielegalnie,</li>
      <li>leków (dla ludzi i weterynaryjnych) bez odpowiedniego uprawnienia,</li>
      <li>środków ochrony roślin w sprzeczności z ustawą nr 326/2004 Sb. (w szczególności
        bez rejestracji ÚKZÚZ, poza profesjonalnymi użytkownikami tam, gdzie wymaga tego prawo),</li>
      <li>broni, amunicji i materiałów wybuchowych w sprzeczności z ustawą nr 119/2002 Sb.,</li>
      <li>żywych zwierząt bez świadectwa weterynaryjnego, gatunków chronionych bez CITES, martwych zwierząt,</li>
      <li>wyrobów tytoniowych, alkoholu, środków odurzających i psychotropowych, e-papierosów,</li>
      <li>kryptowalut, kont do gier, przedmiotów wirtualnych,</li>
      <li>wszystkiego, co narusza prawa autorskie, przemysłowe lub dobra osobiste osób trzecich,</li>
      <li>treści dyskryminujących, obraźliwych, nawołujących do nienawiści lub w inny sposób bezprawnych.</li>
    </ul>
    <p>
      Szczegółowe zasady bazaru, w tym dalsze treści zakazane oraz tryb postępowania przy naruszeniu,
      znajdziesz na stronie <a href="/bazar/pravidla/">Zasady bazaru</a>.
    </p>

    <h3>3.3 Usuwanie ogłoszeń i blokowanie kont</h3>
    <p>
      Operator jest uprawniony <strong>bez uprzedniego powiadomienia</strong> nie opublikować
      ogłoszenia, usunąć opublikowane ogłoszenie, ewentualnie zablokować konto użytkownika, jeżeli:
    </p>
    <ul>
      <li>ogłoszenie lub zachowanie użytkownika narusza niniejsze warunki, zasady bazaru
        lub przepisy prawa,</li>
      <li>ogłoszenie zawiera nieprawdziwe, mylące lub wprowadzające w błąd informacje,</li>
      <li>użytkownik wielokrotnie zamieszcza zduplikowane lub spamowe ogłoszenia,</li>
      <li>operator otrzyma <strong>kwalifikowane zgłoszenie</strong> o bezprawności
        treści od osoby trzeciej lub organu.</li>
    </ul>
    <p>
      Użytkownik zostanie poinformowany o powodzie usunięcia / blokady e-mailem zarejestrowanym do konta.
      Od decyzji można wnieść uzasadnioną skargę na adres
      <a href="mailto:info@samecdigital.com">info@samecdigital.com</a> w terminie 14 dni;
      operator rozpatrzy ją w ciągu 14 dni od doręczenia.
    </p>

