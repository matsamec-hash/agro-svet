---
// SSR — viz sezona/index.astro (locale prefix a prerender se vylučují).
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { SEASONS, getSeason, seasonName, seasonLeadL, seasonWorkLinksL, seasonFaqL, cropsSownInSeason, cropsHarvestedInSeason } from '../../lib/sezona';
import { useTranslations, tf, getLocaleFromUrl, localizeInternalHref } from '../../i18n/utils';
import { SITE_URL } from '../../lib/config';
import { breadcrumbSchema, itemListSchema, faqPageSchema } from '../../lib/structured-data';

const { season } = Astro.params;
const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);
// getStaticPaths odpadl s SSR → neplatné období musí odchytit stránka.
const def = getSeason(season!);
if (!def) return Astro.rewrite('/404');
const seasonLabel = seasonName(def.slug, locale);

const sown = cropsSownInSeason(def.slug, locale);
const harvested = cropsHarvestedInSeason(def.slug, locale);
const workLinks = seasonWorkLinksL(def.slug, locale);
const faq = seasonFaqL(def.slug, locale);
const lead = seasonLeadL(def.slug, locale);

const pageUrl = `${SITE_URL}/sezona/${def.slug}/`;
const title = tf(locale, 'sez.d.title', { season: seasonLabel });
const description = lead.slice(0, 155);

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Domů', url: '/' },
  { name: 'Sezóna', url: '/sezona/' },
  { name: seasonLabel, url: pageUrl },
]);
const itemListJsonLd = itemListSchema(
  [...sown, ...harvested].map((p) => ({ url: `${SITE_URL}/plodiny/${p.slug}/`, name: p.name })),
  `${seasonLabel} — plodiny`,
);
const faqJsonLd = faqPageSchema(faq);
---

<Layout title={title} description={description} canonical={pageUrl}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <div class="sezona-root">
    <nav class="breadcrumb" aria-label="Cesta">
      <a href={localizeInternalHref(locale, '/')}>{tr('cat.bc.home')}</a> <span aria-hidden="true">›</span>
      <a href={localizeInternalHref(locale, '/sezona/')}>{tr('sez.crumb')}</a> <span aria-hidden="true">›</span>
      <span class="current">{seasonLabel}</span>
    </nav>

    <h1>{tf(locale, 'sez.d.h1', { season: seasonLabel })}</h1>
    <p class="lead">{lead}</p>

    {workLinks.length > 0 && (
      <section class="block">
        <h2>{tr('sez.work')}</h2>
        {locale !== 'cs' && <p class="sez-note">{tr('sez.note')}</p>}
        <ul class="links">
          {workLinks.map((l) => (<li><a href={localizeInternalHref(locale, l.href)}>{l.label}</a></li>))}
        </ul>
      </section>
    )}

    {sown.length > 0 && (
      <section class="block">
        <h2>{def.slug === 'zima' ? tr('sez.d.sowPlanned') : tr('sez.d.sowNow')}</h2>
        <ul class="crops">
          {sown.map((p) => (
            <li><a href={localizeInternalHref(locale, `/plodiny/${p.slug}/`)}>{p.name}</a>{p.vysevek ? <span class="meta"> — {tr('sez.d.sowLbl')}: {p.vysevek}</span> : null}</li>
          ))}
        </ul>
      </section>
    )}

    {harvested.length > 0 && (
      <section class="block">
        <h2>{tr('sez.d.harvestNow')}</h2>
        <ul class="crops">
          {harvested.map((p) => (
            <li><a href={localizeInternalHref(locale, `/plodiny/${p.slug}/`)}>{p.name}</a>{p.sklizen ? <span class="meta"> — {tr('sez.d.harvestLbl')}: {p.sklizen}</span> : null}</li>
          ))}
        </ul>
      </section>
    )}

    {/* Akce jsou české (výstavy, polní dny v ČR) a /akce není pro ne-cs
        launchnuté — pod jiným jazykem se blok celý skrývá, nepřekládá. */}
    {locale === 'cs' && (
      <section class="block akce-block">
        <h2>{tr('sez.d.eventsH')}</h2>
        <div id="akce-sezona" aria-live="polite">
          <p class="akce-fallback"><a href="/akce/">Zobrazit kalendář akcí →</a></p>
        </div>
      </section>
    )}

    <section class="faq">
      <h2>{tr('sez.faqH')}</h2>
      {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </section>

    <p class="cross"><a href={localizeInternalHref(locale, '/sezona/')}>{tr('sez.allSeasons')}</a> · <a href={localizeInternalHref(locale, '/sezona/kalendar/')}>{tr('sez.cal')}</a></p>
  </div>

  <style>
  /* Termíny setí/sklizně jsou odvozené z českých dat; pod jiným jazykem to
     stránka přiznává, ať to nevypadá jako lokálně měřená data. */
  .sez-note { font-size: 13px; color: #6B6B72; margin: -4px 0 12px; }
    .sezona-root { max-width: 820px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    .breadcrumb { font-size: .85rem; color: #6b7280; margin-bottom: 1rem; display: flex; gap: .4rem; flex-wrap: wrap; }
    .breadcrumb a { color: #15803d; text-decoration: none; }
    h1 { font-size: 2rem; margin: .2rem 0 .6rem; }
    .lead { color: #374151; font-size: 1.05rem; margin-bottom: 1.8rem; }
    .block { margin-bottom: 1.8rem; }
    .block h2 { font-size: 1.3rem; margin-bottom: .7rem; }
    .links, .crops { list-style: none; padding: 0; margin: 0; display: grid; gap: .4rem; }
    .crops .meta { color: #6b7280; font-size: .85rem; }
    .links a, .crops a { color: #15803d; text-decoration: none; font-weight: 600; }
    .faq h2 { font-size: 1.3rem; margin: 2rem 0 .8rem; }
    .faq details { border-bottom: 1px solid #e5e7eb; padding: .6rem 0; }
    .faq summary { cursor: pointer; font-weight: 600; }
    .faq p { color: #374151; margin: .5rem 0 0; }
    .cross { margin-top: 2rem; font-size: .9rem; }
    .cross a { color: #15803d; }
    .akce-block .akce-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
    .akce-block .akce-nazev { color: #166534; font-weight: 600; }
    .akce-block .akce-list a { color: #15803d; text-decoration: none; font-weight: 600; }
    .akce-block .akce-meta { color: #6b7280; font-size: .85rem; font-weight: 400; }
    .akce-block .akce-empty, .akce-block .akce-fallback { color: #374151; }
    .akce-block .akce-all { margin-top: .8rem; font-size: .9rem; }
    .akce-block .akce-all a, .akce-block .akce-empty a, .akce-block .akce-fallback a { color: #15803d; }
  </style>

  <script is:inline define:vars={{ season: def.slug }}>
    (function () {
      var box = document.getElementById('akce-sezona');
      if (!box) return;
      function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
      fetch('/api/akce-sezona/' + season + '.json/')
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (items) {
          if (!Array.isArray(items) || items.length === 0) {
            box.innerHTML = '<p class="akce-empty">Pro tuto sezónu zatím nejsou naplánované žádné akce. <a href="/akce/">Procházet celý kalendář akcí →</a></p>';
            return;
          }
          var html = '<ul class="akce-list">';
          for (var i = 0; i < items.length; i++) {
            var a = items[i];
            var nazev = esc(a.nazev);
            var termin = esc(a.terminText);
            var obec = esc(a.obec);
            html += '<li><strong class="akce-nazev">' + nazev + '</strong>'
              + '<span class="akce-meta"> — ' + termin + (obec ? ', ' + obec : '') + '</span></li>';
          }
          html += '</ul><p class="akce-all"><a href="/akce/">Všechny akce →</a></p>';
          box.innerHTML = html;
        })
        .catch(function () {
          box.innerHTML = '<p class="akce-empty"><a href="/akce/">Zobrazit kalendář akcí →</a></p>';
        });
    })();
  </script>
</Layout>
