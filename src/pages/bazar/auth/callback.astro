---
import Layout from '../../../layouts/Layout.astro';
import { getPublicSupabaseConfig } from '../../../lib/supabase';

const { url: supabaseUrl, anonKey: supabaseKey } = getPublicSupabaseConfig();
---

<Layout title="Přihlašování…">
  <div style="min-height:60vh; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:16px;">
    <div class="spinner"></div>
    <p id="status" style="color:#666; font-size:14px;">Dokončujeme přihlášení…</p>
  </div>

  <style>
    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid #eee;
      border-top-color: #1a1a1a;
      border-radius: 50%;
      animation: spin .8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

  {/* Konfigurace pro zpracovaný <script> níže (define:vars by z něj udělalo
      is:inline a supabase-js by se nezbundloval z npm). */}
  <div id="sb-auth-config" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} hidden></div>

  <script>
    // supabase-js z npm (Vite ho zbundluje do /_astro/) — dřív z cizího CDN, takže
    // prohlížeč posílal IP návštěvníka cizímu serveru bez souhlasu.
    import { createClient } from '@supabase/supabase-js';

    const statusEl = document.getElementById('status');
    const cfg = document.getElementById('sb-auth-config')?.dataset;

    function fail(msg: string) {
      if (statusEl) statusEl.textContent = msg;
      setTimeout(() => { window.location.href = '/bazar/prihlaseni/?error=oauth'; }, 1500);
    }

    try {
      if (!cfg?.supabaseUrl || !cfg.supabaseKey) throw new Error('missing supabase config');
      const supabase = createClient(cfg.supabaseUrl, cfg.supabaseKey, {
        auth: { detectSessionInUrl: true, flowType: 'pkce', persistSession: true },
      });

      // Give the SDK a tick to process the URL code
      await new Promise(r => setTimeout(r, 200));

      const { data, error } = await supabase.auth.getSession();
      if (error || !data.session) {
        fail('Přihlášení se nezdařilo.');
      } else {
        const res = await fetch('/api/bazar/session/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_token: data.session.access_token,
            refresh_token: data.session.refresh_token,
          }),
        });
        if (res.ok) {
          // Resolve redirect target. Same-origin paths only.
          let target = '/bazar/moje/';
          // 1) ?next= query param — used by the seed/claim passwordless redirect.
          try {
            const nextParam = new URLSearchParams(window.location.search).get('next');
            if (nextParam && nextParam.startsWith('/') && !nextParam.startsWith('//')) {
              target = nextParam;
            }
          } catch {}
          // 2) sessionStorage stash from OAuth login (wins if present).
          try {
            const stashed = sessionStorage.getItem('postLoginRedirect');
            if (stashed && stashed.startsWith('/') && !stashed.startsWith('//')) {
              target = stashed;
            }
            sessionStorage.removeItem('postLoginRedirect');
          } catch {}
          window.location.href = target;
        } else {
          fail('Chyba při ukládání session.');
        }
      }
    } catch (e) {
      fail('Neočekávaná chyba.');
    }
  </script>
</Layout>
