---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { createServerClient } from '../../../lib/supabase';
import { getEnvVar } from '../../../lib/env';
import { CATEGORIES, BRANDS } from '../../../lib/bazar-constants';
import { getProspectByToken, markProspectOpened } from '../../../lib/bazar-seed';
import { isTokenExpired } from '../../../lib/bazar-seed-token';

export const TERMS_VERSION = '2026-07-19';

const { token } = Astro.params;
const supabase = createServerClient();
// Veřejný origin pro <img> — vynutíme https bez portu (server má PUBLIC_SUPABASE_URL
// omylem s interním portem :8000, přes který veřejné HTTPS na obrázky padá).
function publicSupabaseOrigin(): string {
  try {
    const u = new URL(getEnvVar('PUBLIC_SUPABASE_URL') ?? '');
    return `https://${u.hostname}`;
  } catch {
    return '';
  }
}
const publicStorageBase = `${publicSupabaseOrigin()}/storage/v1/object/public/bazar-images`;
const justDeleted = Astro.url.searchParams.get('deleted') === '1';
const prospect = token ? await getProspectByToken(supabase, token) : null;

let state: 'ok' | 'invalid' | 'expired' | 'done' | 'deleted' = 'ok';
if (justDeleted) state = 'deleted';
else if (!prospect) state = 'invalid';
else if (prospect.status === 'confirmed') state = 'done';
else if (isTokenExpired(prospect.token_expires_at)) state = 'expired';

// Prospekt založený jen podle telefonu nemá e-mail — na claim stránce si ho vyžádáme,
// jinak by poslední krok (založení účtu přes e-mail) spadl.
const needsEmail = !(prospect?.email && prospect.email.trim());

interface Spec {
  label: string;
  value: string;
}
interface ClaimListing {
  id: string;
  title: string;
  price: number | null;
  description: string;
  specs: Spec[];
  images: string[];
}

const categoryLabel = (v: string | null) => CATEGORIES.find((c) => c.value === v)?.label ?? null;
const brandLabel = (v: string | null) => BRANDS.find((b) => b.value === v)?.label ?? null;

let listings: ClaimListing[] = [];
if (state === 'ok' && prospect) {
  await markProspectOpened(supabase, prospect.id, new Date().toISOString());
  const { data } = await supabase
    .from('bazar_listings')
    .select(
      'id, title, price, description, category, brand, year_of_manufacture, power_hp, hours_operated, bazar_images(storage_path)',
    )
    .eq('seed_prospect_id', prospect.id);
  listings = (data ?? []).map((l: any) => ({
    id: l.id,
    title: l.title,
    price: l.price,
    description: l.description,
    specs: [
      { label: 'Kategorie', value: categoryLabel(l.category) },
      { label: 'Značka', value: brandLabel(l.brand) },
      { label: 'Rok', value: l.year_of_manufacture ? String(l.year_of_manufacture) : null },
      { label: 'Motohodiny', value: l.hours_operated ? `${l.hours_operated.toLocaleString('cs-CZ')} mth` : null },
      { label: 'Výkon', value: l.power_hp ? `${l.power_hp} k` : null },
    ].filter((s): s is Spec => Boolean(s.value)),
    // URL obrázků stavíme z VEŘEJNÉ Supabase URL (PUBLIC_SUPABASE_URL), ne přes
    // getPublicUrl(). Self-hosted Supabase má server SUPABASE_URL nastavené na interní
    // Docker adresu (http://supabase-kong:8000), kterou by getPublicUrl vrátil do
    // <img src> a prohlížeč by ji nenačetl.
    images: (l.bazar_images ?? []).map(
      (img: { storage_path: string }) => `${publicStorageBase}/${img.storage_path}`,
    ),
  }));
}
---
<Layout title="Zveřejnění inzerátu">
  <main class="mx-auto max-w-4xl p-6">
    {state === 'deleted' && (
      <div class="rounded border border-green-300 bg-green-50 p-4">
        <p class="font-semibold">Inzerát byl smazán.</p>
        <p class="text-sm text-gray-600 mt-1">Nic se nezveřejnilo a všechna data i fotky jsme odstranili. Děkujeme.</p>
      </div>
    )}
    {state === 'invalid' && <p class="text-red-700">Neplatný odkaz.</p>}
    {state === 'expired' && <p class="text-red-700">Platnost odkazu vypršela.</p>}
    {state === 'done' && <p class="text-green-700">Tento inzerát už byl zveřejněn. <a class="underline" href="/bazar/moje/">Přejít do mých inzerátů</a></p>}

    {state === 'ok' && (
      <>
        <span class="section-label">Agro bazar</span>
        <h1 style="font-size:clamp(1.6rem,4vw,2.2rem);margin:2px 0 10px;">Vaše připravené inzeráty</h1>
        <p style="color:#555;line-height:1.6;margin-bottom:22px;">
          Připravili jsme vám {listings.length === 1 ? 'tento inzerát' : `${listings.length} inzerátů`} podle vaší
          nabídky. Vyberte, které chcete <strong>zdarma</strong> zveřejnit na Agro-svět bazaru — zbytek
          zůstane jako váš neveřejný koncept.
        </p>

        <form method="POST" action="/bazar/prevzit/api/confirm/" id="confirmForm">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="terms_version" value={TERMS_VERSION} />

          <label style="display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;margin-bottom:14px;">
            <input type="checkbox" id="selectAllListings" checked /> Vybrat vše
          </label>

          {listings.map((l) => (
            <article class="claim-card" data-selected="true">
              <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                <input type="checkbox" name="listing_ids" value={l.id} checked class="listingChk" style="width:18px;height:18px;flex:none;" />
                <span style="font-family:var(--font-heading);font-weight:700;font-size:1.05rem;">{l.title}</span>
              </label>
              {l.price && <p style="font-weight:700;font-size:1.1rem;margin:8px 0 0 28px;">{l.price.toLocaleString('cs-CZ')} Kč</p>}
              {l.specs.length > 0 && (
                <dl style="margin:10px 0 0 28px;display:flex;flex-wrap:wrap;gap:6px;">
                  {l.specs.map((s) => (
                    <div style="background:#f5f5f5;border-radius:6px;padding:3px 8px;font-size:12px;">
                      <dt style="display:inline;color:#888;">{s.label}:</dt>{' '}
                      <dd style="display:inline;font-weight:600;">{s.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <p class="claim-desc">{l.description}</p>
              {l.images.length > 0 && (
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 0 28px;">
                  {l.images.map((url) => (
                    <img src={url} alt="" style="height:88px;width:88px;object-fit:cover;border-radius:8px;" />
                  ))}
                </div>
              )}
              <a href={`/bazar/${l.id}/?preview=${token}`} target="_blank" rel="noopener" class="link-underline"
                style="display:inline-block;margin:12px 0 0 28px;font-size:13px;">👁️ Náhled inzerátu</a>
            </article>
          ))}

          {needsEmail && (
            <div class="form-group" style="margin-top:8px;">
              <label for="sellerEmail">Váš e-mail <span style="color:#888;font-weight:400;">— pošleme na něj přihlašovací odkaz</span></label>
              <input id="sellerEmail" type="email" name="email" required class="form-input" placeholder="vas@email.cz" autocomplete="email" />
            </div>
          )}

          <label style="display:flex;align-items:flex-start;gap:8px;font-size:14px;margin-top:16px;">
            <input type="checkbox" name="agree" required style="margin-top:3px;flex:none;" />
            <span>Potvrzuji, že jsem vlastníkem inzerátu a fotek a mám právo je zveřejnit, a souhlasím
            s <a href="/bazar/pravidla/" class="link-underline" target="_blank">podmínkami bazaru</a>.</span>
          </label>

          <button type="submit" id="publishBtn" class="btn-primary" style="width:100%;justify-content:center;margin-top:18px;">
            Zveřejnit vybrané ({listings.length})
          </button>
        </form>

        <form method="POST" action="/bazar/prevzit/api/delete/" style="margin-top:14px;text-align:center;"
          onsubmit="return confirm('Opravdu smazat tento předchystaný inzerát? Akce je nevratná.');">
          <input type="hidden" name="token" value={token} />
          <button style="font-size:13px;color:#888;text-decoration:underline;">
            Nemám zájem — smazat inzerát
          </button>
        </form>
      </>
    )}
  </main>
</Layout>

<style>
  .claim-card {
    border: 2px solid var(--line, #e6e6e6);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 14px;
    transition: border-color .15s, background .15s, opacity .15s;
  }
  .claim-card[data-selected="true"] { border-color: #1a1a1a; background: #fffdf0; }
  .claim-card[data-selected="false"] { opacity: .6; }
  /* Popis zkrácený na 3 řádky, ať karty jdou přehledně proskenovat; celý text je v „Náhledu". */
  .claim-desc {
    font-size: 14px; color: #444; white-space: pre-line;
    margin: 10px 0 0 28px; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>

<script>
  const all = document.getElementById('selectAllListings') as HTMLInputElement | null;
  const chks = Array.from(document.querySelectorAll('.listingChk')) as HTMLInputElement[];
  const btn = document.getElementById('publishBtn') as HTMLButtonElement | null;

  function syncCard(chk: HTMLInputElement) {
    const card = chk.closest('.claim-card') as HTMLElement | null;
    if (card) card.dataset.selected = String(chk.checked);
  }
  function refresh() {
    const n = chks.filter((c) => c.checked).length;
    if (btn) {
      btn.textContent = n > 0 ? `Zveřejnit vybrané (${n})` : 'Vyberte alespoň jeden inzerát';
      btn.disabled = n === 0;
      btn.style.opacity = n === 0 ? '.5' : '1';
    }
    if (all) all.checked = n === chks.length;
  }

  chks.forEach((c) => c.addEventListener('change', () => { syncCard(c); refresh(); }));
  all?.addEventListener('change', () => {
    chks.forEach((c) => { c.checked = all.checked; syncCard(c); });
    refresh();
  });
  refresh();
</script>
