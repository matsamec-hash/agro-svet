---
import Layout from '../../layouts/Layout.astro';
import { createServerClient } from '../../lib/supabase';
import { SITE_URL } from '../../lib/config';
import {
  REPORT_REASONS,
  CSAM_REASON,
  DESCRIPTION_MIN,
  DESCRIPTION_MAX,
  NAME_MAX,
  EMAIL_MAX,
  GOOD_FAITH_STATEMENT,
  parseListingRef,
  isUuid,
} from '../../lib/bazar-report';

export const prerender = false;

const url = new URL(Astro.request.url);
const listingRaw = (url.searchParams.get('listing')?.trim() ?? '').slice(0, 300);
const listingId = parseListingRef(listingRaw, SITE_URL) ?? '';
const ok = url.searchParams.get('ok') === '1';
const err = url.searchParams.get('err') ?? '';
const reportIdParam = url.searchParams.get('id') ?? '';
const reportId = isUuid(reportIdParam) ? reportIdParam : '';
const confirmationSent = url.searchParams.get('potvrzeni') === '1';

let listingPreview: { title: string; price: number | null } | null = null;
if (listingId) {
  const supabase = createServerClient();
  const { data } = await supabase
    .from('bazar_listings')
    .select('title, price')
    .eq('id', listingId)
    .neq('status', 'pending_claim')
    .maybeSingle();
  if (data) listingPreview = { title: data.title, price: data.price };
}

const errMessages: Record<string, string> = {
  listing: 'Vložte URL inzerátu z agro-svet.cz (např. https://agro-svet.cz/bazar/…/) nebo jeho ID.',
  'listing-not-found': 'Inzerát s tímto ID jsme nenašli — možná už byl smazán. Zkontrolujte prosím URL.',
  reason: 'Vyberte důvod nahlášení.',
  description: `Doplňte prosím odůvodnění — proč je obsah podle vás nezákonný nebo v rozporu s pravidly (alespoň ${DESCRIPTION_MIN} znaků).`,
  'description-long': `Odůvodnění je příliš dlouhé (max ${DESCRIPTION_MAX} znaků).`,
  name: 'Vyplňte prosím své jméno a příjmení (nebo název firmy).',
  'name-long': `Jméno je příliš dlouhé (max ${NAME_MAX} znaků).`,
  email: 'Vyplňte prosím platný e-mail — pošleme na něj potvrzení o přijetí a rozhodnutí.',
  'good-faith': 'Potvrďte prosím prohlášení o dobré víře.',
  server: 'Hlášení se nepodařilo uložit. Zkuste to prosím znovu nebo nám napište na info@samecdigital.com.',
};
const errMsg = err ? (errMessages[err] ?? 'Chyba při odesílání.') : '';
---
<Layout
  title="Nahlásit závadný inzerát — Agro bazar"
  description="Formulář pro nahlášení inzerátu, který porušuje pravidla bazaru, právní předpisy nebo vaše práva. Posuzujeme do 7 dnů."
>
  <div class="report-page">
    <h1>Nahlásit závadný inzerát</h1>
    <p class="lead">
      Domníváte-li se, že konkrétní inzerát porušuje
      <a href="/bazar/pravidla/">pravidla bazaru</a> nebo právní předpisy, vyplňte
      formulář níže. Oznámení posoudíme <strong>bez zbytečného odkladu</strong>,
      zpravidla do <strong>7 dnů</strong>. Ve zjevně nezákonných případech jednáme
      neprodleně.
    </p>

    {ok && (
      <div class="alert alert-success">
        Děkujeme, oznámení jsme přijali.
        {reportId && <> Číslo oznámení: <strong>{reportId}</strong>.</>}
        {confirmationSent
          ? ' Potvrzení o přijetí vám pošleme na uvedený e-mail a po posouzení vás informujeme o rozhodnutí.'
          : ' Posoudíme ho bez zbytečného odkladu.'}
      </div>
    )}

    {errMsg && (
      <div class="alert alert-error">{errMsg}</div>
    )}

    {!ok && (
      <form method="POST" action="/api/bazar/reports/" class="report-form" id="report-form" data-csam-reason={CSAM_REASON}>
        <p class="field-hint required-hint">Pole označená * jsou povinná.</p>
        <div class="form-group">
          <label for="listing_id">Inzerát (URL nebo ID) *</label>
          {listingPreview ? (
            <div class="listing-preview">
              <p class="listing-preview-title">{listingPreview.title}</p>
              <p class="listing-preview-meta">
                ID: <code>{listingId}</code> ·{' '}
                <a href={`/bazar/${listingId}/`} target="_blank" rel="noopener">otevřít inzerát</a>
              </p>
              <input type="hidden" name="listing_id" value={listingId} />
            </div>
          ) : (
            <>
              <input
                type="text"
                id="listing_id"
                name="listing_id"
                class="form-input"
                placeholder="https://agro-svet.cz/bazar/… nebo UUID inzerátu"
                value={listingRaw}
                required
                maxlength="300"
                pattern="(https?://[^\s]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"
              />
              <p class="field-hint">Přesnou URL najdete v adresním řádku na detailu inzerátu, ID je její poslední část (uuid).</p>
            </>
          )}
        </div>

        <div class="form-group">
          <label for="reason">Důvod nahlášení *</label>
          <select id="reason" name="reason" class="form-select" required>
            <option value="">— vyberte —</option>
            {REPORT_REASONS.map((r) => (
              <option value={r.value}>{r.label}</option>
            ))}
          </select>
          <p class="field-hint csam-hint" id="csam-hint" hidden>
            U tohoto druhu obsahu jméno ani e-mail vyplňovat nemusíte. Prosíme, oznamte ho
            také Policii ČR (tísňová linka 158).
          </p>
        </div>

        <div class="form-group">
          <label for="description">Odůvodnění — proč je obsah podle vás nezákonný nebo v rozporu s pravidly *</label>
          <textarea
            id="description"
            name="description"
            class="form-input"
            rows="5"
            required
            minlength={DESCRIPTION_MIN}
            maxlength={DESCRIPTION_MAX}
            placeholder="Uveďte, co konkrétně je v inzerátu závadné a proč, případně odkažte na zdroj (např. registr ÚKZÚZ, originální fotku, kterou kradou…)"
          ></textarea>
          <p class="field-hint">Alespoň {DESCRIPTION_MIN} znaků. Čím konkrétnější odůvodnění, tím rychleji oznámení posoudíme.</p>
        </div>

        <div class="form-group">
          <label for="reporter_name">Vaše jméno a příjmení (nebo název firmy) <span class="contact-req">*</span></label>
          <input
            type="text"
            id="reporter_name"
            name="reporter_name"
            class="form-input contact-field"
            required
            maxlength={NAME_MAX}
            autocomplete="name"
            placeholder="Jan Novák"
          />
        </div>

        <div class="form-group">
          <label for="reporter_email">Váš e-mail <span class="contact-req">*</span></label>
          <input
            type="email"
            id="reporter_email"
            name="reporter_email"
            class="form-input contact-field"
            required
            maxlength={EMAIL_MAX}
            autocomplete="email"
            placeholder="jan@example.cz"
          />
          <p class="field-hint">
            Pošleme na něj potvrzení o přijetí oznámení a později rozhodnutí o něm. Jméno a
            e-mail použijeme jen k vyřízení oznámení, uchováváme je do jeho uzavření a poté
            je mažeme. Inzerentovi vaši totožnost sdělíme,
            jen pokud je to nezbytně nutné (čl. 17 odst. 3 písm. b) DSA, typicky u sporů
            o autorská práva).
          </p>
        </div>

        <div class="form-group consent-group">
          <label class="consent-label">
            <input type="checkbox" id="good_faith" name="good_faith" value="1" required />
            <span>{GOOD_FAITH_STATEMENT} *</span>
          </label>
        </div>

        {/* Honeypot — bots fill all visible fields, skip CSS-hidden ones. */}
        <div class="hp-field" aria-hidden="true">
          <label for="website">Vyplňte jen, jste-li robot</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p class="legal-hint">
          Údaje z formuláře zpracováváme, abychom mohli oznámení posoudit a vyřídit podle
          čl. 16 nařízení o digitálních službách (DSA) — právní povinnost podle čl. 6 odst. 1
          písm. c) GDPR. Podrobnosti v
          <a href="/zpracovani-osobnich-udaju/" target="_blank" rel="noopener">zásadách zpracování osobních údajů</a>.
          IP adresu uchováváme po dobu 90 dnů (hash) pro detekci opakovaných nahlášení.
        </p>

        <button type="submit" class="btn-primary">Odeslat hlášení</button>
      </form>
    )}

    <hr>

    <h2>Co se s hlášením stane</h2>
    <ol>
      <li>Hlášení dorazí provozovateli (Samec Digital s.r.o.) na info@samecdigital.com. Na váš e-mail hned odejde <strong>potvrzení o přijetí</strong> s číslem oznámení.</li>
      <li>Posoudíme ho zpravidla <strong>do 7 dnů</strong> od přijetí. Pokud je obsah <strong>zjevně nezákonný</strong> (ohrožení zdraví, podvod, padělky), jednáme neprodleně.</li>
      <li>Pokud porušení potvrdíme, inzerát smažeme a/nebo zablokujeme účet inzerenta. Inzerent dostane oznámení s odůvodněním (DSA čl. 17) a může podat <strong>stížnost</strong> ve lhůtě 14 dnů.</li>
      <li>O rozhodnutí vás bez zbytečného odkladu informujeme e-mailem, včetně možností, jak se proti němu bránit.</li>
    </ol>

    <h2>Co tu nemá smysl hlásit</h2>
    <ul>
      <li><strong>Spory o cenu nebo kvalitu</strong> — provozovatel není stranou kupní smlouvy, řešte přímo s inzerentem nebo spotřebitelským sporem.</li>
      <li><strong>Inzerát, který se vám prostě nelíbí</strong> — bez porušení pravidel.</li>
      <li><strong>Žádosti o smazání vlastního inzerátu</strong> — to dělejte ze svého profilu (<a href="/bazar/moje/">Moje inzeráty</a>).</li>
      <li><strong>Reklamace topování</strong> — na info@samecdigital.com.</li>
    </ul>
  </div>
</Layout>

<script>
  // DSA čl. 16 odst. 2 písm. c): u oznámení o trestných činech podle čl. 3–7
  // směrnice 2011/93/EU nesmíme jméno a e-mail vyžadovat. Bez JS zůstanou pole
  // v HTML povinná, server je ale u tohoto důvodu nevyžaduje.
  const form = document.getElementById('report-form');
  const reasonEl = document.getElementById('reason') as HTMLSelectElement | null;
  const hintEl = document.getElementById('csam-hint');
  if (form && reasonEl) {
    const csamReason = form.dataset.csamReason ?? '';
    const fields = form.querySelectorAll<HTMLInputElement>('.contact-field');
    const marks = form.querySelectorAll<HTMLElement>('.contact-req');
    const sync = () => {
      const optional = reasonEl.value === csamReason;
      fields.forEach((f) => { f.required = !optional; });
      marks.forEach((m) => { m.hidden = optional; });
      if (hintEl) hintEl.hidden = !optional;
    };
    reasonEl.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .report-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    line-height: 1.7;
    color: #222;
  }
  .report-page h1 {
    font-family: 'Chakra Petch', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0 0 12px;
  }
  .report-page .lead {
    font-size: 15px;
    color: #444;
    margin: 0 0 24px;
  }
  .report-page h2 {
    font-family: 'Chakra Petch', sans-serif;
    font-weight: 700;
    font-size: 20px;
    margin: 32px 0 12px;
  }
  .report-page a { color: #0B7A3B; text-decoration: underline; }
  .report-page hr { border: 0; border-top: 1px solid #eaeaec; margin: 32px 0; }

  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.55;
  }
  .alert-success {
    background: #e8f5ec;
    border: 1px solid #0B7A3B;
    color: #0B7A3B;
  }
  .alert-error {
    background: #fcebe8;
    border: 1px solid #c0392b;
    color: #c0392b;
  }

  .report-form .form-group { margin: 0 0 18px; }
  .report-form label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 6px;
    color: #1a1a1a;
  }
  .report-form .form-input,
  .report-form .form-select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #d6d3c4;
    border-radius: 8px;
    font: inherit;
    background: #fff;
  }
  .report-form textarea.form-input {
    resize: vertical;
    min-height: 110px;
    font-family: inherit;
  }
  .report-form .form-input:focus,
  .report-form .form-select:focus {
    outline: 2px solid #0B7A3B;
    outline-offset: -1px;
    border-color: #0B7A3B;
  }
  .field-hint {
    font-size: 12px;
    color: #666;
    margin: 6px 0 0;
    line-height: 1.5;
  }

  .listing-preview {
    background: #fbfaf4;
    border: 1px solid #e8e4d2;
    border-radius: 8px;
    padding: 12px 16px;
  }
  .listing-preview-title {
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 4px;
    color: #1a1a1a;
  }
  .listing-preview-meta {
    font-size: 12px;
    color: #666;
    margin: 0;
  }
  .listing-preview-meta code {
    font-size: 11px;
    background: #fff;
    border: 1px solid #e8e4d2;
    padding: 1px 6px;
    border-radius: 4px;
  }

  .required-hint { margin: 0 0 14px; }
  .csam-hint {
    color: #8a4b00;
    background: #fff6e5;
    border-left: 3px solid #e0a040;
    padding: 8px 12px;
    border-radius: 4px;
  }
  .csam-hint[hidden] { display: none; }
  .contact-req[hidden] { display: none; }

  .report-form .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 500;
    cursor: pointer;
  }
  .report-form .consent-label input[type="checkbox"] {
    margin-top: 5px;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  .legal-hint {
    font-size: 12px;
    color: #666;
    line-height: 1.55;
    background: #fafafa;
    border-left: 3px solid #d6d3c4;
    padding: 10px 14px;
    margin: 4px 0 18px;
  }

  .btn-primary {
    background: #0B7A3B;
    color: #fff;
    font: inherit;
    font-weight: 600;
    padding: 12px 24px;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    font-size: 15px;
    transition: background .15s;
  }
  .btn-primary:hover { background: #066027; }

  /* Honeypot — hidden from real users via CSS, bots that auto-fill text inputs will fill it. */
  .hp-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
