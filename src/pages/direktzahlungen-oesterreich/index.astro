---
// src/pages/direktzahlungen-oesterreich/index.astro
// DE-only landing: přímé platby GAP v RAKOUSKU (1. pilíř) — Basiszahlung,
// Umverteilung, Junglandwirte, Almauftriebsprämie. Jurisdikčně vázané na AT
// → obsah psán přímo německy, NE přes t() klíče. Non-de locale → 404.
//
// ‼️ 2026-10-15 přepsáno. Dřívější verze tvrdila, že Rakousko „nevyhlašuje
// roční Einheitsbeträge" a uváděla „Richtwerte" 208/41/44/22/66/100/50 z LKÖ
// (2022, návrh strategického plánu). Ve skutečnosti AMA částky dopočítává
// a vyhlašuje každý rok v prosinci (§ 21 Abs. 11 GSP-AV). Teď: 2025 konečné,
// 2026 předběžné — data v src/data/foerderung-de.ts (AT_DZ).
// Zdroje (stažené v ~/agro-svet/foto-audit/de/zdroje):
//   - AMA, Prämienbetrag gemäß § 21 Abs. 11 GSP-AV (Antragsjahr 2025)
//   - AMA, Merkblatt Direktzahlungen 2026 (13. 11. 2025) — ca.-Beträge 2026,
//     MFA-Frist, Junglandwirte, Umverteilung, Kappung, Almauftrieb
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { localizePath, isLaunchedPath } from '../../i18n/utils';
import { AT_DZ } from '../../data/foerderung-de';

const locale = Astro.locals.locale ?? 'cs';
// Mimo LAUNCHED_PREFIXES.de → 404 i pod /de (stránka se dá znovu stáhnout jedním řádkem).
if (locale !== 'de' || !isLaunchedPath('de', '/direktzahlungen-oesterreich')) return Astro.rewrite('/404');

Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=86400, stale-while-revalidate=604800');

const A = AT_DZ[2025];
const B = AT_DZ[2026];

type Row = { name: string; v2025: number; v2026: number; unit: '€/ha' | '€/RGVE'; note: string };

const flaeche: Row[] = [
  { name: 'Basiszahlung — Heimgutflächen', v2025: A.heimgut, v2026: B.heimgut, unit: '€/ha', note: 'Acker, Grünland und Dauerkulturen im Tal' },
  { name: 'Basiszahlung — Almweideflächen', v2025: A.alm, v2026: B.alm, unit: '€/ha', note: 'eigener, deutlich niedrigerer Satz' },
  { name: 'Umverteilungszahlung — 1. bis 20. Hektar', v2025: A.umv20, v2026: B.umv20, unit: '€/ha', note: 'zusätzlich, nur Heimgut' },
  { name: 'Umverteilungszahlung — 21. bis 40. Hektar', v2025: A.umv40, v2026: B.umv40, unit: '€/ha', note: 'halber Satz, ab dem 41. Hektar nichts' },
  { name: 'Zahlung für Junglandwirtinnen und Junglandwirte', v2025: A.jung, v2026: B.jung, unit: '€/ha', note: 'höchstens 40 ha, höchstens 5 Jahre' },
];

const tiere: Row[] = [
  { name: 'Almauftriebsprämie — Kühe', v2025: A.almKuehe, v2026: B.almKuehe, unit: '€/RGVE', note: 'nur für aufgetriebene Tiere' },
  { name: 'Almauftriebsprämie — Mutterschafe und Mutterziegen', v2025: A.almSchafeZiegen, v2026: B.almSchafeZiegen, unit: '€/RGVE', note: 'nur für aufgetriebene Tiere' },
  { name: 'Almauftriebsprämie — Rinder ohne Kühe', v2025: A.almRinder, v2026: B.almRinder, unit: '€/RGVE', note: 'etwa Kalbinnen und Ochsen' },
];

// Effektiver Satz je Hektar Heimgut nach Staffelung (Antragsjahr 2025, endgültig).
const staffel = [
  { label: '1. bis 20. Hektar', v: A.heimgut + A.umv20 },
  { label: '21. bis 40. Hektar', v: A.heimgut + A.umv40 },
  { label: 'ab dem 41. Hektar', v: A.heimgut },
];

const fmt = (v: number) => v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fmt0 = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 0 });
const lastUpdated = new Date().toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pageUrl = 'https://agro-svet.cz/de/direktzahlungen-oesterreich/';

const faq = [
  { q: 'Wie hoch ist die Basiszahlung in Österreich?', a: `Für das Antragsjahr 2025 hat die AMA ${fmt(A.heimgut)} € je Hektar Heimgutfläche festgesetzt. Almweideflächen erhalten einen eigenen Satz von ${fmt(A.alm)} €/ha. Für 2026 nennt die AMA vorläufig rund ${fmt0(B.heimgut)} bzw. ${fmt0(B.alm)} €/ha; der genaue Betrag folgt im Dezember 2026.` },
  { q: 'Gibt es in Österreich jährliche Einheitsbeträge?', a: 'Ja. Die AMA rechnet die Beträge jedes Jahr neu: Das für Österreich verfügbare Budget einer Maßnahme wird auf die österreichweit beantragten förderfähigen Hektar beziehungsweise RGVE verteilt. Das Ergebnis veröffentlicht sie im Dezember auf ama.at (§ 21 Abs. 11 GSP-AV). Vor der Antragstellung gibt es nur vorläufige Werte im Merkblatt. Verbindlich für den einzelnen Betrieb ist der Bescheid der AMA.' },
  { q: 'Wie wird die Umverteilungszahlung berechnet?', a: `Sie kommt zur Basiszahlung hinzu, aber nur auf Heimgutflächen und höchstens auf 40 Hektar. Die ersten 20 Hektar erhalten den vollen Satz (2025: ${fmt(A.umv20)} €/ha), der 21. bis 40. Hektar den halben (${fmt(A.umv40)} €/ha). Almweideflächen sind ausgenommen. Zusammen mit der Basiszahlung ergeben sich 2025 effektiv ${fmt(A.heimgut + A.umv20)} €/ha für die ersten 20 Hektar.` },
  { q: 'Welche Bedingungen gelten für Junglandwirtinnen und Junglandwirte?', a: `Wer einen Betrieb übernimmt oder gründet, darf im Jahr der Aufnahme der Tätigkeit höchstens 40 Jahre alt sein. Die passende landwirtschaftliche Ausbildung muss spätestens zwei Jahre danach abgeschlossen sein; in begründeten Fällen verlängert die AMA die Frist um ein Jahr. Gezahlt werden ${fmt(A.jung)} €/ha (2025) für höchstens 40 Hektar und längstens fünf aufeinanderfolgende Jahre ab dem ersten Antrag — in der laufenden Periode bis spätestens 2027.` },
  { q: 'Wofür gibt es die Almauftriebsprämie?', a: `Für Tiere, die tatsächlich auf eine Alm aufgetrieben und rechtzeitig gemeldet werden. Gerechnet wird je raufutterverzehrender Großvieheinheit (RGVE): 2025 gab es ${fmt(A.almKuehe)} € für Kühe sowie für Mutterschafe und Mutterziegen und ${fmt(A.almRinder)} € für die übrigen Rinder. 2026 müssen die Tiere bis spätestens 15. Juli aufgetrieben und gemeldet sein.` },
  { q: 'Bis wann muss der Antrag gestellt werden?', a: 'Basiszahlung, Umverteilung, Junglandwirte und Almauftriebsprämie werden im Mehrfachantrag (MFA) beantragt — 2026 bis 15. April, eingereicht über eAMA. Den Auszahlungstermin gibt die AMA jährlich auf ihrer Website bekannt.' },
  { q: 'Gibt es eine Obergrenze?', a: 'Ja. Die Basiszahlung ist je Betrieb grundsätzlich auf 100 000 € begrenzt. Löhne und Gehälter für die landwirtschaftliche Tätigkeit samt Steuern und Sozialabgaben dürfen dabei angerechnet werden, wenn sie der AMA mit dem MFA nachgewiesen werden.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `https://agro-svet.cz${localizePath('de', '/')}` },
        { '@type': 'ListItem', position: 2, name: 'Direktzahlungen Österreich', item: pageUrl },
      ],
    },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
};

const groups: { title: string; rows: Row[] }[] = [
  { title: 'Flächenbezogene Zahlungen', rows: flaeche },
  { title: 'Almauftriebsprämie (gekoppelte Einkommensstützung)', rows: tiere },
];
---

<Layout
  title="Direktzahlungen Österreich 2025 — Einheitsbeträge der AMA"
  description={`Die Einheitsbeträge der Direktzahlungen in Österreich: Basiszahlung ${fmt(A.heimgut)} €/ha Heimgut (2025, AMA), Umverteilung ${fmt(A.umv20)} €/ha auf die ersten 20 Hektar, Junglandwirte ${fmt(A.jung)} €/ha. Vorläufige Werte 2026 und Prämienrechner.`}
  noHreflang={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="db">
    <div class="db-wrap">
      <nav class="db-crumb" aria-label="Brotkrumennavigation">
        <a href={localizePath('de', '/')}>Startseite</a>
        <span>/</span>
        <b>Direktzahlungen Österreich</b>
      </nav>

      <header class="db-head">
        <span class="db-eyebrow">GAP-Direktzahlungen Österreich · Antragsjahr 2025 und 2026</span>
        <h1>Direktzahlungen in Österreich — Beträge je Hektar</h1>
        <p class="db-lead">
          Basiszahlung, Umverteilung auf die ersten 40 Hektar, Junglandwirte und Almauftriebsprämie:
          die von der AMA festgesetzten Einheitsbeträge für 2025, die vorläufigen Werte für 2026,
          die effektive Staffelung je Hektar und ein Rechner.
        </p>
      </header>

      <div class="db-flag">
        <strong>2025 endgültig, 2026 vorläufig.</strong> Die AMA berechnet die Beträge jedes Jahr neu und
        veröffentlicht sie im Dezember. Die Werte für 2025 sind die festgesetzten Einheitsbeträge; für 2026
        gibt es bisher nur die gerundeten Werte aus dem Merkblatt, den genauen Betrag verlautbart die AMA im
        Dezember 2026. Verbindlich für den einzelnen Betrieb ist der Bescheid der AMA.
      </div>

      <section class="db-hero-stats" aria-label="Wichtigste Beträge 2025">
        <div class="db-stat db-stat--hl">
          <span class="db-stat-l">Basiszahlung Heimgut 2025</span>
          <b class="db-stat-v">{fmt(A.heimgut)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">1. bis 20. Hektar effektiv</span>
          <b class="db-stat-v">{fmt(A.heimgut + A.umv20)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Junglandwirte</span>
          <b class="db-stat-v">{fmt(A.jung)} <em>€/ha</em></b>
        </div>
        <div class="db-stat">
          <span class="db-stat-l">Almweidefläche</span>
          <b class="db-stat-v">{fmt(A.alm)} <em>€/ha</em></b>
        </div>
      </section>

      <section class="db-calc" aria-labelledby="calc-h">
        <h2 id="calc-h">Prämienrechner — Heimgutfläche</h2>
        <p class="db-calc-sub">Basiszahlung und Umverteilung für Heimgutflächen mit den Beträgen 2025.
          Almweideflächen, Junglandwirte und die Almauftriebsprämie sind nicht enthalten.</p>
        <div class="db-calc-box">
          <label class="db-calc-field">
            Hektar
            <input id="ha" type="number" min="0" step="0.1" value="30" inputmode="decimal" />
          </label>
          <div class="db-calc-out">
            <div class="db-calc-line"><span>Basiszahlung</span><b id="o-grund">—</b></div>
            <div class="db-calc-line"><span>Umverteilung <em>(1.–40. ha, gestaffelt)</em></span><b id="o-umv">—</b></div>
            <div class="db-calc-line db-calc-total"><span>Summe (überschlägig)</span><b id="o-sum">—</b></div>
          </div>
        </div>
        <p class="db-calc-note">Überschlägige Rechnung. Abzüge aus Kontrollen, die Konditionalität und die
          Obergrenze von 100 000 € Basiszahlung je Betrieb sind nicht berücksichtigt.</p>
      </section>

      <section class="db-tables" aria-labelledby="tab-h">
        <h2 id="tab-h">Alle Zahlungsarten im Überblick</h2>
        {groups.map((g) => (
          <div class="db-tw">
            <h3>{g.title}</h3>
            <table class="db-table">
              <thead>
                <tr><th scope="col">Zahlungsart</th><th scope="col">2025 (endgültig)</th><th scope="col">2026 (vorläufig)</th><th scope="col">Anmerkung</th></tr>
              </thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td>{r.name}</td>
                    <td class="db-num">{fmt(r.v2025)} {r.unit}</td>
                    <td class="db-num">ca. {fmt0(r.v2026)} {r.unit}</td>
                    <td class="db-note">{r.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>

      <section class="db-tables" aria-labelledby="dev-h">
        <h2 id="dev-h">Effektiver Satz je Hektar nach Staffelung</h2>
        <p class="db-calc-sub">Basiszahlung und Umverteilung zusammen, Heimgutflächen, Antragsjahr 2025.</p>
        <div class="db-tw">
          <table class="db-table">
            <thead><tr><th scope="col">Flächenbereich</th><th scope="col">Basis + Umverteilung</th></tr></thead>
            <tbody>
              {staffel.map((s) => (
                <tr><td>{s.label}</td><td class="db-num">{fmt(s.v)} €/ha</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="db-explain" aria-labelledby="exp-h">
        <h2 id="exp-h">Was die einzelnen Zahlungen bedeuten</h2>
        <div class="db-explain-grid">
          <div class="db-exp"><h3>Basiszahlung</h3><p>Die Grundlage des Systems: ein Betrag je förderfähigem Hektar, gebunden an die Konditionalität. Für Almweiden gilt ein eigener, viel niedrigerer Satz, weil eine Hochweide nicht dasselbe trägt wie ein Talbetrieb. Je Betrieb ist die Basiszahlung auf 100 000 € begrenzt; Lohnkosten lassen sich anrechnen.</p></div>
          <div class="db-exp"><h3>Umverteilungszahlung</h3><p>Ein Aufschlag für die ersten Hektar, der kleinere Betriebe stärkt — gerade in Österreich mit seinen vielen kleinen Höfen. Bis 20 Hektar voll, vom 21. bis zum 40. Hektar zur Hälfte, darüber nichts. Almweideflächen zählen nicht mit.</p></div>
          <div class="db-exp"><h3>Junglandwirtinnen und Junglandwirte</h3><p>Ein Zuschlag je Hektar für den Einstieg in die Landwirtschaft: Altersgrenze 40 Jahre im Jahr der Aufnahme, Ausbildung spätestens zwei Jahre danach. Höchstens 40 Hektar, höchstens fünf Jahre hintereinander.</p></div>
          <div class="db-exp"><h3>Almauftriebsprämie</h3><p>Die einzige an Tiere gekoppelte Direktzahlung: Sie gibt es nur für Kühe, übrige Rinder sowie Mutterschafe und Mutterziegen, die auf eine Alm getrieben werden. Kühe und Muttertiere erhalten je RGVE doppelt so viel wie die übrigen Rinder.</p></div>
        </div>
      </section>

      <section class="db-faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Häufige Fragen</h2>
        {faq.map((f) => (
          <details class="db-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>

      <div class="db-related">
        <a href={localizePath('de', '/oepul/')}>→ ÖPUL 2023 — das österreichische Agrarumweltprogramm (Prämien)</a>
        <a href={localizePath('de', '/direktzahlungen/')}>→ Direktzahlungen in Deutschland — Einheitsbeträge im Vergleich</a>
      </div>

      <footer class="db-src">
        <p>Datenquellen: <a href="https://www.ama.at/fachliche-informationen/direktzahlungen/praemienbetrag-gemaess-21-abs-11-gsp-av" target="_blank" rel="noopener">AMA — Prämienbetrag gemäß § 21 Abs. 11 GSP-AV</a> (Einheitsbeträge 2025, veröffentlicht am 15. Dezember 2025) und <a href="https://www.ama.at/media/uzrh0lop/merkblatt_diza2026_endversion_13112025.pdf" target="_blank" rel="noopener">AMA — Merkblatt Direktzahlungen 2026</a> (vorläufige Beträge, Fristen und Voraussetzungen). Verbindlich ist der Bescheid der AMA. Letzte Aktualisierung dieser Seite: <strong>{lastUpdated}</strong>.</p>
      </footer>
    </div>
  </main>

  <script type="application/json" id="dbRates" set:html={JSON.stringify({ grund: A.heimgut, umv20: A.umv20, umv40: A.umv40 })} />
  <script is:inline>
    (function () {
      var cfg = JSON.parse(document.getElementById('dbRates').textContent);
      var ha = document.getElementById('ha');
      var oG = document.getElementById('o-grund'), oU = document.getElementById('o-umv'), oS = document.getElementById('o-sum');
      var f = function (v) { return v.toLocaleString('de-DE', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' €'; };
      function calc() {
        var h = parseFloat((ha.value || '0').replace(',', '.'));
        if (isNaN(h) || h < 0) h = 0;
        var g = h * cfg.grund;
        var u = Math.min(h, 20) * cfg.umv20 + Math.max(0, Math.min(h, 40) - 20) * cfg.umv40;
        oG.textContent = f(g);
        oU.textContent = f(u);
        oS.textContent = f(g + u);
      }
      ha.addEventListener('input', calc);
      calc();
    })();
  </script>
</Layout>

<style>
  .db{--yellow:#FFEA00;--yellow-d:#FFD400;--ink:#0A0A0B;--line:#E7E7EA;--muted:#6E6E76;--paper:#FBFAF3;--soft:#F5F5F2;--green:#2E9E57;--red:#D6492B;
    font-family:'Chakra Petch',system-ui,sans-serif;color:var(--ink);background:#fff}
  .db-wrap{max-width:1000px;margin:0 auto;padding:26px 28px 72px}
  .db a{color:inherit}
  .db-crumb{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:22px;flex-wrap:wrap}
  .db-crumb a{text-decoration:none}.db-crumb a:hover{color:var(--ink);text-decoration:underline}
  .db-crumb b{color:var(--ink)}

  .db-head{padding-bottom:22px;border-bottom:2px solid var(--ink)}
  .db-eyebrow{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
  .db-head h1{font-size:44px;letter-spacing:-.03em;font-weight:800;margin:8px 0 12px;line-height:1.02}
  .db-lead{font-size:15.5px;line-height:1.6;color:#2A2A2F;max-width:80ch}

  .db-hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:24px 0}
  .db-stat{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:5px}
  .db-stat--hl{background:var(--yellow);border-color:var(--yellow-d)}
  .db-stat .l{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .db-stat--hl .l{color:#5c5300}
  .db-stat .v{font-size:30px;font-weight:800;letter-spacing:-.02em}
  .db-stat .v small{font-size:14px;color:var(--muted);font-weight:600}
  .db-stat--hl .v small{color:#5c5300}
  .db-stat .d{font-size:12px;color:var(--muted)}
  .db-stat--hl .d{color:#5c5300}

  .db h2{font-size:24px;letter-spacing:-.02em;font-weight:800;margin:36px 0 6px}
  .db h3{font-size:16px;font-weight:800;letter-spacing:-.01em}

  .db-calc{margin-top:34px}
  .db-calc-sub{font-size:14px;color:var(--muted);margin:0 0 14px;max-width:70ch}
  .db-calc-box{display:grid;grid-template-columns:220px 1fr;gap:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:22px}
  .db-calc-field{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-calc-field input{font:800 26px 'Chakra Petch',sans-serif;color:var(--ink);border:2px solid var(--ink);border-radius:12px;padding:10px 14px;width:100%}
  .db-calc-out{display:flex;flex-direction:column;justify-content:center;gap:8px}
  .db-calc-line{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14.5px;padding:6px 0;border-bottom:1px dashed var(--line)}
  .db-calc-line em{color:var(--muted);font-style:normal;font-size:12px}
  .db-calc-line b{font-size:18px;font-weight:800;white-space:nowrap}
  .db-calc-total{border-bottom:0;margin-top:2px}
  .db-calc-total span{font-weight:700}
  .db-calc-total b{font-size:24px;background:var(--yellow);padding:2px 8px;border-radius:8px}
  .db-calc-note{font-size:12px;color:var(--muted);margin-top:10px}

  .db-tblcard{margin-top:18px;border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .db-tblcard h3{padding:14px 18px;background:var(--soft);border-bottom:1px solid var(--line);margin:0}
  .db-tblscroll{overflow-x:auto}
  .db-tbl{width:100%;border-collapse:collapse;font-size:14px;min-width:520px}
  .db-tbl th,.db-tbl td{padding:11px 16px;text-align:left;border-bottom:1px solid var(--line)}
  .db-tbl th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .db-tbl th.num,.db-tbl td.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
  .db-tbl tr:last-child td{border-bottom:0}
  .db-tbl-name{display:block;font-weight:700}
  .db-tbl-note{display:block;font-size:12px;color:var(--muted);margin-top:2px}
  .db-tbl td.strong{font-weight:800}
  .db-tbl td.unit{color:var(--muted);font-size:12.5px;white-space:nowrap}
  .db-yoy{font-weight:800;font-size:12.5px}
  .db-yoy.up{color:var(--green)}.db-yoy.dn{color:var(--red)}
  .db-tbl-src{font-size:12px;color:var(--muted);margin-top:12px}

  .db-explain-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
  .db-exp{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
  .db-exp h3{margin:0 0 6px}
