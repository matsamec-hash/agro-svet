---
// SSR — viz plodiny/index.astro (locale prefix a prerender se vylučují).
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { listPlodiny, getPlodina, isOdrudaIndexable } from '../../../lib/plodiny';
import { chorobaChipsForPlodina } from '../../../lib/choroby';
import { useTranslations, tf, getLocaleFromUrl, localizeInternalHref, localizePath } from '../../../i18n/utils';
import { breadcrumbSchema, howToSchema, faqPageSchema, itemListSchema, imageObjectSchema } from '../../../lib/structured-data';
import OsivaLinks from '../../../components/OsivaLinks.astro';

const { plodina: slug } = Astro.params;
const locale = Astro.locals.locale ?? getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);
const plodina = getPlodina(slug!, locale);
// Detail odrůdy zůstává cs-only (úřední popisy ÚKZÚZ k odrůdám registrovaným
// v ČR). Pod ne-cs locale proto odrůdy NElinkujeme — tabulka sama nese hodnotu
// (název, rok, udržovatel) a nevzniká skok do češtiny ani 302.
const linkOdrudy = locale === 'cs';
if (!plodina) return Astro.rewrite('/404');

const base = `/plodiny/${plodina.slug}/`;
const breadcrumb = breadcrumbSchema([
  { name: tr('cat.bc.home'), url: localizePath(locale, '/') },
  { name: tr('plod.hub.crumb'), url: localizePath(locale, '/plodiny/') },
  { name: tr(`plod.skupina.${plodina.skupina}`), url: localizePath(locale, `/plodiny/skupina/${plodina.skupina}/`) },
  { name: plodina.name, url: base },
]);

const howTo = plodina.osevni_postup && plodina.osevni_postup.length > 0
  ? howToSchema({
      name: tf(locale, 'plod.d.osevniPostupName', { name: plodina.name }),
      description: `Jak pěstovat plodinu ${plodina.name.toLowerCase()}.`,
      url: base,
      steps: plodina.osevni_postup,
    })
  : null;
const faq = plodina.faq && plodina.faq.length > 0 ? faqPageSchema(plodina.faq) : null;
const chorobaChips = chorobaChipsForPlodina(plodina.slug, locale);

// Cross-link plodina → cenová statistika komodity (jen plodiny s cenovou řadou).
const STAT_KOMODITA: Record<string, { slug: string; label: string }> = {
  'psenice-ozima': { slug: 'psenice', label: 'Ceny pšenice' },
  'psenice-jarni': { slug: 'psenice', label: 'Ceny pšenice' },
  'jecmen-ozimy': { slug: 'jecmen', label: 'Ceny ječmene' },
  'jecmen-jarni': { slug: 'jecmen', label: 'Ceny ječmene' },
  'repka-ozima': { slug: 'repka', label: 'Ceny řepky' },
  'repka-jarni': { slug: 'repka', label: 'Ceny řepky' },
  kukurice: { slug: 'kukurice', label: 'Ceny kukuřice' },
  mak: { slug: 'mak', label: 'Ceny máku' },
};
const statKomodita = STAT_KOMODITA[plodina.slug];
const heroImageSchema = plodina.hero_image
  ? imageObjectSchema({
      contentUrl: plodina.hero_image,
      author: plodina.hero_author || undefined,
      license: plodina.hero_license,
      acquireLicensePage: plodina.hero_source,
      representativeOfPage: true,
    })
  : null;
const list = plodina.odrudy.length > 0
  ? itemListSchema(
      plodina.odrudy.map((o) => ({
        url: isOdrudaIndexable(o) ? `${base}${o.slug}/` : base,
        name: o.name,
      })),
      `Odrůdy — ${plodina.name}`,
    )
  : null;
---

<Layout
  title={tf(locale, 'plod.d.title', { name: plodina.name })}
  description={tf(locale, 'plod.d.desc', { name: plodina.name, count: plodina.odrudy.length })}
  ogImage={`https://agro-svet.cz/og/plodiny-${plodina.slug}.png`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  {howTo && <script type="application/ld+json" is:inline set:html={JSON.stringify(howTo)} />}
  {faq && <script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />}
  {list && <script type="application/ld+json" is:inline set:html={JSON.stringify(list)} />}
  {heroImageSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(heroImageSchema)} />}

  <div class="pl-detail">

    <nav class="breadcrumb" aria-label={tr('a11y.breadcrumb')}>
      <a href={localizeInternalHref(locale, '/')}>{tr('cat.bc.home')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizeInternalHref(locale, '/plodiny/')}>{tr('plod.hub.crumb')}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <a href={localizeInternalHref(locale, `/plodiny/skupina/${plodina.skupina}/`)}>{tr(`plod.skupina.${plodina.skupina}`)}</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <span class="current">{plodina.name}</span>
    </nav>

    <section class="hero">
      <div class="hero-left">
        <span class="kicker"><span class="dot"></span>{tr(`plod.skupina.${plodina.skupina}`)} · {tr('plod.d.kickerSuffix')}</span>
        <h1>{plodina.name}</h1>
        <p class="hero-lede">{plodina.description}</p>
        <div class="hero-stats">
          {plodina.odrudy.length > 0 && (
            <div class="s"><span class="n">{plodina.odrudy.length}</span><span class="l">{tr('plod.d.statOdrudLbl')}</span></div>
          )}
          {plodina.vynos_t_ha && (
            <div class="s"><span class="n">{plodina.vynos_t_ha}</span><span class="l">{tr('plod.d.statVynos')}</span></div>
          )}
          {plodina.osevni_postup && plodina.osevni_postup.length > 0 && (
            <div class="s"><span class="n">{plodina.osevni_postup.length}</span><span class="l">{tr('plod.d.statSteps2')}</span></div>
          )}
        </div>
        <div class="hero-actions">
          <a class="cta-back" href={localizeInternalHref(locale, '/plodiny/')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            {tr('plod.d.backToHub')}
          </a>
          <a class="cta-group" href={localizeInternalHref(locale, `/plodiny/skupina/${plodina.skupina}/`)}>
            {tr(`plod.skupina.${plodina.skupina}`)}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
      <div class="hero-right">
        {plodina.hero_image ? (
          <img
            src={plodina.hero_image}
            alt={`Plodina ${plodina.name}`}
            width="280"
            height="210"
            loading="eager"
            decoding="async"
            class="hero-photo"
          />
        ) : (
          <div class="hero-emoji-tile" aria-hidden="true">🌾</div>
        )}
      </div>
    </section>

    {plodina.hero_image && (
      <p class="hero-attribution">
        {plodina.hero_license === 'Public domain' && !plodina.hero_author
          ? <>{tr('plod.d.photoIllu')}, <a href={plodina.hero_source} target="_blank" rel="noopener nofollow">{tr('plod.d.srcLbl')}</a></>
          : plodina.hero_author
            ? <>{tr('plod.d.photoLbl')}: {plodina.hero_author}, {plodina.hero_license} (<a href={plodina.hero_source} target="_blank" rel="noopener nofollow">{tr('plod.d.srcLbl')}</a>)</>
            : <>{tr('plod.d.photoLbl')}: {plodina.hero_license} (<a href={plodina.hero_source} target="_blank" rel="noopener nofollow">{tr('plod.d.srcLbl')}</a>)</>
        }
      </p>
    )}

    {(plodina.vysevek || plodina.hnojeni || plodina.vynos_t_ha || plodina.sklizen || plodina.vyuziti) && (
      <section class="card-section agro-facts">
        <h2 class="section-title">{tr('plod.d.agronomie')}</h2>
        <dl class="facts-dl">
          {plodina.vysevek && (
            <>
              <dt>{tr('plod.d.vysevek')}</dt>
              <dd>{plodina.vysevek}</dd>
            </>
          )}
          {plodina.hnojeni && (
            <>
              <dt>{tr('plod.d.hnojeni')}</dt>
              <dd>{plodina.hnojeni}</dd>
            </>
          )}
          {plodina.vynos_t_ha && (
            <>
              <dt>{tr('plod.d.vynos')}</dt>
              <dd>{plodina.vynos_t_ha} t/ha</dd>
            </>
          )}
          {plodina.sklizen && (
            <>
              <dt>{tr('plod.d.sklizen')}</dt>
              <dd>{plodina.sklizen}</dd>
            </>
          )}
          {plodina.vyuziti && (
            <>
              <dt>{tr('plod.d.vyuziti')}</dt>
              <dd>{plodina.vyuziti}</dd>
            </>
          )}
        </dl>
      </section>
    )}

    {plodina.osevni_postup && plodina.osevni_postup.length > 0 && (
      <section class="card-section">
        <h2 class="section-title">{tr('plod.d.osevniPostup')}</h2>
        <ol class="how-to-list">
          {plodina.osevni_postup.map((s, i) => (
            <li id={`krok-${i + 1}`} class="how-to-step">
              <span class="step-num">{i + 1}</span>
              <div class="step-body">
                <strong class="step-name">{s.name}</strong>
                <p class="step-text">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {chorobaChips.length > 0 && (
      <section class="card-section">
        <h2 class="section-title">{tr('plod.d.choroby')}</h2>
        <ul class="tag-list">
          {chorobaChips.map((c) => (
            c.slug
              ? <li class="tag-item"><a href={localizeInternalHref(locale, `/choroby/${c.slug}/`)}>{c.chip}</a></li>
              : <li class="tag-item">{c.chip}</li>
          ))}
        </ul>
      </section>
    )}

    {plodina.body && (
      <section class="card-section prose" set:html={plodina.body} />
    )}

    {plodina.odrudy.length > 0 && (
      <section class="card-section odrudy-section">
        <h2 class="section-title">
          {tr('plod.d.varietiesH')}
          <span class="section-title-c">{plodina.odrudy.length}</span>
        </h2>
        {!linkOdrudy && <p class="odrudy-note">{tr('plod.d.varietiesNote')}</p>}
        <div class="table-wrap">
          <table class="odrudy-table">
            <thead>
              <tr>
                <th>{tr('plod.d.thOdruda')}</th>
                <th>{tr('plod.d.thTyp')}</th>
                <th>{tr('plod.d.thRanost')}</th>
                <th>{tr('plod.d.thRegistrace')}</th>
                <th>{tr('plod.d.thUdrzovatel')}</th>
              </tr>
            </thead>
            <tbody>
              {plodina.odrudy.map((o) => (
                <tr>
                  <td class="td-name">
                    {linkOdrudy && isOdrudaIndexable(o)
                      ? <a href={`${base}${o.slug}/`}>{o.name}</a>
                      : o.name}
                  </td>
                  <td>{o.typ ?? '—'}</td>
                  <td>{o.ranost ?? '—'}</td>
                  <td>{o.rok_registrace ?? '—'}</td>
                  <td>{o.udrzovatel ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {plodina.faq && plodina.faq.length > 0 && (
      <section class="card-section faq-section">
        <h2 class="section-title">{tr('plod.d.faq')}</h2>
        <div class="faq-list">
          {plodina.faq.map((f) => (
            <div class="faq-item">
              <h3 class="faq-q">{f.q}</h3>
              <p class="faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="card-section related-links">
      <h2 class="section-title">{tr('plod.d.related')}</h2>
      <div class="rl-grid">
        {statKomodita && (
          <a class="rl-item" href={localizeInternalHref(locale, `/statistiky/komodita/${statKomodita.slug}/`)}>
            <span class="rl-ico" aria-hidden="true">📈</span>
            <span class="rl-txt"><strong>{locale === 'cs' ? statKomodita.label : tf(locale, 'plod.d.pricesOf', { name: plodina.name })}</strong><small>{tr('plod.d.rlPrices')}</small></span>
          </a>
        )}
        <a class="rl-item" href={localizeInternalHref(locale, '/kalkulacka/naklady-na-hektar/')}>
          <span class="rl-ico" aria-hidden="true">🧮</span>
          <span class="rl-txt"><strong>{tr('plod.d.rlCosts')}</strong><small>{tr('plod.d.rlCostsSub')}</small></span>
        </a>
        <a class="rl-item" href={localizeInternalHref(locale, '/statistiky/')}>
          <span class="rl-ico" aria-hidden="true">📊</span>
          <span class="rl-txt"><strong>{tr('plod.d.rlStats')}</strong><small>{tr('plod.d.rlStatsSub')}</small></span>
        </a>
        <a class="rl-item" href={localizeInternalHref(locale, '/slovnik/')}>
          <span class="rl-ico" aria-hidden="true">📖</span>
          <span class="rl-txt"><strong>{tr('plod.d.rlGloss')}</strong><small>{tr('plod.d.rlGlossSub')}</small></span>
        </a>
      </div>
    </section>

    <div class="card-section osiva-wrap">
      {/* Síťový blok míří na české prodejce osiv (/prodejci/, farmakrty.cz) —
          pod ne-cs locale nedává smysl a vedl by do češtiny. Neskrývá se
          překladem, ale úplně: je to CZ obchodní kontext, ne obsah. */}
      {locale === 'cs' && <OsivaLinks plodina={plodina.name} skupina={plodina.skupina} />}
    </div>

  </div>
</Layout>

<style>
  .pl-detail {
    --yellow: #FFEA00; --ink: #0A0A0B; --body: #1E1E22; --muted: #6B6B72;
    --muted-2: #9A9AA3; --line: #EAEAEC; --card: #FFFFFF; --green: #3c7a1a;
    --green-soft: #eaf4e0; --green-dark: #2a5a10;
    --r-xl: 24px; --r-lg: 18px; --r-md: 12px;
    --sh-1: 0 1px 2px rgba(10,10,12,.04), 0 0 0 1px rgba(10,10,12,.03);
    --sh-3: 0 18px 40px -12px rgba(10,10,12,.18), 0 0 0 1px rgba(10,10,12,.04);
    max-width: 1280px; margin: 0 auto; padding: 26px 24px 96px; color: var(--body);
  }

  /* ── Breadcrumb ── */
  .pl-detail .breadcrumb { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); margin-bottom: 22px; flex-wrap: wrap; }
  .pl-detail .breadcrumb a { color: var(--muted); text-decoration: none; }
  .pl-detail .breadcrumb a:hover { color: #000; }
  .pl-detail .breadcrumb svg { color: var(--muted-2); flex-shrink: 0; }
  .pl-detail .breadcrumb .current { color: #000; font-weight: 600; }

  /* ── Související ── */
  .pl-detail .rl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .pl-detail .rl-item {
    display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit;
    background: #F7F7FA; border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 14px 16px; transition: .15s;
  }
  .pl-detail .rl-item:hover { background: var(--green-soft); border-color: #cfe0bd; transform: translateY(-1px); }
  .pl-detail .rl-ico { font-size: 24px; line-height: 1; flex-shrink: 0; }
  .pl-detail .rl-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pl-detail .rl-txt strong { font-size: 14.5px; color: var(--ink); font-weight: 700; }
  .pl-detail .rl-txt small { font-size: 12px; color: var(--muted); }

  /* ── Hero ── */
  .pl-detail .hero {
    position: relative; overflow: hidden; color: #fff; border-radius: var(--r-xl);
    background:
      radial-gradient(600px 300px at 15% 20%, rgba(255, 234, 0, .14), transparent 60%),
      radial-gradient(700px 400px at 90% 90%, rgba(60, 140, 40, .30), transparent 60%),
      linear-gradient(135deg, #0F1409 0%, #161F0E 60%, #1C2B10 100%);
    padding: 48px 48px 40px; margin-bottom: 26px; display: flex; gap: 32px; align-items: center;
    box-shadow: var(--sh-3);
  }
  .pl-detail .hero-left { flex: 1; min-width: 0; }
  .pl-detail .kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #D8EBC0; margin-bottom: 16px; }
  .pl-detail .kicker .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--yellow); }
  .pl-detail .hero h1 { font-size: clamp(28px, 4vw, 44px); line-height: 1.08; margin: 0 0 14px; font-weight: 800; }
  .pl-detail .hero-lede { font-size: 16.5px; line-height: 1.6; color: #E0ECDA; max-width: 60ch; margin: 0 0 22px; }
  .pl-detail .hero-stats { display: flex; gap: 28px; flex-wrap: wrap; margin-bottom: 22px; }
  .pl-detail .hero-stats .s { display: flex; flex-direction: column; }
  .pl-detail .hero-stats .n { font-size: 26px; font-weight: 800; color: #fff; }
  .pl-detail .hero-stats .l { font-size: 12.5px; color: #B2C9A8; }
  .pl-detail .hero-right { flex-shrink: 0; }
  .pl-detail .hero-emoji-tile { font-size: 92px; line-height: 1; filter: drop-shadow(0 8px 24px rgba(0,0,0,.4)); }
  .pl-detail .hero-photo {
    width: 280px; height: 210px; object-fit: cover;
    border-radius: var(--r-lg); display: block;
    box-shadow: 0 8px 32px rgba(0,0,0,.45);
  }
  .pl-detail .hero-attribution {
    font-size: 11.5px; color: var(--muted-2); margin: -18px 0 20px;
    padding: 0 4px; line-height: 1.5;
  }
  .pl-detail .hero-attribution a { color: var(--muted); text-decoration: underline; }
  .pl-detail .hero-attribution a:hover { color: #000; }
  .pl-detail .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .pl-detail .cta-back {
    display: inline-flex; align-items: center; gap: 8px;
    color: #c8c8d0; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
    padding: 11px 16px; border-radius: var(--r-md); text-decoration: none;
    font-size: 13.5px; font-weight: 500; transition: .15s;
  }
  .pl-detail .cta-back:hover { background: rgba(255,255,255,.12); color: #fff; border-color: rgba(255,255,255,.22); }
  .pl-detail .cta-group {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--yellow); color: #0A0A0B;
    padding: 11px 16px; border-radius: var(--r-md); text-decoration: none;
    font-size: 13.5px; font-weight: 700; transition: .15s;
  }
  .pl-detail .cta-group:hover { opacity: .9; }

  /* ── Section cards ── */
  .pl-detail .card-section {
    background: var(--card); border-radius: var(--r-lg); padding: 28px 32px;
    box-shadow: var(--sh-1); margin-bottom: 20px;
  }
  .pl-detail .section-title {
    font-size: 20px; font-weight: 800; color: var(--ink); margin: 0 0 20px;
    display: flex; align-items: center; gap: 10px;
  }
  .pl-detail .section-title-c {
    font-size: 13px; background: var(--green-soft); color: var(--green);
    font-weight: 700; padding: 3px 10px; border-radius: 999px;
  }

  /* ── Agronomie DL ── */
  .pl-detail .facts-dl {
    display: grid; grid-template-columns: max-content 1fr; gap: 0;
    border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden;
  }
  .pl-detail .facts-dl dt,
  .pl-detail .facts-dl dd {
    padding: 11px 16px; margin: 0; font-size: 14.5px; line-height: 1.5;
  }
  .pl-detail .facts-dl dt {
    font-weight: 700; color: var(--ink); background: #F7F7FA;
    border-bottom: 1px solid var(--line);
  }
  .pl-detail .facts-dl dd {
    color: var(--body); background: #fff; border-bottom: 1px solid var(--line);
  }
  .pl-detail .facts-dl dt:last-of-type,
  .pl-detail .facts-dl dd:last-child { border-bottom: none; }

  /* ── Osevní postup ── */
  .pl-detail .how-to-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .pl-detail .how-to-step {
    display: flex; gap: 16px; align-items: flex-start;
    background: #F7F7FA; border-radius: var(--r-md); padding: 16px 20px;
    border-left: 4px solid var(--green);
  }
  .pl-detail .step-num {
    flex-shrink: 0; width: 30px; height: 30px;
    background: var(--green); color: #fff;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; line-height: 1;
  }
  .pl-detail .step-body { flex: 1; min-width: 0; }
  .pl-detail .step-name { display: block; font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 5px; }
  .pl-detail .step-text { margin: 0; font-size: 14px; line-height: 1.6; color: var(--body); }

  /* ── Choroby tag list ── */
